@prefix topcd: <https://w3id.org/top/hcls/clinical-care/v1#> .
@prefix top:   <https://w3id.org/top/v1#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
#  TOP HCLS — Clinical-Care v1  (PATTERN-B STUBS ONLY)
#
#  These are placeholder classes that clinical-research v1 crosses into
#  via Pattern B. They carry just enough structure for SHACL to pass.
#  They do NOT pretend to be a complete clinical-care reference graph —
#  full clinical-care lifts after clinical-research v1 ships, when the
#  clinical-care WG forms and graduates these stubs to real classes.
#  The URIs stay stable, so clinical-research's Pattern-B declarations
#  continue to resolve unchanged. (Seed §"Pattern B stubs".)
#################################################################

<https://w3id.org/top/hcls/clinical-care/v1> a owl:Ontology ;
    rdfs:comment "Clinical-care v1 — stub ontology. Contains only the placeholder classes clinical-research v1 references via Pattern B." ;
    owl:imports <https://w3id.org/top/core/v1> .

topcd:AdverseEvent
    a owl:Class ;
    rdfs:subClassOf top:Observation ;
    skos:prefLabel "Adverse Event (clinical-care)"@en ;
    rdfs:comment "STUB. An AE observed in the course of care. Graduates to a full class when the clinical-care WG forms." .

topcd:MedicationAdministration
    a owl:Class ;
    rdfs:subClassOf top:Activity ;
    skos:prefLabel "Medication Administration (clinical-care)"@en ;
    rdfs:comment "STUB. Administration of a medication in the course of care." .

topcd:Encounter
    a owl:Class ;
    rdfs:subClassOf top:Activity ;
    skos:prefLabel "Encounter (clinical-care)"@en ;
    rdfs:comment "STUB. A clinical-care encounter." .

topcd:Procedure
    a owl:Class ;
    rdfs:subClassOf top:Activity ;
    skos:prefLabel "Procedure (clinical-care)"@en ;
    rdfs:comment "STUB. A clinical-care procedure." .
