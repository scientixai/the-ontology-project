@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix top: <https://top.scientix.ai/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://top.scientix.ai/core/v1> a owl:Ontology ;
    dcterms:created "2026-05-10"^^xsd:date ;
    dcterms:description "OWL/SHACL view of the SKOS taxonomy at taxonomy/taxonomy.ttl. Defines the root top:CommonEntity, the eight L2 categories, the 28 L3 leaves, the Universal DNA properties, the category relational extensions, and the SHACL UniversalDNAShape that enforces the three required practitioner-grounded properties on every TOP entity."@en ;
    dcterms:license "Apache-2.0" ;
    dcterms:title "TOP Core — OWL classes and SHACL contract"@en ;
    rdfs:seeAlso <https://top.scientix.ai/core/v1/index.html>,
        <https://top.scientix.ai/governance/decision-log.md>,
        top:TaxonomyV1 ;
    owl:imports <https://top.scientix.ai/core/v1/modules/top-agent.ttl>,
        <https://top.scientix.ai/core/v1/modules/top-ai.ttl>,
        <https://top.scientix.ai/core/v1/modules/top-bitemporal.ttl>,
        <https://top.scientix.ai/core/v1/modules/top-constraint.ttl>,
        <https://top.scientix.ai/core/v1/modules/top-evidence.ttl>,
        <https://top.scientix.ai/core/v1/modules/top-location.ttl>,
        <https://top.scientix.ai/core/v1/modules/top-outcome.ttl>,
        <https://top.scientix.ai/core/v1/modules/top-resource.ttl>,
        <https://top.scientix.ai/core/v1/modules/top-root.ttl>,
        <https://top.scientix.ai/core/v1/modules/top-scope.ttl>,
        <https://top.scientix.ai/core/v1/modules/top-temporal.ttl> .

top:AgentNotConstraintShape a sh:NodeShape ;
    rdfs:label "Agent ⊓ Constraint disjointness"@en ;
    sh:message "An entity typed top:Agent must not also be typed top:Constraint." ;
    sh:not [ sh:class top:Constraint ] ;
    sh:targetClass top:Agent .

top:AgentNotEvidenceShape a sh:NodeShape ;
    rdfs:label "Agent ⊓ Evidence disjointness"@en ;
    sh:message "An entity typed top:Agent must not also be typed top:Evidence (L2 categories are mutually disjoint)." ;
    sh:not [ sh:class top:Evidence ] ;
    sh:targetClass top:Agent .

top:AgentNotLocationShape a sh:NodeShape ;
    rdfs:label "Agent ⊓ Location disjointness"@en ;
    sh:message "An entity typed top:Agent must not also be typed top:Location." ;
    sh:not [ sh:class top:Location ] ;
