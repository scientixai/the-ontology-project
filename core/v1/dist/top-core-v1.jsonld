      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Invariant"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#validFrom",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Domain intentionally open: rdfs:domain is an inference axiom, not a constraint \u2014 a domain of top:Versioned would retype every dated entity as Versioned and drag it under the versioning contract (the RDFS target cascade). The requirement side lives in SHACL: top:BitemporalShape demands validFrom on Versioned."
      },
      {
        "@language": "en",
        "@value": "Start of the valid-time interval \u2014 when this version's state became true in the world. Distinct from top:observedAt (transaction time). Invariant per ADR-0019, like top:startTime/top:endTime. No PROV-O peer: PROV models system time, not valid-time-of-a-fact (declared absence, per ADR-0021)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "valid from"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Invariant"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#validUntil",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "End of the valid-time interval; open (absent) for the currently-valid version. Invariant per ADR-0019."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "valid until"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Invariant"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#variance",
