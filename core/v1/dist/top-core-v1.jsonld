        "@id": "https://top.scientix.ai/v1#CommonEntity"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#VersionSeries",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The stable identity root for a chain of top:Versioned snapshots. An instance of top:VersionSeries has a single IRI that never changes; each point-in-time value-version links to it via prov:specializationOf. Consumers and external references always point at the VersionSeries; version navigation is a query, not an IRI change."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Version Series"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Versioned",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Marker for an immutable, bitemporally-tracked value-version \u2014 an attribute-value-at-a-time (or whole-entity snapshot) carrying valid time and a stable identity via prov:specializationOf. Applied where Tier-1 entailment fires or where a workflow opts an attribute in. Not every TOP entity is Versioned; only those that need full bitemporal history."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Versioned"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Virtual",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A logical place addressable via URI / path / network identifier \u2014 data warehouse, system zone, application namespace, regulatory jurisdiction."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Virtual Location"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Location"
      },
      {
        "@id": "https://top.scientix.ai/v1#Location"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Window",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A bounded interval within which an activity must occur \u2014 visit window, dose window, regulatory submission window, calibration window."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Window"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      },
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      }
    ]
  },
  {
