      {
        "@id": "https://top.scientix.ai/v1#Agent"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Tightenable"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#concludesAbout",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The entity (or set of entities) this Conclusion pertains to."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#Conclusion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "concludes about"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
