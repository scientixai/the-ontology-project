      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "top:validUntil is open (absent) for the current version, or exactly one xsd:dateTime when closed."
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/v1#validUntil"
