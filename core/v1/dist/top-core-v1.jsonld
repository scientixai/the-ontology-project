    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The minimum every TOP entity must carry: a unique identifier, an observation timestamp, and a current status."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Universal DNA Shape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:cb1860b63ea3a213e90d6ff1573004fd79df2486462f87783bec5f86d2b0582dea5"
      },
      {
