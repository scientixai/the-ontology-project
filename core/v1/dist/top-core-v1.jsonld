        "@value": "Status changes must be versioned"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A top:StatusChange is the audit event of a transition and must be an immutable version."
      }
    ],
    "http://www.w3.org/ns/shacl#node": [
      {
