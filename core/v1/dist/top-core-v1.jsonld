        "@value": "A discrete transition in lifecycle state \u2014 enrollment, withdrawal, batch release, IRB approval, record finalization."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Status Change"
