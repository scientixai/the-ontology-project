      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A software or operational system used to execute work \u2014 EDC, CTMS, IRT, LIMS, MES, ERP."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "System"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://purl.obolibrary.org/obo/bfo#GenericallyDependentContinuant"
      },
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "https://top.scientix.ai/v1#Resource"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Temporal",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The time-based dimension of operations. Both plans (schedules, milestones, campaigns) and execution (visits, procedures, batches, shipments)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Temporal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://purl.obolibrary.org/obo/bfo#Process"
      },
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      },
      {
        "@id": "https://top.scientix.ai/v1#CommonEntity"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Tightenable",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A top:flavor value indicating domain specializations may narrow this property's range or add sh:in / sh:minInclusive constraints, but may not loosen the base constraint."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Tightenable"
      }
    ]
  },
