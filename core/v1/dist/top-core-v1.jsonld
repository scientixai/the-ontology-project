    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Constraints required to enter this Location (clearance, training prerequisite, escort policy, biosafety level)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#Location"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "access requirement"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Tightenable"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#appliesTo",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Targets of the Constraint. Constraints can scope to Agents, Resources, Scopes, or Temporals; range is top:CommonEntity so the targeting is uniform across Categories. Leaf layer narrows by domain."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "applies to"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/v1#CommonEntity"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Tightenable"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#authorizedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The authority that granted the Agent permission to act in a specific scope."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#Agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
