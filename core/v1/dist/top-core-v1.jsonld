  },
  {
    "@id": "https://top.scientix.ai/v1",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/bibliographicCitation": [
      {
        "@value": "ScientixAI (2026). TOP Core (v1). The Ontology Project."
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "ScientixAI"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The universal foundation of The Ontology Project: one root (top:CommonEntity), eight Category-Level Objects, the Universal DNA (identifier / observedAt / status), the ADR-0021 bitemporal vocabulary, and the ADR-0019 extension-flavor contract. Domain reference graphs (e.g. TOP-CR) specialize this artifact and pin it by checksum."
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-07-07"
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://www.apache.org/licenses/LICENSE-2.0"
      }
    ],
    "http://purl.org/dc/terms/publisher": [
      {
        "@value": "ScientixAI"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "TOP Core"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TOP Core"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://top.scientix.ai/v1/core-v1"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "v1"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Activity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An executed unit of operational work \u2014 a procedure performed, a batch run, a shipment received, a review completed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Activity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      },
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Additive",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A top:flavor value indicating domain specializations may add new properties or shapes at their layer without affecting the base constraint. Purely extensible."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Agent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The entity that holds authority or bears responsibility for what is done: it signs, owns, authorizes, enforces, and can be attributed an action. Persons, Organizations, Groups, Autonomous Agents (software with delegated authority). Capacity to act is not sufficient. A thing that merely acts causally (a pathogen, a compound, a river) is not an Agent unless it can be held to account."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://purl.obolibrary.org/obo/bfo#IndependentContinuant"
      },
      {
        "@id": "http://www.w3.org/ns/prov#Agent"
      },
      {
        "@id": "https://top.scientix.ai/v1#CommonEntity"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      },
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Location"
      },
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      },
      {
        "@id": "https://top.scientix.ai/v1#Resource"
      },
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      },
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Artifact",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A produced object \u2014 a manufactured batch unit, a generated dataset, a derived report, a synthesized substance."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Artifact"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://purl.obolibrary.org/obo/bfo#MaterialEntity"
      },
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Attestation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A formal declaration by an Agent affirming a fact \u2014 signed consent, regulatory attestation, compliance declaration, e-signature on a record."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Attestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#AttestationMustVersionShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Attestations must be versioned"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A top:Attestation is a committed, signed declaration and must be an immutable version."
      }
    ],
    "http://www.w3.org/ns/shacl#node": [
      {
        "@id": "https://top.scientix.ai/v1#BitemporalShape"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://top.scientix.ai/v1#Attestation"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#AutonomousAgent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A software entity acting on delegated authority \u2014 robotic process, AI agent, automated decision system, scheduler, monitor."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Autonomous Agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#SoftwareAgent"
      },
      {
        "@id": "https://top.scientix.ai/v1#Agent"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#BitemporalShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The contract a versioned value satisfies: a valid-time start, an optional (open) valid-time end, and a stable identity via prov:specializationOf. Opt-in \u2014 NOT targeted at top:CommonEntity, so it never burdens mono-temporal entities."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Bitemporal Shape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:cb115f57c473f1e2dc1e96fe93cc4f113ca3e2bb6388f580b953f64ef619da364ed"
      },
      {
        "@id": "_:cb196f662f5b40e938ccebf980582b196d8b23fd48064bb6a55ab4d47d4f9f53874"
      },
      {
        "@id": "_:cb469155d2e487fe6a4b176e7f2e5f5298ded1ca8c41e11a15efac219f1b876aea"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#CommonEntity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The root of every TOP entity. Carries Universal DNA \u2014 top:identifier, top:observedAt, top:status \u2014 that every Category and every Leaf inherits. Not directly instantiated; serves as the type lattice that lets queries reach across every Category."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Common Entity"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Conclusion",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A reasoned determination \u2014 adjudication outcome, root-cause finding, regulatory decision, eligibility determination."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Conclusion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://purl.obolibrary.org/obo/bfo#GenericallyDependentContinuant"
      },
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Constraint",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Non-negotiable boundaries \u2014 physical, legal, regulatory, contractual, safety. Inclusion criteria, dose limits, regulatory deadlines, blinding rules, biosafety floors, SLAs."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Constraint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "https://top.scientix.ai/v1#CommonEntity"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Credential",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Proof of qualification or identity for an Agent \u2014 license, certification, training record, role assignment, e-credential."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Credential"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Document",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A formal artifact carrying recorded content \u2014 protocol, SOP, IB, ICF, CAPA report, batch record, regulatory submission."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Document"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Equipment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A physical device used in operations \u2014 analyzer, scale, freezer, infusion pump, imaging modality, sequencer, sensor."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Equipment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://purl.obolibrary.org/obo/bfo#MaterialEntity"
      },
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "https://top.scientix.ai/v1#Resource"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#Evidence",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Artifacts that provide verifiable proof of an event, state, or action. Lab reports, signed forms, audit logs, calibration certificates, batch records, MedWatch submissions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://purl.obolibrary.org/obo/bfo#GenericallyDependentContinuant"
