      {
        "@value": "Tightenable"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#observedAt",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "When this fact was observed to hold in the world \u2014 the valid-time observation instant; top:validFrom / top:validUntil carry the valid-time interval on versioned values. Complements top:recordedAt (transaction time: when the system first knew it). ADR-0021 as corrected by the 2026-09-01 erratum. Distinct from intrinsic activity times (Temporal.startTime / endTime, domain-level)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#CommonEntity"
