    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "OWL/SHACL view of the SKOS taxonomy at taxonomy/taxonomy.ttl. Defines the root top:CommonEntity, the eight L2 categories, the 28 L3 leaves, the Universal DNA properties, the category relational extensions, and the SHACL UniversalDNAShape that enforces the three required practitioner-grounded properties on every TOP entity."
      }
    ],
    "http://purl.org/dc/terms/license": [
