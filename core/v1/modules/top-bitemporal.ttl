@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix bfo:   <http://purl.obolibrary.org/obo/bfo#> .
@prefix top:   <https://top.scientix.ai/v1#> .

# Bitemporal model (per ADR-0021): Versioned class, valid-time properties, SHACL shapes.

top:VersionSeries a owl:Class ;
    rdfs:label "Version Series"@en ;
    rdfs:comment "The stable identity root for a chain of top:Versioned snapshots. An instance of top:VersionSeries has a single IRI that never changes; each point-in-time value-version links to it via prov:specializationOf. Consumers and external references always point at the VersionSeries; version navigation is a query, not an IRI change."@en .

top:Versioned a owl:Class ;
    rdfs:label "Versioned"@en ;
    rdfs:comment "Marker for an immutable, bitemporally-tracked value-version — an attribute-value-at-a-time (or whole-entity snapshot) carrying valid time and a stable identity via prov:specializationOf. Applied where Tier-1 entailment fires or where a workflow opts an attribute in. Not every TOP entity is Versioned; only those that need full bitemporal history."@en .

top:validFrom a owl:DatatypeProperty ;
    rdfs:label "valid from"@en ;
    top:flavor "Invariant" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Domain intentionally open: rdfs:domain is an inference axiom, not a constraint — a domain of top:Versioned would retype every dated entity as Versioned and drag it under the versioning contract (the RDFS target cascade). The requirement side lives in SHACL: top:BitemporalShape demands validFrom on Versioned."@en ;
    rdfs:comment "Start of the valid-time interval — when this version's state became true in the world. Distinct from top:observedAt (the valid-time observation instant; the transaction clock is top:recordedAt — ADR-0021 erratum, 2026-09-01). Invariant per ADR-0019, like top:startTime/top:endTime. No PROV-O peer: PROV models system time, not valid-time-of-a-fact (declared absence, per ADR-0021)."@en .

top:validUntil a owl:DatatypeProperty ;
    rdfs:label "valid until"@en ;
    top:flavor "Invariant" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "End of the valid-time interval; open (absent) for the currently-valid version. Invariant per ADR-0019."@en .

prov:specializationOf rdfs:range top:VersionSeries .

# ── Transaction time (append-only system knowledge) ─────────────────────────
# Promoted from the CR domain (2026-07, convener ruling resolving the stub's
# "documented divergence"): valid time says when a fact was true in the world;
# transaction time says when the SYSTEM knew it. Both are needed to answer
# "what did we know on day X" — the inspector's question.

top:recordedAt a owl:DatatypeProperty ;
    rdfs:label "recorded at"@en ;
    top:flavor "Invariant" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Transaction time (append-only): when the system first knew this fact. Never rewritten. Complements top:observedAt / top:validFrom (valid time). PROV peer: prov:generatedAtTime carries the same instant when a generation activity is modeled."@en .

top:supersededAt a owl:DatatypeProperty ;
    rdfs:label "superseded at"@en ;
    top:flavor "Invariant" ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Transaction time (append-only): when a later assertion superseded this one. A correction is a NEW assertion carrying its own recordedAt; this timestamp closes the old one and is never rewritten."@en .

top:ProvenancedEntity a owl:Class ;
    rdfs:label "Provenanced Entity"@en ;
    rdfs:comment "Marker for anything carrying the full bitemporal + PROV envelope: exactly one top:observedAt, exactly one top:recordedAt, at least one prov:wasAttributedTo (an identified agent). Domains enforce the envelope with their own SHACL (e.g. the CR domain's top:BitemporalProvShape); Core carries the vocabulary."@en .

top:BitemporalShape a sh:NodeShape ;
    rdfs:label "Bitemporal Shape"@en ;
    rdfs:comment "The contract a versioned value satisfies: a valid-time start, an optional (open) valid-time end, and a stable identity via prov:specializationOf. Opt-in — NOT targeted at top:CommonEntity, so it never burdens mono-temporal entities."@en ;
    sh:targetClass top:Versioned ;
    sh:property [
        sh:path top:validFrom ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A versioned value must state when its state became valid (top:validFrom, exactly one)." ;
    ] ;
    sh:property [
        sh:path top:validUntil ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:message "top:validUntil is open (absent) for the current version, or exactly one xsd:dateTime when closed." ;
    ] ;
    sh:property [
        sh:path prov:specializationOf ;
        sh:class top:VersionSeries ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A versioned value must point at its stable identity (prov:specializationOf → top:VersionSeries, exactly one)." ;
    ] .

top:HashedMustVersionShape a sh:NodeShape ;
    rdfs:label "Hashed values must be versioned"@en ;
    sh:targetSubjectsOf top:integrityHash ;
    sh:severity sh:Violation ;
    sh:node top:BitemporalShape ;
    sh:message "A value carrying top:integrityHash must be an immutable version (top:Versioned: top:validFrom + prov:specializationOf). You cannot hash a value and leave it mutable." .

top:SignedMustVersionShape a sh:NodeShape ;
    rdfs:label "Signed values must be versioned"@en ;
    sh:targetSubjectsOf top:signedBy ;
    sh:severity sh:Violation ;
    sh:node top:BitemporalShape ;
    sh:message "A value carrying top:signedBy must be an immutable version. You cannot sign a value and leave it mutable." .

top:AttestationMustVersionShape a sh:NodeShape ;
    rdfs:label "Attestations must be versioned"@en ;
    sh:targetClass top:Attestation ;
    sh:severity sh:Violation ;
    sh:node top:BitemporalShape ;
    sh:message "A top:Attestation is a committed, signed declaration and must be an immutable version." .

top:StatusChangeMustVersionShape a sh:NodeShape ;
    rdfs:label "Status changes must be versioned"@en ;
    sh:targetClass top:StatusChange ;
    sh:severity sh:Violation ;
    sh:node top:BitemporalShape ;
    sh:message "A top:StatusChange is the audit event of a transition and must be an immutable version." .

top:EvidenceShouldVersionShape a sh:NodeShape ;
    rdfs:label "Evidence should be versioned once committed"@en ;
    sh:targetClass top:Document, top:Log, top:Credential ;
    sh:property [
        sh:path top:validFrom ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "This evidentiary value is not yet a version. Drafts may stay mutable; once finalized (and certainly once hashed or signed) it must be versioned (top:Versioned with top:validFrom)." ;
    ] .
