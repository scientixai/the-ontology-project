# TOP Core — aggregator (owl:imports all per-category modules)
#
# This file is the single entry point for tools that need the complete
# TOP Core OWL/SHACL graph. It imports each per-category module so that
# loading this file is equivalent to loading all eleven modules.
#
# Per-category modules live in modules/. Each is independently parseable.
# Edit ontology content in the modules; edit this file only to add/remove modules.
#
# owl:imports use repo-relative file IRIs so a local pyshacl --imports run
# loads the modules. Published module IRIs remain inside each module file.

@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .

<https://top.scientix.ai/core/v1> a owl:Ontology ;
    dct:title "TOP Core — OWL classes and SHACL contract"@en ;
    dct:description "OWL/SHACL view of the SKOS taxonomy at taxonomy/taxonomy.ttl. Defines the root top:CommonEntity, the eight L2 categories, the 28 L3 leaves, the Universal DNA properties, the category relational extensions, and the SHACL UniversalDNAShape that enforces the three required practitioner-grounded properties on every TOP entity."@en ;
    dct:created "2026-05-10"^^xsd:date ;
    dct:license "Apache-2.0" ;
    rdfs:seeAlso <https://top.scientix.ai/v1#TaxonomyV1>,
                 <https://top.scientix.ai/core/v1/index.html>,
                 <https://top.scientix.ai/governance/decision-log.md> ;
    owl:imports <modules/top-root.ttl> ;
    owl:imports <modules/top-agent.ttl> ;
    owl:imports <modules/top-location.ttl> ;
    owl:imports <modules/top-resource.ttl> ;
    owl:imports <modules/top-scope.ttl> ;
    owl:imports <modules/top-temporal.ttl> ;
    owl:imports <modules/top-evidence.ttl> ;
    owl:imports <modules/top-outcome.ttl> ;
    owl:imports <modules/top-constraint.ttl> ;
    owl:imports <modules/top-bitemporal.ttl> ;
    owl:imports <modules/top-ai.ttl> .
