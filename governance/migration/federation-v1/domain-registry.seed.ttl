@prefix reg:  <https://w3id.org/top/registry/v1#> .
@prefix top:  <https://w3id.org/top/v1#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

# Seed for core/registry/domains.ttl — the Core-owned domain registry (ADR-0023's
# third thing; RFC 0002 §Proposal.3). Discoverability without coupling: name, owner,
# repo, namespace, pinned Core version, tier, contract-conformance status.
#
# Namespaces use the permanent w3id base (RFC 0002 §Proposal.0). w3id.org/top
# redirects to the project host (the-ontology-project.org); the redirect is
# retargetable without changing any IRI. The public site is assembled at deploy
# time from these entries.

<https://w3id.org/top/registry/v1> a owl:Ontology ;
    owl:versionInfo "1.0-seed" ;
    dct:title "TOP federation registry (seed)" ;
    dct:publisher <https://the-ontology-project.org> ;   # redirect host for w3id.org/top
    rdfs:comment "Initial entries for the RFC-0002 five-repo federation. Conformance status is aspirational until the executable-contract CI (ADR-0023) is adopted per repo." .

# --- vocabulary (minimal; graduates into core/registry/ on acceptance) --------
reg:Node          a owl:Class ; rdfs:label "Federation node" .
reg:tier          a owl:DatatypeProperty ; rdfs:label "tier" .            # hub | sub-hub | spoke | node
reg:owner         a owl:DatatypeProperty ; rdfs:label "owning group" .
reg:repo          a owl:AnnotationProperty ; rdfs:label "repository URL" .
reg:namespace     a owl:AnnotationProperty ; rdfs:label "namespace IRI" .
reg:pinsCore      a owl:DatatypeProperty ; rdfs:label "pinned Core version" .
reg:pinsBucket    a owl:DatatypeProperty ; rdfs:label "pinned bucket-base version" .
reg:conformance   a owl:DatatypeProperty ; rdfs:label "contract conformance" . # pending | conformant

# --- entries ------------------------------------------------------------------
reg:core a reg:Node ;
    rdfs:label "core" ;
    reg:tier "hub" ;
    reg:owner "Core Stewards" ;
    reg:repo <https://github.com/the-ontology-project/core> ;
    reg:namespace <https://w3id.org/top/v1#> ;
    reg:conformance "n/a" ;
    rdfs:comment "Upper ontology + executable extension contract + this registry." .

reg:hcls a reg:Node ;
    rdfs:label "hcls" ;
    reg:tier "sub-hub" ;
    reg:owner "HCLS umbrella WG (forming)" ;
    reg:repo <https://github.com/the-ontology-project/hcls> ;
    reg:namespace <https://w3id.org/top/hcls/v1#> ;
    reg:pinsCore "v1" ;
    reg:conformance "pending" ;
    rdfs:comment "Healthcare & life-sciences base layer. Extracted from cr-domain/ontology/hcls-core.ttl." .

reg:clinical-research a reg:Node ;
    rdfs:label "clinical-research" ;
    reg:tier "spoke" ;
    reg:owner "Clinical Research WG" ;
    reg:repo <https://github.com/the-ontology-project/clinical-research> ;
    reg:namespace <https://w3id.org/top/cr/v1#> ;
    reg:pinsCore "v1" ;
    reg:pinsBucket "hcls@v1" ;
    reg:conformance "pending" ;
    rdfs:comment "Launch demonstrator. The former cr-domain/, minus hcls-core and the top-core stub." .

reg:standards a reg:Node ;
    rdfs:label "standards" ;
    reg:tier "node" ;
    reg:owner "HCLS umbrella WG (forming)" ;
    reg:repo <https://github.com/the-ontology-project/standards> ;
    reg:namespace <https://w3id.org/top/standards/v1#> ;
    reg:pinsCore "v1" ;
    reg:pinsBucket "hcls@v1" ;
    reg:conformance "n/a" ;
    rdfs:comment "Shared HCLS alignments (FHIR w5-axis, AFO/BFO, NCIt mapsets). License-quarantined; owned mappings + pinned manifests only." .

# site is a deploy node, not an ontology consumer — intentionally not a registry entry.
