@prefix ex:   <https://top.scientix.ai/examples/> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# VIOLATION — measurement theater: a KRI with no critical-to-quality ancestry,
# no category, and no action threshold. A metric nobody can act on, protecting
# nothing anyone named.

ex:kri-bad a cr:KeyRiskIndicator ; rdfs:label "Dashboard widget #14" ;
    cr:measuredParameter "queries per site per month" ;
    cr:warningThreshold "50.0"^^xsd:decimal .
# Missing: cr:informsFactor (no CtQ link), cr:kriCategory, cr:actionThreshold.
