@prefix ex:   <https://top.scientix.ai/examples/ta-1/> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix hcls: <https://top.scientix.ai/hcls/v1#> .
@prefix top:  <https://top.scientix.ai/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ═══════════════════════════════════════════════════════════════════════════
# TA-1 T5 DNA ONLY — Violation fixture
#
# A CausalityAssessment that carries DNA (identifier + observedAt + status)
# and verdict, but has NO attribution (no prov:wasAttributedTo, no cr:assessedBy).
# Violates JudgmentAttributionShape (T5).
#
# Expected: FAIL (T5: JudgmentAttributionShape violation)
# ═══════════════════════════════════════════════════════════════════════════

ex:assessor a hcls:Person, prov:Agent ;
    rdfs:label "Dr. James Chen, Safety Physician" ;
    top:identifier "person:james-chen"^^xsd:anyURI ;
    top:status "active" ;
    top:observedAt "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    hcls:actsAs "Safety Physician" .

ex:participant a cr:StudySubject, prov:Agent ;
    rdfs:label "Participant P-042" ;
    top:identifier "urn:participant:P-042"^^xsd:anyURI ;
    top:status "enrolled" ;
    top:observedAt "2026-02-01T00:00:00Z"^^xsd:dateTime .

ex:ae-p042-001 a cr:SeriousAdverseEvent ;
    rdfs:label "SAE: myocardial infarction" ;
    top:identifier "urn:sae:p042-001"^^xsd:anyURI ;
    top:status "active" ;
    top:observedAt "2026-03-15T14:30:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-03-15T16:00:00Z"^^xsd:dateTime ;
    cr:forSubject ex:participant ;
    cr:meddraPreferredTerm <https://identifiers.org/meddra:10028596> ;
    cr:meddraLowestLevelTerm <https://identifiers.org/meddra:10019273> ;
    cr:meddraDictionaryVersion "27.0" ;
    prov:wasAttributedTo ex:assessor .

# T5 VIOLATION: CausalityAssessment with DNA but NO attribution
ex:causality a cr:CausalityAssessment ;
    rdfs:label "Causality: possible relationship" ;
    top:identifier "urn:causality:p042-001-noattrib"^^xsd:anyURI ;
    top:status "active" ;
    top:observedAt "2026-03-16T11:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-03-16T11:05:00Z"^^xsd:dateTime ;
    top:concludesAbout ex:ae-p042-001 ;
    cr:causalityVerdict "possible" .
    # NO prov:wasAttributedTo
    # NO cr:assessedBy
    # T5 violation: judgment without attribution

# ═══════════════════════════════════════════════════════════════════════════
# Expected violation: T5 JudgmentAttributionShape
# Message: "A promoted judgment must carry attribution: prov:wasAttributedTo OR 
#           the domain edge (cr:codedBy, cr:assessedBy, cr:reviewedBy)."
# ═══════════════════════════════════════════════════════════════════════════
