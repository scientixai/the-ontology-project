@prefix ex:   <https://top.scientix.ai/examples/> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix tmf:  <https://top.scientix.ai/tmf/v1#> .
@prefix hcls: <https://top.scientix.ai/hcls/v1#> .
@prefix top:  <https://top.scientix.ai/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# WORKED EXAMPLE — a site receives a study start-up package and activates.
# The package is a set of typed document artifacts; three work streams consume those
# documents and produce site-specific outputs (customized ICF, DoA log, 1572, signed CTA),
# each output tracing to the input it derived from. Regulatory + budget complete -> the
# activation is admissible (and still cites IRB approval, executed CTA, and SIV).

ex:sp-site a cr:StudySite ;
    rdfs:label "Site 701 — Denver" ;
    top:identifier "urn:sp-site"^^xsd:anyURI ;
    top:observedAt "2025-11-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:sp-mgr  a hcls:Person, prov:Agent ;
    rdfs:label "Marta Kowalski" ;
    top:identifier "person:marta-kowalski"^^xsd:anyURI ;
    hcls:actsAs "Start-up Manager" ;
    top:observedAt "2025-01-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .

# --- The start-up package (typed input documents) ---
ex:sp-pkg a cr:StudyStartupPackage ;
    rdfs:label "OPP-101 start-up package (Site 701)" ;
    cr:packageForSite ex:sp-site ;
    cr:includesArtifact ex:a-ib, ex:a-protocol, ex:a-icf-tmpl, ex:a-cta-doc, ex:a-monplan, ex:a-soa ;
    top:identifier "urn:sp-pkg"^^xsd:anyURI ;
    top:observedAt "2025-12-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .

ex:a-ib       a cr:StartupArtifact ;
    rdfs:label "Investigator Brochure" ;
    cr:ofArtifactType tmf:InvestigatorBrochure ;
    top:identifier "urn:a-ib"^^xsd:anyURI ;
    top:observedAt "2025-12-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:a-protocol a cr:StartupArtifact ;
    rdfs:label "Protocol v1.0" ;
    cr:ofArtifactType tmf:Protocol ;
    top:identifier "urn:a-protocol"^^xsd:anyURI ;
    top:observedAt "2025-12-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:a-icf-tmpl a cr:StartupArtifact ;
    rdfs:label "ICF template" ;
    cr:ofArtifactType tmf:InformedConsentForm ;
    top:identifier "urn:a-icf-tmpl"^^xsd:anyURI ;
    top:observedAt "2025-12-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:a-cta-doc  a cr:StartupArtifact ;
    rdfs:label "CTA (unsigned)" ;
    cr:ofArtifactType tmf:ClinicalTrialAgreementDoc ;
    top:identifier "urn:a-cta-doc"^^xsd:anyURI ;
    top:observedAt "2025-12-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:a-monplan  a cr:StartupArtifact ;
    rdfs:label "Monitoring Plan" ;
    cr:ofArtifactType tmf:MonitoringPlan ;
    top:identifier "urn:a-monplan"^^xsd:anyURI ;
    top:observedAt "2025-12-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:a-soa      a cr:StartupArtifact ;
    rdfs:label "Schedule of Activities" ;
    cr:ofArtifactType tmf:ScheduleOfActivities ;
    top:identifier "urn:a-soa"^^xsd:anyURI ;
    top:observedAt "2025-12-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .

# --- Outputs the work streams produce (each derived from an input) ---
ex:o-icf-custom a cr:StartupArtifact ;
    rdfs:label "Site-customized ICF" ;
    cr:ofArtifactType tmf:InformedConsentForm ;
    prov:wasDerivedFrom ex:a-icf-tmpl ;
    top:identifier "urn:o-icf-custom"^^xsd:anyURI ;
    top:observedAt "2026-01-10T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:o-doa     a cr:StartupArtifact ;
    rdfs:label "Delegation-of-Authority log" ;
    cr:ofArtifactType tmf:DelegationOfAuthorityLog ;
    prov:wasDerivedFrom ex:a-protocol ;
    top:identifier "urn:o-doa"^^xsd:anyURI ;
    top:observedAt "2026-01-10T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:o-1572    a cr:StartupArtifact ;
    rdfs:label "Form FDA 1572" ;
    cr:ofArtifactType tmf:Form1572 ;
    prov:wasDerivedFrom ex:a-protocol ;
    top:identifier "urn:o-1572"^^xsd:anyURI ;
    top:observedAt "2026-01-10T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:o-irb-ltr a cr:StartupArtifact ;
    rdfs:label "IRB approval letter" ;
    cr:ofArtifactType tmf:IRBApprovalLetter ;
    prov:wasDerivedFrom ex:o-icf-custom ;
    top:identifier "urn:o-irb-ltr"^^xsd:anyURI ;
    top:observedAt "2026-01-15T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:o-signed-cta a cr:StartupArtifact ;
    rdfs:label "Signed CTA" ;
    cr:ofArtifactType tmf:ClinicalTrialAgreementDoc ;
    prov:wasDerivedFrom ex:a-cta-doc ;
    top:identifier "urn:o-signed-cta"^^xsd:anyURI ;
    top:observedAt "2026-01-20T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:o-dmplan  a cr:StartupArtifact ;
    rdfs:label "Site data-management plan" ;
    cr:ofArtifactType tmf:DataManagementPlan ;
    prov:wasDerivedFrom ex:a-soa ;
    top:identifier "urn:o-dmplan"^^xsd:anyURI ;
    top:observedAt "2026-01-25T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .

# --- The three work streams ---
ex:ws-reg a cr:RegulatoryWorkStream ;
    rdfs:label "Regulatory" ;
    cr:streamForSite ex:sp-site ;
    cr:consumes ex:a-protocol, ex:a-ib, ex:a-icf-tmpl ;
    cr:produces ex:o-icf-custom, ex:o-doa, ex:o-1572, ex:o-irb-ltr ;
    cr:streamStatus "complete" ;
    top:identifier "urn:ws-reg"^^xsd:anyURI ;
    top:observedAt "2026-01-05T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:ws-bud a cr:BudgetContractingWorkStream ;
    rdfs:label "Budget & contracting" ;
    cr:streamForSite ex:sp-site ;
    cr:consumes ex:a-cta-doc, ex:a-protocol ;
    cr:produces ex:o-signed-cta ;
    cr:streamStatus "complete" ;
    top:identifier "urn:ws-bud"^^xsd:anyURI ;
    top:observedAt "2026-01-05T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:ws-clin a cr:ClinOpsWorkStream ;
    rdfs:label "Clinical operations" ;
    cr:streamForSite ex:sp-site ;
    cr:consumes ex:a-protocol, ex:a-soa, ex:a-monplan ;
    cr:produces ex:o-dmplan ;
    cr:streamStatus "active" ;
    top:identifier "urn:ws-clin"^^xsd:anyURI ;
    top:observedAt "2026-01-05T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .

# --- Activation prerequisites (bitemporal) + the work-stream gate ---
ex:sp-irb a cr:IRBApproval ; cr:forStudySite ex:sp-site ;
    top:observedAt "2026-01-15T00:00:00Z"^^xsd:dateTime ;
    top:validFrom "2026-01-15T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-01-15T12:00:00Z"^^xsd:dateTime ;
    prov:specializationOf ex:sp-irb-series ;
    prov:wasAttributedTo ex:sp-mgr .
ex:sp-irb-series a top:VersionSeries ;
    top:identifier "urn:sp-irb:series"^^xsd:anyURI ;
    top:observedAt "2026-01-15T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:sp-cta a cr:ClinicalTrialAgreement ; cr:forStudySite ex:sp-site ;
    top:observedAt "2026-01-20T00:00:00Z"^^xsd:dateTime ;
    top:validFrom "2026-01-20T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-01-20T12:00:00Z"^^xsd:dateTime ;
    prov:specializationOf ex:sp-cta-series ;
    prov:wasAttributedTo ex:sp-mgr .
ex:sp-cta-series a top:VersionSeries ;
    top:identifier "urn:sp-cta:series"^^xsd:anyURI ;
    top:observedAt "2026-01-20T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:sp-siv a cr:SiteInitiationVisit ; cr:forStudySite ex:sp-site ;
    top:observedAt "2026-02-01T00:00:00Z"^^xsd:dateTime ;
    top:validFrom "2026-02-01T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-01T16:00:00Z"^^xsd:dateTime ;
    prov:specializationOf ex:sp-siv-series ;
    prov:wasAttributedTo ex:sp-mgr .
ex:sp-siv-series a top:VersionSeries ;
    top:identifier "urn:sp-siv:series"^^xsd:anyURI ;
    top:observedAt "2026-02-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:sp-act a cr:SiteActivation ; rdfs:label "Site 701 activated" ;
    cr:activates ex:sp-site ; cr:irbApproval ex:sp-irb ; cr:cta ex:sp-cta ; cr:siv ex:sp-siv ;
    cr:hasWorkStream ex:ws-reg, ex:ws-bud, ex:ws-clin ;
    cr:activationPackage ex:sp-pkg ;
    top:observedAt "2026-02-05T00:00:00Z"^^xsd:dateTime ;
    top:validFrom "2026-02-05T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-05T09:00:00Z"^^xsd:dateTime ;
    prov:specializationOf ex:sp-act-series ;
    prov:wasAttributedTo ex:sp-mgr .
ex:sp-act-series a top:VersionSeries ;
    top:identifier "urn:sp-act:series"^^xsd:anyURI ;
    top:observedAt "2026-02-05T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .

# --- Universal DNA (TOP Core): identifier + status for the bitemporal entities ---
ex:sp-irb top:identifier "urn:sp-irb"^^xsd:anyURI ; top:status "active" .
ex:sp-cta top:identifier "urn:sp-cta"^^xsd:anyURI ; top:status "active" .
ex:sp-siv top:identifier "urn:sp-siv"^^xsd:anyURI ; top:status "active" .
ex:sp-act top:identifier "urn:sp-act"^^xsd:anyURI ; top:status "active" .
