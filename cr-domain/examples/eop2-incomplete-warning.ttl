@prefix ex:   <https://top.scientix.ai/examples/> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix top:  <https://top.scientix.ai/v1#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# RISK-PROPORTIONATE (Warning): an EOP2 meeting recorded with a risk register but no
# binding agreement yet — readiness warning, not a hard failure.
ex:eop2-bad a cr:RegulatoryInteraction ;
    cr:meetingType "EOP2" ;
    cr:meetingDate "2026-01-15"^^xsd:date ;
    cr:hasRiskRegister ex:rr-x ;
    top:identifier "ex:eop2-bad"^^xsd:anyURI ;
    top:observedAt "2026-01-15T10:00:00Z"^^xsd:dateTime ;
    top:validFrom "2026-01-15T10:00:00Z"^^xsd:dateTime ;
    top:status "ACTIVE" .

ex:rr-x a cr:RiskRegister ;
    top:identifier "ex:rr-x"^^xsd:anyURI ;
    top:observedAt "2026-01-15T09:00:00Z"^^xsd:dateTime ;
    top:validFrom "2026-01-15T09:00:00Z"^^xsd:dateTime ;
    top:status "ACTIVE" .
