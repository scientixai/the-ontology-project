@prefix ex:   <https://top.scientix.ai/examples/> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix hcls: <https://top.scientix.ai/hcls/v1#> .
@prefix top:  <https://top.scientix.ai/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ═══════════════════════════════════════════════════════════════════════════
# WORKED EXAMPLE — Closeout (A1): the database-lock pivot, done correctly.
#
# The story: last patient's last visit closes the study; the data is cleaned
# and SOFT-locked for review, then HARD-locked for analysis. A late safety
# follow-up value still arrives AFTER the hard lock — but it is legitimate,
# because it is captured under a recorded cr:DatabaseUnlock. Nothing changes
# silently: post-lock change is an audited event, not a rewrite.
#
# CONFORMANT: 0 violations, 0 warnings across every baseline + closeout shape.
# The study is referenced by IRI (defined in the set-up graph, not re-typed).
# ═══════════════════════════════════════════════════════════════════════════

# ── Parties ──────────────────────────────────────────────────────────────────
ex:sponsor a hcls:Organization ;
    top:identifier "urn:org:sponsor"^^xsd:anyURI ;
    top:observedAt "2025-01-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" ;
    rdfs:label "Sponsor data-management (lock authority)" .

# ── The last-patient-last-visit milestone — opens closeout ────────────────────
ex:lplv a cr:LastPatientLastVisit ;
    top:identifier "urn:lplv:closeout1"^^xsd:anyURI ; top:status "active" ;
    top:observedAt "2026-06-01T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-06-01T12:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:sponsor ;
    cr:lplvForStudy ex:study-closeout1 ;         # study referenced by IRI
    rdfs:label "LPLV — last active participant's final protocol visit" .

# ── Soft lock (reversible, for review) then hard lock (for analysis) ──────────
ex:softlock a cr:DatabaseLock ;
    top:identifier "urn:dblock:soft-1"^^xsd:anyURI ; top:status "active" ;
    top:observedAt "2026-06-20T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-06-20T09:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:sponsor ;
    cr:locksStudy ex:study-closeout1 ;
    cr:lockType "soft" ;
    rdfs:label "Soft lock — database frozen for final review" .

ex:hardlock a cr:DatabaseLock ;
    top:identifier "urn:dblock:hard-1"^^xsd:anyURI ; top:status "active" ;
    top:observedAt "2026-07-01T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-07-01T09:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:sponsor ;
    cr:locksStudy ex:study-closeout1 ;
    cr:lockType "hard" ;
    rdfs:label "Hard lock — database frozen for primary analysis" .

# ── A controlled reopening: the audit gate that legitimizes a late value ──────
ex:unlock a cr:DatabaseUnlock ;
    top:identifier "urn:dbunlock:1"^^xsd:anyURI ; top:status "active" ;
    top:observedAt "2026-07-10T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-07-10T09:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:sponsor ;
    cr:reopens ex:hardlock ;
    cr:unlockReason "Late-arriving long-term safety follow-up value; correction approved by DM lead per closeout SOP." ;
    rdfs:label "Controlled unlock — scoped to the safety follow-up correction" .

# ── The subject + the variable definition ─────────────────────────────────────
ex:subj a cr:StudySubject ;
    top:identifier "urn:subject:S-207"^^xsd:anyURI ;
    top:observedAt "2026-01-10T00:00:00Z"^^xsd:dateTime ;
    top:status "active" ;
    cr:subjectId "S-207" ;
    top:validFrom "2026-01-10T00:00:00Z"^^xsd:dateTime .

ex:de-ae a cr:DataElementDef ;
    rdfs:label "Late safety follow-up finding" ;
    cr:phiClassification "NotPHI" ;
    top:identifier "urn:de-ae"^^xsd:anyURI ;
    top:observedAt "2025-12-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .

# ── Long-term follow-up: the programme + a safety follow-up visit ─────────────
ex:ltfu a cr:LongTermFollowUp ;
    top:identifier "urn:ltfu:survival"^^xsd:anyURI ;
    top:observedAt "2025-12-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" ;
    rdfs:label "Long-term safety follow-up programme" .

ex:fuv a cr:FollowUpVisit ;
    top:identifier "urn:fuv"^^xsd:anyURI ;
    top:observedAt "2026-07-11T00:00:00Z"^^xsd:dateTime ;
    top:status "active" ;
    cr:followUpType "safety" ;
    cr:followsUp ex:ltfu ;
    rdfs:label "Follow-up visit (safety) — beyond the treatment period" .

# ── The post-lock value: recorded AFTER the hard lock, but UNDER the unlock ────
# PostLockDataShape passes precisely because cr:underUnlock is present.
ex:postlock-obs a cr:ClinicalObservation ; rdf:value "grade 1 rash (resolved)" ;
    top:identifier "urn:obs:S-207-ltfu-safety"^^xsd:anyURI ; top:status "active" ;
    cr:definedBy ex:de-ae ;
    cr:forSubject ex:subj ;
    cr:observationForSubject ex:subj ;
    cr:capturedDuring ex:fuv ;
    cr:underUnlock ex:unlock ;
    top:observedAt "2026-07-12T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-07-12T08:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:sponsor .
