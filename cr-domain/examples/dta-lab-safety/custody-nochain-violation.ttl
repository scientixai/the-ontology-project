@prefix ex:    <https://top.scientix.ai/examples/> .
@prefix cr:    <https://top.scientix.ai/cr/v1#> .
@prefix hcls:  <https://top.scientix.ai/hcls/v1#> .
@prefix top:   <https://top.scientix.ai/v1#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# ═══════════════════════════════════════════════════════════════════════════
# DELIBERATELY BROKEN — proves cr:TransferCustodyChainShape bites (handoff G1).
#
# The transferred result is otherwise perfectly formed (rides an hcls:Specimen,
# joins its StudySubject, references its assay, carries the transfer lifecycle
# timestamps). The ONE defect: its specimen has NO cr:CustodyEvent chain — the
# lifecycle timestamps float free of any authoritative chain of custody. That is
# exactly the "Sample Management provenance you can't file" gap: the convenience
# view exists but the managed custody record behind it does not.
# ═══════════════════════════════════════════════════════════════════════════

ex:vendor-cl a hcls:Organization ;
    top:identifier "urn:org:CentralLab" ; top:status "active" ;
    rdfs:label "Central Lab (data provider)" .

ex:subj-x a cr:StudySubject ;
    top:identifier "urn:subject:S-900" ; top:status "active" ;
    cr:subjectId "S-900" ;
    top:validFrom "2026-01-10T00:00:00Z"^^xsd:dateTime .

# A well-formed specimen (has an origin) but with NO cr:CustodyEvent chain.
ex:collect-x a cr:StudyEvent ;
    top:identifier "urn:collect:S-900" ; top:status "completed" ;
    top:observedAt "2026-02-15T08:00:00Z"^^xsd:dateTime .
ex:spec-x a hcls:Specimen ;
    top:identifier "urn:specimen:S-900-serum" ; top:status "active" ;
    prov:wasDerivedFrom ex:collect-x .

ex:svc-x a cr:AssayDefinition ;
    top:identifier "urn:service:sodium-assay-x" ; top:status "active" ;
    rdfs:label "Serum sodium assay" .

ex:result-x a cr:AssayResult ;
    top:identifier "urn:result:S-900-sodium" ; top:status "final" ;
    top:observedAt "2026-02-15T14:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-16T02:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:vendor-cl ;
    cr:onSpecimen ex:spec-x ;
    cr:forSubject ex:subj-x ;
    cr:resultOfAssay ex:svc-x ;
    rdf:value "140" ;
    # transfer lifecycle timestamps present, but the specimen has no custody chain
    cr:specimenCollectedAt "2026-02-15T08:00:00Z"^^xsd:dateTime ;
    cr:specimenReceivedAt  "2026-02-15T11:30:00Z"^^xsd:dateTime ;
    cr:analysisCompletedAt "2026-02-15T14:00:00Z"^^xsd:dateTime ;
    cr:reportGeneratedAt   "2026-02-16T02:00:00Z"^^xsd:dateTime .
    # ex:spec-x has no cr:CustodyEvent -> cr:TransferCustodyChainShape (Violation)
