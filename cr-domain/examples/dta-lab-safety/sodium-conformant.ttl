@prefix ex:    <https://top.scientix.ai/examples/> .
@prefix cr:    <https://top.scientix.ai/cr/v1#> .
@prefix hcls:  <https://top.scientix.ai/hcls/v1#> .
@prefix top:   <https://top.scientix.ai/v1#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix loinc: <https://loinc.org/> .
@prefix qudt:  <http://qudt.org/vocab/unit/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# ═══════════════════════════════════════════════════════════════════════════
# WORKED EXAMPLE (§9) — one central-lab safety analyte, Sodium, end to end.
# Mirrors the Interchange demo's Systolic-BP trace, in the vendor-transfer
# context. CONFORMANT: passes every baseline shape + every dta-*.ttl shape.
#
#   Vendor delivers: column SODIUM, unit mEq/L, visit label "V3 D29", value 140.
#   Resolve: SODIUM -> BiomedicalConcept(Sodium)=LOINC 2951-2 (high conf);
#            mEq/L -> UCUM/QUDT mmol/L; "V3 D29" -> canonical cr:Visit 3.
#   Graph: cr:AssayResult with DNA + full transfer bitemporal timeline + PROV.
#   Validate: shapes confirm concept bound, unit resolvable, encounter
#            resolved, signatory Credential-backed, amendment propagated.
#   Project: same entity -> SDTM LB row, Dataset-JSON, Define-XML, DTA doc.
# ═══════════════════════════════════════════════════════════════════════════

# ── Parties ──────────────────────────────────────────────────────────────────
ex:vendor-centrallab a hcls:Organization ;
    top:identifier "urn:org:AcmeCentralLab"^^xsd:anyURI ; top:status "active" ;
    rdfs:label "Acme Central Lab (data provider)" .

ex:signer-qa a hcls:Person ;
    top:identifier "urn:person:qa-lead"^^xsd:anyURI ; top:status "active" ;
    rdfs:label "Vendor QA lead (authorized signatory)" .

ex:cred-transfer a cr:Credential ;
    top:identifier "urn:cred:data-transfer-auth"^^xsd:anyURI ; top:status "active" ;
    rdfs:label "Data-transfer authorization (training + delegation on file)" .

# ── The signatory Attestation (a signature is a fact, not a boolean) ──────────
ex:attest-dta a top:Attestation ;
    top:identifier "urn:attest:dta-sodium-v1"^^xsd:anyURI ; top:status "active" ;
    top:observedAt "2026-02-01T09:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-01T09:00:05Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:signer-qa ;
    cr:attestedBy ex:signer-qa ;
    cr:backedByCredential ex:cred-transfer .

# ── Canonical concept + unit (concept-first; codes are Relationships to URIs) ─
ex:concept-sodium a cr:BiomedicalConcept ;
    top:identifier "urn:concept:sodium"^^xsd:anyURI ; top:status "active" ;
    rdfs:label "Sodium (serum/plasma)" ;
    cr:codedAs loinc:2951-2 .            # verified: Sodium [Moles/volume] in Serum or Plasma

# ── Provenance of the transformation (this is NOT the source) ─────────────────
# The original FHIR resource is retained and dereferenceable, so any resolved
# value can be traced back to it; the autonomous agent that resolved it is
# recorded with its model — the whole point is provenance.
ex:fhir-obs-sodium a prov:Entity ;
    cr:sourceSystem "Acme Central Lab / FHIR R4" ;
    cr:sourceUri "https://fhir.acme.example/Observation/obs-88213"^^xsd:anyURI .

ex:fhir-obs-visit a prov:Entity ;
    cr:sourceSystem "Acme Central Lab / FHIR R4" ;
    cr:sourceUri "https://fhir.acme.example/Encounter/enc-4471"^^xsd:anyURI .

ex:auto-resolver a top:AutonomousAgent ;
    rdfs:label "Auto-resolver 1.4.0" ;
    cr:agentModel "Auto-resolver 1.4.0" .

# ── Vendor alias corpus: resolved ONCE, not stored per-DTA ────────────────────
# Each auto-resolution carries prov:wasDerivedFrom (the retained FHIR source) and
# cr:resolvedBy (the autonomous agent) — enforced by cr:ResolutionProvenanceShape.
ex:alias-sodium-col a cr:VendorAlias ;
    top:identifier "urn:alias:col-SODIUM"^^xsd:anyURI ; top:status "active" ;
    cr:vendorTerm "SODIUM" ;
    cr:aliasResolvesTo ex:concept-sodium ;
    cr:resolutionConfidence "0.98"^^xsd:decimal ;
    cr:resolvedAgainstVersion "cr/v1" ;
    cr:resolvedFrom ex:vendor-centrallab ;
    prov:wasDerivedFrom ex:fhir-obs-sodium ;
    cr:resolvedBy ex:auto-resolver .

ex:alias-visit-v3d29 a cr:VendorAlias ;
    top:identifier "urn:alias:visit-V3D29"^^xsd:anyURI ; top:status "active" ;
    cr:vendorTerm "V3 D29" ;
    cr:aliasResolvesTo ex:visit-3 ;
    cr:resolutionConfidence "0.86"^^xsd:decimal ;
    cr:resolvedAgainstVersion "cr/v1" ;
    cr:resolvedFrom ex:vendor-centrallab ;
    prov:wasDerivedFrom ex:fhir-obs-visit ;
    cr:resolvedBy ex:auto-resolver .

# The template's LBCODE is "populated with the LUDWIG numeric code" (handoff G3).
# LUDWIG is not a public URI-resolvable terminology (LOINC/SNOMED/NCIt) — it is a
# proprietary numeric lab dictionary. So the numeric code does NOT violate the
# code-as-URI rule: it is captured as a VendorAlias RESOLUTION to the canonical
# concept (which itself is cr:codedAs the LOINC URI), never stored as an
# authoritative string. Resolve the proprietary code once; the corpus compounds.
# (LUDWIG:8480 below is an illustrative vendor code, not a verified LUDWIG value.)
ex:alias-ludwig-na a cr:VendorAlias ;
    top:identifier "urn:alias:ludwig-8480"^^xsd:anyURI ; top:status "active" ;
    cr:vendorTerm "LUDWIG:8480" ;                 # the vendor's numeric LBCODE
    cr:aliasResolvesTo ex:concept-sodium ;        # -> canonical concept -> LOINC 2951-2
    cr:resolutionConfidence "0.97"^^xsd:decimal ;
    cr:resolvedAgainstVersion "cr/v1" ;
    cr:resolvedFrom ex:vendor-centrallab ;
    prov:wasDerivedFrom ex:fhir-obs-sodium ;
    cr:resolvedBy ex:auto-resolver .

ex:visit-3 a cr:Visit ;
    top:identifier "urn:visit:V3"^^xsd:anyURI ; top:status "active" ;
    top:observedAt "2026-02-15T00:00:00Z"^^xsd:dateTime ;
    rdfs:label "Visit 3 (Week 4 / Day 29)" .

# ── Content spec (DTS): the Sodium data element, concept-bound ────────────────
ex:dts-labsafety a cr:TransferSpecification ;
    top:identifier "urn:dts:labsafety-v1"^^xsd:anyURI ; top:status "active" ;
    top:observedAt "2026-02-01T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-01T00:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:vendor-centrallab ;
    cr:specForStudy ex:study-safety1 ;   # USDM study referenced by IRI, defined elsewhere
    cr:hasDataElement ex:de-sodium , ex:de-vendor-passthrough .

# A BOUND element: concept + UCUM unit + origin (Origin/CT columns render from here).
ex:de-sodium a cr:DataElementSpecification ;
    top:identifier "urn:de:sodium"^^xsd:anyURI ;
    rdfs:label "Sodium (safety lab)" ;
    cr:boundConcept ex:concept-sodium ;
    cr:declaredUnitConcept qudt:MilliMOL-PER-L ;   # UCUM code mmol/L
    cr:requirementLevel "required" ;
    cr:significantDigits 3 ;
    cr:elementOrigin "collected" ;
    cr:valueRangeLow "120"^^xsd:decimal ;
    cr:valueRangeHigh "160"^^xsd:decimal .

# An EXPLICITLY-UNBOUND element: the template's vendor passthrough (C*) reality.
# No canonical concept yet — but that is an auditable choice with a reason, not a
# silent prose gap. Bind, don't describe; and when you can't bind, say why.
ex:de-vendor-passthrough a cr:DataElementSpecification ;
    top:identifier "urn:de:vendor-CTESTCD"^^xsd:anyURI ;
    rdfs:label "Vendor passthrough (CTESTCD/CTEST) — no canonical concept yet" ;
    cr:unboundRationale "Vendor-proprietary panel code with no LOINC/NCIt equivalent at transfer time; carried as passthrough pending concept curation (template AUX/C* escape hatch)." ;
    cr:requirementLevel "permissible" ;
    cr:elementOrigin "collected" .

# ── Operational envelope (TransferProfile) + blinding ─────────────────────────
ex:profile-labsafety a cr:TransferProfile ;
    top:identifier "urn:profile:labsafety-v1"^^xsd:anyURI ; top:status "active" ;
    cr:fileFormat "SAS-XPT" ;
    cr:transmissionMethod "SFTP" ;
    cr:transmissionType "incremental" ;
    cr:transferSchedule "weekly" ;
    cr:providerFolder "/outbound/labsafety" ;
    cr:receiverFolder "/inbound/vendor/acme" ;
    cr:transferEnvironment "production" ;
    cr:blindingConstraint ex:blinding-labsafety .

ex:blinding-labsafety a cr:BlindingConstraint ;
    top:identifier "urn:blinding:labsafety"^^xsd:anyURI ; top:status "active" ;
    cr:blindingScope "none" .            # safety labs are unblinded

# ── The governing agreement (a fact graph, not a Word artifact) ───────────────
ex:legal-dta-doc a top:Evidence ;
    top:identifier "urn:doc:dta-signed-pdf"^^xsd:anyURI ; top:status "active" ;
    rdfs:label "Executed DTA (DocuSign PDF) — referenced, not modeled" .

ex:dta-acme a cr:DataTransferAgreement ;
    top:identifier "urn:dta:acme-labsafety-v1"^^xsd:anyURI ; top:status "active" ;
    top:observedAt "2026-02-01T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-01T00:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:vendor-centrallab ;
    cr:packagesSpecification ex:dts-labsafety ;
    cr:referencesProfile ex:profile-labsafety ;
    cr:ratifiedBy ex:attest-dta ;
    cr:forDataScope ex:scope-labsafety ;
    cr:referencesLegalDocument ex:legal-dta-doc ;
    cr:documentHash "sha256:3f9a...c21e" ;
    cr:citesShape <https://top.scientix.ai/cr/v1/shapes/dta-content> .

ex:scope-labsafety a cr:TransferScope ;
    top:identifier "urn:scope:labsafety"^^xsd:anyURI ; top:status "active" ;
    cr:scopeVendor ex:vendor-centrallab ;
    cr:scopeSpecification ex:dts-labsafety .

# ── The transferred datum: a real result with the full transfer lifecycle ─────
ex:subj-001 a cr:StudySubject ;
    top:identifier "urn:subject:S-001"^^xsd:anyURI ; top:status "active" ;
    cr:subjectId "S-001" ;
    top:validFrom "2026-01-10T00:00:00Z"^^xsd:dateTime .

ex:collect-001 a cr:StudyEvent ;
    top:identifier "urn:collect:S-001-V3"^^xsd:anyURI ; top:status "completed" ;
    top:observedAt "2026-02-15T08:00:00Z"^^xsd:dateTime .

ex:spec-001 a hcls:Specimen ;
    top:identifier "urn:specimen:S-001-V3-serum"^^xsd:anyURI ; top:status "active" ;
    prov:wasDerivedFrom ex:collect-001 .

# ── Chain of custody (PROVENANCE, not a Biomedical Concept) — the authoritative
#    record the transfer-lifecycle timestamps are a convenience view over. Reuses
#    the LIMS cr:CustodyEvent state machine rather than reinventing it (handoff G1). ─
ex:ce-recv-001 a cr:CustodyEvent ;
    top:identifier "urn:custody:S-001-received"^^xsd:anyURI ; top:status "active" ;
    cr:specimen ex:spec-001 ; cr:fromState "SampleDue" ; cr:toState "Received" ;
    top:observedAt "2026-02-15T11:30:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-15T11:31:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:vendor-centrallab .
ex:ce-verif-001 a cr:CustodyEvent ;
    top:identifier "urn:custody:S-001-verified"^^xsd:anyURI ; top:status "active" ;
    cr:specimen ex:spec-001 ; cr:fromState "ToBeVerified" ; cr:toState "Verified" ;
    top:observedAt "2026-02-15T14:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-15T14:05:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:vendor-centrallab .
ex:ce-pub-001 a cr:CustodyEvent ;
    top:identifier "urn:custody:S-001-published"^^xsd:anyURI ; top:status "active" ;
    cr:specimen ex:spec-001 ; cr:fromState "Verified" ; cr:toState "Published" ;
    top:observedAt "2026-02-16T02:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-16T02:05:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:vendor-centrallab .

ex:svc-sodium a cr:AssayDefinition ;
    top:identifier "urn:service:sodium-assay"^^xsd:anyURI ; top:status "active" ;
    rdfs:label "Serum sodium assay" .

ex:result-sodium-001 a cr:AssayResult ;
    top:identifier "urn:result:S-001-V3-sodium"^^xsd:anyURI ; top:status "final" ;
    top:observedAt "2026-02-15T14:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-16T02:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:vendor-centrallab ;
    prov:wasGeneratedBy ex:svc-sodium ;
    cr:onSpecimen ex:spec-001 ;
    cr:forSubject ex:subj-001 ;
    cr:resultOfAssay ex:svc-sodium ;
    rdf:value "140" ;
    cr:resolvedFrom ex:alias-sodium-col , ex:alias-visit-v3d29 , ex:alias-ludwig-na ;
    cr:resolvedAgainstVersion "cr/v1" ;
    # transfer lifecycle — a convenience view over the cr:CustodyEvent chain above
    cr:specimenCollectedAt "2026-02-15T08:00:00Z"^^xsd:dateTime ;
    cr:specimenReceivedAt  "2026-02-15T11:30:00Z"^^xsd:dateTime ;
    cr:analysisCompletedAt "2026-02-15T14:00:00Z"^^xsd:dateTime ;
    cr:reportGeneratedAt   "2026-02-16T02:00:00Z"^^xsd:dateTime ;
    cr:clinicalReviewAt    "2026-02-16T09:00:00Z"^^xsd:dateTime .

ex:file-w07 a cr:TransferFile ;
    top:identifier "urn:file:acme-labsafety-2026W07"^^xsd:anyURI ; top:status "delivered" ;
    top:observedAt "2026-02-16T02:30:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-16T02:30:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:vendor-centrallab ;
    cr:deliveredUnder ex:dts-labsafety .

# ── Amendment as event: propagation is explicit ──────────────────────────────
ex:amend-1 a cr:TransferAmendment ;
    top:identifier "urn:amend:labsafety-add-potassium"^^xsd:anyURI ; top:status "active" ;
    top:observedAt "2026-03-01T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-03-01T00:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:vendor-centrallab ;
    cr:effectiveFrom "2026-03-15T00:00:00Z"^^xsd:dateTime ;
    cr:affectsSpecification ex:dts-labsafety .
