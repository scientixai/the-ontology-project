@prefix ex:   <https://top.scientix.ai/examples/> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix hcls: <https://top.scientix.ai/hcls/v1#> .
@prefix top:  <https://top.scientix.ai/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ═══════════════════════════════════════════════════════════════════════════
# NEGATIVE EXAMPLE — the funnel-integrity breach.
#
# A candidate whose screening came out "screen-failure" (citing the failed
# criterion) is nonetheless converted to a Participant by an Enrollment.
# cr:RecruitConversionShape fires: conversion without an 'eligible' screening.
# EXPECT: violation.
# ═══════════════════════════════════════════════════════════════════════════

ex:rfv-study a cr:Study ; rdfs:label "OPP-101" ;
    cr:sponsoredBy ex:rfv-sponsor ; cr:conductedAt ex:rfv-site ;
    cr:hasProtocolVersion ex:rfv-proto .
ex:rfv-sponsor a cr:Sponsor ; rdfs:label "Oppentix Bio" .
ex:rfv-site a cr:StudySite ; rdfs:label "Denver Cancer Center" .
ex:rfv-proto a cr:ProtocolVersion ; rdfs:label "OPP-101 protocol v1.0" ;
    top:identifier "urn:proto:OPP-101-v1"^^xsd:anyURI ; top:status "active" ;
    top:observedAt "2026-01-05T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-01-05T00:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:rfv-sponsor ;
    cr:hasEligibilityCriterion ex:rfv-elig .
ex:rfv-elig a cr:EligibilityCriterion ; rdfs:label "ECOG performance status 0-1" ;
    cr:criterionType "inclusion" ; cr:criterionText "ECOG performance status 0-1" .
ex:rfv-arm a cr:Arm ; rdfs:label "Arm A" .
ex:rfv-crc a hcls:Practitioner ; rdfs:label "Jo Santos" ; hcls:actsAs "Site Coordinator" .
ex:rfv-criterion a cr:EligibilityCriterion ; rdfs:label "ECOG performance status 0–1" .

ex:rfv-person a hcls:Person ; rdfs:label "Candidate (PII)" .

ex:rfv-recruit a cr:Recruit ;
    rdfs:label "Candidate R-031" ;
    cr:recruitmentSource "physician referral" ;
    cr:candidatePerson ex:rfv-person ;
    cr:convertedBy ex:rfv-enroll .          # ← converted anyway

ex:rfv-screening a cr:ScreeningRecord ;
    rdfs:label "Screening of R-031 — screen-failure (ECOG 3)" ;
    top:identifier "urn:screening:R-031"^^xsd:anyURI ; top:status "active" ;
    cr:screensRecruit ex:rfv-recruit ;
    cr:screeningOutcome "screen-failure" ;
    cr:failedCriterion ex:rfv-criterion ;
    top:observedAt "2026-02-04T14:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-04T14:10:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:rfv-crc .

ex:rfv-subject a cr:StudySubject ;
    rdfs:label "S-031 (should never have existed)" ;
    cr:subjectId "S-031" ;
    top:validFrom "2026-02-05T10:00:00Z"^^xsd:dateTime .

ex:rfv-enroll a cr:Enrollment ;
    rdfs:label "Enrollment of screen-failed candidate" ;
    top:identifier "urn:enroll:S-031"^^xsd:anyURI ; top:status "active" ;
    cr:enrolledPerson ex:rfv-person ;
    cr:asSubject ex:rfv-subject ;
    cr:intoStudy ex:rfv-study ;
    cr:enrollmentDate "2026-02-05"^^xsd:date ;
    cr:enrolledInArm ex:rfv-arm ;
    top:validFrom "2026-02-05T10:00:00Z"^^xsd:dateTime ;
    top:observedAt "2026-02-05T10:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-02-05T10:05:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:rfv-crc .

# Provenance identity — attribution targets are identified agents, not bare roles.
ex:rfv-crc top:identifier "person:jo-santos"^^xsd:anyURI .
ex:rfv-sponsor top:identifier "org:oppentix"^^xsd:anyURI .
