@prefix ex:   <https://top.scientix.ai/examples/> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix hcls: <https://top.scientix.ai/hcls/v1#> .
@prefix top:  <https://top.scientix.ai/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# RISK-PROPORTIONATE (Warning): 100% SDV applied to a LOW-risk factor (wasteful).
ex:ctq-cm a cr:CriticalToQualityFactor ;
    rdfs:label "Concomitant medications" ;
    top:identifier "urn:ctq-cm"^^xsd:anyURI ;
    top:observedAt "2025-12-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:ra-cm a cr:RiskAssessment ; cr:assessesFactor ex:ctq-cm ; cr:riskLevel "low" ;
    top:observedAt "2026-03-01T00:00:00Z"^^xsd:dateTime ;
    top:validFrom "2026-03-01T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-03-01T00:00:00Z"^^xsd:dateTime ;
    prov:specializationOf ex:ra-cm-series ;
    prov:wasAttributedTo ex:rbqm-mgr3 .
ex:ra-cm-series a top:VersionSeries ;
    top:identifier "urn:ra-cm:series"^^xsd:anyURI ;
    top:observedAt "2026-03-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .
ex:rbqm-mgr3 a hcls:Person, prov:Agent ;
    rdfs:label "Sofia Marino" ;
    top:identifier "person:sofia-marino"^^xsd:anyURI ;
    top:observedAt "2025-01-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" ;
    hcls:actsAs "Central Monitor" .
ex:mp-cm a cr:MitigationPlan ;
    rdfs:label "100% SDV (over-monitoring)" ;
    cr:mitigates ex:ra-cm ;
    cr:monitoringStrategy "full-SDV" ;
    cr:sdvIntensity "1.0"^^xsd:decimal ;
    top:identifier "urn:mp-cm"^^xsd:anyURI ;
    top:observedAt "2026-03-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .

# --- Universal DNA (TOP Core): identifier + status (observedAt already present above) ---
<https://top.scientix.ai/examples/ra-cm> top:identifier "urn:ra-cm"^^xsd:anyURI ; top:status "active" .
