@prefix ex:   <https://top.scientix.ai/examples/> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix hcls: <https://top.scientix.ai/hcls/v1#> .
@prefix top:  <https://top.scientix.ai/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ═══════════════════════════════════════════════════════════════════════════
# WORKED EXAMPLE — Submission (B1): the terminal manifest, done correctly.
#
# The eCTD submission is a MANIFEST, not a new source of truth: it references
# the HARD-locked database (A1), the Clinical Study Report (A3), the ADaM
# analysis datasets (A2), and the Define-XML. Every arrow points back at
# already-produced, locked content — nothing is re-authored here.
#
# CONFORMANT: 0 violations, 0 warnings across every baseline + B1 shape.
# Study referenced by IRI (defined in the set-up graph, not re-typed).
# ═══════════════════════════════════════════════════════════════════════════

ex:sponsor-b1 a hcls:Organization ;
    top:identifier "urn:org:sponsor-b1" ; top:status "active" ;
    rdfs:label "Sponsor regulatory affairs" .
ex:biostat-b1 a hcls:Practitioner ; rdfs:label "Femi Balogun" ; hcls:actsAs "Lead Biostatistician" .

# ── A1: the hard database lock the submission rests on ────────────────────────
ex:hardlock-b1 a cr:DatabaseLock ;
    top:identifier "urn:dblock:hard-b1" ; top:status "active" ;
    top:observedAt "2026-07-01T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-07-01T09:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:sponsor-b1 ;
    cr:locksStudy ex:study-opp201 ;
    cr:lockType "hard" ;
    rdfs:label "Hard lock — database frozen for the submission analysis" .

# ── A2: an ADaM dataset (reproducible to source) ──────────────────────────────
ex:native-b1 a prov:Entity ;
    cr:sourceSystem "EDC / native clinical facts" ;
    rdfs:label "Native clinical source facts" .
ex:adsl-b1 a cr:AnalysisDataset ; rdfs:label "ADSL (subject-level analysis dataset)" ;
    top:identifier "urn:adam:ADSL-b1" ; top:status "active" ;
    prov:wasDerivedFrom ex:native-b1 ;
    top:observedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:biostat-b1 .

# ── A3: the Clinical Study Report (synopsis section — narrative, exempt) ───────
ex:csr-b1 a cr:ClinicalStudyReport ; rdfs:label "OPP-201 Clinical Study Report" ;
    top:identifier "urn:csr:OPP-201-b1" ; top:status "active" ;
    cr:csrForStudy ex:study-opp201 ;
    cr:hasSection ex:csr-b1-syn ;
    top:observedAt "2026-09-01T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-09-01T00:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:sponsor-b1 .
ex:csr-b1-syn a cr:CSRSection ; rdfs:label "Synopsis" ;
    cr:sectionNumber "2" ; cr:sectionTitle "Synopsis" ; cr:sectionKind "synopsis" .

# ── Define-XML: the map a reviewer reads the datasets against ──────────────────
ex:define-b1 a cr:DataDefinition ;
    top:identifier "urn:define:OPP-201" ; top:status "active" ;
    rdfs:label "Define-XML v2.1 (ADaM data definition)" .

# ── B1: the terminal eCTD manifest — every arrow points at locked content ─────
ex:ectd-b1 a cr:eCTDSubmission ; rdfs:label "OPP-201 NDA (eCTD Module 5)" ;
    top:identifier "urn:ectd:OPP-201-NDA" ; top:status "active" ;
    cr:submissionType "NDA" ;
    cr:submissionForStudy ex:study-opp201 ;      # study referenced by IRI
    cr:builtOnLock ex:hardlock-b1 ;              # rests on the HARD lock
    cr:includesReport ex:csr-b1 ;                # Module 5.3.5
    cr:includesDataset ex:adsl-b1 ;              # Module 5.3.x
    cr:includesDefine ex:define-b1 ;
    top:observedAt "2026-10-01T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-10-01T00:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:sponsor-b1 .

# Provenance identity — attribution targets are identified agents, not bare roles.
ex:biostat-b1 top:identifier "person:femi-balogun" .
