@prefix ex:   <https://top.scientix.ai/examples/> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix top:  <https://top.scientix.ai/v1#> .
@prefix hcls: <https://top.scientix.ai/hcls/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# CONFORMANT: an act attached to a pseudonymous StudySubject — the normal, contained case.
ex:pii-ok-ae a cr:AdverseEvent ;
    cr:forSubject ex:pii-subj ;
    top:observedAt  "2026-06-01T00:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-06-01T06:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo ex:pii-inv .
ex:pii-subj a cr:StudySubject ;
    cr:subjectId "PII-001" ;
    top:identifier "urn:pii-subj"^^xsd:anyURI ;
    top:observedAt "2025-06-01T00:00:00Z"^^xsd:dateTime ;
    top:status "enrolled" ;
    top:validFrom "2025-06-01T00:00:00Z"^^xsd:dateTime .
ex:pii-inv a hcls:Practitioner ;
    top:observedAt "2025-01-01T00:00:00Z"^^xsd:dateTime ;
    top:status "active" .

# --- Universal DNA (TOP Core): identifier + status (observedAt already present above) ---
<https://top.scientix.ai/examples/pii-ok-ae> top:identifier "urn:pii-ok-ae"^^xsd:anyURI ; top:status "active" .

# Provenance identity — attribution targets are identified agents, not bare roles.
ex:pii-inv rdfs:label "Dr. Ana Rivera" ; top:identifier "person:ana-rivera"^^xsd:anyURI ; hcls:actsAs "Principal Investigator" .
