@prefix ex:   <https://top.scientix.ai/examples/ta-2/> .
@prefix ex1:  <https://top.scientix.ai/examples/ta-1/> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix hcls: <https://top.scientix.ai/hcls/v1#> .
@prefix top:  <https://top.scientix.ai/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/vocab/unit/> .
@prefix loinc: <https://loinc.org/> .

# ═══════════════════════════════════════════════════════════════════════════
# TA-2 T-ONSPECIMEN — MISSING cr:onSpecimen (Violation)
#
# The AssayResult OMITS cr:onSpecimen (required by cr:AssayResultShape).
# It has cr:forSubject and cr:resultOfAssay, so the named join is the bite.
#
# VIOLATION: cr:AssayResultShape
# Assay result must reference the sample analyzed (cr:onSpecimen).
#
# Expected: VIOLATION (AssayResultShape)
# ═══════════════════════════════════════════════════════════════════════════

# ── Reused TA-1 entities ───────────────────────────────────────────────────

ex1:participant a cr:StudySubject ;
    rdfs:label "Participant P-042" ;
    top:identifier "urn:participant:P-042"^^xsd:anyURI ;
    top:status "enrolled" ;
    top:observedAt "2026-02-01T00:00:00Z"^^xsd:dateTime ;
    cr:subjectId "P-042" .

# ── TA-2 specific entities ─────────────────────────────────────────────────

ex:lab-tech a hcls:Person, prov:Agent ;
    rdfs:label "Lab Technician Maria Santos" ;
    top:identifier "urn:person:maria-santos"^^xsd:anyURI ;
    top:status "active" ;
    top:observedAt "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    hcls:actsAs "Lab Technician" .

ex:concept-sodium a cr:BiomedicalConcept ;
    rdfs:label "Serum Sodium" ;
    top:identifier "urn:concept:sodium"^^xsd:anyURI ;
    top:status "active" ;
    top:observedAt "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    cr:codedAs loinc:2951-2 .

ex:collection-p042-na a cr:StudyEvent ;
    rdfs:label "Blood draw for P-042 on 2026-03-15" ;
    top:identifier "urn:collection:p042-na-001"^^xsd:anyURI ;
    top:status "completed" ;
    top:observedAt "2026-03-15T09:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-03-15T09:05:00Z"^^xsd:dateTime .

ex:specimen-p042-na-parent a hcls:Specimen ;
    rdfs:label "Parent serum specimen P-042-NA" ;
    top:identifier "urn:specimen:p042-na-parent"^^xsd:anyURI ;
    top:status "active" ;
    top:observedAt "2026-03-15T09:00:00Z"^^xsd:dateTime ;
    cr:collectedAt ex:collection-p042-na .

ex:specimen-p042-na-aliquot a hcls:Specimen ;
    rdfs:label "Aliquot serum specimen P-042-NA-A1" ;
    top:identifier "urn:specimen:p042-na-aliquot"^^xsd:anyURI ;
    top:status "active" ;
    top:observedAt "2026-03-15T10:00:00Z"^^xsd:dateTime ;
    cr:aliquotOf ex:specimen-p042-na-parent ;
    prov:wasDerivedFrom ex:specimen-p042-na-parent .

ex:specimen-p042-na-parent cr:hasAliquot ex:specimen-p042-na-aliquot .

ex:custody-published a cr:CustodyEvent ;
    rdfs:label "Custody: Published" ;
    top:identifier "urn:custody:p042-na-published"^^xsd:anyURI ;
    top:status "active" ;
    top:observedAt "2026-03-15T16:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-03-15T16:05:00Z"^^xsd:dateTime ;
    cr:specimen ex:specimen-p042-na-aliquot ;
    cr:toState "Published" ;
    prov:wasAttributedTo ex:lab-tech .

ex:assay-sodium a cr:AssayDefinition ;
    rdfs:label "Serum Sodium Assay" ;
    top:identifier "urn:assay:sodium"^^xsd:anyURI ;
    top:status "active" ;
    top:observedAt "2026-01-01T00:00:00Z"^^xsd:dateTime .

# ── AssayResult (MISSING cr:onSpecimen, VIOLATION) ─────────────────────────

ex:result-p042-na-001 a cr:AssayResult ;
    rdfs:label "Serum sodium result: 128 mmol/L (low)" ;
    top:identifier "urn:result:p042-na-001"^^xsd:anyURI ;
    top:status "final" ;
    top:observedAt "2026-03-15T14:00:00Z"^^xsd:dateTime ;
    top:recordedAt "2026-03-15T16:00:00Z"^^xsd:dateTime ;
    # VIOLATION: cr:onSpecimen is MISSING
    # cr:onSpecimen ex:specimen-p042-na-aliquot ;
    cr:forSubject ex1:participant ;
    cr:resultOfAssay ex:assay-sodium ;
    hcls:value "128"^^xsd:decimal ;
    hcls:hasUnit qudt:MilliMOL-PER-L ;
    prov:wasAttributedTo ex:lab-tech .

# ═══════════════════════════════════════════════════════════════════════════
# VIOLATION SUMMARY:
# - AssayResult missing cr:onSpecimen ✗
# - cr:AssayResultShape violated ✗
# ═══════════════════════════════════════════════════════════════════════════
