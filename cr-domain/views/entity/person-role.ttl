@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:PersonRoleEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:PersonRole ;
    rdfs:label "Person Role" ;
    cr:catalogNumber 13 ;
    sh:property [ sh:path cr:roleId ; sh:name "roleId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, unique: Identifier." ] ;
    sh:property [ sh:path cr:roleName ; sh:name "roleName" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Display name (e.g., Principal Investigator, Coordinator, Pharmacist)." ] ;
    sh:property [ sh:path cr:roleDescription ; sh:name "roleDescription" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Description." ] ;
    sh:property [ sh:path cr:roleCategory ; sh:name "roleCategory" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: CLINICAL, OPERATIONS, REGULATORY, QUALITY, FINANCE, DATA, EXECUTIVE." ] ;
    sh:property [ sh:path cr:permissions ; sh:name "permissions" ; rdfs:comment "array<permissionId>: Permission ids granted to the role." ] ;
    sh:property [ sh:path cr:status ; sh:name "status" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: ACTIVE, INACTIVE." ] ;
    sh:property [ sh:path cr:createdBy ; sh:name "createdBy" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "string: Creator." ] ;
    sh:property [ sh:path cr:creationDate ; sh:name "creationDate" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Created." ] ;
    sh:property [ sh:path cr:modifiedBy ; sh:name "modifiedBy" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "string: Modifier." ] ;
    sh:property [ sh:path cr:modificationDate ; sh:name "modificationDate" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modified." ] ;
    sh:property [ sh:path cr:heldBy ; sh:name "heldBy -> Person" ; sh:node cr:PersonEntityView ; rdfs:comment "[0..N] People holding this role." ] ;
    sh:property [ sh:path cr:groupedBy ; sh:name "groupedBy -> Tag" ; sh:node cr:TagEntityView ; rdfs:comment "[0..N] Tags." ] ;
    sh:property [ sh:path cr:mapsToUserRole ; sh:name "mapsToUserRole -> User Role" ; sh:node cr:UserRoleEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Equivalent system permission set." ] .
