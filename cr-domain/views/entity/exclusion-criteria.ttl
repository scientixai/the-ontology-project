@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:ExclusionCriteriaEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:ExclusionCriteria ;
    rdfs:label "Exclusion Criteria" ;
    cr:catalogNumber 53 ;
    sh:property [ sh:path cr:exclusionCriteriaId ; sh:name "exclusionCriteriaId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
    sh:property [ sh:path cr:protocolId ; sh:name "protocolId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI: Parent protocol." ] ;
    sh:property [ sh:path cr:ordinal ; sh:name "ordinal" ; sh:datatype xsd:integer ; sh:maxCount 1 ; rdfs:comment "integer: Display order." ] ;
    sh:property [ sh:path cr:criterionText ; sh:name "criterionText" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Criterion text." ] ;
    sh:property [ sh:path cr:criterionCode ; sh:name "criterionCode" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: Coded condition." ] ;
    sh:property [ sh:path cr:rationale ; sh:name "rationale" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Rationale." ] ;
    sh:property [ sh:path cr:effectiveStart ; sh:name "effectiveStart" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date: Effective start." ] ;
    sh:property [ sh:path cr:effectiveEnd ; sh:name "effectiveEnd" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date, optional: Effective end." ] ;
    sh:property [ sh:path cr:version ; sh:name "version" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, semver: Criterion version." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:definedBy ; sh:name "definedBy -> Protocol" ; sh:node cr:ProtocolEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Parent protocol." ] ;
    sh:property [ sh:path cr:evaluatedAgainst ; sh:name "evaluatedAgainst -> Participant" ; sh:node cr:ParticipantEntityView ; rdfs:comment "[0..N] Subjects evaluated." ] ;
    sh:property [ sh:path cr:triggers ; sh:name "triggers -> Screen Fail" ; sh:node cr:ScreenFailEntityView ; rdfs:comment "[0..N] Triggers screen fail." ] ;
    sh:property [ sh:path cr:hasAmendments ; sh:name "hasAmendments -> Amendment" ; sh:node cr:AmendmentEntityView ; rdfs:comment "[0..N] Amendments." ] ;
    sh:property [ sh:path cr:hasAuditTrail ; sh:name "hasAuditTrail -> Audit Trail Entry" ; sh:node cr:AuditTrailEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Trail." ] .
