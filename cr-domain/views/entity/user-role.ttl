    sh:property [ sh:path cr:systemId ; sh:name "systemId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI: System." ] ;
    sh:property [ sh:path cr:scope ; sh:name "scope" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: global, study, site." ] ;
