    sh:property [ sh:path cr:hasBudgetForecast ; sh:name "hasBudgetForecast -> Budget Forecast" ; sh:node cr:BudgetForecastEntityView ; rdfs:comment "[0..N] Forecasts; flagged as missing object below." ] ;
