    sh:property [ sh:path cr:hasCoverageAnalysis ; sh:name "hasCoverageAnalysis -> Coverage Analysis" ; sh:node cr:CoverageAnalysisEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Coverage analysis; flagged as missing object below." ] ;
