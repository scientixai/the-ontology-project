@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:OtherClinicalEventEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:OtherClinicalEvent ;
    rdfs:label "Other Clinical Event" ;
    cr:catalogNumber 45 ;
    sh:property [ sh:path cr:otherClinicalEventId ; sh:name "otherClinicalEventId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
    sh:property [ sh:path cr:subjectId ; sh:name "subjectId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI: Subject." ] ;
    sh:property [ sh:path cr:eventCategory ; sh:name "eventCategory" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: planned_procedure, hospitalization, pregnancy_exposure, protocol_deviation_linked, other." ] ;
    sh:property [ sh:path cr:eventTerm ; sh:name "eventTerm" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Preferred term." ] ;
    sh:property [ sh:path cr:meddraCode ; sh:name "meddraCode" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: MedDRA code." ] ;
    sh:property [ sh:path cr:eventStart ; sh:name "eventStart" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; rdfs:comment "datetime: Start." ] ;
    sh:property [ sh:path cr:eventEnd ; sh:name "eventEnd" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; rdfs:comment "datetime, optional: End." ] ;
    sh:property [ sh:path cr:outcome ; sh:name "outcome" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Outcome." ] ;
    sh:property [ sh:path cr:reportableToSponsor ; sh:name "reportableToSponsor" ; sh:datatype xsd:boolean ; sh:maxCount 1 ; rdfs:comment "boolean: Reportable." ] ;
    sh:property [ sh:path cr:eventStatus ; sh:name "eventStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: ongoing, resolved, resolved_with_sequelae, fatal." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:reportedBy ; sh:name "reportedBy" ; cr:isMetadata true ; rdfs:comment "PersonRef: Reporter." ] ;
    sh:property [ sh:path cr:forSubject ; sh:name "forSubject -> Participant" ; sh:node cr:ParticipantEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Subject." ] ;
    sh:property [ sh:path cr:capturedOnCRF ; sh:name "capturedOnCRF -> CRF" ; sh:node cr:CRFEntityView ; rdfs:comment "[0..N] CRF capture." ] ;
    sh:property [ sh:path cr:reviewedBy ; sh:name "reviewedBy -> Person" ; sh:node cr:PersonEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Reviewers." ] ;
    sh:property [ sh:path cr:mayRelateTo ; sh:name "mayRelateTo -> Adverse Event" ; sh:node cr:AdverseEventEntityView ; rdfs:comment "[0..N] Adjacent AEs." ] ;
    sh:property [ sh:path cr:mayRelateTo ; sh:name "mayRelateTo -> Concomitant Medication" ; sh:node cr:ConcomitantMedicationEntityView ; rdfs:comment "[0..N] ConMeds; flagged as missing object below." ] ;
    sh:property [ sh:path cr:mayRelateTo ; sh:name "mayRelateTo -> Medical History" ; sh:node cr:MedicalHistoryEntityView ; rdfs:comment "[0..N] Medical history; flagged as missing object below." ] ;
    sh:property [ sh:path cr:hasAuditTrail ; sh:name "hasAuditTrail -> Audit Trail Entry" ; sh:node cr:AuditTrailEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Trail." ] .
