@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:LogEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:Log ;
    rdfs:label "Log" ;
    cr:catalogNumber 37 ;
    sh:property [ sh:path cr:logId ; sh:name "logId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
    sh:property [ sh:path cr:logName ; sh:name "logName" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Display name." ] ;
    sh:property [ sh:path cr:logType ; sh:name "logType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: delegation, training, screening, enrollment, temperature, drug_accountability, deviation, monitoring_visit, visitor, sample, other." ] ;
    sh:property [ sh:path cr:siteId ; sh:name "siteId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI: Site." ] ;
    sh:property [ sh:path cr:studyId ; sh:name "studyId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI, optional: Study (if scoped)." ] ;
    sh:property [ sh:path cr:logStatus ; sh:name "logStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: active, archived." ] ;
    sh:property [ sh:path cr:lastEntryAt ; sh:name "lastEntryAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; rdfs:comment "datetime, optional: Last entry." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:scopedToSite ; sh:name "scopedToSite -> Site" ; sh:node cr:SiteEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Site." ] ;
    sh:property [ sh:path cr:scopedToStudy ; sh:name "scopedToStudy -> Study" ; sh:node cr:StudyEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Study." ] ;
    sh:property [ sh:path cr:hasEntries ; sh:name "hasEntries -> Log Entry" ; sh:node cr:LogEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Entries; flagged as missing object below." ] ;
    sh:property [ sh:path cr:observedBy ; sh:name "observedBy -> Monitoring Visit" ; sh:node cr:MonitoringVisitEntityView ; rdfs:comment "[0..N] Reviewed by monitoring visit." ] ;
    sh:property [ sh:path cr:hasAuditTrail ; sh:name "hasAuditTrail -> Audit Trail Entry" ; sh:node cr:AuditTrailEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Trail." ] .
