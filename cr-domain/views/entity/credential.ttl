    sh:property [ sh:path cr:mfaEnabled ; sh:name "mfaEnabled" ; sh:datatype xsd:boolean ; sh:maxCount 1 ; rdfs:comment "boolean: MFA flag." ] ;
    sh:property [ sh:path cr:credentialStatus ; sh:name "credentialStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: active, expired, revoked, suspended." ] ;
