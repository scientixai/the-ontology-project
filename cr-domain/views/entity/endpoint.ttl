# ---------------------------------------------------------------------------
# REFERENCE ENTITY VIEW  (generated — do not edit by hand)
# Source: docs/ooux-object-catalog-v0.2.md  |  Generator: tools/gen_entity_views.py
#
# REFERENCE, NOT RUNTIME. This is the exhaustive, FLAT menu of everything a
# Endpoint can express in a view: its own attributes, its provenance metadata,
# and its relationships as POINTERS to other objects' views. It carries NO
# prominence, rank, ordering, or role scoping — that arrangement is an
# application's choice, recorded per person per day in the runtime graph, never
# in the commons. A pointer RESOLVES to the target's view; it never inlines it.
# The depth-0 render of a pointer is the target's identity set (cr:isIdentity).
# See the entity-view ADR and RFC 0001.
# ---------------------------------------------------------------------------
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix top:  <https://top.scientix.ai/v1#> .
@prefix hcls: <https://top.scientix.ai/hcls/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:EndpointEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:Endpoint ;
    rdfs:label "Endpoint" ;
    cr:catalogNumber 35 ;
    sh:property [ sh:path cr:endpointId ; sh:name "endpointId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
    sh:property [ sh:path cr:endpointName ; sh:name "endpointName" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Name." ] ;
    sh:property [ sh:path cr:endpointType ; sh:name "endpointType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: primary, secondary, exploratory, safety, pk, pd, biomarker." ] ;
    sh:property [ sh:path cr:estimand ; sh:name "estimand" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Estimand definition." ] ;
    sh:property [ sh:path cr:unit ; sh:name "unit" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: Unit of measure." ] ;
    sh:property [ sh:path cr:analysisPopulation ; sh:name "analysisPopulation" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Analysis population." ] ;
    sh:property [ sh:path cr:successCriterion ; sh:name "successCriterion" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Success criterion." ] ;
    sh:property [ sh:path cr:timeFrame ; sh:name "timeFrame" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Assessment time frame." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:definedBy ; sh:name "definedBy -> Protocol" ; sh:node cr:ProtocolEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Parent protocol." ] ;
    sh:property [ sh:path cr:measuredVia ; sh:name "measuredVia -> Assessment" ; sh:node cr:AssessmentEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Source assessments; flagged as missing object below." ] ;
    sh:property [ sh:path cr:analyzedIn ; sh:name "analyzedIn -> Plan" ; sh:node cr:PlanEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Statistical Analysis Plan." ] ;
    sh:property [ sh:path cr:analyzedIn ; sh:name "analyzedIn -> Interim Analysis" ; sh:node cr:InterimAnalysisEntityView ; rdfs:comment "[0..N] Interim analyses; flagged as missing object below." ] ;
    sh:property [ sh:path cr:reportedIn ; sh:name "reportedIn -> Report" ; sh:node cr:ReportEntityView ; rdfs:comment "[0..N] Reports." ] ;
    sh:property [ sh:path cr:hasAuditTrail ; sh:name "hasAuditTrail -> Audit Trail Entry" ; sh:node cr:AuditTrailEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Trail." ] .
