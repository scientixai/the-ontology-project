@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:SiteNetworkEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:SiteNetwork ;
    rdfs:label "Site Network" ;
    cr:catalogNumber 58 ;
    sh:property [ sh:path cr:networkId ; sh:name "networkId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
    sh:property [ sh:path cr:networkName ; sh:name "networkName" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Display name." ] ;
    sh:property [ sh:path cr:networkType ; sh:name "networkType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: smo, academic, ihn, government, other." ] ;
    sh:property [ sh:path cr:centralIrbId ; sh:name "centralIrbId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI, optional: Central IRB body." ] ;
    sh:property [ sh:path cr:headquartersCountry ; sh:name "headquartersCountry" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, ISO 3166: HQ country." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:ownsSite ; sh:name "ownsSite -> Site" ; sh:node cr:SiteEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Member sites." ] ;
    sh:property [ sh:path cr:governedBy ; sh:name "governedBy -> Oversight Body" ; sh:node cr:OversightBodyEntityView ; rdfs:comment "[0..N] Central governance." ] ;
    sh:property [ sh:path cr:holdsContracts ; sh:name "holdsContracts -> Contract" ; sh:node cr:ContractEntityView ; rdfs:comment "[0..N] Master contracts." ] .
