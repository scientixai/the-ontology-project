@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:QuestionnaireEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:Questionnaire ;
    rdfs:label "Questionnaire" ;
    cr:catalogNumber 44 ;
    sh:property [ sh:path cr:questionnaireId ; sh:name "questionnaireId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
    sh:property [ sh:path cr:questionnaireName ; sh:name "questionnaireName" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Display name." ] ;
    sh:property [ sh:path cr:questionnaireType ; sh:name "questionnaireType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: pro, clinro, obsro, perfo, qol, symptom_diary, safety." ] ;
    sh:property [ sh:path cr:instrumentCode ; sh:name "instrumentCode" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: Instrument code (e.g., EQ-5D-5L, PROMIS-29)." ] ;
    sh:property [ sh:path cr:administrationModality ; sh:name "administrationModality" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: paper, epro, phone, in_clinic." ] ;
    sh:property [ sh:path cr:languages ; sh:name "languages" ; rdfs:comment "list\\[string, ISO 639\\]: Languages available." ] ;
    sh:property [ sh:path cr:itemCount ; sh:name "itemCount" ; sh:datatype xsd:integer ; sh:maxCount 1 ; rdfs:comment "integer: Number of items." ] ;
    sh:property [ sh:path cr:scoringAlgorithm ; sh:name "scoringAlgorithm" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Scoring description." ] ;
    sh:property [ sh:path cr:validationStatus ; sh:name "validationStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: validated, under_validation, unvalidated." ] ;
    sh:property [ sh:path cr:licensingTerms ; sh:name "licensingTerms" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: License." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:partOfSOA ; sh:name "partOfSOA -> Schedule of Assessments" ; sh:node cr:ScheduleOfAssessmentsEntityView ; rdfs:comment "[0..N] In SOA." ] ;
    sh:property [ sh:path cr:administeredAtVisit ; sh:name "administeredAtVisit -> Visit" ; sh:node cr:VisitEntityView ; rdfs:comment "[0..N] Visit administration." ] ;
    sh:property [ sh:path cr:completedBy ; sh:name "completedBy -> Participant" ; sh:node cr:ParticipantEntityView ; rdfs:comment "[0..N] Subjects completing." ] ;
    sh:property [ sh:path cr:completedBy ; sh:name "completedBy -> Person" ; sh:node cr:PersonEntityView ; rdfs:comment "[0..N] Clinicians or observers." ] ;
    sh:property [ sh:path cr:producesCRF ; sh:name "producesCRF -> CRF" ; sh:node cr:CRFEntityView ; rdfs:comment "[0..N] CRF transport." ] ;
    sh:property [ sh:path cr:measuresEndpoint ; sh:name "measuresEndpoint -> Endpoint" ; sh:node cr:EndpointEntityView ; rdfs:comment "[0..N] Endpoints measured." ] ;
    sh:property [ sh:path cr:hasAuditTrail ; sh:name "hasAuditTrail -> Audit Trail Entry" ; sh:node cr:AuditTrailEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Trail." ] .
