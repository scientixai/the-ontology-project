@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:ParticipantEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:Participant ;
    rdfs:label "Participant" ;
    cr:catalogNumber 8 ;
    sh:property [ sh:path cr:participantId ; sh:name "participantId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, unique: Pseudonymous study identifier (subject number)." ] ;
    sh:property [ sh:path cr:screeningNumber ; sh:name "screeningNumber" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Screening number assigned at site." ] ;
    sh:property [ sh:path cr:randomizationNumber ; sh:name "randomizationNumber" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: Randomization id where applicable." ] ;
    sh:property [ sh:path cr:enrollmentStatus ; sh:name "enrollmentStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: SCREENING, SCREENED, ELIGIBLE, ENROLLED, RANDOMIZED, ON_TREATMENT, FOLLOW_UP, COMPLETED, WITHDRAWN, SCREEN_FAILED, LOST_TO_FOLLOWUP." ] ;
    sh:property [ sh:path cr:gender ; sh:name "gender" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum, FHIR Administrative Gender: Administrative gender." ] ;
    sh:property [ sh:path cr:sexAssignedAtBirth ; sh:name "sexAssignedAtBirth" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum, optional: Where collected and permitted by jurisdiction." ] ;
    sh:property [ sh:path cr:dateOfBirth ; sh:name "dateOfBirth" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date: DOB; subject to anonymization in projections." ] ;
    sh:property [ sh:path cr:age ; sh:name "age" ; sh:datatype xsd:integer ; sh:maxCount 1 ; rdfs:comment "integer: Age in years (computed)." ] ;
    sh:property [ sh:path cr:race ; sh:name "race" ; rdfs:comment "array<enum>: Race categories per local rules." ] ;
    sh:property [ sh:path cr:ethnicity ; sh:name "ethnicity" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: Ethnicity per local rules." ] ;
    sh:property [ sh:path cr:enrollmentDate ; sh:name "enrollmentDate" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date: Enrollment date." ] ;
    sh:property [ sh:path cr:consentDate ; sh:name "consentDate" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date: Initial consent date." ] ;
    sh:property [ sh:path cr:consentVersion ; sh:name "consentVersion" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Consent form version." ] ;
    sh:property [ sh:path cr:decentralizedConsentMethod ; sh:name "decentralizedConsentMethod" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum, optional: IN_PERSON, ECONSENT, REMOTE_ECONSENT, HYBRID." ] ;
    sh:property [ sh:path cr:lastVisitDate ; sh:name "lastVisitDate" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date: Most recent visit." ] ;
    sh:property [ sh:path cr:expectedCompletionDate ; sh:name "expectedCompletionDate" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date: Anticipated completion." ] ;
    sh:property [ sh:path cr:actualCompletionDate ; sh:name "actualCompletionDate" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date, optional: Actual completion." ] ;
    sh:property [ sh:path cr:completionReason ; sh:name "completionReason" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum, optional: Reason completed or discontinued." ] ;
    sh:property [ sh:path cr:withdrawalDate ; sh:name "withdrawalDate" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date, optional: Withdrawal date." ] ;
    sh:property [ sh:path cr:withdrawalReason ; sh:name "withdrawalReason" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum, optional: Reason for withdrawal." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
