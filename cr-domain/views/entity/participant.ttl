    sh:property [ sh:path cr:hasScreeningRecord ; sh:name "hasScreeningRecord -> Screening Record" ; sh:node cr:ScreeningRecordEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Screening data; flagged as missing object below." ] ;
