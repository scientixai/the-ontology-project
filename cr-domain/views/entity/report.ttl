@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix top:  <https://top.scientix.ai/v1#> .
@prefix hcls: <https://top.scientix.ai/hcls/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:ReportEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:Report ;
    rdfs:label "Report" ;
    cr:catalogNumber 42 ;
    sh:property [ sh:path cr:reportId ; sh:name "reportId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
    sh:property [ sh:path cr:reportName ; sh:name "reportName" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Display name." ] ;
    sh:property [ sh:path cr:reportType ; sh:name "reportType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: csr, dsur, psur, monitoring_report, site_performance, enrollment, safety, data_quality, listing, dashboard, adhoc." ] ;
    sh:property [ sh:path cr:reportingPeriodStart ; sh:name "reportingPeriodStart" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date, optional: Start." ] ;
    sh:property [ sh:path cr:reportingPeriodEnd ; sh:name "reportingPeriodEnd" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date, optional: End." ] ;
    sh:property [ sh:path cr:generatedAt ; sh:name "generatedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; rdfs:comment "datetime: Generation." ] ;
    sh:property [ sh:path cr:format ; sh:name "format" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: pdf, docx, xlsx, html, json, xml." ] ;
    sh:property [ sh:path cr:version ; sh:name "version" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, semver: Version." ] ;
    sh:property [ sh:path cr:reportStatus ; sh:name "reportStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: draft, in_review, final, archived." ] ;
    sh:property [ sh:path cr:uri ; sh:name "uri" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, URL: Location." ] ;
    sh:property [ sh:path cr:confidentialityLevel ; sh:name "confidentialityLevel" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: public, internal, restricted, confidential." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:generatedBy ; sh:name "generatedBy" ; cr:isMetadata true ; rdfs:comment "PersonRef or SystemRef: Generator." ] ;
    sh:property [ sh:path cr:forStudy ; sh:name "forStudy -> Study" ; sh:node cr:StudyEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Study." ] ;
    sh:property [ sh:path cr:forSite ; sh:name "forSite -> Site" ; sh:node cr:SiteEntityView ; rdfs:comment "[0..N] Sites." ] ;
    sh:property [ sh:path cr:coversEndpoints ; sh:name "coversEndpoints -> Endpoint" ; sh:node cr:EndpointEntityView ; rdfs:comment "[0..N] Endpoints reported." ] ;
    sh:property [ sh:path cr:generatedBySystem ; sh:name "generatedBySystem -> System" ; sh:node cr:SystemEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Source system." ] ;
    sh:property [ sh:path cr:generatedByService ; sh:name "generatedByService -> Service" ; sh:node cr:ServiceEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Source service." ] ;
    sh:property [ sh:path cr:basedOnDataTransfer ; sh:name "basedOnDataTransfer -> Data Transfer" ; sh:node cr:DataTransferEntityView ; rdfs:comment "[0..N] Source data transfers." ] ;
    sh:property [ sh:path cr:hasDocuments ; sh:name "hasDocuments -> Document" ; sh:node cr:DocumentEntityView ; rdfs:comment "[0..N] Attached files." ] ;
    sh:property [ sh:path cr:reviewedBy ; sh:name "reviewedBy -> Oversight Body" ; sh:node cr:OversightBodyEntityView ; rdfs:comment "[0..N] Reviewing bodies." ] ;
    sh:property [ sh:path cr:submittedIn ; sh:name "submittedIn -> Regulatory Submission" ; sh:node cr:RegulatorySubmissionEntityView ; rdfs:comment "[0..N] Submissions including." ] ;
    sh:property [ sh:path cr:hasAuditTrail ; sh:name "hasAuditTrail -> Audit Trail Entry" ; sh:node cr:AuditTrailEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Trail." ] .
