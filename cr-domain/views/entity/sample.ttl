@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:SampleEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:Sample ;
    rdfs:label "Sample" ;
    cr:catalogNumber 48 ;
    sh:property [ sh:path cr:sampleId ; sh:name "sampleId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
    sh:property [ sh:path cr:subjectId ; sh:name "subjectId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI: Subject." ] ;
    sh:property [ sh:path cr:visitId ; sh:name "visitId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI: Visit." ] ;
    sh:property [ sh:path cr:sampleType ; sh:name "sampleType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: whole_blood, serum, plasma, urine, tissue, biopsy, saliva, csf, swab, stool, other." ] ;
    sh:property [ sh:path cr:volume ; sh:name "volume" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; rdfs:comment "decimal, optional: Volume." ] ;
    sh:property [ sh:path cr:volumeUnit ; sh:name "volumeUnit" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, UCUM, optional: Volume unit." ] ;
    sh:property [ sh:path cr:containerType ; sh:name "containerType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Container type." ] ;
    sh:property [ sh:path cr:preservative ; sh:name "preservative" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: Preservative." ] ;
    sh:property [ sh:path cr:collectedAt ; sh:name "collectedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; rdfs:comment "datetime: Collection." ] ;
    sh:property [ sh:path cr:storageTemperatureC ; sh:name "storageTemperatureC" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; rdfs:comment "decimal: Storage temperature." ] ;
    sh:property [ sh:path cr:storageLocationId ; sh:name "storageLocationId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI, optional: Location reference; flagged as missing object below." ] ;
    sh:property [ sh:path cr:biobankRetained ; sh:name "biobankRetained" ; sh:datatype xsd:boolean ; sh:maxCount 1 ; rdfs:comment "boolean: Retained for biobanking." ] ;
    sh:property [ sh:path cr:biobankConsentScope ; sh:name "biobankConsentScope" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: Consent scope for biobanking." ] ;
    sh:property [ sh:path cr:sampleStatus ; sh:name "sampleStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: collected, in_transit, received, processed, analyzed, depleted, destroyed." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:collectedBy ; sh:name "collectedBy" ; cr:isMetadata true ; rdfs:comment "PersonRef: Collector." ] ;
    sh:property [ sh:path cr:fromSubject ; sh:name "fromSubject -> Participant" ; sh:node cr:ParticipantEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Subject." ] ;
    sh:property [ sh:path cr:atVisit ; sh:name "atVisit -> Visit" ; sh:node cr:VisitEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Visit." ] ;
    sh:property [ sh:path cr:producesLabResult ; sh:name "producesLabResult -> Lab Results" ; sh:node cr:LabResultsEntityView ; rdfs:comment "[0..N] Lab results." ] ;
    sh:property [ sh:path cr:shippedVia ; sh:name "shippedVia -> Shipment" ; sh:node cr:ShipmentEntityView ; rdfs:comment "[0..N] Shipments." ] ;
    sh:property [ sh:path cr:governedByConsent ; sh:name "governedByConsent -> Informed Consent" ; sh:node cr:InformedConsentEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Consent governing." ] ;
    sh:property [ sh:path cr:storedAt ; sh:name "storedAt -> Storage Location" ; sh:node cr:StorageLocationEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Storage location; flagged as missing object below." ] ;
    sh:property [ sh:path cr:hasDocuments ; sh:name "hasDocuments -> Document" ; sh:node cr:DocumentEntityView ; rdfs:comment "[0..N] Chain-of-custody documents." ] ;
    sh:property [ sh:path cr:hasAuditTrail ; sh:name "hasAuditTrail -> Audit Trail Entry" ; sh:node cr:AuditTrailEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Trail." ] .
