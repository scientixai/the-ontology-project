# ---------------------------------------------------------------------------
# REFERENCE ENTITY VIEW  (generated — do not edit by hand)
# Source: docs/ooux-object-catalog-v0.2.md  |  Generator: tools/gen_entity_views.py
#
# REFERENCE, NOT RUNTIME. This is the exhaustive, FLAT menu of everything a
# Finding can express in a view: its own attributes, its provenance metadata,
# and its relationships as POINTERS to other objects' views. It carries NO
# prominence, rank, ordering, or role scoping — that arrangement is an
# application's choice, recorded per person per day in the runtime graph, never
# in the commons. A pointer RESOLVES to the target's view; it never inlines it.
# The depth-0 render of a pointer is the target's identity set (cr:isIdentity).
# See the entity-view ADR and RFC 0001.
# ---------------------------------------------------------------------------
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:FindingEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:Finding ;
    rdfs:label "Finding" ;
    cr:catalogNumber 64 ;
    sh:property [ sh:path cr:findingId ; sh:name "findingId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
    sh:property [ sh:path cr:findingTitle ; sh:name "findingTitle" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Title." ] ;
    sh:property [ sh:path cr:findingDescription ; sh:name "findingDescription" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Description." ] ;
    sh:property [ sh:path cr:severity ; sh:name "severity" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: critical, major, minor, observation." ] ;
    sh:property [ sh:path cr:category ; sh:name "category" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: protocol_compliance, informed_consent, source_documentation, ip_accountability, regulatory_binder, safety_reporting, data_integrity, training, other." ] ;
    sh:property [ sh:path cr:identifiedAt ; sh:name "identifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; rdfs:comment "datetime: Identified." ] ;
    sh:property [ sh:path cr:identifiedBy ; sh:name "identifiedBy" ; rdfs:comment "PersonRef: Identifier." ] ;
    sh:property [ sh:path cr:findingStatus ; sh:name "findingStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: open, accepted, in_remediation, resolved, closed_no_action." ] ;
    sh:property [ sh:path cr:responseDueBy ; sh:name "responseDueBy" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date, optional: Response due." ] ;
    sh:property [ sh:path cr:responseReceivedAt ; sh:name "responseReceivedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; rdfs:comment "datetime, optional: Response received." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:raisedDuring ; sh:name "raisedDuring -> Monitoring Visit" ; sh:node cr:MonitoringVisitEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Monitoring visit." ] ;
    sh:property [ sh:path cr:raisedDuring ; sh:name "raisedDuring -> Audit" ; sh:node cr:AuditEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Audit." ] ;
    sh:property [ sh:path cr:atSite ; sh:name "atSite -> Site" ; sh:node cr:SiteEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Site." ] ;
    sh:property [ sh:path cr:triggersCAPA ; sh:name "triggersCAPA -> CAPA" ; sh:node cr:CAPAEntityView ; rdfs:comment "[0..N] CAPAs." ] ;
    sh:property [ sh:path cr:hasDocuments ; sh:name "hasDocuments -> Document" ; sh:node cr:DocumentEntityView ; rdfs:comment "[0..N] Documents." ] ;
    sh:property [ sh:path cr:hasAuditTrail ; sh:name "hasAuditTrail -> Audit Trail Entry" ; sh:node cr:AuditTrailEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Trail." ] .
