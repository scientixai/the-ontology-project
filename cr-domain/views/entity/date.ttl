    sh:property [ sh:path cr:parentObjectType ; sh:name "parentObjectType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: subject, study, site, arm." ] ;
    sh:property [ sh:path cr:parentObjectId ; sh:name "parentObjectId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI: Parent reference." ] ;
    sh:property [ sh:path cr:dateValue ; sh:name "dateValue" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date: Date value." ] ;
    sh:property [ sh:path cr:rationale ; sh:name "rationale" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: Rationale or note." ] ;
    sh:property [ sh:path cr:effectiveStatusAfter ; sh:name "effectiveStatusAfter" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: Status after this date." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:recordedBy ; sh:name "recordedBy" ; cr:isMetadata true ; rdfs:comment "PersonRef: Recorder." ] ;
