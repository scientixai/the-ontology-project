    cr:catalogNumber 59 ;
    sh:property [ sh:path cr:therapeuticAreaId ; sh:name "therapeuticAreaId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
