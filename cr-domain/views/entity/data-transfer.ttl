@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:DataTransferEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:DataTransfer ;
    rdfs:label "Data Transfer" ;
    cr:catalogNumber 50 ;
    sh:property [ sh:path cr:dataTransferId ; sh:name "dataTransferId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
    sh:property [ sh:path cr:dataTransferName ; sh:name "dataTransferName" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Display name." ] ;
    sh:property [ sh:path cr:transferType ; sh:name "transferType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: lab_feed, irt_feed, safety_feed, sponsor_to_authority, sponsor_to_vendor, vendor_to_sponsor, intra_system." ] ;
    sh:property [ sh:path cr:sourceSystemId ; sh:name "sourceSystemId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI: Source system." ] ;
    sh:property [ sh:path cr:destinationSystemId ; sh:name "destinationSystemId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI: Destination system." ] ;
    sh:property [ sh:path cr:scheduledStartAt ; sh:name "scheduledStartAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; rdfs:comment "datetime: Scheduled start." ] ;
    sh:property [ sh:path cr:actualStartAt ; sh:name "actualStartAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; rdfs:comment "datetime, optional: Actual start." ] ;
    sh:property [ sh:path cr:actualEndAt ; sh:name "actualEndAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; rdfs:comment "datetime, optional: Actual end." ] ;
    sh:property [ sh:path cr:recordCount ; sh:name "recordCount" ; sh:datatype xsd:integer ; sh:maxCount 1 ; rdfs:comment "integer, optional: Records." ] ;
    sh:property [ sh:path cr:fileFormat ; sh:name "fileFormat" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: csv, sas_xpt, json, xml, sdtm, adam, hl7, fhir, edc_export." ] ;
    sh:property [ sh:path cr:schemaVersion ; sh:name "schemaVersion" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: Schema version." ] ;
    sh:property [ sh:path cr:transferStatus ; sh:name "transferStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: scheduled, in_progress, succeeded, partial, failed, reconciled." ] ;
    sh:property [ sh:path cr:reconciliationOutcome ; sh:name "reconciliationOutcome" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum, optional: matched, discrepancies, not_reconciled." ] ;
    sh:property [ sh:path cr:dtaReference ; sh:name "dtaReference" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI, optional: Data Transfer Agreement." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:fromSystem ; sh:name "fromSystem -> System" ; sh:node cr:SystemEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Source system." ] ;
    sh:property [ sh:path cr:toSystem ; sh:name "toSystem -> System" ; sh:node cr:SystemEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Destination system." ] ;
    sh:property [ sh:path cr:governedBy ; sh:name "governedBy -> Service" ; sh:node cr:ServiceEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Service." ] ;
    sh:property [ sh:path cr:governedBy ; sh:name "governedBy -> Contract" ; sh:node cr:ContractEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] DTA." ] ;
    sh:property [ sh:path cr:producesReport ; sh:name "producesReport -> Report" ; sh:node cr:ReportEntityView ; rdfs:comment "[0..N] Reports." ] ;
    sh:property [ sh:path cr:carriesCRFs ; sh:name "carriesCRFs -> CRF" ; sh:node cr:CRFEntityView ; rdfs:comment "[0..N] CRF data." ] ;
    sh:property [ sh:path cr:carriesLabResults ; sh:name "carriesLabResults -> Lab Results" ; sh:node cr:LabResultsEntityView ; rdfs:comment "[0..N] Lab data." ] ;
    sh:property [ sh:path cr:mayTrigger ; sh:name "mayTrigger -> Discrepancy" ; sh:node cr:DiscrepancyEntityView ; rdfs:comment "[0..N] Reconciliation queries." ] ;
    sh:property [ sh:path cr:hasAuditTrail ; sh:name "hasAuditTrail -> Audit Trail Entry" ; sh:node cr:AuditTrailEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Trail." ] .
