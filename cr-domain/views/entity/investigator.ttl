    sh:property [ sh:path cr:debarmentStatus ; sh:name "debarmentStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: clear, debarred, under_review." ] ;
