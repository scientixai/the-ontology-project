@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:InterimAnalysisEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:InterimAnalysis ;
    rdfs:label "Interim Analysis" ;
    cr:catalogNumber 71 ;
    sh:property [ sh:path cr:interimAnalysisId ; sh:name "interimAnalysisId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
    sh:property [ sh:path cr:interimAnalysisName ; sh:name "interimAnalysisName" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Display name." ] ;
    sh:property [ sh:path cr:studyId ; sh:name "studyId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI: Study." ] ;
    sh:property [ sh:path cr:analysisType ; sh:name "analysisType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: efficacy, futility, safety, sample_size_reestimation, adaptation." ] ;
    sh:property [ sh:path cr:triggerType ; sh:name "triggerType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: time_based, event_based, unplanned." ] ;
    sh:property [ sh:path cr:triggerSpec ; sh:name "triggerSpec" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Trigger specification." ] ;
    sh:property [ sh:path cr:cutoffDate ; sh:name "cutoffDate" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date: Data cutoff." ] ;
    sh:property [ sh:path cr:plannedDecisionRules ; sh:name "plannedDecisionRules" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Pre-specified decision rules." ] ;
    sh:property [ sh:path cr:actualDecision ; sh:name "actualDecision" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum, optional: continue, stop_for_efficacy, stop_for_futility, stop_for_safety, modify." ] ;
    sh:property [ sh:path cr:decisionRationale ; sh:name "decisionRationale" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: Rationale." ] ;
    sh:property [ sh:path cr:analysisStatus ; sh:name "analysisStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: planned, in_progress, complete." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:forStudy ; sh:name "forStudy -> Study" ; sh:node cr:StudyEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Study." ] ;
    sh:property [ sh:path cr:analyzesEndpoint ; sh:name "analyzesEndpoint -> Endpoint" ; sh:node cr:EndpointEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Endpoints analyzed." ] ;
    sh:property [ sh:path cr:reviewedBy ; sh:name "reviewedBy -> Oversight Body" ; sh:node cr:OversightBodyEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] DSMB." ] ;
    sh:property [ sh:path cr:hasReport ; sh:name "hasReport -> Report" ; sh:node cr:ReportEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Report." ] ;
    sh:property [ sh:path cr:triggersAmendment ; sh:name "triggersAmendment -> Amendment" ; sh:node cr:AmendmentEntityView ; rdfs:comment "[0..N] Resulting amendments." ] ;
    sh:property [ sh:path cr:hasAuditTrail ; sh:name "hasAuditTrail -> Audit Trail Entry" ; sh:node cr:AuditTrailEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Trail." ] .
