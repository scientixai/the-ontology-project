@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:VisitEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:Visit ;
    rdfs:label "Visit" ;
    cr:catalogNumber 6 ;
    sh:property [ sh:path cr:visitId ; sh:name "visitId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, unique: Identifier." ] ;
