    sh:property [ sh:path cr:windowAnchor ; sh:name "windowAnchor" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: BASELINE, PRIOR_VISIT, FIXED_DATE." ] ;
    sh:property [ sh:path cr:visitStatus ; sh:name "visitStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: SCHEDULED, IN_PROGRESS, COMPLETED, MISSED, CANCELED." ] ;
    sh:property [ sh:path cr:visitDuration ; sh:name "visitDuration" ; sh:datatype xsd:duration ; sh:maxCount 1 ; rdfs:comment "duration: Planned duration." ] ;
    sh:property [ sh:path cr:visitLocation ; sh:name "visitLocation" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Physical or virtual location." ] ;
    sh:property [ sh:path cr:windowComplianceStatus ; sh:name "windowComplianceStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: IN_WINDOW, OUT_OF_WINDOW." ] ;
    sh:property [ sh:path cr:visitCost ; sh:name "visitCost" ; rdfs:comment "money: Cost for budget accrual." ] ;
