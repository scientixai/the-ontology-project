    sh:property [ sh:path cr:visitName ; sh:name "visitName" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Display name." ] ;
    sh:property [ sh:path cr:visitType ; sh:name "visitType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: SCREENING, BASELINE, TREATMENT, FOLLOW_UP, EARLY_TERMINATION, UNSCHEDULED." ] ;
    sh:property [ sh:path cr:visitModality ; sh:name "visitModality" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: IN_CLINIC, TELEVISIT, HOME_HEALTH, HYBRID." ] ;
    sh:property [ sh:path cr:scheduledDate ; sh:name "scheduledDate" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; rdfs:comment "datetime: Planned datetime." ] ;
    sh:property [ sh:path cr:actualDate ; sh:name "actualDate" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; rdfs:comment "datetime: Actual datetime." ] ;
