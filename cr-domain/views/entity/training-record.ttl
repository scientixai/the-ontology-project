    sh:property [ sh:path cr:personId ; sh:name "personId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI: Trainee." ] ;
    sh:property [ sh:path cr:trainingTitle ; sh:name "trainingTitle" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Training title." ] ;
    sh:property [ sh:path cr:trainingType ; sh:name "trainingType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: gcp, protocol, system, safety, privacy, device, other." ] ;
    sh:property [ sh:path cr:version ; sh:name "version" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Training version." ] ;
    sh:property [ sh:path cr:completedAt ; sh:name "completedAt" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date: Completion." ] ;
    sh:property [ sh:path cr:expiresAt ; sh:name "expiresAt" ; sh:datatype xsd:date ; sh:maxCount 1 ; rdfs:comment "date, optional: Expiry." ] ;
    sh:property [ sh:path cr:certificateReference ; sh:name "certificateReference" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, IRI, optional: Certificate." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:completedBy ; sh:name "completedBy -> Person" ; sh:node cr:PersonEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Trainee." ] ;
    sh:property [ sh:path cr:forStudy ; sh:name "forStudy -> Study" ; sh:node cr:StudyEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Study." ] ;
    sh:property [ sh:path cr:forSite ; sh:name "forSite -> Site" ; sh:node cr:SiteEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Site." ] ;
    sh:property [ sh:path cr:forSystem ; sh:name "forSystem -> System" ; sh:node cr:SystemEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] System." ] ;
    sh:property [ sh:path cr:hasDocuments ; sh:name "hasDocuments -> Document" ; sh:node cr:DocumentEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Certificate files." ] ;
    sh:property [ sh:path cr:hasAuditTrail ; sh:name "hasAuditTrail -> Audit Trail Entry" ; sh:node cr:AuditTrailEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Trail." ] .
