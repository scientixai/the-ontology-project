# ---------------------------------------------------------------------------
# REFERENCE ENTITY VIEW  (generated — do not edit by hand)
# Source: docs/ooux-object-catalog-v0.2.md  |  Generator: tools/gen_entity_views.py
#
# REFERENCE, NOT RUNTIME. This is the exhaustive, FLAT menu of everything a
# Tag can express in a view: its own attributes, its provenance metadata,
# and its relationships as POINTERS to other objects' views. It carries NO
# prominence, rank, ordering, or role scoping — that arrangement is an
# application's choice, recorded per person per day in the runtime graph, never
# in the commons. A pointer RESOLVES to the target's view; it never inlines it.
# The depth-0 render of a pointer is the target's identity set (cr:isIdentity).
# See the entity-view ADR and RFC 0001.
# ---------------------------------------------------------------------------
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:TagEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:Tag ;
    rdfs:label "Tag" ;
    cr:catalogNumber 3 ;
    sh:property [ sh:path cr:tagId ; sh:name "tagId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, unique: Unique identifier." ] ;
    sh:property [ sh:path cr:tagLabel ; sh:name "tagLabel" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Display label." ] ;
    sh:property [ sh:path cr:tagDescription ; sh:name "tagDescription" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Free-text description." ] ;
    sh:property [ sh:path cr:tagPrompt ; sh:name "tagPrompt" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Helper prompt shown when applying the tag." ] ;
    sh:property [ sh:path cr:tagColor ; sh:name "tagColor" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, hex: Color for UI badges." ] ;
    sh:property [ sh:path cr:tagScope ; sh:name "tagScope" ; rdfs:comment "array<enum>: Object types this tag may decorate (STUDY, PARTICIPANT, SITE, etc.)." ] ;
    sh:property [ sh:path cr:ownerSponsorId ; sh:name "ownerSponsorId" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Sponsor that owns and curates the tag vocabulary." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Tag creation." ] ;
    sh:property [ sh:path cr:createdBy ; sh:name "createdBy" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "string: Creator person id." ] ;
    sh:property [ sh:path cr:decorates ; sh:name "decorates -> Study" ; sh:node cr:StudyEntityView ; rdfs:comment "[0..N] Studies the tag is applied to." ] ;
    sh:property [ sh:path cr:ownedBy ; sh:name "ownedBy -> Sponsor" ; sh:node cr:SponsorEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Owning sponsor." ] ;
    sh:property [ sh:path cr:managedBy ; sh:name "managedBy -> Person" ; sh:node cr:PersonEntityView ; rdfs:comment "[0..N] Users authorised to apply or curate." ] ;
    sh:property [ sh:path cr:references ; sh:name "references -> Document" ; sh:node cr:DocumentEntityView ; rdfs:comment "[0..N] Documents categorised by the tag." ] ;
    sh:property [ sh:path cr:reportedIn ; sh:name "reportedIn -> Report" ; sh:node cr:ReportEntityView ; rdfs:comment "[0..N] Reports filtered by tag." ] ;
    sh:property [ sh:path cr:governs ; sh:name "governs -> User Role" ; sh:node cr:UserRoleEntityView ; rdfs:comment "[0..N] Tag-scoped permissions." ] ;
    sh:property [ sh:path cr:audits ; sh:name "audits -> Audit Trail Entry" ; sh:node cr:AuditTrailEntryEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Trail of tag application changes." ] .
