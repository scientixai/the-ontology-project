@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:CRFEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:CRF ;
    rdfs:label "CRF" ;
    cr:catalogNumber 14 ;
    sh:property [ sh:path cr:crfId ; sh:name "crfId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, unique: Identifier." ] ;
    sh:property [ sh:path cr:crfName ; sh:name "crfName" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Display name." ] ;
    sh:property [ sh:path cr:crfType ; sh:name "crfType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: DEMOGRAPHICS, VITAL_SIGNS, ADVERSE_EVENTS, MEDICAL_HISTORY, LAB, OTHER." ] ;
    sh:property [ sh:path cr:crfVersion ; sh:name "crfVersion" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Version." ] ;
    sh:property [ sh:path cr:crfStatus ; sh:name "crfStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: NOT_STARTED, IN_PROGRESS, COMPLETED, VERIFIED, LOCKED." ] ;
    sh:property [ sh:path cr:dataEntryMethod ; sh:name "dataEntryMethod" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: EDC, PAPER, eSOURCE, IMPORT." ] ;
