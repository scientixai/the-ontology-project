    sh:property [ sh:path cr:electronicSignatureStatus ; sh:name "electronicSignatureStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: NOT_REQUIRED, PENDING, SIGNED." ] ;
    sh:property [ sh:path cr:dataExportStatus ; sh:name "dataExportStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: NOT_EXPORTED, EXPORTED, EXPORT_FAILED." ] ;
    sh:property [ sh:path cr:crfTemplateReference ; sh:name "crfTemplateReference" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Reference to the template definition." ] ;
