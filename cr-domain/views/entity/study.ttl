    sh:property [ sh:path cr:hasUserRoles ; sh:name "hasUserRoles -> User Role" ; sh:node cr:UserRoleEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Study-scoped role assignments." ] ;
