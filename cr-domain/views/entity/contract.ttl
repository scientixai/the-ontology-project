cr:ContractEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:Contract ;
    rdfs:label "Contract" ;
    cr:catalogNumber 33 ;
    sh:property [ sh:path cr:contractId ; sh:name "contractId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, IRI: Unique identifier." ] ;
    sh:property [ sh:path cr:contractName ; sh:name "contractName" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string: Display name." ] ;
    sh:property [ sh:path cr:contractType ; sh:name "contractType" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: cta, msa, work_order, change_order, nda, dpa, vendor." ] ;
    sh:property [ sh:path cr:parties ; sh:name "parties" ; rdfs:comment "list\\[OrganizationRef\\]: Parties to contract." ] ;
