    sh:property [ sh:path cr:relatesTo ; sh:name "relatesTo -> Sponsor" ; sh:node cr:SponsorEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Sponsors and vendors." ] ;
    sh:property [ sh:path cr:references ; sh:name "references -> Budget" ; sh:node cr:BudgetEntityView ; sh:maxCount 1 ; rdfs:comment "[0..1] Budget." ] ;
    sh:property [ sh:path cr:hasDocuments ; sh:name "hasDocuments -> Document" ; sh:node cr:DocumentEntityView ; sh:minCount 1 ; rdfs:comment "[1..N] Executed copies." ] ;
    sh:property [ sh:path cr:hasAmendments ; sh:name "hasAmendments -> Amendment" ; sh:node cr:AmendmentEntityView ; rdfs:comment "[0..N] Amendments." ] ;
