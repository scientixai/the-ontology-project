    sh:property [ sh:path cr:currency ; sh:name "currency" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, ISO 4217: Currency." ] ;
    sh:property [ sh:path cr:paymentTermsDays ; sh:name "paymentTermsDays" ; sh:datatype xsd:integer ; sh:maxCount 1 ; rdfs:comment "integer: Net payment days." ] ;
    sh:property [ sh:path cr:governingLaw ; sh:name "governingLaw" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Governing law." ] ;
    sh:property [ sh:path cr:noticePeriodDays ; sh:name "noticePeriodDays" ; sh:datatype xsd:integer ; sh:maxCount 1 ; rdfs:comment "integer: Notice period." ] ;
    sh:property [ sh:path cr:indemnificationTerms ; sh:name "indemnificationTerms" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Indemnification." ] ;
    sh:property [ sh:path cr:ipOwnership ; sh:name "ipOwnership" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: IP ownership." ] ;
    sh:property [ sh:path cr:publicationRights ; sh:name "publicationRights" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Publication." ] ;
    sh:property [ sh:path cr:dataPrivacyAddendum ; sh:name "dataPrivacyAddendum" ; sh:datatype xsd:boolean ; sh:maxCount 1 ; rdfs:comment "boolean: DPA included." ] ;
    sh:property [ sh:path cr:createdAt ; sh:name "createdAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Creation." ] ;
    sh:property [ sh:path cr:modifiedAt ; sh:name "modifiedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Modification." ] ;
    sh:property [ sh:path cr:signedBy ; sh:name "signedBy" ; cr:isMetadata true ; rdfs:comment "list\\[PersonRef\\]: Signatories." ] ;
    sh:property [ sh:path cr:signedAt ; sh:name "signedAt" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; cr:isMetadata true ; rdfs:comment "datetime: Signature time." ] ;
