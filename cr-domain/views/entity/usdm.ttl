    sh:property [ sh:path usdm:SubjectEnrollment-forStudySiteId ; sh:name "forStudySiteId" ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path usdm:SubjectEnrollment-id ; sh:name "id" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; cr:isIdentity true ] ;
    sh:property [ sh:path usdm:SubjectEnrollment-instanceType ; sh:name "instanceType" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path usdm:SubjectEnrollment-label ; sh:name "label" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ] ;
