cr:USDM_AbbreviationEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass usdm:Abbreviation ;
    rdfs:label "Abbreviation" ;
    rdfs:comment "A set of letters that are drawn from a word or from a sequence of words and that are used for brevity in place of the full word or phrase. (CDISC Glossary)" ;
    sh:property [ sh:path usdm:Abbreviation-abbreviatedText ; sh:name "abbreviatedText" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path usdm:Abbreviation-expandedText ; sh:name "expandedText" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path usdm:Abbreviation-id ; sh:name "id" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; cr:isIdentity true ] ;
    sh:property [ sh:path usdm:Abbreviation-instanceType ; sh:name "instanceType" ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path usdm:Abbreviation-extensionAttributes ; sh:name "extensionAttributes" ; sh:node cr:USDM_ExtensionAttributeEntityView ] ;
    sh:property [ sh:path usdm:Abbreviation-notes ; sh:name "notes" ; sh:node cr:USDM_CommentAnnotationEntityView ] .

