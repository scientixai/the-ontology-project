cr:USDM_SubjectEnrollmentEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass usdm:SubjectEnrollment ;
    rdfs:label "SubjectEnrollment" ;
    rdfs:comment "The act of enrolling subjects into a study. The subject will have met the inclusion/exclusion criteria to participate in the trial and will have signed an informed consent form. (CDISC Glossary)" ;
