@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:InvestigationalDeviceEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:InvestigationalDevice ;
    rdfs:label "Investigational Device" ;
    cr:catalogNumber 24 ;
