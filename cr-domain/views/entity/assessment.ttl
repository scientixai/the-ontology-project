    sh:property [ sh:path cr:definedBy ; sh:name "definedBy -> Schedule of Assessments" ; sh:node cr:ScheduleOfAssessmentsEntityView ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "[1] Parent SOA." ] ;
