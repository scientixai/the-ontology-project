    sh:property [ sh:path cr:code ; sh:name "code" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string, optional: Coded concept (LOINC, SNOMED)." ] ;
    sh:property [ sh:path cr:estimatedDurationMinutes ; sh:name "estimatedDurationMinutes" ; sh:datatype xsd:integer ; sh:maxCount 1 ; rdfs:comment "integer: Duration." ] ;
