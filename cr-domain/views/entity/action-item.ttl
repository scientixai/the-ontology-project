@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


cr:ActionItemEntityView a sh:NodeShape, cr:EntityView ;
    sh:targetClass cr:ActionItem ;
    rdfs:label "Action Item" ;
    cr:catalogNumber 18 ;
    sh:property [ sh:path cr:actionItemId ; sh:name "actionItemId" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "string, unique: Identifier." ] ;
    sh:property [ sh:path cr:actionItemTrackingNumber ; sh:name "actionItemTrackingNumber" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Tracking number." ] ;
    sh:property [ sh:path cr:actionItemDescription ; sh:name "actionItemDescription" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "string: Description." ] ;
    sh:property [ sh:path cr:actionItemStatus ; sh:name "actionItemStatus" ; sh:datatype xsd:string ; sh:maxCount 1 ; cr:isIdentity true ; rdfs:comment "enum: OPEN, IN_PROGRESS, COMPLETED, OVERDUE, CANCELED." ] ;
    sh:property [ sh:path cr:priority ; sh:name "priority" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: LOW, MEDIUM, HIGH, CRITICAL." ] ;
    sh:property [ sh:path cr:actionItemImpactLevel ; sh:name "actionItemImpactLevel" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: LOW, MEDIUM, HIGH." ] ;
    sh:property [ sh:path cr:actionItemCategory ; sh:name "actionItemCategory" ; sh:datatype xsd:string ; sh:maxCount 1 ; rdfs:comment "enum: DATA_QUERY, PROTOCOL_DEVIATION, REGULATORY, SAFETY, OTHER." ] ;
