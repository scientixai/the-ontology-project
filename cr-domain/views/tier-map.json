{
  "_doc": "Tier attribution for clinical-research OOUX objects — the reconciliation record enforced by tools/lint_layering.py. See docs/ooux-layer-blindness.md. Every object a domain mints or targets must resolve to its home layer: dedupe (bind to an existing parent class), subclass (domain-native, rdfs:subClassOf a named existing parent), promote (a cross-domain primitive with no parent yet — needs a Core/mid class via RFC), or review (tier decision pending). dedupe/subclass PASS; promote/review WARN (tracked, non-blocking) until --strict. An object absent from this map is an untriaged shadow/orphan and FAILS the gate — that is what prevents recurrence.",
  "_verdicts": {
    "dedupe": "same concept the parent already owns — bind the view/target to it, do not re-mint",
    "subclass": "domain-native specialization — mint in cr:, but rdfs:subClassOf the named parent",
    "promote": "cross-domain primitive; no parent exists yet — candidate for Core or a mid-layer (RFC)",
    "review": "home tier not yet decided — tracked so the map stays complete; resolve before federation"
  },
  "objects": {
    "Person":              {"verdict": "dedupe",   "resolve": "hcls:Person"},
    "System":              {"verdict": "dedupe",   "resolve": "top:System"},
    "Log":                 {"verdict": "dedupe",   "resolve": "top:Log"},
    "Document":            {"verdict": "dedupe",   "resolve": "top:Document"},
    "Equipment":           {"verdict": "dedupe",   "resolve": "top:Equipment"},
