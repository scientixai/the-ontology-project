@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

# THE ROOT OF THE CR DOMAIN — the one file that declares what the module set IS.
# Load this (with imports resolution) and you have the whole domain; the merged
# dist artifact (docs/dist/top-cr-v1.ttl) is the same content pre-merged, with
# Core folded in from the pinned artifact (upstream-pin.json).

<https://top.scientix.ai/cr/v1> a owl:Ontology ;
    dct:title "TOP Clinical Research (CR) domain — module root" ;
    rdfs:comment "Imports every authored module of the CR domain plus the pinned TOP Core. The coherence gate enforces that every ontology/*.ttl module is listed here." ;
    owl:imports <https://top.scientix.ai/v1> ;   # TOP Core (pinned: upstream-pin.json)
    owl:imports <https://top.scientix.ai/cr/v1/actions> ;   # cr-core-actions.ttl
    owl:imports <https://top.scientix.ai/cr/v1/adam> ;   # cr-core-adam.ttl
    owl:imports <https://top.scientix.ai/cr/v1#analysisModule> ;   # cr-core-analysis.ttl
    owl:imports <https://top.scientix.ai/cr/v1#closeoutModule> ;   # cr-core-closeout.ttl
    owl:imports <https://top.scientix.ai/cr/v1/coding> ;   # cr-core-coding.ttl
    owl:imports <https://top.scientix.ai/cr/v1/deviation> ;   # cr-core-deviation.ttl
    owl:imports <https://top.scientix.ai/cr/v1/disclosure> ;   # cr-core-disclosure.ttl
    owl:imports <https://top.scientix.ai/cr/v1/edc> ;   # cr-core-edc.ttl
    owl:imports <https://top.scientix.ai/cr/v1/eop2> ;   # cr-core-eop2.ttl
    owl:imports <https://top.scientix.ai/cr/v1/gcp> ;   # cr-core-gcp.ttl
    owl:imports <https://top.scientix.ai/cr/v1/lims> ;   # cr-core-lims.ttl
    owl:imports <https://top.scientix.ai/cr/v1/participant> ;   # cr-core-participant.ttl
    owl:imports <https://top.scientix.ai/cr/v1/phases> ;   # cr-core-phases.ttl
    owl:imports <https://top.scientix.ai/cr/v1/preind> ;   # cr-core-preind.ttl
    owl:imports <https://top.scientix.ai/cr/v1/privacy> ;   # cr-core-privacy.ttl
    owl:imports <https://top.scientix.ai/cr/v1/randomization> ;   # cr-core-randomization.ttl
    owl:imports <https://top.scientix.ai/cr/v1/rbqm> ;   # cr-core-rbqm.ttl
    owl:imports <https://top.scientix.ai/cr/v1/recruitment> ;   # cr-core-recruitment.ttl
    owl:imports <https://top.scientix.ai/cr/v1#reportingModule> ;   # cr-core-reporting.ttl
    owl:imports <https://top.scientix.ai/cr/v1/roles> ;   # cr-core-roles.ttl
    owl:imports <https://top.scientix.ai/cr/v1/safety> ;   # cr-core-safety.ttl
    owl:imports <https://top.scientix.ai/cr/v1/schedule> ;   # cr-core-schedule.ttl
    owl:imports <https://top.scientix.ai/cr/v1/site-closeout> ;   # cr-core-site-closeout.ttl
    owl:imports <https://top.scientix.ai/cr/v1/startup-package> ;   # cr-core-startup-package.ttl
    owl:imports <https://top.scientix.ai/cr/v1/startup> ;   # cr-core-startup.ttl
    owl:imports <https://top.scientix.ai/cr/v1#submissionModule> ;   # cr-core-submission.ttl
    owl:imports <https://top.scientix.ai/cr/v1/supply> ;   # cr-core-supply.ttl
    owl:imports <https://top.scientix.ai/cr/v1/visit-execution> ;   # cr-core-visit-execution.ttl
    owl:imports <https://top.scientix.ai/cr/v1#> ;   # cr-core.ttl
    owl:imports <https://top.scientix.ai/cr/v1/regulatory> ;   # cr-regulatory.ttl
    owl:imports <https://top.scientix.ai/cr/v1/thesaurus> ;   # cr-thesaurus.ttl
    owl:imports <https://top.scientix.ai/crosswalk/v1#> ;   # crosswalk-vocab.ttl
    owl:imports <https://top.scientix.ai/cr/v1#dtaModule> ;   # dta-module.ttl
    owl:imports <https://top.scientix.ai/hcls/v1#> ;   # hcls-core.ttl
    owl:imports <https://top.scientix.ai/cr/v1/tmf-onboarding> ;   # tmf-onboarding.ttl
    owl:imports <https://top.scientix.ai/cr/v1/tmf-reference> .   # tmf-reference.ttl
