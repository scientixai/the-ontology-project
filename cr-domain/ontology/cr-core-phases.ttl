@prefix cr:   <https://top.scientix.ai/cr/v1#> .
@prefix hcls: <https://top.scientix.ai/hcls/v1#> .
@prefix top:  <https://top.scientix.ai/v1#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Trial Phase vs. Trial Lifecycle Stage — two concepts, deliberately separated.
#
# Convener ruling (sanity review, 2026-07): an earlier version of this file
# conflated them under one word. They answer DIFFERENT questions:
#
#   TRIAL PHASE — what kind of trial IS this?   (Phase 1..4, BESH)
#                 A classification OF THE STUDY. "This is a Phase 2 trial."
#   TRIAL STAGE — where in its execution is it? (startup / conduct / closeout)
#                 A position IN THE TRIAL'S RUN. "This trial is in startup."
#
# Both live in the CR domain, not hcls: trial phases and trial stages exist
# ONLY in clinical research. A bare 'Phase' class was removed from hcls-core
# for the same reason 'phase' is watch-listed — the word alone is ambiguous;
# only the qualified forms (trial phase, trial stage) are model names.
#
# A Phase 3 trial passes through every lifecycle stage; a trial in the conduct
# stage can be of any phase. 'Phase' is on the ambiguous-terms watch-list
# (cr-thesaurus.ttl) with this exact routing.
#
# Scope note: veterinary studies also run phases 1-3, but animal studies are a
# different domain — out of scope here (see BOUNDARIES.md posture).

#################################################################
# A. TRIAL PHASE — classification of the study
#################################################################

cr:TrialPhase a owl:Class ;
    rdfs:label "Trial Phase" ;
    skos:definition "The regulatory development phase a clinical trial belongs to — the answer to 'what kind of trial is this?' (Phase 1, 2, 3, 4, or BESH). A classification of the study itself, not a position in its execution (that is the lifecycle stage)." ;
    rdfs:comment "Carried on the study as cr:trialPhase -> one of the named individuals below (ADR-0024: a classification rides as a value/individual, never a subclass of Study). Each phase carries the names practitioners actually use — including the device-world names, per the in-model devices decision (BOUNDARIES.md). USDM: StudyVersion.studyPhase is the crosswalk target." ;
    rdfs:subClassOf top:Scope .

cr:trialPhase a owl:ObjectProperty ;
    rdfs:label "trial phase" ;
    rdfs:comment "The development phase of this study (one of the cr:TrialPhase individuals)." ;
    rdfs:domain cr:Study ;
    rdfs:range cr:TrialPhase ;
    top:flavor "Additive" .

cr:Phase1 a cr:TrialPhase ;
    rdfs:label "Phase 1" ;
    skos:altLabel "early-stage study"@en , "first-in-human"@en , "FIH"@en ,
        "phase I"@en ;
    skos:altLabel "feasibility study"@en , "pilot study"@en , "early feasibility study"@en ;
    rdfs:comment "Purpose: initial human safety, tolerability, dosing (dose escalation, MTD), and pharmacokinetics — not efficacy. Size: small (typically 20–100), healthy volunteers or, in oncology, patients. Sites: specialized Phase-1 units with intensive-monitoring capability, usually a handful. Device-world names: feasibility / pilot / early feasibility study." .

cr:Phase2 a cr:TrialPhase ;
    rdfs:label "Phase 2" ;
    skos:altLabel "phase II"@en , "proof-of-concept study"@en , "dose-finding study"@en ;
    rdfs:comment "Purpose: preliminary efficacy signal and dose selection (dose-ranging; ends at the EOP2 gate this model treats as the analysis decision node), continued safety. Size: moderate (typically 100–300 patients with the condition). Sites: academic and specialty investigative sites, tens of sites." .

cr:Phase3 a cr:TrialPhase ;
    rdfs:label "Phase 3" ;
    skos:altLabel "phase III"@en , "pivotal study"@en , "late-stage study"@en ,
        "confirmatory trial"@en , "pre-market pivotal study"@en ;
    rdfs:comment "Purpose: confirmatory efficacy and safety versus control — the evidence a marketing application rests on. Size: large (typically 300–3,000+). Sites: broad multi-site, multi-region networks including community sites. Device-world name: pivotal study (the pre-market confirmatory trial, akin to a Phase 3 drug trial)." .

cr:Phase4 a cr:TrialPhase ;
    rdfs:label "Phase 4" ;
    skos:altLabel "phase IV"@en , "post-marketing study"@en ,
        "post-market surveillance study"@en , "PMS study"@en ;
    rdfs:comment "Purpose: real-world safety and effectiveness after approval — rare adverse events, long-term outcomes, use in broader populations; often a post-marketing commitment. Size: large to very large. Sites: routine-care settings. Device-world name: post-market surveillance study." .

cr:BESH a cr:TrialPhase ;
    rdfs:label "BESH" ;
    skos:altLabel "basic experimental studies involving humans"@en ,
        "basic experimental study with humans"@en ;
    rdfs:comment "Basic Experimental Studies Involving Humans — the FDA/NIH-defined category sitting BETWEEN non-human basic research and conventional clinical trials: mechanistic studies that meet the NIH clinical-trial definition (human participants, prospective assignment, intervention, biomedical outcome) but whose aim is understanding a phenomenon, not evaluating a clinical intervention. Registered and disclosed under dedicated FDA/NIH policy. Size: small; sites: academic research settings." .

#################################################################
# B. TRIAL STAGES — position in the trial's execution
#################################################################
#
# Named individuals (reference-graph archetypes, not instances of any specific
# trial). Three top-level STAGES with named sub-stages; a containment tree plus
# a precedence chain at the top level.
#
# Operator grounding: each stage anchors cr:occursInStage on Actions, letting
# agents answer: "What am I authorized to do right now given where this trial is?"

cr:TrialStage a owl:Class ;
    rdfs:label "Trial Stage" ;
    skos:altLabel "lifecycle stage"@en , "study stage"@en ;
    skos:definition "A bounded, sequenced stage of a clinical trial's execution lifecycle — the answer to 'where in its run is this trial?' (startup, conduct, closeout, and their named sub-stages). A position in the trial's execution, not a classification of the study (that is the trial phase)." ;
    rdfs:comment "Stages form a containment tree (cr:containsStage) and a precedence chain (cr:precedesStage). Actions bind to stages via cr:occursInStage. CR-owned deliberately: trial stages exist only in clinical research, so this does not live in hcls-core." ;
    rdfs:subClassOf top:Scope .

cr:containsStage a owl:ObjectProperty ;
    rdfs:label "contains stage" ;
    rdfs:comment "Containment: a trial stage contains its named sub-stages. Transitive; used to derive the top-level stage for any sub-stage." ;
    rdfs:domain cr:TrialStage ;
    rdfs:range cr:TrialStage ;
    top:flavor "Additive" .

cr:precedesStage a owl:ObjectProperty ;
    rdfs:label "precedes stage" ;
    rdfs:comment "Temporal sequencing: Stage A precedes Stage B means B cannot begin before A's gate conditions are met." ;
    rdfs:domain cr:TrialStage ;
    rdfs:range cr:TrialStage ;
    top:flavor "Additive" .

cr:occursInStage a owl:ObjectProperty ;
    rdfs:label "occurs in stage" ;
    rdfs:comment "The trial stage in which this Action is typically performed." ;
    rdfs:domain hcls:Action ;
    rdfs:range cr:TrialStage ;
    top:flavor "Additive" .

cr:TrialLifecycle a cr:TrialStage ;
    rdfs:label "Clinical Trial Lifecycle" ;
    rdfs:comment "The root stage encompassing the entire lifespan of a clinical trial from protocol design to study archival." ;
    cr:containsStage cr:StartupStage , cr:ConductStage , cr:CloseoutStage .

# ── Stage 1: Startup ─────────────────────────────────────────────────────────

cr:StartupStage a cr:TrialStage ;
    rdfs:label "Startup" ;
    rdfs:comment "Everything from initial protocol design through first-patient-in (FPI). Gate condition: first participant randomized. Canonical ICH E6(R3) pre-trial period." ;
    cr:precedesStage cr:ConductStage ;
    cr:containsStage
        cr:StudyDesignStage ,
        cr:SiteSelectionStage ,
        cr:SiteRegulatoryStage ,
        cr:SiteActivationStage .

cr:StudyDesignStage a cr:TrialStage ;
    rdfs:label "Study Design" ;
    rdfs:comment "Protocol authoring, statistical analysis plan, SoA construction, CRF design, arm configuration, endpoint definition. Output: approved protocol version." .

cr:SiteSelectionStage a cr:TrialStage ;
    rdfs:label "Site Selection" ;
    rdfs:comment "Feasibility assessment, site evaluation, qualification visit (SQV), site selection committee review. Output: selected site list with signed contracts." .

cr:SiteRegulatoryStage a cr:TrialStage ;
    rdfs:label "Site Regulatory" ;
    rdfs:comment "IND/CTA filing, IRB/EC review, country-level submissions, amendment management. Output: regulatory clearance per country." .

cr:SiteActivationStage a cr:TrialStage ;
    rdfs:label "Site Activation" ;
    rdfs:comment "Study Startup Package readiness, Site Initiation Visit (SIV), training, delegation of authority, equipment qualification. Output: site activated and ready to enroll. (The stage; the green-light act itself is cr:SiteActivation.)" .

# ── Stage 2: Conduct ─────────────────────────────────────────────────────────

cr:ConductStage a cr:TrialStage ;
    rdfs:label "Conduct" ;
    rdfs:comment "From first patient in (FPI) through last patient out (LPO) / database lock (DBL). The operational execution window of the trial." ;
    cr:precedesStage cr:CloseoutStage ;
    cr:containsStage
        cr:RecruitmentStage ,
        cr:VisitExecutionStage ,
        cr:DataCollectionStage ,
        cr:SafetyStage ,
        cr:OversightStage .

cr:RecruitmentStage a cr:TrialStage ;
    rdfs:label "Recruitment" ;
    rdfs:comment "Candidate identification, screening, informed consent, eligibility assessment, enrollment, randomization. Operator primary: Site Coordinator + Investigator." .

cr:VisitExecutionStage a cr:TrialStage ;
    rdfs:label "Visit Execution" ;
    rdfs:comment "Scheduled and unscheduled visit conduct: actuals vs. SoA, activity completion, IP administration, sample collection, CRF completion at visit level." .

cr:DataCollectionStage a cr:TrialStage ;
    rdfs:label "Data Collection" ;
    rdfs:comment "EDC data entry and CRF completion, query management, lab reconciliation, concomitant medication and medical history recording. Dual-lens: site captures, sponsor/DM validates." .

cr:SafetyStage a cr:TrialStage ;
    rdfs:label "Safety" ;
    rdfs:comment "Adverse event reporting, SAE expedited reporting, investigator causality assessment, pharmacovigilance line listing, safety signal detection. Always concurrent with other sub-stages." .

cr:OversightStage a cr:TrialStage ;
    rdfs:label "Oversight" ;
    rdfs:comment "Risk-based monitoring, interim monitoring visits, source data verification, deviation identification and classification, CAPA management, audit. Operator primary: CRA + Sponsor Quality." .

# ── Stage 3: Closeout ────────────────────────────────────────────────────────

cr:CloseoutStage a cr:TrialStage ;
    rdfs:label "Closeout" ;
    rdfs:comment "From last patient last visit (LPLV) through regulatory submission and study archival. Includes database lock, CSR, and eTMF finalization." ;
    cr:containsStage
        cr:FollowUpStage ,
        cr:DataAnalysisStage ,
        cr:ReportingStage ,
        cr:ArchivalStage .

cr:FollowUpStage a cr:TrialStage ;
    rdfs:label "Follow-up" ;
    rdfs:comment "Post-treatment assessments, long-term safety evaluation, survival follow-up, adverse event monitoring through the follow-up window." .

cr:DataAnalysisStage a cr:TrialStage ;
    rdfs:label "Data Analysis" ;
    rdfs:comment "Database lock, data cleaning and validation, statistical analysis plan execution, longitudinal analysis, survival analysis, interim and final analyses." .

cr:ReportingStage a cr:TrialStage ;
    rdfs:label "Reporting" ;
    rdfs:comment "Clinical Study Report (CSR) authoring, regulatory submission package preparation, safety reporting, data disclosure." .

cr:ArchivalStage a cr:TrialStage ;
    rdfs:label "Archival" ;
    rdfs:comment "Site close-out visits, eTMF finalization, study archival, storage period compliance per country regulations." .
