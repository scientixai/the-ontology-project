@prefix cr: <https://top.scientix.ai/cr/v1#> .
@prefix hcls: <https://top.scientix.ai/hcls/v1#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix top: <https://top.scientix.ai/v1#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<https://top.scientix.ai/cr/v1/lims> a owl:Ontology ;
    dct:title "CR-core — laboratory & specimens" ;
    dct:description "Lab orders, assay definitions, specimens, custody chain, and assay results." .

cr:resultOfAssay a owl:ObjectProperty ;
    rdfs:label "result of assay" ;
    rdfs:comment "The assay (catalog test definition) this laboratory result was produced by. Renamed from cr:fromService — 'service' collides with non-lab concepts (first-principles P2 / ADR-0024 ambiguity gate)." ;
    rdfs:domain cr:AssayResult ;
    rdfs:range cr:AssayDefinition ;
    top:flavor "Additive" .

cr:fromState a owl:DatatypeProperty ;
    rdfs:label "from state" ;
    rdfs:domain cr:CustodyEvent ;
    top:flavor "Additive" .

cr:hasAliquot a owl:ObjectProperty ;
    rdfs:label "has aliquot" ;
    rdfs:comment "An aliquot partitioned from this specimen (forward of cr:aliquotOf)." ;
    rdfs:domain hcls:Specimen ;
    rdfs:range hcls:Specimen ;
    owl:inverseOf cr:aliquotOf ;
    top:flavor "Additive" .

cr:hasConsent a owl:ObjectProperty ;
    rdfs:label "has consent" ;
    rdfs:comment "The informed consent under which a participant-facing act was performed." ;
    rdfs:domain cr:StudyEvent ;
    rdfs:range cr:InformedConsent ;
    top:flavor "Additive" .

cr:hasCustodyEvent a owl:ObjectProperty ;
    rdfs:label "has custody event" ;
    rdfs:comment "A custody transition on this specimen (forward of cr:specimen, for single-pull retrieval)." ;
    rdfs:domain hcls:Specimen ;
    rdfs:range cr:CustodyEvent ;
    owl:inverseOf cr:specimen ;
    top:flavor "Additive" .

cr:onSpecimen a owl:ObjectProperty ;
    rdfs:label "on specimen" ;
    rdfs:comment "The specimen a lab order or assay result concerns. Renamed from cr:onSample for consistency with hcls:Specimen (operators say both; 'specimen' is the anchored term)." ;
    rdfs:range hcls:Specimen ;
    top:flavor "Additive" .

cr:precededByAct a owl:ObjectProperty ;
    rdfs:label "preceded by act" ;
    rdfs:comment "The assessment this act followed (executed ordering cite, e.g. the ECG before the draw)." ;
    rdfs:domain cr:StudyEvent ;
    rdfs:range cr:Assessment ;
    top:flavor "Additive" .

cr:producesSpecimen a owl:ObjectProperty ;
    rdfs:label "produces specimen" ;
    rdfs:comment "The primary specimen a collection act produced (forward of cr:collectedAt)." ;
    rdfs:domain cr:StudyEvent ;
    rdfs:range hcls:Specimen ;
    owl:inverseOf cr:collectedAt ;
    top:flavor "Additive" .

cr:ordersAssay a owl:ObjectProperty ;
    rdfs:label "orders assay" ;
    rdfs:comment "The assay this lab order requests. Renamed from cr:requestsService (P2/ambiguity)." ;
    rdfs:domain cr:LabOrder ;
    rdfs:range cr:AssayDefinition ;
    top:flavor "Additive" .

cr:toState a owl:DatatypeProperty ;
    rdfs:label "to state" ;
    rdfs:domain cr:CustodyEvent ;
    top:flavor "Additive" .

cr:yieldsResult a owl:ObjectProperty ;
    rdfs:label "yields result" ;
    rdfs:comment "An assay result that traces to this collection act (forward of cr:derivedFromCollection)." ;
    rdfs:domain cr:StudyEvent ;
    rdfs:range cr:AssayResult ;
    owl:inverseOf cr:derivedFromCollection ;
    top:flavor "Additive" .

cr:LabOrder a owl:Class ;
    rdfs:label "Lab Order" ;
    rdfs:comment "The order binding an assay to a specimen — what the operator calls 'the order'. Renamed from cr:AnalysisRequest: 'analysis request' collides with every non-lab sense of analysis (e.g. a manager asking for a site-performance analysis) — first-principles P2, ADR-0024 ambiguity gate." ;
    rdfs:subClassOf top:Temporal .

cr:aliquotOf a owl:ObjectProperty ;
    rdfs:label "aliquot of" ;
    rdfs:comment "Partition/aliquot lineage (a kind of prov:wasDerivedFrom)." ;
    rdfs:domain hcls:Specimen ;
    rdfs:range hcls:Specimen ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    top:flavor "Additive" .

cr:collectedAt a owl:ObjectProperty ;
    rdfs:label "collected at" ;
    rdfs:comment "The StudyEvent (e.g. blood draw) at which a primary specimen was collected." ;
    rdfs:domain hcls:Specimen ;
    rdfs:range cr:StudyEvent ;
    top:flavor "Additive" .

cr:derivedFromCollection a owl:ObjectProperty ;
    rdfs:label "derived from collection" ;
    rdfs:comment "The collection act a result ultimately traces to (lineage back-edge)." ;
    rdfs:domain cr:AssayResult ;
    rdfs:range cr:StudyEvent ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    top:flavor "Additive" .

cr:specimen a owl:ObjectProperty ;
    rdfs:label "specimen" ;
    rdfs:comment "The specimen this custody transition concerns." ;
    rdfs:domain cr:CustodyEvent ;
    rdfs:range hcls:Specimen ;
    top:flavor "Additive" .

cr:AssayDefinition a owl:Class ;
    rdfs:label "Assay Definition" ;
    rdfs:comment "Catalog definition of a laboratory test/assay (e.g. a biomarker assay) — the definitional pattern of cr:VisitDefinition and cr:DataElementDef applied to the lab. Renamed from cr:AnalysisService ('service' collides with service-provider and API senses)." ;
    rdfs:subClassOf top:Evidence .

cr:AssayResult a owl:Class ;
    rdfs:label "Assay Result" ;
    rdfs:comment "A measured laboratory result on a Specimen, joined to the StudySubject." ;
    rdfs:subClassOf hcls:Observation .

cr:CustodyEvent a owl:Class ;
    rdfs:label "Custody Event" ;
    rdfs:comment "A specimen state transition (SampleDue->Received->ToBeVerified->Verified->Published) — chain of custody." ;
    rdfs:subClassOf top:Temporal .


# ── Deprecated aliases (renamed for ambiguity, ADR-0024; removed after 2 MINORs) ─

cr:AnalysisRequest a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass cr:LabOrder ;
    rdfs:comment "Deprecated: renamed cr:LabOrder ('analysis request' collides with non-lab analysis requests)." .

cr:AnalysisService a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass cr:AssayDefinition ;
    rdfs:comment "Deprecated: renamed cr:AssayDefinition ('service' collides with service-provider/API senses)." .
