@prefix cr:     <https://top.scientix.ai/cr/v1#> .
@prefix hcls:   <https://top.scientix.ai/hcls/v1#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .
@prefix dct:    <http://purl.org/dc/terms/> .

#
# TOP CR — Thesaurus (Pipeline layers 1 & 4, per ADR-0024)
#
# The dialect layer: every known practitioner term for a modeled concept, so an
# operator (or an agent) searching in their own vocabulary finds the formal term.
# Posture (ADR-0024): cover dialects GENEROUSLY; gate only the high-ambiguity /
# high-cross-pattern terms on the watch-list at the end of this file, each of
# which carries an anti-synonym / context-routing note.
#
# Conventions:
#   skos:prefLabel  — the one preferred (operator) name; equals rdfs:label.
#   skos:altLabel   — practitioner dialects, acronyms, spelling variants.
#   skos:hiddenLabel— terms we ROUTE but do not promote: standards jargon
#                     (ResearchSubject, ItemData) and lay terms (side effect).
#   skosxl:altLabel — reified labels where provenance matters (who says this),
#                     carrying dct:source; used for the watch-list and for terms
#                     sourced from practitioner documents.
#
# Primary practitioner source for this seeding:
#   "Clinical Trial Operating Model" (operator source document, 2026-07),
#   abbreviated OPMODEL in dct:source below. Role aliases come from the OOUX
#   persona aliases already recorded in cr-core-roles.ttl (ROLES).
#

<https://top.scientix.ai/cr/v1/thesaurus> a owl:Ontology ;
    dct:title "TOP CR — operator thesaurus (dialects, acronyms, routing)" ;
    owl:versionInfo "1.0" ;
    rdfs:comment "Controlled-vocabulary + thesaurus layer for the CR domain (ADR-0024; first-principles P7 layers 1 and 4). Labels only — no classes or properties are defined here." .

# ── The participant (the ADR-0024 headline ruling) ───────────────────────────

cr:StudySubject
    skos:prefLabel "Participant"@en ;
    skos:altLabel "study participant"@en , "study subject"@en , "subject"@en ;
    skos:hiddenLabel "ResearchSubject"@en , "patient"@en ;
    skos:scopeNote "ADR-0024: 'Participant' is the preferred operator label for the pseudonymous in-study identity (IRI stays cr:StudySubject for stability). 'Patient' is routed but not promoted — industry drift toward 'patient' is noted; in clinical research the person is a participant, patient only in care contexts. The identifiable human is hcls:Person, never this class; the only bridge is the attested cr:Enrollment."@en ;
    skosxl:altLabel cr:xl-participant-patient .

cr:xl-participant-patient a skosxl:Label ;
    skosxl:literalForm "patient"@en ;
    dct:source "Industry drift observed by convener, 2026-07 (ADR-0024): 'There are indications that the industry is moving to patient, but for clinical research, participant should be the preferred label.'" ;
    skos:scopeNote "Routed to cr:StudySubject in study context; routed to hcls:Person in care-delivery context."@en .

hcls:Person
    skos:scopeNote "The identifiable human — PII, boundary-only. When an operator says 'participant' or 'patient' about in-study data, route to cr:StudySubject; this class is only for the site-sovereign identity behind the enrollment bridge."@en .

# ── Safety ───────────────────────────────────────────────────────────────────

cr:AdverseEvent
    skos:prefLabel "Adverse Event"@en ;
    skos:altLabel "AE"@en , "adverse experience"@en , "safety event"@en ;
    skos:hiddenLabel "side effect"@en , "adverse reaction"@en ;
    skos:scopeNote "'Side effect' (lay) and 'adverse reaction' (implies causality) are routed here but not promoted: an AE makes no causality claim — that is cr:CausalityAssessment."@en .

cr:SeriousAdverseEvent
    skos:prefLabel "Serious Adverse Event"@en ;
    skos:altLabel "SAE"@en .

cr:SUSAR
    skos:prefLabel "SUSAR"@en ;
    skos:altLabel "suspected unexpected serious adverse reaction"@en .

cr:SafetyReport
    skos:prefLabel "Safety Report"@en ;
    skos:altLabel "expedited report"@en , "15-day report"@en , "IND safety report"@en .

cr:CausalityAssessment
    skos:prefLabel "Causality Assessment"@en ;
    skos:altLabel "causality"@en , "relatedness"@en , "attribution"@en .

cr:DoseLimitingToxicity
    skos:prefLabel "Dose-Limiting Toxicity"@en ;
    skos:altLabel "DLT"@en .

