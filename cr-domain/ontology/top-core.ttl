@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix top:  <https://top.scientix.ai/v1#> .

#
# TOP Core — LOCAL WORKING STUB (non-authoritative)
#
# This file re-exports the subset of canonical TOP Core that the cr: domain
# references, so the cr-domain module set is self-contained: every top:
# superclass and property used by a cr module resolves inside this repo's
# ontology/ directory, and the merged dist artifact carries no dangling IRIs.
#
# The authoritative source is core/v1/modules/*.ttl in
# github.com/scientixai/the-ontology-project (Apache-2.0). On extraction of
# cr-domain to its own repository (ADR-0023), this stub is replaced by a
# pinned import of the published TOP Core artifact.
#
# Documented divergence (pending upstream alignment): the cr conventions'
# transaction-time envelope — top:recordedAt / top:supersededAt — and
# top:validTo are defined HERE, not in core/v1 (core's ADR-0021 vocabulary
# uses top:validFrom / top:validUntil and NGSI-LD createdAt/modifiedAt for
# transaction time). top:ProvenancedEntity is likewise a cr-conventions
# marker class not (yet) in core/v1. See conventions.md.
#

<https://top.scientix.ai/cr/v1/top-core-stub> a owl:Ontology ;
    dct:title "TOP Core — local working stub for the CR domain" ;
    owl:versionInfo "stub-of-core-v1" ;
    rdfs:comment "Non-authoritative re-export of the TOP Core terms the cr: domain references. Aligned to core/v1 (one top:CommonEntity root, eight Category-Level Objects, Universal DNA, ADR-0021 bitemporal vocabulary). Replaced by a pinned import at domain extraction (ADR-0023)." ;
    rdfs:seeAlso <https://github.com/scientixai/the-ontology-project> .

# ── Root ─────────────────────────────────────────────────────────────────────

top:CommonEntity a owl:Class ;
    rdfs:label "Common Entity" ;
    rdfs:comment "The single root above the eight Category-Level Objects. Everything modeled is, ultimately, a kind of CommonEntity, and carries the Universal DNA: identifier, observedAt, status." .

# ── The eight Category-Level Objects (CLOs) ──────────────────────────────────

top:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "CLO: an actor that can bear responsibility — person, organization, group, system, organism." ;
    rdfs:subClassOf top:CommonEntity .

top:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "CLO: a physical or virtual place." ;
    rdfs:subClassOf top:CommonEntity .

top:Resource a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:comment "CLO: a consumable or usable asset — material, equipment, storage." ;
    rdfs:subClassOf top:CommonEntity .

top:Scope a owl:Class ;
    rdfs:label "Scope" ;
    rdfs:comment "CLO: a unit of intent that bounds work — program, project, plan element." ;
    rdfs:subClassOf top:CommonEntity .

top:Temporal a owl:Class ;
    rdfs:label "Temporal" ;
    rdfs:comment "CLO: a time-anchored occurrence — activity, milestone, schedule, window." ;
    rdfs:subClassOf top:CommonEntity .

top:Outcome a owl:Class ;
    rdfs:label "Outcome" ;
    rdfs:comment "CLO: a result of activity — conclusion, status change, deliverable state." ;
    rdfs:subClassOf top:CommonEntity .

top:Evidence a owl:Class ;
    rdfs:label "Evidence" ;
    rdfs:comment "CLO: an information artifact that supports or records — document, observation, log, credential, attestation." ;
    rdfs:subClassOf top:CommonEntity .

top:Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "CLO: a rule that governs — regulatory law, physical limit, safety guardrail." ;
    rdfs:subClassOf top:CommonEntity .

# ── Referenced leaves / markers ──────────────────────────────────────────────

top:RegulatoryLaw a owl:Class ;
    rdfs:label "Regulatory Law" ;
    rdfs:comment "A legally-binding rule issued by a regulator (Constraint leaf)." ;
    rdfs:subClassOf top:Constraint .

top:Conclusion a owl:Class ;
    rdfs:label "Conclusion" ;
    rdfs:comment "A reasoned determination resting on evidence (Outcome leaf)." ;
    rdfs:subClassOf top:Outcome .

top:AutonomousAgent a owl:Class ;
    rdfs:label "Autonomous Agent" ;
    rdfs:comment "A software agent acting with delegated autonomy (Agent leaf)." ;
    rdfs:subClassOf top:Agent .

top:Versioned a owl:Class ;
    rdfs:label "Versioned" ;
    rdfs:comment "Marker for an immutable, bitemporally-tracked value-version (ADR-0021). Applied where Tier-1 entailment fires or where a workflow opts an attribute in." ;
    rdfs:subClassOf top:CommonEntity .

top:VersionSeries a owl:Class ;
    rdfs:label "Version Series" ;
    rdfs:comment "The stable identity root for a chain of top:Versioned snapshots (ADR-0021)." ;
    rdfs:subClassOf top:CommonEntity .

top:ProvenancedEntity a owl:Class ;
    rdfs:label "Provenanced Entity" ;
    rdfs:comment "cr-conventions marker: anything carrying the bitemporal + PROV envelope (exactly one observedAt, exactly one recordedAt, >=1 prov:wasAttributedTo). Enforced by top:BitemporalProvShape. Not yet in core/v1 — documented divergence, see the header of this file." ;
    rdfs:subClassOf top:CommonEntity .

# ── Universal DNA (identity · time · lifecycle) ──────────────────────────────

top:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    rdfs:comment "Universal DNA (identity): a stable identifier." ;
    rdfs:domain top:CommonEntity ;
    rdfs:range xsd:string .

top:observedAt a owl:DatatypeProperty ;
    rdfs:label "observed at" ;
    rdfs:comment "Universal DNA (time): valid-time instant; the canonical NGSI-LD term." ;
    rdfs:domain top:CommonEntity ;
    rdfs:range xsd:dateTime .

top:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:comment "Universal DNA (lifecycle): e.g. active, superseded, retired." ;
    rdfs:domain top:CommonEntity ;
    rdfs:range xsd:string .

# ── Bitemporal envelope (valid time + transaction time) ──────────────────────

top:validFrom a owl:DatatypeProperty ;
    rdfs:label "valid from" ;
    rdfs:comment "Valid time: when the fact starts being true in the world (ADR-0021)." ;
    rdfs:range xsd:dateTime .

top:validTo a owl:DatatypeProperty ;
    rdfs:label "valid to" ;
    rdfs:comment "Valid time: when the fact stops being true in the world. cr-conventions name; core/v1 (ADR-0021) spells this top:validUntil — documented divergence, see the header of this file." ;
    rdfs:range xsd:dateTime .

top:recordedAt a owl:DatatypeProperty ;
    rdfs:label "recorded at" ;
    rdfs:comment "Transaction time (append-only): when the system first knew the fact. cr-conventions extension not yet in core/v1 — documented divergence, see the header of this file." ;
    rdfs:range xsd:dateTime .

top:supersededAt a owl:DatatypeProperty ;
    rdfs:label "superseded at" ;
    rdfs:comment "Transaction time (append-only): when a later assertion superseded this one. A correction is a NEW assertion; this timestamp is never rewritten. cr-conventions extension not yet in core/v1 — documented divergence, see the header of this file." ;
    rdfs:range xsd:dateTime .

# ── Annotation & governance properties ───────────────────────────────────────

top:flavor a owl:AnnotationProperty ;
    rdfs:label "flavor" ;
    rdfs:comment "Extension-contract annotation (ADR-0019): how a term extends Core — 'Additive' (new term, no Core semantics changed), 'Specializing', or 'Constraining'." .

top:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by" ;
    rdfs:comment "Links an entity to the Constraint that governs it." ;
    rdfs:range top:Constraint .

top:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:comment "Links a Constraint to what it constrains." ;
    rdfs:domain top:Constraint .

top:promptTemplate a owl:DatatypeProperty ;
    rdfs:label "prompt template" ;
    rdfs:comment "AI inference provenance (canonical in core/v1/modules/top-ai.ttl): the verbatim prompt template behind an LLM-contributed Conclusion." ;
    rdfs:range xsd:string .

top:sourceContext a owl:DatatypeProperty ;
    rdfs:label "source context" ;
    rdfs:comment "AI inference provenance (canonical in core/v1/modules/top-ai.ttl): the verbatim retrieved context injected into the prompt. PII: upstream redaction applies." ;
    rdfs:range xsd:string .

top:modelVersion a owl:DatatypeProperty ;
    rdfs:label "model version" ;
    rdfs:comment "AI inference provenance (canonical in core/v1/modules/top-ai.ttl): the LLM name + version/hash that produced the conclusion." ;
    rdfs:range xsd:string .

top:rationale a owl:DatatypeProperty ;
    rdfs:label "rationale" ;
    rdfs:comment "The recorded reasoning behind a decision or conclusion." ;
    rdfs:range xsd:string .
