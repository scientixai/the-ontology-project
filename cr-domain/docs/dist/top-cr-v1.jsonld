  {
    "@id": "https://top.scientix.ai/cr/v1#eCTDSubmission",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Module 5 (clinical) is what this reference reaches; earlier modules (quality, nonclinical) are out of scope. The submission must be built on a HARD database lock \u2014 submitting on reversible (soft-locked) data is inadmissible."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "eCTD Submission"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "BLA"
      },
      {
        "@language": "en",
        "@value": "NDA"
      },
      {
        "@language": "en",
        "@value": "filing"
      },
      {
        "@language": "en",
        "@value": "marketing application"
      },
      {
        "@language": "en",
        "@value": "submission"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An electronic Common Technical Document submission to a regulator (e.g. NDA / BLA / MAA). Modeled as a manifest that references the locked, already-produced content \u2014 the Clinical Study Report, the analysis datasets, and the Define-XML \u2014 not a re-authored copy of any of it."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "eCTD Submission"
      }
    ]
  },
