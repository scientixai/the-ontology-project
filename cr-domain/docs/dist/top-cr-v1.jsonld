  {
    "@id": "https://top.scientix.ai/cr/v1#KeyRiskIndicator",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Operational and leading, in contrast to the trial-level cr:QualityToleranceLimit which is systemic. A KRI should trace to the CtQ factor it protects (cr:informsFactor) \u2014 a KRI with no CtQ ancestry is measurement theater."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Key Risk Indicator"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "KRI"
      },
      {
        "@language": "en",
        "@value": "quality metric"
      },
      {
        "@language": "en",
        "@value": "risk indicator"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A site- or data-domain-level leading metric used to detect localized performance degradation early \u2014 screen-failure rate, eCRF entry cycle time, query aging, deviation rate. Breaches trigger targeted monitoring intervention, not (by themselves) CSR reporting."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Key Risk Indicator"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#KitAssignment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The kit number is what the site sees; the arm behind it stays with the randomization system. Dispensing (cr:DispensingEvent, supply module) cites the kit."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Kit Assignment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "blinded kit"
      },
      {
        "@language": "en",
        "@value": "kit number"
      },
      {
        "@language": "en",
        "@value": "kit"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The assignment of a blinded kit (numbered container of investigational product or comparator) to a randomized participant \u2014 the mechanism that operationalizes the blind."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hiddenLabel": [
      {
        "@language": "en",
        "@value": "IRT"
      },
      {
        "@language": "en",
        "@value": "IWRS"
      },
      {
        "@language": "en",
        "@value": "IxRS"
      },
      {
        "@language": "en",
        "@value": "RTSM"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Kit Assignment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "IxRS / IWRS / IRT / RTSM name the SYSTEM that performs randomization and supply; its recorded acts are cr:RandomizationEvent and cr:KitAssignment."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#LabOrder",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The order binding an assay to a specimen \u2014 what the operator calls 'the order'. Renamed from cr:AnalysisRequest: 'analysis request' collides with every non-lab sense of analysis (e.g. a manager asking for a site-performance analysis) \u2014 first-principles P2, ADR-0024 ambiguity gate."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Lab Order"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "lab request"
      },
      {
        "@language": "en",
        "@value": "order"
      },
      {
        "@language": "en",
        "@value": "test order"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hiddenLabel": [
      {
        "@language": "en",
        "@value": "AnalysisRequest"
      },
      {
        "@language": "en",
        "@value": "analysis request"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Lab Order"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Renamed from cr:AnalysisRequest (ADR-0024 ambiguity gate): 'analysis request' collides with every non-lab sense \u2014 a manager requesting a site-performance analysis is not a lab order."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#LastPatientLastVisit",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
