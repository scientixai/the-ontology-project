    "@id": "https://top.scientix.ai/cr/v1#SiteActivationStage",
    "@type": [
      "https://top.scientix.ai/cr/v1#TrialStage"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Study Startup Package readiness, Site Initiation Visit (SIV), training, delegation of authority, equipment qualification. Output: site activated and ready to enroll. (The stage; the green-light act itself is cr:SiteActivation.)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Site Activation"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteBoundary",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Site"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteClosure",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A promoted fact (P6): 'isClosed' is never a flag. Closure without its evidence (COV + reconciliations complete) is a Violation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Site Closure"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "closure"
      },
      {
        "@language": "en",
        "@value": "site closed"
      },
      {
        "@language": "en",
        "@value": "site closeout"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The record that a site's participation in the study has ended \u2014 resting on the Close-Out Visit and the completed reconciliations."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Site Closure"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteCoordinator",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The day-to-day clinical operations professional at a Site. Screens and enrolls participants, executes visits, completes CRFs, manages AE reporting, and maintains site logs. Also known as Clinical Research Coordinator (CRC). OOUX persona aliases: Coordinator, Study Coordinator, CRC."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Site Coordinator"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Practitioner"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "CRC"
      },
      {
        "@language": "en",
        "@value": "coordinator"
      },
      {
        "@language": "en",
        "@value": "research coordinator"
      },
      {
        "@language": "en",
        "@value": "study coordinator"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Site Coordinator"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "ROLES: OOUX persona aliases."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteInitiationVisit",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The visit that prepares and activates a site for enrollment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Site Initiation Visit (SIV)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "SIV"
      },
      {
        "@language": "en",
        "@value": "initiation visit"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Site Initiation Visit"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteMetrics",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A periodic KPI snapshot for a study site; bitemporal (top:observedAt = snapshot date, top:validFrom = reporting period start)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Site Metrics"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteRegulatoryStage",
    "@type": [
      "https://top.scientix.ai/cr/v1#TrialStage"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "IND/CTA filing, IRB/EC review, country-level submissions, amendment management. Output: regulatory clearance per country."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Site Regulatory"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteSelectionDecision",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A recorded, provenance-tagged decision about a study site at a specific lifecycle transition. Captures both positive (Selected, Reserve) and negative (Dropped) outcomes with mandatory rationale. The negative path \u2014 why a site was not selected \u2014 is institutional intelligence that is almost never captured in practice today but is essential for: (a) sponsor learning across studies, (b) avoiding repeat qualification of unsuitable sites, (c) CRO accountability. Bitemporal (top:Versioned) because decisions can be revised (a Dropped site can become Reserve under rescue conditions)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Site Selection Decision"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteSelectionStage",
    "@type": [
      "https://top.scientix.ai/cr/v1#TrialStage"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Feasibility assessment, site evaluation, qualification visit (SQV), site selection committee review. Output: selected site list with signed contracts."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Site Selection"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteStatusActive",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Site is actively enrolling or conducting the trial (post-SIV, first subject possible or enrolled)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Active"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteStatusClosed",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Site close-out visit completed; no further subject activity; eTMF finalization in progress."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Closed"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteStatusDropped",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Site was not selected or was withdrawn after selection. The reason MUST be captured in a cr:SiteSelectionDecision \u2014 this is institutional intelligence almost never recorded today."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Dropped"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteStatusFeasibility",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Site is under feasibility assessment: SQV scheduled or completed, selection committee review pending."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Feasibility"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteStatusReserve",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Site has passed feasibility but is held in reserve as a rescue site. Sponsor may activate it if enrollment falls short at active sites. Distinct from Selected: no startup work has begun."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Reserve"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteStatusSelected",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Site has been selected: contracts signed, Study Startup Package in preparation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Selected"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SiteStatusStartup",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Site Initiation Visit completed or in progress; staff training, delegation of authority, equipment qualification underway."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Startup"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SourceData",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://www.ich.org/page/efficacy-guidelines"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Source Data"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "original data"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The original recorded information, and certified copies of it, needed to reconstruct and evaluate the trial (paraphrased, ICH E6(R3))."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Source Data"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SourceDocument",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://www.ich.org/page/efficacy-guidelines"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Source Document"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/cr/v1#EssentialRecord"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "source doc"
      },
      {
        "@language": "en",
        "@value": "source"
      },
      {
        "@language": "en",
        "@value": "worksheet"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The original document/record holding source data (paraphrased, ICH E6(R3))."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Source Document"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Sponsor",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The organization that initiates and is accountable for the trial."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Sponsor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Organization"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SponsorBoundary",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Sponsor"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SponsorOperationsStaff",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Manages protocol amendments, site network structure, regions, country configuration, site activation mechanics, and system configuration. OOUX persona aliases: Sponsor Operations, Sponsor Ops, Site Activation Manager."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Sponsor Operations"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SponsorProjectManager",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Creates and activates studies, selects and manages sites, tracks milestones and enrollment, and closes studies. OOUX persona aliases: Sponsor PM, Study PM, Project Manager, Study Manager."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Sponsor Project Manager"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#SponsorQualityStaff",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Classifies, approves, and closes deviations. Conducts audits and risk assessments; manages CAPAs. OOUX persona aliases: Sponsor Quality, Quality, Auditor."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Sponsor Quality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#StartVisit",
    "@type": [
      "https://top.scientix.ai/hcls/v1#Action"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Start Visit"
      }
    ],
    "https://top.scientix.ai/cr/v1#occursInStage": [
      {
        "@id": "https://top.scientix.ai/cr/v1#VisitExecutionStage"
      }
    ],
    "https://top.scientix.ai/hcls/v1#authorizedAgentType": [
      {
        "@id": "https://top.scientix.ai/cr/v1#SiteCoordinator"
      }
    ],
    "https://top.scientix.ai/hcls/v1#operatesOn": [
      {
        "@id": "https://top.scientix.ai/cr/v1#VisitOccurrence"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#StartupArtifact",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A document instance in (or produced from) the start-up package, classified to a TMF artifact type. Carries the data that the work streams consume and transform."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Start-up Artifact"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#StartupStage",
    "@type": [
      "https://top.scientix.ai/cr/v1#TrialStage"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Everything from initial protocol design through first-patient-in (FPI). Gate condition: first participant randomized. Canonical ICH E6(R3) pre-trial period."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Startup"
      }
    ],
    "https://top.scientix.ai/cr/v1#containsStage": [
      {
        "@id": "https://top.scientix.ai/cr/v1#SiteActivationStage"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#SiteRegulatoryStage"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#SiteSelectionStage"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#StudyDesignStage"
      }
    ],
    "https://top.scientix.ai/cr/v1#precedesStage": [
      {
        "@id": "https://top.scientix.ai/cr/v1#ConductStage"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#StatisticalAnalysisPlan",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The pre-specified plan for analyzing the study's data."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Statistical Analysis Plan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "SAP"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Statistical Analysis Plan"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#StoppingRule",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A safety rule that halts dosing or enrollment when triggered."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Stopping Rule"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "futility rule"
      },
      {
        "@language": "en",
        "@value": "safety stopping boundary"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Stopping Rule"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Study",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A clinical study \u2014 the unit of investigation the protocol defines."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Study"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "clinical study"
      },
      {
        "@language": "en",
        "@value": "clinical trial"
      },
      {
        "@language": "en",
        "@value": "protocol"
      },
      {
        "@language": "en",
        "@value": "trial"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Study"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "'Protocol' is routed here when the speaker means the study itself ('this protocol is enrolling'); the versioned protocol document is cr:ProtocolVersion."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#StudyDesignStage",
    "@type": [
      "https://top.scientix.ai/cr/v1#TrialStage"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Protocol authoring, statistical analysis plan, SoA construction, CRF design, arm configuration, endpoint definition. Output: approved protocol version."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Study Design"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#StudyEvent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A scheduled or unscheduled timepoint (StudyEventOID) when data is captured."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Study Event"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#StudySite",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An investigative site conducting the study (an organization at a facility)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Study Site"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Organization"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "clinical site"
      },
      {
        "@language": "en",
        "@value": "investigative site"
      },
      {
        "@language": "en",
        "@value": "research site"
      },
      {
        "@language": "en",
        "@value": "site"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Study Site"
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#altLabel": [
      {
        "@id": "https://top.scientix.ai/cr/v1#xl-site"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#StudyStartupPackage",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The bundle of document artifacts a site receives on being awarded a study. Not a singular item \u2014 a set of typed artifacts; in practice fetched one-by-one from sponsor portals."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Study Start-up Package"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "award package"
      },
      {
        "@language": "en",
        "@value": "site package"
      },
      {
        "@language": "en",
        "@value": "startup package"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Study Startup Package"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#StudySubject",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The pseudonymous in-study participant identity. Linked to an hcls:Person via the bitemporal cr:Enrollment act (the sensitive bridge); carries no PII. Preferred label 'Participant' per ADR-0024 (operator vocabulary, first-principles P2); the IRI stays cr:StudySubject for stability. The PII boundary is held by homonym routing, not the label: 'Participant' names this pseudonymous identity, never the identifiable hcls:Person."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Participant"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Agent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "study participant"
      },
      {
        "@language": "en",
        "@value": "study subject"
      },
      {
        "@language": "en",
        "@value": "subject"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hiddenLabel": [
      {
        "@language": "en",
        "@value": "ResearchSubject"
      },
      {
        "@language": "en",
        "@value": "patient"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Participant"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "ADR-0024: 'Participant' is the preferred operator label for the pseudonymous in-study identity (IRI stays cr:StudySubject for stability). 'Patient' is routed but not promoted \u2014 industry drift toward 'patient' is noted; in clinical research the person is a participant, patient only in care contexts. The identifiable human is hcls:Person, never this class; the only bridge is the attested cr:Enrollment."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#altLabel": [
      {
        "@id": "https://top.scientix.ai/cr/v1#xl-participant-patient"
      }
    ]
  },
  {
