      {
        "@language": "en",
        "@value": "satisfies constraint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Tightenable"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#severityLevel",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Operational impact of violation. Universal enum \u2014 INFORMATIONAL / MINOR / MAJOR / CRITICAL. Workflow extensions can refine."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "severity level"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Tightenable"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#signedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links the Evidence to the Agent who attested to its truth. E-signature semantics (21 CFR Part 11) and PROV attribution."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
