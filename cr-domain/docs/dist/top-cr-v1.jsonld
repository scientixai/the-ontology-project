    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Suspected Unexpected Serious Adverse Reaction \u2014 requires expedited regulatory reporting (7 days fatal/life-threatening, 15 days other). ADR-0024 known deviation: 'suspected' (causality) and 'unexpected' (vs. reference safety information) are judgments against criteria; refactors together with cr:SeriousAdverseEvent in the dedicated safety-module pass."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "SUSAR"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/cr/v1#SeriousAdverseEvent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "suspected unexpected serious adverse reaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "SUSAR"
      }
    ]
  },
