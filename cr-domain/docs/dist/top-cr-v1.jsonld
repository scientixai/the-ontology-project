        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#witnessedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The person who witnessed the consent signing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/cr/v1#InformedConsent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "witnessed by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-agent",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "First-principles P7 CV-obligations (anti-synonym example)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "ANTI-SYNONYM: pharmacological 'agent' (the drug/substance) is NOT top:Agent (an actor bearing responsibility). Route drug-sense to cr:InvestigationalProduct / hcls:Substance; actor-sense to top:Agent."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "agent"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-arm",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "OPMODEL \u00a71.1 Study Design"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: treatment arm (cr:Arm) vs the anatomical arm (blood-draw laterality, injection site). Study-design context routes to cr:Arm; clinical-procedure context is anatomical."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "arm"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-monitor",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "OPMODEL \u00a72.5 Oversight; ROLES persona aliases"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: the person (cr:ClinicalResearchAssociate), the visit (monitoring visit), the discipline (risk-based / central / medical monitoring \u2014 distinct capabilities), and the verb. Default routing: the CRA role; qualify otherwise."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "monitor"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-participant-patient",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Industry drift observed by convener, 2026-07 (ADR-0024): 'There are indications that the industry is moving to patient, but for clinical research, participant should be the preferred label.'"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Routed to cr:StudySubject in study context; routed to hcls:Person in care-delivery context."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "patient"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-screen",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "OPMODEL \u00a72.2 Recruitment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: eligibility screening (the recruitment-funnel activity \u2014 vocabulary lands with the funnel model, a declared V1 deferral) vs screen failure vs the UI screen. No default routing; qualify."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "screen"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-site",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "OPMODEL \u00a71.4 Site Selection"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: the investigative site (cr:StudySite, an organization) vs bfo:Site / top:Location (a place) vs injection/body site vs website. Default routing in this domain: cr:StudySite."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "site"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-subject",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "First-principles P7 CV-obligations (homonym-routing example); OPMODEL"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: human-research 'subject' routes to cr:StudySubject (prefLabel Participant, ADR-0024); animal-research 'subject' is out of this domain; grammatical/email 'subject' is noise. Never route to hcls:Person."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "subject"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#yieldsDesign",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The Phase3Design a 'go' (or 'go-with-modification') decision produces \u2014 the consequence edge that makes a go-decision actionable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/cr/v1#AnalysisDecision"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "yields design"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/cr/v1#Phase3Design"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#yieldsResult",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An assay result that traces to this collection act (forward of cr:derivedFromCollection)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/cr/v1#StudyEvent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "yields result"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/cr/v1#AssayResult"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://top.scientix.ai/cr/v1#derivedFromCollection"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/gcp",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/rights": [
      {
        "@value": "Independent derivative adaptation of the ICH E6(R3) Guideline. The classes, properties, and SKOS concepts here are an adaptation (structure + paraphrased definitions), not a reproduction. NOT endorsed or sponsored by ICH. The original ICH E6(R3) document is copyright \u00a9 ICH."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "ICH E6(R3) Good Clinical Practice (Step 4, adopted January 2025): Principles, Glossary, and Annex 1 (interventional trials). Annex 2 (additional/non-traditional data sources) is NOT modeled in this version."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Changes made: ICH E6(R3) terms are reorganized into an OWL/SKOS structure, definitions are paraphrased, and obligations are expressed as SHACL shapes rather than encoded text. Each derived term carries rdfs:isDefinedBy the ICH efficacy-guidelines source."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TOP CR \u2014 ICH E6(R3) GCP definitional layer"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/participant",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Extends CR-core with InformedConsent enrichment (US-500-003): consentVersion, consentFormIRI, witnessedBy, withdrawalDate. Property-only module: the classes these properties describe (cr:InformedConsent, cr:StudySubject, cr:Enrollment, cr:EligibilityCriterion) are defined once, in cr-core.ttl."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core ontology \u2014 participant & consent module"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.5"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/thesaurus",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "TOP CR \u2014 operator thesaurus (dialects, acronyms, routing)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Controlled-vocabulary + thesaurus layer for the CR domain (ADR-0024; first-principles P7 layers 1 and 4). Labels only \u2014 no classes or properties are defined here."
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/top-core-stub",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "TOP Core \u2014 local working stub for the CR domain"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Non-authoritative re-export of the TOP Core terms the cr: domain references. Aligned to core/v1 (one top:CommonEntity root, eight Category-Level Objects, Universal DNA, ADR-0021 bitemporal vocabulary). Replaced by a pinned import at domain extraction (ADR-0023)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://github.com/scientixai/the-ontology-project"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "stub-of-core-v1"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "OWNED, provenance-tagged crosswalks from TOP/CR-core to external ontologies. Aligns to SSSOM slots (subject_id/predicate_id/object_id/mapping_justification/confidence/author_id/mapping_date); an SSSOM TSV is an edge projection of these. Crosswalks are assertions WE own and curate, never imports of the external ontology."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TOP crosswalk vocabulary (SSSOM-aligned)"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#Mapping",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A curated, provenanced correspondence from a TOP term to an external ontology term."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Crosswalk Mapping"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#author",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The curator/agent IRI (SSSOM author_id)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "author id"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#confidence",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "confidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#confirmedAt",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Timestamp when a mapping was confirmed by a human reviewer. Together with cx:confirmedBy, closes the audit trail for human-in-the-loop validation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "confirmed at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#confirmedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The human agent (or committee) that reviewed and confirmed a proposed mapping. Required for promotion from 'under_review' to 'confirmed'."
      },
      {
        "@value": "The human curator (prov:Person IRI) who reviewed and approved an LLM-inferred mapping. Required before verificationStatus may be set to 'verified'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/crosswalk/v1#Mapping"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "confirmed by"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#inferredBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The LLM agent (prov:SoftwareAgent IRI) that produced this mapping candidate. Presence triggers the SHACL HITL gate."
      },
      {
        "@value": "The top:AutonomousAgent instance that proposed this mapping via LLM inference. Enables provenance tracing back to the agent model and prompt version."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/crosswalk/v1#Mapping"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "inferred by"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#justification",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A semapv justification IRI (e.g. ManualMappingCuration)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "mapping justification"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#mappingDate",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "mapping date"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#date"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#mappingMethod",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Free-text tag describing how the mapping was produced. Controlled values: 'ManualCuration', 'LLMInference', 'LexicalMatching', 'LogicalReasoning'."
      },
      {
        "@value": "How the mapping was produced: ManualCuration | LLMInference | RuleBasedExtraction | HybridReview. Drives downstream trust and routing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/crosswalk/v1#Mapping"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "mapping method"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#mappingRationale",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Human-readable explanation of why this mapping was proposed, especially for LLM-inferred mappings. Mirrors top:rationale on a Conclusion."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "mapping rationale"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#objectId",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The external ontology term (right side)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "object id"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#predicateId",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "SKOS mapping predicate."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "predicate id"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#retrievedFrom",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The primary source the target IRI was verified against (URL + retrieval date)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "retrieved from"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#reviewStatus",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Lifecycle state of the mapping: proposed | under_review | confirmed | rejected | deprecated. Confirmed mappings graduate from ephemeral inference to Layer-2 crosswalk."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "review status"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#subjectId",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The TOP/CR-core term (left side)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "subject id"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#verificationStatus",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "verified | unverified | deprecated \u2014 whether the target IRI was confirmed against a primary source."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "verification status"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Mid-layer specializing TOP Core for entities that recur across >=2 HCLS domains (clinical research, hospital, manufacturing, pharmacovigilance, RWE, commercialization). Seeded minimally; grows by promotion (rule of three). Standards projection target: FHIR, OMOP."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "HCLS-core"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Action",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A named, authorized operation (Call To Action in OOUX terms) that an agent of a given type may perform in a given Phase. Actions are reference-graph archetypes (top:Constraint: they specify what is authorized). Realized occurrences in instance graphs are prov:Activity individuals linked back via hcls:realizationOf."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Action"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Clinician",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A licensed clinician who provides or oversees clinical care or research. Specializes in sub-domains: Investigator (clinical research), Physician (clinical care), Pharmacist, etc."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Clinician"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Practitioner"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Condition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A diagnosed state of a Person."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Consent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An act of agreement by a Person authorizing an action or use of their data/person. HCLS-universal: permutates to cr:InformedConsentAct (clinical trial enrollment), HIPAA Authorization (data use), Treatment Consent (clinical care). Carries valid-time (when consent was given, when it expires) and transaction-time (when it was recorded)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Consent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#HealthcareFacility",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A physical place where care or research is conducted."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Healthcare Facility"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Location"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#JobToBeDone",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A bounded unit of operator intent: the goal an agent type is trying to achieve, with a trigger condition and measurable success signals. Scoped to an agent type (OWL class) and a Phase. References the object graph and authorized Actions involved. Derived from OOUX JTBD blocks."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Job to Be Done"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Lot",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A manufactured batch/lot; the primary join to the manufacturing domain."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Lot"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Resource"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#MedicinalProduct",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A medicinal product (drug or biologic)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Medicinal Product"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Resource"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Observation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An information artifact recording a measured value; refersTo the Person/Specimen it is about."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Organization",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An organization \u2014 sponsor, CRO, site, central lab, or regulator."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Organization"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Agent"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Person",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A human. BOUNDARY-ONLY / PII layer: an identifiable Person lives inside the source/site sovereign boundary. Downstream and shareable artifacts must attach to a pseudonymous cr:StudySubject, never to a Person. The only legal Person<->Subject link is the attested Enrollment bridge (cr:enrolledPerson). Clinical data is PSEUDONYMIZED, not anonymized: re-identification is preserved but controlled (safety / emergency unblinding)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Person"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Agent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The identifiable human \u2014 PII, boundary-only. When an operator says 'participant' or 'patient' about in-study data, route to cr:StudySubject; this class is only for the site-sovereign identity behind the enrollment bridge."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Phase",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A bounded, sequenced stage of a process lifecycle within an HCLS domain. Phases form a containment tree (hcls:contains) and a precedence chain (hcls:precedes). Permutates to: cr:StartupPhase/ConductPhase/CloseoutPhase (clinical research); Admission/Inpatient/Discharge (clinical care); Formulation/Fill-Finish/Release (manufacturing)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Phase"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Practitioner",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A healthcare professional."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Practitioner"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Specimen",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A biospecimen collected from a Person."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specimen"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Resource"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "aliquot"
      },
      {
        "@language": "en",
        "@value": "biospecimen"
      },
      {
        "@language": "en",
        "@value": "blood sample"
      },
      {
        "@language": "en",
        "@value": "sample"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Specimen"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Substance",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A chemical or biological substance."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Substance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Resource"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#actsAs",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "At instance-graph time, a human-readable label for the contextual role a Person plays within a Scope (Study, Site, Care Episode). Not a class; purely a string annotation on the Person-Scope binding. Example value: 'Principal Investigator'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "acts as"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#affiliatedWith",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "affiliated with"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Organization"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#authorizedAgentType",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The OWL class of agent authorized to execute this Action. Authorization binds directly to agent type \u2014 no OperatorRole intermediary. Multi-valued: an Action may be authorized for more than one agent type."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Action"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "authorized agent type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#collectedFrom",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Specimen"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "collected from"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#consentSubject",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Consent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "consent subject"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#contains",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Containment: a phase contains its named sub-phases. Transitive; used to derive the top-level phase for any sub-phase."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Phase"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "contains"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Phase"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#executesAction",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An Action performed as part of accomplishing this job."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#JobToBeDone"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "executes action"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Action"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#givesConsent",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "gives consent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Consent"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#involvesObject",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An entity class that participates in this job's object graph."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#JobToBeDone"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "involves object"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#jobOfAgentType",
    "@type": [
