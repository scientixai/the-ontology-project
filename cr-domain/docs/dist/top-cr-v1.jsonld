  {
    "@id": "https://top.scientix.ai/cr/v1#MetricObservation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The bitemporal envelope is what answers the inspector's question 'why didn't the algorithm flag the March 1 event on March 3?' \u2014 because recordedAt shows the event had not yet arrived."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Metric Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "CSM metric"
      },
      {
        "@language": "en",
        "@value": "KRI reading"
      },
      {
        "@language": "en",
        "@value": "centralized monitoring output"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A computed value of a monitored quality parameter at a point in time \u2014 the output of a centralized-monitoring run. Attributed (prov:wasAttributedTo) to the computing agent, typically a system agent; bitemporal, so 'what did the algorithm know on March 3' is a filter, not an excavation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Metric Observation"
      }
    ]
  },
  {
