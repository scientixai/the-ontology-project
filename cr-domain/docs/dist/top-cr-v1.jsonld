  {
    "@id": "https://top.scientix.ai/cr/v1#AnalysisDataset",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Must declare prov:wasDerivedFrom its source so any result built on it is reproducible to source. Its ADaM structure (ADSL/BDS/OCCDS) is cr:datasetStructure \u2014 a value, not a subclass (ADR-0024 one-question gate)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Analysis Dataset (ADaM)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "ADaM dataset"
      },
      {
        "@language": "en",
        "@value": "analysis data"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An ADaM analysis dataset (e.g. ADSL, ADAE, ADEFF) \u2014 analysis-ready data derived from the native clinical facts, structured per a CDISC ADaM structure class."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Analysis Dataset"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#AnalysisDecision",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Makes the decision a first-class, evidenced node rather than a free-text cr:meetingOutcome. The decision is bitemporal: superseding a decision (e.g. a later reversal) is a new assertion, never a rewrite."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Analysis Decision (gate)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "gate decision"
      },
      {
        "@language": "en",
        "@value": "go decision"
      },
      {
        "@language": "en",
        "@value": "go/no-go"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A determinate go / no-go (or modify) decision taken at a study gate on the basis of analysis outputs. The End-of-Phase-2 decision is the canonical instance: a coded verdict that rests on the evidence (TLFs / endpoint results) and yields a consequence (a proposed Phase 3 design, or a stop)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Analysis Decision"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#AnalysisRequest",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Deprecated: renamed cr:LabOrder ('analysis request' collides with non-lab analysis requests)."
      }
    ],
    "http://www.w3.org/2002/07/owl#deprecated": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": true
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "https://top.scientix.ai/cr/v1#LabOrder"
      }
    ]
  },
