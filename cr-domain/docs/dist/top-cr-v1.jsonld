  {
    "@id": "https://top.scientix.ai/cr/v1#OperationalRecord",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Non-clinical, non-GCP-governed data captured during trial operations \u2014 process metrics, site performance indicators, sponsor-defined operational fields (e.g. X_WHATEVER extensions in Medidata). Not an hcls:Observation (no clinical value) and not directly regulated by ICH E6; captured in operational CRFs or sponsor-specific payloads. Primary target for LLM-assisted field-mapping inference (cr:mappingConfidence)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Operational Record"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#OverseeStudyConductAtSite",
    "@type": [
      "https://top.scientix.ai/hcls/v1#JobToBeDone"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Hold legal responsibility for trial conduct at the Site"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "PI-J01"
      }
    ],
    "https://top.scientix.ai/hcls/v1#executesAction": [
      {
        "@id": "https://top.scientix.ai/cr/v1#AddInvestigatorDelegation"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#RefreshGCPTraining"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#UpdateFCOIDisclosure"
      }
    ],
    "https://top.scientix.ai/hcls/v1#involvesObject": [
      {
        "@id": "https://top.scientix.ai/cr/v1#Credential"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#Delegation"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#Study"
      }
    ],
    "https://top.scientix.ai/hcls/v1#jobOfAgentType": [
      {
        "@id": "https://top.scientix.ai/cr/v1#Investigator"
      }
    ],
    "https://top.scientix.ai/hcls/v1#jobTrigger": [
      {
        "@value": "Site selected for a Study; PI designated as Principal Investigator."
      }
    ],
    "https://top.scientix.ai/hcls/v1#successSignal": [
      {
        "@value": "GCP training current throughout the Study."
      },
      {
        "@value": "No regulatory or sponsor actions escalated to debarment."
      },
      {
        "@value": "Regulatory investigator-commitment form on file (e.g. Form FDA 1572 in the US; jurisdiction-equivalent elsewhere)."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#OversightStage",
    "@type": [
      "https://top.scientix.ai/cr/v1#TrialStage"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Risk-based monitoring, interim monitoring visits, source data verification, deviation identification and classification, CAPA management, audit. Operator primary: CRA + Sponsor Quality."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Oversight"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#ParticipantSchedule",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The schedule projected for a specific subject from a ScheduleTimeline once an anchor date (e.g. enrollment) is known. Bitemporal: re-projected when the governing protocol version changes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Participant Schedule"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#PharmacovigilianceSpecialist",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Manages safety signal detection, expedited SAE reporting, safety line listings, and periodic safety reports (DSUR, PSUR). OOUX persona aliases: Pharmacovigilance, PV."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Pharmacovigilance Specialist"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "PV"
      },
      {
        "@language": "en",
        "@value": "drug safety"
      },
      {
        "@language": "en",
        "@value": "safety specialist"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Pharmacovigilance Specialist"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Phase1",
    "@type": [
      "https://top.scientix.ai/cr/v1#TrialPhase"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Purpose: initial human safety, tolerability, dosing (dose escalation, MTD), and pharmacokinetics \u2014 not efficacy. Size: small (typically 20\u2013100), healthy volunteers or, in oncology, patients. Sites: specialized Phase-1 units with intensive-monitoring capability, usually a handful. Device-world names: feasibility / pilot / early feasibility study."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Phase 1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "FIH"
      },
      {
        "@language": "en",
        "@value": "early feasibility study"
      },
      {
        "@language": "en",
        "@value": "early-stage study"
      },
      {
        "@language": "en",
        "@value": "feasibility study"
      },
      {
        "@language": "en",
        "@value": "first-in-human"
      },
      {
        "@language": "en",
        "@value": "phase I"
      },
      {
        "@language": "en",
        "@value": "pilot study"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Phase2",
    "@type": [
      "https://top.scientix.ai/cr/v1#TrialPhase"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Purpose: preliminary efficacy signal and dose selection (dose-ranging; ends at the EOP2 gate this model treats as the analysis decision node), continued safety. Size: moderate (typically 100\u2013300 patients with the condition). Sites: academic and specialty investigative sites, tens of sites."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Phase 2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "dose-finding study"
      },
      {
        "@language": "en",
        "@value": "phase II"
      },
      {
        "@language": "en",
        "@value": "proof-of-concept study"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Phase3",
    "@type": [
      "https://top.scientix.ai/cr/v1#TrialPhase"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Purpose: confirmatory efficacy and safety versus control \u2014 the evidence a marketing application rests on. Size: large (typically 300\u20133,000+). Sites: broad multi-site, multi-region networks including community sites. Device-world name: pivotal study (the pre-market confirmatory trial, akin to a Phase 3 drug trial)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Phase 3"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "confirmatory trial"
      },
      {
        "@language": "en",
        "@value": "late-stage study"
      },
      {
        "@language": "en",
        "@value": "phase III"
      },
      {
        "@language": "en",
        "@value": "pivotal study"
      },
      {
        "@language": "en",
        "@value": "pre-market pivotal study"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Phase3Design",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A proposed Phase 3 trial design taken to the EOP2 meeting."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Proposed Phase 3 Design"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Phase4",
    "@type": [
      "https://top.scientix.ai/cr/v1#TrialPhase"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Purpose: real-world safety and effectiveness after approval \u2014 rare adverse events, long-term outcomes, use in broader populations; often a post-marketing commitment. Size: large to very large. Sites: routine-care settings. Device-world name: post-market surveillance study."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Phase 4"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "PMS study"
      },
      {
        "@language": "en",
        "@value": "phase IV"
      },
      {
        "@language": "en",
        "@value": "post-market surveillance study"
      },
      {
        "@language": "en",
        "@value": "post-marketing study"
      }
    ]
  },
