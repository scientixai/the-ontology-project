  {
    "@id": "https://top.scientix.ai/cr/v1#Publication",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The kind (article/abstract/preprint) is cr:publicationKind, a value (ADR-0024). A publication reporting a result cites it by IRI (cr:disclosesResult) \u2014 'what does this paper's number rest on' is the same graph walk as the CSR's cr:reportsResult."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Publication"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
