    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#RiskReview",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "RBQM is a cycle, not a checklist: identification, evaluation, control, communication, review \u2014 and review feeds back into identification. The review is the entity that makes the cycle auditable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Risk Review"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "periodic risk review"
      },
      {
        "@language": "en",
        "@value": "risk re-assessment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A periodic re-examination of a risk assessment against accumulated trial experience \u2014 the ICH E6(R3) risk review step. Each review confirms, revises, or retires the assessment it reviews."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Risk Review"
      }
    ]
  },
