      {
        "@value": "active"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#CDISC_SDTM",
    "@type": [
      "https://top.scientix.ai/v1#RegulatoryLaw"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "CDISC standard for organizing and formatting clinical trial data for regulatory submissions (FDA/PMDA)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "CDISC SDTM \u2014 Study Data Tabulation Model"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "CDISC SDTM"
      }
    ],
    "https://top.scientix.ai/v1#status": [
      {
        "@value": "active"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#CFR_21_Part_11",
    "@type": [
      "https://top.scientix.ai/v1#RegulatoryLaw"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "US FDA regulation governing electronic records and electronic signatures in clinical data systems. Requires audit trails, access controls, and non-repudiable e-signatures."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "21 CFR Part 11 \u2014 Electronic Records and Signatures"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "21 CFR Part 11"
      }
    ],
    "https://top.scientix.ai/v1#status": [
      {
        "@value": "active"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#CFR_21_Part_312",
    "@type": [
      "https://top.scientix.ai/v1#RegulatoryLaw"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "US FDA IND regulations. Governs the submission, conduct, and reporting obligations of IND-enabling and IND-active clinical trials in the US."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "21 CFR Part 312 \u2014 Investigational New Drug Application"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "21 CFR Part 312"
      }
    ],
    "https://top.scientix.ai/v1#status": [
      {
        "@value": "active"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#CFR_21_Part_50",
    "@type": [
      "https://top.scientix.ai/v1#RegulatoryLaw"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "US FDA informed consent regulations. Governs the process and documentation of consent from trial participants."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "21 CFR Part 50 \u2014 Protection of Human Subjects"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "21 CFR Part 50"
      }
    ],
    "https://top.scientix.ai/v1#status": [
      {
        "@value": "active"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#CFR_21_Part_56",
    "@type": [
      "https://top.scientix.ai/v1#RegulatoryLaw"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
