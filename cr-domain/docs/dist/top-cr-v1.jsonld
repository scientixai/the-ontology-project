      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Timing",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A relative-timing rule: an offset (days or hours) from an anchor \u2014 another node, or an anchor event such as enrollment \u2014 with an allowed window. The footnote logic, made explicit."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Timing"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TransferAmendment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Amendment as event (Outcome:StatusChange). Bitemporal; drives the cross-entity shape that forces amendment propagation to be explicit."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Transfer Amendment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A status change on a protocol/spec version that carries effectiveFrom/To and MUST reference the TransferSpecifications it affects. Propagation is a graph update + re-validation, not N manual DTA re-authorings."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TransferFile",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Grounded in the info-model TRANSFER_FILE entity. The specification is the plan; the file is the Outcome:Artifact."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Transfer File"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An actual delivered file instance (as distinct from its TransferSpecification). Carries its own transfer lifecycle timestamps and PROV attribution to the vendor org."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TransferProfile",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Grounded in MVP Inventory \u00a75 'File Transfer Information'. Specialized per vendor as cr:VendorConnectorProfile instances grounded in each vendor's public API/export surface."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Transfer Profile"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The operational envelope of a transfer: file format, delimiter, encoding, transmission method, transmission type (cumulative vs incremental), schedule, provider/receiver folder, environment. A declaration (top:Scope); its validity is enforced by cr:TransferProfile* SHACL shapes (open Q2: Scope for declaration + Constraint shapes for enforcement)."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TransferScope",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Grounded in DTA MVP Information Model open Q1 (multi-vendor / multi-scope DTA). Recommend modeling scope explicitly \u2014 the single-vendor simplification is exactly where the exponential hides."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Transfer Scope"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A mediator that lets one DataTransferAgreement cover multiple vendor/data-type scopes without repeating the agreement. Each TransferScope binds a data type, a vendor Organization and its TransferSpecification(s). Modeling scope explicitly from the start is where the DTA group's combinatorics are made visible rather than hidden (open Q1)."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TransferSpecification",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Grounded in the info-model TRANSFER_SPECIFICATION entity and CDISC LAB Model v2.0 content. Placed under top:Scope (a specification/plan), bitemporal so amendments supersede cleanly."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Transfer Specification"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The content layer (the DTS): the set of DataElementSpecifications to be delivered for a given data type/vendor under a DataTransferAgreement. A plan for content, not an act."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TrialLifecycle",
