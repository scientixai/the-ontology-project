    "@id": "https://top.scientix.ai/cr/v1#windowLowerDays",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/cr/v1#Window"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "window lower (days)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#windowStart",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/cr/v1#PlannedVisit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "window start"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#windowUpperDays",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/cr/v1#Window"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "window upper (days)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#withdrawalDate",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Calendar date on which consent was withdrawn, if applicable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/cr/v1#InformedConsent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "withdrawal date"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#date"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#withdrawalReason",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Coded reason: subject-decision, AE, lost-to-follow-up, or other."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/cr/v1#ConsentWithdrawal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "withdrawal reason"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#witnessedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The person who witnessed the consent signing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/cr/v1#InformedConsent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "witnessed by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-agent",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "First-principles P7 CV-obligations (anti-synonym example)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "ANTI-SYNONYM: pharmacological 'agent' (the drug/substance) is NOT top:Agent (an actor bearing responsibility). Route drug-sense to cr:InvestigationalProduct / hcls:Substance; actor-sense to top:Agent."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "agent"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-analysis",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Convener sanity review, 2026-07 (cr-core-lims ambiguity finding)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: a laboratory assay (cr:AssayDefinition / cr:LabOrder), the statistical analysis layer (cr:AnalysisDataset / cr:AnalysisDecision / SAP), and everyday operational analysis ('analyze the five worst sites'). Never route the bare word; qualify by context \u2014 lab context -> assay terms, biostatistics context -> analysis-layer terms, otherwise no routing."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "analysis"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-arm",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "OPMODEL \u00a71.1 Study Design"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: treatment arm (cr:Arm) vs the anatomical arm (blood-draw laterality, injection site). Study-design context routes to cr:Arm; clinical-procedure context is anatomical."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "arm"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-monitor",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "OPMODEL \u00a72.5 Oversight; ROLES persona aliases"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: the person (cr:ClinicalResearchAssociate), the visit (monitoring visit), the discipline (risk-based / central / medical monitoring \u2014 distinct capabilities), and the verb. Default routing: the CRA role; qualify otherwise."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "monitor"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-participant-patient",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Industry drift observed by convener, 2026-07 (ADR-0024): 'There are indications that the industry is moving to patient, but for clinical research, participant should be the preferred label.'"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Routed to cr:StudySubject in study context; routed to hcls:Person in care-delivery context."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "patient"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-phase",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Convener sanity review, 2026-07 (cr-core-phases conflation finding)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: the trial phase (cr:TrialPhase \u2014 Phase 1..4 / BESH, a classification of the STUDY: 'this is a Phase 2 trial') vs the trial stage (cr:TrialStage \u2014 startup/conduct/closeout, a position in the trial's EXECUTION). Neither concept uses the bare word: the model only names the qualified forms (trial phase, trial stage); any new label containing 'phase' must route explicitly."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "phase"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-screen",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "OPMODEL \u00a72.2 Recruitment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: eligibility screening (the recruitment-funnel activity \u2014 vocabulary lands with the funnel model, a declared V1 deferral) vs screen failure vs the UI screen. No default routing; qualify."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "screen"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-service",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Convener sanity review, 2026-07 (cr-core-lims ambiguity finding)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: a catalog lab test (cr:AssayDefinition, formerly 'AnalysisService'), a vendor organization (cr:ServiceProvider), and the API/runtime sense. Default routing: none; qualify."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "service"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-site",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "OPMODEL \u00a71.4 Site Selection"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: the investigative site (cr:StudySite, an organization) vs bfo:Site / top:Location (a place) vs injection/body site vs website. Default routing in this domain: cr:StudySite."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "site"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#xl-subject",
    "@type": [
      "http://www.w3.org/2008/05/skos-xl#Label"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "First-principles P7 CV-obligations (homonym-routing example); OPMODEL"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "HOMONYM: human-research 'subject' routes to cr:StudySubject (prefLabel Participant, ADR-0024); animal-research 'subject' is out of this domain; grammatical/email 'subject' is noise. Never route to hcls:Person."
      }
    ],
    "http://www.w3.org/2008/05/skos-xl#literalForm": [
      {
        "@language": "en",
        "@value": "subject"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#yieldsDesign",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The Phase3Design a 'go' (or 'go-with-modification') decision produces \u2014 the consequence edge that makes a go-decision actionable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/cr/v1#AnalysisDecision"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "yields design"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/cr/v1#Phase3Design"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#yieldsResult",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An assay result that traces to this collection act (forward of cr:derivedFromCollection)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/cr/v1#StudyEvent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "yields result"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/cr/v1#AssayResult"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://top.scientix.ai/cr/v1#derivedFromCollection"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/actions",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The authorized-operation layer: 78 hcls:Action archetypes (who may do what, in which trial stage, on what) grounding agent authorization queries."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 action catalog"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/adam",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "ADaM's value is reproducibility: every analysis result traces to its source. In this reference the chain is result -> analysis dataset -> NATIVE source facts (via W3C PROV wasDerivedFrom) \u2014 traceability to the one source of truth, not the fragile SDTM-document -> ADaM-document chain. SDTM and ADaM are both views of the native graph. v1.1 adds the CDISC ADaM structural vocabulary: the dataset's structure class (ADSL / BDS / OCCDS \u2014 a CLASSIFICATION carried as a value, ADR-0024) and the analysis variable / parameter layer (PARAMCD) that BDS datasets pivot on."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 ADaM analysis layer & traceability"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.1"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/coding",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The coding WORKFLOW the term crosswalks alone don't carry (Operating Model \u00a73.2): a code assignment is a promoted JUDGMENT \u2014 'this verbatim term means this dictionary code' \u2014 with its method (autocoder vs manual), its coder, and its review. The existing cr:meddra* properties record WHERE an event landed in MedDRA; this module records WHO decided that, HOW, and whether a human reviewed it. WHODrug joins MedDRA as a BYOL (bring-your-own-license) IRI reference \u2014 no licensed content is reproduced. NOTICE: MedDRA is \u00a9 MSSO/ICH; WHODrug is \u00a9 Uppsala Monitoring Centre; both require valid licences to resolve."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 medical coding workflow (MedDRA / WHODrug)"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/deviation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Deviation events, antecedents, risk signals, and corrective/preventive actions \u2014 the quality-event chain."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 protocol deviations & CAPA"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/disclosure",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Two submission-and-transparency layers the CSR/eCTD spine didn't carry (Operating Model \u00a73.4): (1) the Integrated Summaries of Safety and Efficacy (ISS/ISE) \u2014 cross-study analyses that rest on the per-study locked datasets; the summary KIND is a value, not a class (ADR-0024). (2) The public-disclosure obligations: the trial-registry record (ClinicalTrials.gov / EUCTR \u2014 registration, results posting) and publications. Disclosure artifacts are projections of already-produced results, never new sources of truth \u2014 the same manifest discipline as the eCTD."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 integrated summaries & disclosure"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/edc",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Electronic data capture: eCRF, clinical observations, queries, source data verification."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 EDC & clinical observations"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/eop2",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The EOP2 gate: analysis decisions, briefing evidence, go/no-go conclusions."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 End-of-Phase-2 decision"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/gcp",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/rights": [
      {
        "@value": "Independent derivative adaptation of the ICH E6(R3) Guideline. The classes, properties, and SKOS concepts here are an adaptation (structure + paraphrased definitions), not a reproduction. NOT endorsed or sponsored by ICH. The original ICH E6(R3) document is copyright \u00a9 ICH."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "ICH E6(R3) Good Clinical Practice (Step 4, adopted January 2025): Principles, Glossary, and Annex 1 (interventional trials). Annex 2 (additional/non-traditional data sources) is NOT modeled in this version."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Changes made: ICH E6(R3) terms are reorganized into an OWL/SKOS structure, definitions are paraphrased, and obligations are expressed as SHACL shapes rather than encoded text. Each derived term carries rdfs:isDefinedBy the ICH efficacy-guidelines source."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TOP CR \u2014 ICH E6(R3) GCP definitional layer"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/lims",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Lab orders, assay definitions, specimens, custody chain, and assay results."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 laboratory & specimens"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/participant",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Extends CR-core with InformedConsent enrichment (US-500-003): consentVersion, consentFormIRI, witnessedBy, withdrawalDate. Property-only module: the classes these properties describe (cr:InformedConsent, cr:StudySubject, cr:Enrollment, cr:EligibilityCriterion) are defined once, in cr-core.ttl."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core ontology \u2014 participant & consent module"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.5"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/phases",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Two deliberately separated concepts: cr:TrialPhase (Phase 1-4, BESH \u2014 classification of the study) and cr:TrialStage (startup/conduct/closeout \u2014 position in execution)."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 trial phases & trial stages"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/preind",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Pre-IND meetings, briefing books, regulatory questions and positions, the IND 30-day clock."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 pre-IND & regulatory interactions"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/privacy",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "PII boundary vocabulary: lawful bases, data categories, pseudonymization discipline."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 privacy & lawful basis"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/randomization",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The events an IxRS/RTSM system records, modeled as first-class bitemporal facts (Operating Model \u00a72.3): the randomization act (subject \u2192 arm, under a stratum), the kit assignment that keeps the blind, and the audited unblinding event. The design-time ratio stays on the study (cr:randomizationRatio); these are the EXECUTION events. An unblinding without a recorded reason and authorization is the pharmacovigilance breach every inspector checks first \u2014 modeled exactly like cr:DatabaseUnlock: an audited event, never a silent state flip."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 randomization & blinding (IxRS/RTSM events)"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/rbqm",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The ICH E6(R3)/Q9(R1) RBQM cycle: CtQ factors, risk assessments, QTLs, KRIs, metric observations, limit breaches, mitigation and review."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 risk-based quality management"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/recruitment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The funnel from outreach to enrolled participant (Operating Model \u00a72.2\u20132.3): campaign \u2192 candidate \u2192 pre-screening \u2192 screening \u2192 conversion. The candidate (cr:Recruit) is a SITE-BOUNDARY identity like hcls:Person \u2014 PII-side, never referenced by downstream clinical data; conversion to the pseudonymous cr:StudySubject happens only through the attested cr:Enrollment bridge. Screen failure is an OUTCOME VALUE, not a class (ADR-0024 one-question gate: a classification of a screening, not a kind of thing)."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 recruitment & screening funnel"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/regulatory",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Regulatory laws and lawful bases the domain cites (ICH E6(R3), 21 CFR Part 11, GDPR) as named individuals."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR \u2014 regulatory constraints"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/roles",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "OWL agent-type classes (site- and sponsor-boundary) and the JTBD catalog binding operator intent to authorized actions."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 agent types & jobs-to-be-done"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/safety",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Adverse events, SAEs, causality and expectedness assessments, expedited reporting clocks."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 safety & pharmacovigilance"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/schedule",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The bitemporal SoA: planned visits and activities, amendments, as-of reconstruction."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 schedule of activities"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/site-closeout",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The SITE-side of closeout (Operating Model \u00a73.1) \u2014 the counterpart of the data-side database lock: the Close-Out Visit, the reconciliations (drug, device, documents, queries \u2014 the SCOPE is a value, not four classes, ADR-0024), the Investigator Site File whose completeness gates closure, the archival with its retention clock, and the site-closure record that must rest on all of it. A closure without a Close-Out Visit and completed reconciliations is a Violation \u2014 a site is closed by evidence, not by declaration."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 site closeout"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/startup",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Site activation and its prerequisites: IRB approval, CTA, SIV; enrollment-before-activation is the flagship violation."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 site activation"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/startup-package",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Startup artifacts, work streams, and the derivation chain from package to activation prerequisites."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 study startup package"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/supply",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The investigational-product custody events (Operating Model \u00a72.1/\u00a72.4/\u00a73.1): shipment to site, dispensing to a participant, return, and authorized destruction \u2014 each a first-class bitemporal event on an hcls:Lot. The ACCOUNTABILITY LOG IS A PROJECTION of these events (like the DoA log), never a maintained spreadsheet: reconcile-ability is a query over the event chain. A temperature excursion is a promoted fact that quarantines what it touched."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 drug supply & IMP accountability"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/thesaurus",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "TOP CR \u2014 operator thesaurus (dialects, acronyms, routing)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Controlled-vocabulary + thesaurus layer for the CR domain (ADR-0024; first-principles P7 layers 1 and 4). Labels only \u2014 no classes or properties are defined here."
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/tmf-onboarding",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Trial Master File onboarding: expected-essential artifact sets and the filed-set diff."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "TMF \u2014 onboarding & completeness"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/tmf-reference",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "TMF artifact types aligned by name to the DIA TMF Reference Model (licensed; no text reproduced)."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "TMF \u2014 artifact type reference"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1/visit-execution",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Actual visit conduct against the SoA: performed activities, missed visits, visit-level capture."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "CR-core \u2014 visit execution"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "OWNED, provenance-tagged crosswalks from TOP/CR-core to external ontologies. Aligns to SSSOM slots (subject_id/predicate_id/object_id/mapping_justification/confidence/author_id/mapping_date); an SSSOM TSV is an edge projection of these. Crosswalks are assertions WE own and curate, never imports of the external ontology."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TOP crosswalk vocabulary (SSSOM-aligned)"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#Mapping",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A curated, provenanced correspondence from a TOP term to an external ontology term."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Crosswalk Mapping"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#author",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The curator/agent IRI (SSSOM author_id)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "author id"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#confidence",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "confidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#confirmedAt",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Timestamp when a mapping was confirmed by a human reviewer. Together with cx:confirmedBy, closes the audit trail for human-in-the-loop validation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "confirmed at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#confirmedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The human agent (or committee) that reviewed and confirmed a proposed mapping. Required for promotion from 'under_review' to 'confirmed'."
      },
      {
        "@value": "The human curator (prov:Person IRI) who reviewed and approved an LLM-inferred mapping. Required before verificationStatus may be set to 'verified'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/crosswalk/v1#Mapping"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "confirmed by"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#inferredBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The LLM agent (prov:SoftwareAgent IRI) that produced this mapping candidate. Presence triggers the SHACL HITL gate."
      },
      {
        "@value": "The top:AutonomousAgent instance that proposed this mapping via LLM inference. Enables provenance tracing back to the agent model and prompt version."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/crosswalk/v1#Mapping"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "inferred by"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#justification",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A semapv justification IRI (e.g. ManualMappingCuration)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "mapping justification"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#mappingDate",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "mapping date"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#date"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#mappingMethod",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Free-text tag describing how the mapping was produced. Controlled values: 'ManualCuration', 'LLMInference', 'LexicalMatching', 'LogicalReasoning'."
      },
      {
        "@value": "How the mapping was produced: ManualCuration | LLMInference | RuleBasedExtraction | HybridReview. Drives downstream trust and routing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/crosswalk/v1#Mapping"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "mapping method"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#mappingRationale",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Human-readable explanation of why this mapping was proposed, especially for LLM-inferred mappings. Mirrors top:rationale on a Conclusion."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "mapping rationale"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#objectId",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The external ontology term (right side)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "object id"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#predicateId",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "SKOS mapping predicate."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "predicate id"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#retrievedFrom",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The primary source the target IRI was verified against (URL + retrieval date)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "retrieved from"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#reviewStatus",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Lifecycle state of the mapping: proposed | under_review | confirmed | rejected | deprecated. Confirmed mappings graduate from ephemeral inference to Layer-2 crosswalk."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "review status"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#subjectId",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The TOP/CR-core term (left side)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "subject id"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/crosswalk/v1#verificationStatus",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "verified | unverified | deprecated \u2014 whether the target IRI was confirmed against a primary source."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "verification status"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Mid-layer specializing TOP Core for entities that recur across >=2 HCLS domains (clinical research, hospital, manufacturing, pharmacovigilance, RWE, commercialization). Seeded minimally; grows by promotion (rule of three). Standards projection target: FHIR, OMOP."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "HCLS-core"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Action",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A named, authorized operation (Call To Action in OOUX terms) that an agent of a given type may perform in a given lifecycle stage. Actions are reference-graph archetypes (top:Constraint: they specify what is authorized). Realized occurrences in instance graphs are prov:Activity individuals linked back via hcls:realizationOf."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Action"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Clinician",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A licensed clinician who provides or oversees clinical care or research. Specializes in sub-domains: Investigator (clinical research), Physician (clinical care), Pharmacist, etc."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Clinician"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Practitioner"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Condition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A diagnosed state of a Person."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Consent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An act of agreement by a Person authorizing an action or use of their data/person. HCLS-universal: permutates to cr:InformedConsentAct (clinical trial enrollment), HIPAA Authorization (data use), Treatment Consent (clinical care). Carries valid-time (when consent was given, when it expires) and transaction-time (when it was recorded)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Consent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#HealthcareFacility",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A physical place where care or research is conducted."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Healthcare Facility"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Location"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#JobToBeDone",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A bounded unit of operator intent: the goal an agent type is trying to achieve, with a trigger condition and measurable success signals. Scoped to an agent type (OWL class) and a lifecycle stage. References the object graph and authorized Actions involved. Derived from OOUX JTBD blocks."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Job to Be Done"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Lot",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A manufactured batch/lot; the primary join to the manufacturing domain."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Lot"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Resource"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#MedicinalProduct",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A medicinal product (drug or biologic)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Medicinal Product"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Resource"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Observation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An information artifact recording a measured value; refersTo the Person/Specimen it is about."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Organization",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An organization \u2014 sponsor, CRO, site, central lab, or regulator."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Organization"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Agent"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Person",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A human. BOUNDARY-ONLY / PII layer: an identifiable Person lives inside the source/site sovereign boundary. Downstream and shareable artifacts must attach to a pseudonymous cr:StudySubject, never to a Person. The only legal Person<->Subject link is the attested Enrollment bridge (cr:enrolledPerson). Clinical data is PSEUDONYMIZED, not anonymized: re-identification is preserved but controlled (safety / emergency unblinding)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Person"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Agent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The identifiable human \u2014 PII, boundary-only. When an operator says 'participant' or 'patient' about in-study data, route to cr:StudySubject; this class is only for the site-sovereign identity behind the enrollment bridge."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Practitioner",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A healthcare professional."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Practitioner"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Specimen",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A biospecimen collected from a Person."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specimen"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Resource"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "aliquot"
      },
      {
        "@language": "en",
        "@value": "biospecimen"
      },
      {
        "@language": "en",
        "@value": "blood sample"
      },
      {
        "@language": "en",
        "@value": "sample"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Specimen"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#Substance",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A chemical or biological substance."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Substance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Resource"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#actsAs",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "At instance-graph time, a human-readable label for the contextual role a Person plays within a Scope (Study, Site, Care Episode). Not a class; purely a string annotation on the Person-Scope binding. Example value: 'Principal Investigator'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "acts as"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#affiliatedWith",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "affiliated with"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Organization"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#authorizedAgentType",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The OWL class of agent authorized to execute this Action. Authorization binds directly to agent type \u2014 no OperatorRole intermediary. Multi-valued: an Action may be authorized for more than one agent type."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Action"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "authorized agent type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#collectedFrom",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Specimen"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "collected from"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
