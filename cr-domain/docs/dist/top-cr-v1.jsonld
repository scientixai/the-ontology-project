      {
        "@value": "New staff onboarded; or protocol amendment changes delegation requirements."
      }
    ],
    "https://top.scientix.ai/hcls/v1#successSignal": [
      {
        "@value": "Delegation of Authority log is current and agrees with the recorded delegation acts."
      },
      {
        "@value": "Each delegated task has a qualified delegate with training in place."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Delegation",
