      {
        "@value": "Detect and evaluate emerging safety signals"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "PV-J01"
      }
    ],
    "https://top.scientix.ai/hcls/v1#executesAction": [
      {
        "@id": "https://top.scientix.ai/cr/v1#CloseSafetySignal"
      },
      {
