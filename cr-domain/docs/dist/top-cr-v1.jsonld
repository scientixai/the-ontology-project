      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/hcls/v1#operatesOn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The OWL class of the primary entity this Action targets. Enables querying: what Actions are available on a given entity type for a given agent type in a given stage?"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Action"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "operates on"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
