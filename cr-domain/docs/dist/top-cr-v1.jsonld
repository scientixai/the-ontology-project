      },
      {
        "@language": "en",
        "@value": "randomization"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The act of assigning an enrolled participant to a treatment arm by the randomization system, under a stratification key, yielding a randomization number."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
