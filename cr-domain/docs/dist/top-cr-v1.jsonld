  {
    "@id": "https://top.scientix.ai/cr/v1#RiskAssessment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An assessment of risk to a CtQ factor. Carries the ICH Q9(R1) decomposition \u2014 cr:likelihood, cr:impact, cr:detectability \u2014 plus the rolled-up cr:riskLevel and optional cr:riskScore. Bitemporal: re-assessments supersede, never overwrite."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Risk Assessment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "RACT entry"
      },
      {
        "@language": "en",
        "@value": "risk review"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Risk Assessment"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#RiskManagementPlan",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A living document \u2014 updated as circumstances change; versions supersede bitemporally. Aggregates via cr:documentsAssessment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Risk Management Plan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "RBQM plan"
      },
      {
        "@language": "en",
        "@value": "RMP"
      },
      {
        "@language": "en",
        "@value": "quality management plan"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The living document that records the trial's risk methodology and current risk posture: identified assessments, evaluation criteria, control strategies, monitoring approach, and review cadence."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Risk Management Plan"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#RiskRegister",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
