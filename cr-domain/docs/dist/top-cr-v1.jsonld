        "@id": "https://top.scientix.ai/v1#Temporal"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DM-J01",
    "@type": [
      "https://top.scientix.ai/hcls/v1#JobToBeDone"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Resolve open queries and achieve clean data state"
      }
    ],
    "https://top.scientix.ai/hcls/v1#executesAction": [
      {
        "@id": "https://top.scientix.ai/cr/v1#AssignQuery"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#CloseQuery"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#CreateQuery"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#ReopenQuery"
      }
    ],
    "https://top.scientix.ai/hcls/v1#involvesObject": [
      {
        "@id": "https://top.scientix.ai/cr/v1#eCRF"
      }
    ],
    "https://top.scientix.ai/hcls/v1#jobOfAgentType": [
      {
        "@id": "https://top.scientix.ai/cr/v1#DataManager"
      }
    ],
    "https://top.scientix.ai/hcls/v1#jobTrigger": [
      {
        "@value": "Query created on a CRF; or discrepancy detected in incoming data."
      }
    ],
    "https://top.scientix.ai/hcls/v1#successSignal": [
      {
        "@value": "All queries on a CRF closed before CRF lock."
      },
      {
        "@value": "Re-open rate below sponsor threshold."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DM-J02",
    "@type": [
      "https://top.scientix.ai/hcls/v1#JobToBeDone"
