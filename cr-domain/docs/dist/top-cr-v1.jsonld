      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The TOP cr/v1 reference version a binding resolved against, so reference drift never silently re-writes meaning (\u00a74 reference-version pinning)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "resolved against reference version"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#resolvedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The top:AutonomousAgent that produced an automatic resolution. A kind of prov:wasAttributedTo, so the transforming agent is queryable as provenance. When a human reconciles, a second attribution is appended \u2014 the machine step is never overwritten."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "resolved by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/v1#AutonomousAgent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://www.w3.org/ns/prov#wasAttributedTo"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#resolvedFrom",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Binding provenance: the VendorAlias (or source corpus entry) a resolved binding was derived from. A kind of prov:wasDerivedFrom, so lineage queries traverse it natively."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
