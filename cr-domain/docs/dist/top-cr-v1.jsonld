      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Budget negotiation and contract (CTA) review and execution."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Budget & Contracting Work Stream"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/cr/v1#WorkStream"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#CAPA",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Corrective And Preventive Action \u2014 the formal response to a deviation or finding (corrective: fix this occurrence; preventive: stop recurrence). Bitemporal + attested."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "CAPA"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "corrective action"
      },
      {
        "@language": "en",
        "@value": "corrective and preventive action"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "CAPA"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#CDISC_CDASH",
    "@type": [
      "https://top.scientix.ai/v1#RegulatoryLaw"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "CDISC standard defining the content of data collected on case report forms. Primary crosswalk target for cr:OperationalRecord field mapping."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "CDISC CDASH \u2014 Clinical Data Acquisition Standards Harmonization"
