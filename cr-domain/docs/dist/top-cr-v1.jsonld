    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The single root above the eight Category-Level Objects. Everything modeled is, ultimately, a kind of CommonEntity, and carries the Universal DNA: identifier, observedAt, status."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Common Entity"
      }
    ]
  },
