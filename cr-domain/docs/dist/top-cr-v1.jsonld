  {
    "@id": "https://top.scientix.ai/cr/v1#TableListingFigure",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The tlfType qualifier (table | listing | figure) distinguishes the kind without a parallel hierarchy. A TLF that is not pre-specified is a post-hoc analysis \u2014 legitimate as exploratory, inadmissible when presented as pivotal."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Table / Listing / Figure (TLF)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "TFL"
      },
      {
        "@language": "en",
        "@value": "TLF"
      },
      {
        "@language": "en",
        "@value": "display"
      },
      {
        "@language": "en",
        "@value": "output"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A pre-specified analysis output \u2014 a table, a listing, or a figure \u2014 built from an ADaM analysis dataset. The unit the CSR and the submission actually present. Must be reproducible to source (prov:wasDerivedFrom an AnalysisDataset) and grounded in the SAP that pre-specified it."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Table, Listing or Figure"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TemperatureExcursion",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Temperature Excursion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "cold-chain excursion"
      },
      {
        "@language": "en",
        "@value": "excursion"
      },
      {
        "@language": "en",
        "@value": "temp excursion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A recorded departure from a lot's required storage conditions \u2014 a promoted fact (never an 'isCompromised' flag) that quarantines the affected product until disposition."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Temperature Excursion"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TerminateStartupPackage",
    "@type": [
      "https://top.scientix.ai/hcls/v1#Action"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Terminate Startup"
      }
    ],
    "https://top.scientix.ai/cr/v1#occursInStage": [
      {
        "@id": "https://top.scientix.ai/cr/v1#SiteActivationStage"
      }
    ],
    "https://top.scientix.ai/hcls/v1#authorizedAgentType": [
      {
