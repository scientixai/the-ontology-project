      {
        "@language": "en",
        "@value": "signed by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/v1#Agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://www.w3.org/ns/prov#wasAttributedTo"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Tightenable"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#sourceContext",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The retrieved context passages (e.g. SPARQL results, vector-search snippets) injected into the prompt. Stored verbatim. See the PII scope note in this module's header."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#Conclusion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source context"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Additive"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#startTime",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Actual or planned start. PROV-aligned to prov:startedAtTime."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "start time"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://www.w3.org/ns/prov#startedAtTime"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Invariant"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#status",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Current lifecycle / health state. Each Category narrows the enum at its layer; leaves narrow further. Universal at this layer because every entity has SOME state and the project-wide status query is operationally meaningful."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#CommonEntity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "status"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Tightenable"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#supersededAt",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Transaction time (append-only): when a later assertion superseded this one. A correction is a NEW assertion carrying its own recordedAt; this timestamp closes the old one and is never rewritten."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "superseded at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Invariant"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#validFrom",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Domain intentionally open: rdfs:domain is an inference axiom, not a constraint \u2014 a domain of top:Versioned would retype every dated entity as Versioned and drag it under the versioning contract (the RDFS target cascade). The requirement side lives in SHACL: top:BitemporalShape demands validFrom on Versioned."
      },
      {
        "@language": "en",
        "@value": "Start of the valid-time interval \u2014 when this version's state became true in the world. Distinct from top:observedAt (transaction time). Invariant per ADR-0019, like top:startTime/top:endTime. No PROV-O peer: PROV models system time, not valid-time-of-a-fact (declared absence, per ADR-0021)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "valid from"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Invariant"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#validUntil",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "End of the valid-time interval; open (absent) for the currently-valid version. Invariant per ADR-0019."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "valid until"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Invariant"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#variance",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Delta between expected and actual. Format depends on leaf specialization."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "variance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Tightenable"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#verifiesOutcome",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Direct link to the Outcome this Evidence supports."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "verifies outcome"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Tightenable"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/v1#withinLocation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#TransitiveProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Recursive parent location. Transitive: Room within Building within Campus is queryable as Room within Campus."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://top.scientix.ai/v1#Location"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "within location"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://top.scientix.ai/v1#Location"
      }
    ],
    "https://top.scientix.ai/v1#flavor": [
      {
        "@value": "Tightenable"
      }
    ]
  }
]
