      },
      {
        "@id": "https://top.scientix.ai/cr/v1#RegulatorySubPhase"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#SiteSelectionSubPhase"
      }
    ],
    "https://top.scientix.ai/hcls/v1#precedes": [
      {
        "@id": "https://top.scientix.ai/cr/v1#ConductPhase"
      }
    ]
  },
