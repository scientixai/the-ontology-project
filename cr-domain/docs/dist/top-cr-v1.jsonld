      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "cr-conventions marker: anything carrying the bitemporal + PROV envelope (exactly one observedAt, exactly one recordedAt, >=1 prov:wasAttributedTo). Enforced by top:BitemporalProvShape. Not yet in core/v1 \u2014 documented divergence, see the header of this file."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Provenanced Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#CommonEntity"
      }
    ]
  },
