        "@language": "en",
        "@value": "A top:flavor value indicating domain specializations may narrow this property's range or add sh:in / sh:minInclusive constraints, but may not loosen the base constraint."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
