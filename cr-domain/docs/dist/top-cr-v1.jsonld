        "@value": "ISS"
      },
      {
        "@language": "en",
        "@value": "integrated summary of efficacy"
      },
      {
        "@language": "en",
        "@value": "integrated summary of safety"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A cross-study integrated analysis prepared for a marketing application \u2014 the Integrated Summary of Safety (ISS) or of Efficacy (ISE) \u2014 resting on the locked analysis datasets of the studies it integrates."
