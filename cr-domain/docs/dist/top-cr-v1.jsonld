  {
    "@id": "https://top.scientix.ai/cr/v1#QualityToleranceLimit",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Trial-level, few in number (TransCelerate: 3-5 per trial \u2014 see QTLCountShape), defined before first participant first visit, monitored continuously, and every significant deviation documented in the CSR (cr:reportedIn). Site-level leading metrics are cr:KeyRiskIndicator, a different concept."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Quality Tolerance Limit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "QTL"
      },
      {
        "@language": "en",
        "@value": "acceptable range"
      },
      {
        "@language": "en",
        "@value": "quality tolerance level"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A trial-level boundary on a quality parameter tied to a critical-to-quality factor \u2014 the range beyond which a systemic issue threatens participant safety, data integrity, or the study's statistical power. ICH E6(R3) calls these acceptable ranges; the industry says QTL."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Quality Tolerance Limit"
      }
    ]
  },
