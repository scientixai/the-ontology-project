    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Deprecated (convener sanity review, 2026-07): duplicate of cr:ClinicalStudyReport (cr-core-reporting.ttl), which carries the section/traceability model. Unused by any example or shape; removed after 2 MINOR versions per the deprecation policy."
      }
    ],
    "http://www.w3.org/2002/07/owl#deprecated": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": true
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "https://top.scientix.ai/cr/v1#ClinicalStudyReport"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#CSRSection",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The sectionKind qualifier (efficacy-results | safety-results | synopsis | narrative | administrative) selects which sections must carry analysis traceability, without a parallel hierarchy."
      }
