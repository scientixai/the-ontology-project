      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "'Side effect' (lay) and 'adverse reaction' (implies causality) are routed here but not promoted: an AE makes no causality claim \u2014 that is cr:CausalityAssessment."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#AmbiguousTermsWatchList",
