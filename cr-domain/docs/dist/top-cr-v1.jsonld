      }
    ],
    "https://top.scientix.ai/hcls/v1#operatesOn": [
      {
        "@id": "https://top.scientix.ai/cr/v1#StudySite"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Timing",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A relative-timing rule: an offset (days or hours) from an anchor \u2014 another node, or an anchor event such as enrollment \u2014 with an allowed window. The footnote logic, made explicit."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Timing"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TransferAmendment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Amendment as event (Outcome:StatusChange). Bitemporal; drives the cross-entity shape that forces amendment propagation to be explicit."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Transfer Amendment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A status change on a protocol/spec version that carries effectiveFrom/To and MUST reference the TransferSpecifications it affects. Propagation is a graph update + re-validation, not N manual DTA re-authorings."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TransferFile",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Grounded in the info-model TRANSFER_FILE entity. The specification is the plan; the file is the Outcome:Artifact."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Transfer File"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Outcome"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An actual delivered file instance (as distinct from its TransferSpecification). Carries its own transfer lifecycle timestamps and PROV attribution to the vendor org."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TransferProfile",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Grounded in MVP Inventory \u00a75 'File Transfer Information'. Specialized per vendor as cr:VendorConnectorProfile instances grounded in each vendor's public API/export surface."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Transfer Profile"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The operational envelope of a transfer: file format, delimiter, encoding, transmission method, transmission type (cumulative vs incremental), schedule, provider/receiver folder, environment. A declaration (top:Scope); its validity is enforced by cr:TransferProfile* SHACL shapes (open Q2: Scope for declaration + Constraint shapes for enforcement)."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TransferScope",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Grounded in DTA MVP Information Model open Q1 (multi-vendor / multi-scope DTA). Recommend modeling scope explicitly \u2014 the single-vendor simplification is exactly where the exponential hides."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Transfer Scope"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A mediator that lets one DataTransferAgreement cover multiple vendor/data-type scopes without repeating the agreement. Each TransferScope binds a data type, a vendor Organization and its TransferSpecification(s). Modeling scope explicitly from the start is where the DTA group's combinatorics are made visible rather than hidden (open Q1)."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TransferSpecification",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Grounded in the info-model TRANSFER_SPECIFICATION entity and CDISC LAB Model v2.0 content. Placed under top:Scope (a specification/plan), bitemporal so amendments supersede cleanly."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Transfer Specification"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The content layer (the DTS): the set of DataElementSpecifications to be delivered for a given data type/vendor under a DataTransferAgreement. A plan for content, not an act."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TrialLifecycle",
    "@type": [
      "https://top.scientix.ai/cr/v1#TrialStage"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The root stage encompassing the entire lifespan of a clinical trial from protocol design to study archival."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Clinical Trial Lifecycle"
      }
    ],
    "https://top.scientix.ai/cr/v1#containsStage": [
      {
        "@id": "https://top.scientix.ai/cr/v1#CloseoutStage"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#ConductStage"
      },
      {
        "@id": "https://top.scientix.ai/cr/v1#StartupStage"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TrialMasterFile",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://www.ich.org/page/efficacy-guidelines"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Trial Master File"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "TMF"
      },
      {
        "@language": "en",
        "@value": "eTMF"
      },
      {
        "@value": "TMF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The collection of essential records that allows the conduct of the trial and the quality of the data to be evaluated (paraphrased, ICH E6(R3))."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Trial Master File"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TrialPhase",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Carried on the study as cr:trialPhase -> one of the named individuals below (ADR-0024: a classification rides as a value/individual, never a subclass of Study). Each phase carries the names practitioners actually use \u2014 including the device-world names, per the in-model devices decision (BOUNDARIES.md). USDM: StudyVersion.studyPhase is the crosswalk target."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Trial Phase"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The regulatory development phase a clinical trial belongs to \u2014 the answer to 'what kind of trial is this?' (Phase 1, 2, 3, 4, or BESH). A classification of the study itself, not a position in its execution (that is the lifecycle stage)."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#TrialStage",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Stages form a containment tree (cr:containsStage) and a precedence chain (cr:precedesStage). Actions bind to stages via cr:occursInStage. CR-owned deliberately: trial stages exist only in clinical research, so this does not live in hcls-core."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Trial Stage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "lifecycle stage"
      },
      {
        "@language": "en",
        "@value": "study stage"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A bounded, sequenced stage of a clinical trial's execution lifecycle \u2014 the answer to 'where in its run is this trial?' (startup, conduct, closeout, and their named sub-stages). A position in the trial's execution, not a classification of the study (that is the trial phase)."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#UnblindingEvent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Modeled like cr:DatabaseUnlock: the blind is never silently broken. An unblinding must carry its reason and its authorizer; one without both is a Violation. The unblinding kind (emergency vs planned) is a value, not a class (ADR-0024 one-question gate)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Unblinding Event"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "breaking the blind"
      },
      {
        "@language": "en",
        "@value": "code break"
      },
      {
        "@language": "en",
        "@value": "emergency unblinding"
      },
      {
        "@language": "en",
        "@value": "unblinding"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The controlled, audited disclosure of a participant's treatment assignment \u2014 emergency (safety) or planned (analysis milestone)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Unblinding Event"
      }
    ]
  },
