      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#LimitBreach",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Root-cause disposition distinguishes 'systemic' (threatens the trial; may require protocol amendment; QTL breaches are documented in the CSR via cr:reportedIn) from 'isolated' (an operational artifact; targeted site action via cr:escalatedTo a CAPA or risk signal)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Limit Breach"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Conclusion"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "QTL excursion"
      },
      {
        "@language": "en",
        "@value": "out-of-tolerance event"
      },
      {
        "@language": "en",
        "@value": "threshold breach"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A determination that a monitored parameter crossed its boundary \u2014 promoted to an entity (P6) so it carries evidence, disposition, escalation, and reporting, rather than living as a flag on the observation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Limit Breach"
      }
    ]
  },
