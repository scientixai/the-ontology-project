      },
      {
        "@language": "en",
        "@value": "term coding"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The recorded judgment that a verbatim term (an investigator's words) corresponds to a dictionary code (MedDRA term, WHODrug record) \u2014 with its method, coder, and dictionary version."
