      }
    ],
    "https://top.scientix.ai/hcls/v1#jobTrigger": [
      {
        "@value": "Last patient last visit completed; data cleaning cycle closed."
      }
    ],
    "https://top.scientix.ai/hcls/v1#successSignal": [
      {
        "@value": "All CRFs in LOCKED state."
      },
      {
        "@value": "Database lock confirmed by authorized Data Manager sign-off."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DataAnalysisSubPhase",
    "@type": [
      "https://top.scientix.ai/hcls/v1#Phase"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Database lock, data cleaning and validation, statistical analysis planning execution, longitudinal analysis, survival analysis, interim and final analyses."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Data Analysis"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DataCollectionSubPhase",
    "@type": [
      "https://top.scientix.ai/hcls/v1#Phase"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "EDC data entry and CRF completion, query management, lab reconciliation, concomitant medication and medical history recording. Dual-lens: site captures, sponsor/DM validates."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Data Collection"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DataDefinition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Data Definition (Define-XML)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The CDISC Define-XML metadata that describes the submitted datasets (variable-level metadata, value-level metadata, controlled terminology, computational method traceability). The map a reviewer uses to read the datasets."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DataElementDef",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A variable DEFINITION (ItemOID), independent of any form version; carries a PHI classification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Data Element Definition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DataElementSpecification",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Grounded in MVP Inventory content rows and the LAB v2.0 LB variable list. The SDTM target is NEVER a stored attribute here \u2014 it is a crosswalk edge rendered on projection."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Data Element Specification"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "One expected data element in a TransferSpecification: it binds to a canonical BiomedicalConcept, declares its unit, value range, controlled terminology, mandatory-ness, significant digits and derived flag. The universal content pattern \u2014 one shape covers lab, ECG, imaging analytes; data-type specifics are typed extensions, not parallel hierarchies."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DataManager",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Creates and locks CRFs, manages queries, reconciles lab and date data, and manages data transfers. Dual-lens: sees CRF as data source for analysis (sponsor perspective)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Data Manager"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "CDM"
      },
      {
        "@language": "en",
        "@value": "DM"
      },
      {
        "@language": "en",
        "@value": "clinical data manager"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Data Manager"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DataProcessingAgreement",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A GDPR-required agreement between a data controller (sponsor) and data processor (CRO, central lab), versioned and effective-dated."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Data Processing Agreement"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DataSubjectRequest",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A GDPR data subject right exercise: access, erasure, rectification, or portability."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Data Subject Request"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DataTransferAgreement",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Grounded in the DTA MVP Information Model DTA entity and MVP Inventory \u00a73 (Version, Version Date, Version Change Rationale). Not a Word/PDF artifact with fields \u2014 a fact graph."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Data Transfer Agreement"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "DTA"
      },
      {
        "@language": "en",
        "@value": "DTS"
      },
      {
        "@language": "en",
        "@value": "data transfer spec"
      },
      {
        "@language": "en",
        "@value": "vendor data agreement"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The governing artifact for a vendor-to-sponsor transfer relationship. Packages one or more TransferSpecifications, references a TransferProfile, is ratified by Attestations, and cites the conformance shapes it must satisfy. Versioned (DNA status + bitemporal)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Data Transfer Agreement"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DatabaseLock",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Bitemporal: the lock's valid time (top:observedAt) is the lock date; corrections are new assertions, never rewrites."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Database Lock"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "DB lock"
      },
      {
        "@language": "en",
        "@value": "data lock"
      },
      {
        "@language": "en",
        "@value": "hard lock"
      },
      {
        "@language": "en",
        "@value": "soft lock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The act of freezing the study database. A SOFT lock freezes it for review and is reversible; a HARD lock freezes it for analysis. After a hard lock, no clinical value may change without a recorded DatabaseUnlock."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Database Lock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Operators say 'the finish line'; soft vs hard is carried by cr:lockType, not by separate classes (ADR-0024 one-question gate: a classification, not a kind)."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DatabaseUnlock",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Database Unlock"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "database reopen"
      },
      {
        "@language": "en",
        "@value": "unlock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A controlled, reasoned reopening of a locked database (e.g. a late data correction). It references the DatabaseLock it reopens and records a reason \u2014 the audit gate that makes post-lock change legitimate rather than silent."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Database Unlock"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DefineRegion",
    "@type": [
      "https://top.scientix.ai/hcls/v1#Action"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Define Region"
      }
    ],
