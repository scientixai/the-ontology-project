    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One class, four scopes (ADR-0024 one-question gate: drug vs document reconciliation is a classification of the act, not a different kind of act). The IMP scope reconciles against the accountability-log projection (supply module) \u2014 arithmetic over events, not a spreadsheet."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Reconciliation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
