      {
        "@language": "en",
        "@value": "device reconciliation"
      },
      {
        "@language": "en",
        "@value": "document reconciliation"
      },
      {
        "@language": "en",
        "@value": "drug reconciliation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The act of confirming that a site's records balance at closeout \u2014 investigational product counts, device counts, essential documents, or open queries. The scope (what is being reconciled) is cr:reconciliationScope, a value."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Reconciliation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "One act, four scopes (IMP/device/documents/queries) \u2014 the scope is a value, never four classes (ADR-0024)."
      }
    ]
  },
