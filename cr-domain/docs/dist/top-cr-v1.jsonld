      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "abstract"
      },
      {
        "@language": "en",
        "@value": "journal article"
      },
      {
        "@language": "en",
        "@value": "manuscript"
      },
      {
        "@language": "en",
        "@value": "paper"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A peer-reviewed article, conference abstract, or preprint disclosing study results \u2014 reporting results that trace to the analysis layer."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Publication"
      }
    ]
