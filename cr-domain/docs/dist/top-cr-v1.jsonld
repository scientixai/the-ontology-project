      {
        "@id": "https://top.scientix.ai/cr/v1#PharmacovigilianceSpecialist"
      }
    ],
    "https://top.scientix.ai/hcls/v1#jobTrigger": [
      {
        "@value": "Aggregate AE data shows unexpected frequency or severity pattern."
      }
    ],
    "https://top.scientix.ai/hcls/v1#successSignal": [
      {
        "@value": "DSMB/IDMC notified if threshold met."
      },
      {
        "@value": "Signal evaluated and action (escalate, monitor, or close) documented within SOP timeline."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DeviationAntecedent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A latent operational condition that predisposes a deviation (e.g. a visit window too tight for the site's staffing). The missing middle between a critical-to-quality factor and the deviation event it manifests as; bitemporal (it exists, and is detected, over time)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Deviation Antecedent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DeviationEvent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A protocol deviation occurrence (departure from the protocol or GCP). Classified by materiality; significant deviations require a CAPA. Bitemporal + attested."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Deviation Event"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "PD"
      },
      {
        "@language": "en",
        "@value": "deviation"
      },
      {
        "@language": "en",
        "@value": "protocol deviation"
      },
      {
        "@language": "en",
        "@value": "protocol violation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Deviation Event"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DispensingEvent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Dispensed TO the pseudonymous Participant (cr:StudySubject), never an identifiable Person \u2014 the PII containment invariant extends to the pharmacy."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Dispensing Event"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "dispensation"
      },
      {
        "@language": "en",
        "@value": "dispensing"
      },
      {
        "@language": "en",
        "@value": "drug dispensing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The handing of investigational product (by kit, from a lot) to a participant at a visit \u2014 the pivotal accountability event."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Dispensing Event"
      }
    ]
  },
