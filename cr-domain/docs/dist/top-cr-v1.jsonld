        "@value": "Validate System"
      }
    ],
    "https://top.scientix.ai/hcls/v1#authorizedAgentType": [
      {
        "@id": "https://top.scientix.ai/cr/v1#SponsorQualityStaff"
      }
    ],
    "https://top.scientix.ai/hcls/v1#occursIn": [
      {
        "@id": "https://top.scientix.ai/cr/v1#ActivationSubPhase"
      }
    ],
    "https://top.scientix.ai/hcls/v1#operatesOn": [
      {
        "@id": "https://top.scientix.ai/cr/v1#Study"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#VendorAlias",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The exemplar of the whole thesis. Resolve once; the next sponsor with the same vendor term auto-resolves. Grounded in the info-model ENCOUNTER_MAPPING / Data-Provider-Visit fields \u2014 deliberately re-modeled."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Vendor Alias"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A vendor's term (column name, visit label, unit string) captured ONLY as a resolution edge into the canonical corpus: cr:vendorTerm (the raw string) + cr:aliasResolvesTo (the canonical concept/encounter/unit) + cr:resolutionConfidence + cr:resolvedFrom provenance. Deliberately NOT a stored per-DTA row \u2014 the DTA group's ENCOUNTER_MAPPING re-modeled as resolution so the corpus compounds."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#VendorConnectorProfile",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Instances grounded in verified public documentation: Castor EDC (OAuth2 REST + CDISC ODM export), Veeva Vault CDMS/CDB (SDE CSV/SAS/XPT + incremental SFF), Medidata Rave (RWS + ODM + audit-ID incremental), Oracle Clinical One (ODM-XML extract, Snapshot/Transactional). See examples/dta-lab-safety/vendor-connectors.ttl."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Vendor Connector Profile"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/cr/v1#TransferProfile"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A TransferProfile pre-populated from a named vendor's documented data-export surface (API/format/terminology), so a sponsor onboarding that vendor starts from a catalog default rather than a blank DTA. The operational counterpart to the compounding alias corpus."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#VerifyCAPAEffectiveness",
    "@type": [
      "https://top.scientix.ai/hcls/v1#Action"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Verify CAPA Effectiveness"
      }
    ],
    "https://top.scientix.ai/hcls/v1#authorizedAgentType": [
      {
        "@id": "https://top.scientix.ai/cr/v1#SponsorQualityStaff"
      }
    ],
    "https://top.scientix.ai/hcls/v1#occursIn": [
      {
        "@id": "https://top.scientix.ai/cr/v1#OversightSubPhase"
      }
    ],
    "https://top.scientix.ai/hcls/v1#operatesOn": [
      {
        "@id": "https://top.scientix.ai/cr/v1#AdverseEvent"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Visit",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A protocol visit \u2014 a kind of study event."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Trial Visit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/cr/v1#StudyEvent"
      },
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#VisitDefinition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The protocol-defined visit template: what is SUPPOSED to happen (type, window, mode, ordering). USDM-ingest-derivable from StudyDesign.encounters[]. UNSCHEDULED visits (urgent care, AE workup) have no VisitDefinition; their VisitOccurrence.definedBy is absent. USDM: Encounter. SDTM projection: SE (Study Elements) domain."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Visit Definition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "https://top.scientix.ai/v1#Scope"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#VisitExecutionSubPhase",
    "@type": [
      "https://top.scientix.ai/hcls/v1#Phase"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Scheduled and unscheduled visit conduct: actuals vs. SOA, activity completion, IP administration, sample collection, CRF completion at visit level."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Visit Execution"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#VisitOccurrence",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An actual protocol visit: what DID happen. Anchored at Participant (1..1) and StudySite (1..1). Optionally definedBy a VisitDefinition (absent for unscheduled visits). FHIR R5: Encounter. SDTM: SV domain (SVSTDTC / SVENDTC / VISITNUM / VISIT). OMOP: VISIT_OCCURRENCE."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Visit Occurrence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      },
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "encounter"
      },
      {
        "@language": "en",
        "@value": "patient visit"
      },
      {
        "@language": "en",
        "@value": "study visit"
      },
      {
        "@language": "en",
        "@value": "visit"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hiddenLabel": [
      {
        "@language": "en",
        "@value": "Encounter"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Visit Occurrence"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "FHIR/USDM 'Encounter' is the standards term (projection layer); the operator word is 'visit'."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Window",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An allowed tolerance around a planned time: a lower and an upper offset in days (e.g. [-2 days, +2 days])."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Window"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ]
  },
