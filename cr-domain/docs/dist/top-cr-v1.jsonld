    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Data Transfer Agreement / Specification extension: vendor non-CRF data transfer as a fact graph. Additive over TOP Core; grounded in the CDISC DDF5a DTA working-group corpus (Scoping Report v54, MVP Inventory, MVP Information Model, LAB Model v2.0)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TOP CR \u2014 DTA/DTS module"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#eCRF",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Electronic case report form \u2014 the data-collection instrument used at the site."
