  {
    "@id": "https://top.scientix.ai/cr/v1#SeriousAdverseEvent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An adverse event meeting seriousness criteria (expedited reporting). ADR-0024 known deviation: seriousness is a judgment against ICH E2A criteria \u2014 the same shape as cr:CausalityAssessment, which the model already promotes to a fact. Slated to become a promoted seriousness assessment with 'SAE' derived as a view, in a dedicated safety-module pass (the expedited-reporting shapes and worked examples currently depend on this class)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Serious Adverse Event"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/cr/v1#AdverseEvent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "SAE"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Serious Adverse Event"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#ServiceProvider",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
