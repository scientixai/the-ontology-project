      {
        "@language": "en",
        "@value": "sign-off"
      },
      {
        "@language": "en",
        "@value": "signature"
      },
      {
        "@language": "en",
        "@value": "signed statement"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Attestation"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#AuditTrail",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://www.ich.org/page/efficacy-guidelines"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Audit Trail"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "audit log"
      },
      {
        "@language": "en",
        "@value": "change history"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Secure, computer- or paper-generated documentation that allows reconstruction of the course of events around a record (paraphrased, ICH E6(R3)). In TOP, the bitemporal + PROV envelope realizes this by construction."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Audit Trail"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#BESH",
    "@type": [
      "https://top.scientix.ai/cr/v1#TrialPhase"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Basic Experimental Studies Involving Humans \u2014 the FDA/NIH-defined category sitting BETWEEN non-human basic research and conventional clinical trials: mechanistic studies that meet the NIH clinical-trial definition (human participants, prospective assignment, intervention, biomedical outcome) but whose aim is understanding a phenomenon, not evaluating a clinical intervention. Registered and disclosed under dedicated FDA/NIH policy. Size: small; sites: academic research settings."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "BESH"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "basic experimental studies involving humans"
      },
      {
        "@language": "en",
        "@value": "basic experimental study with humans"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#BiomedicalConcept",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Reuses CDISC Biomedical Concept anchors as an INPUT (crosswalk targets), not a rival. The concept-first pivot: bind once to the concept; every standard (SDTM/Define/FHIR) is then a projection."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Biomedical Concept"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A canonical, sponsor-agnostic concept a data element binds to (e.g. Sodium). Codes to external terminologies (LOINC, NCIt, SNOMED) are attached as Relationships to dereferenceable URIs via cr:codedAs \u2014 never as string Properties."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#BlindingConstraint",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Grounded in MVP Inventory \u00a75 blinding. A cr:blindingScope value (e.g. 'treatment-assignment', 'unblinded-pk') plus provenance."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Blinding Constraint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Constraint"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The scope and provenance of what is blinded in a transfer, and to whom \u2014 a constraint that drives routing, not a boolean. Replaces the MVP's boolean 'Transfer Blinding'."
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#BriefingBook",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A dossier submitted to the regulator ahead of a meeting (Pre-IND / EOP2)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Briefing Book"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Evidence"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#BudgetContractingWorkStream",
