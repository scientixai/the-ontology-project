      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#DoseLimitingToxicity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Oncology dose-escalation: a DLT informs the next dose decision. ADR-0024 known deviation: 'dose-limiting' is a judgment against protocol criteria, not a kind of event \u2014 slated to become a promoted fact (assessment) with the DLT 'type' derived as a view, in a dedicated safety-module pass."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Dose-Limiting Toxicity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/cr/v1#AdverseEvent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "DLT"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Dose-Limiting Toxicity"
      }
    ]
  },
