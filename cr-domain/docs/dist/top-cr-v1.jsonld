      {
        "@id": "https://top.scientix.ai/cr/v1#Study"
      }
    ]
  },
  {
    "@id": "https://top.scientix.ai/cr/v1#Delegation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "PI delegates a Capability to a Person, gated by a Credential, attested. DOA/training logs are projections of this."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Delegation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://top.scientix.ai/v1#Temporal"
      },
      {
        "@id": "https://top.scientix.ai/v1#Versioned"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "DoA"
      },
      {
        "@language": "en",
        "@value": "delegation of authority"
      },
      {
        "@language": "en",
        "@value": "task delegation"
