    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A bounded body of work with a defined start, end, and objective \u2014 a study, a campaign, a batch, a submission, a commissioning effort."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
