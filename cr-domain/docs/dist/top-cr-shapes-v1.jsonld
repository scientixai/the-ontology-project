      }
    ]
  },
  {
    "@id": "_:cb3875526b2a390968fc49074d71ba6229fda253f868e3de4712c61061d98eed5a4",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Violation: a screen-failure must cite the failed eligibility criterion (cr:failedCriterion)."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/shapes/recruitment-v1"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n                $this cr:screeningOutcome \"screen-failure\" .\n                FILTER NOT EXISTS { $this cr:failedCriterion ?c }\n            }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "_:cb38950f00af3498c4c0b7d704d16b16ddb1d4194aa234c4e4cbb1c209b8014a4e8",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#Arm"
      }
    ],
