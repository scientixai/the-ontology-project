      {
        "@id": "https://top.scientix.ai/cr/v1#AssayDefinition"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Assay result must reference the analysis service that produced it."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#resultOfAssay"
      }
    ]
  },
  {
    "@id": "_:cb3d93c91187e192cc4d05a5a8f3a7613a2d968f002dbf3182e60d193ccf09b8a28",
