      }
    ]
  },
  {
    "@id": "_:cb2209935c7b08a5c795f7c6d90b0da55ff6b2ecaaf28935e053ef755ff1ac757cb",
    "http://www.w3.org/ns/shacl#datatype": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Violation: an unblinding without a recorded reason \u2014 the blind is never silently broken."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#unblindingReason"
      }
    ]
  },
  {
    "@id": "_:cb221ba8d17c55d396b39c196d05b7e4cfc6ef489d1b99fe291b4db46d5be7d4caa",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "API"
          },
          {
            "@value": "BigQuery-direct"
          },
          {
            "@value": "FHIR-API"
          },
          {
            "@value": "FTP"
          },
          {
            "@value": "Manual-upload"
          },
          {
            "@value": "SFTP"
          },
          {
            "@value": "Snowflake-share"
          },
          {
            "@value": "Webhook"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "TransferProfile.transmissionMethod is mandatory and must be in controlled terminology (SFTP | FTP | API | FHIR-API | Webhook | Snowflake-share | BigQuery-direct | Manual-upload)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#transmissionMethod"
      }
    ]
  },
  {
    "@id": "_:cb221f5ce2135f4ba5769f26719a3f0bfdaa6d4621129033c4856fd652918af4da0",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#StatisticalAnalysisPlan"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "EndpointResult must trace to the SAP it was analyzed under."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#analyzedUnder"
      }
    ]
  },
  {
    "@id": "_:cb2224093e2b1e9b644d402245b8359acc621090195bb235cc86814e792be2c21b6",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "cumulative"
          },
          {
            "@value": "incremental"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "TransferProfile.transmissionType is mandatory and must be 'cumulative' or 'incremental'."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#transmissionType"
      }
    ]
  },
  {
    "@id": "_:cb22272a8231e3e70d6f1e5d016e4db52d39621516511c704803076694c27945bab",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Violation: an integrated summary that derives from nothing \u2014 the integrated number must be reproducible to the per-study datasets."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://www.w3.org/ns/prov#wasDerivedFrom"
      }
    ]
  },
  {
    "@id": "_:cb2235e5cb31a16d51f75740428f8a63e1c9b4da335a0783887ddc3a03d0d4a0eb2",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A clinical observation was recorded/changed after a HARD database lock but is not covered by a cr:DatabaseUnlock. Post-lock change must be legitimate (a documented unlock), never silent."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/cr/v1#"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr:  <https://top.scientix.ai/cr/v1#>\n            PREFIX top: <https://top.scientix.ai/v1#>\n            SELECT $this WHERE {\n              $this a cr:ClinicalObservation ; top:observedAt ?od .\n              ?lk a cr:DatabaseLock ; cr:lockType \"hard\" ; top:observedAt ?ld .\n              FILTER ( ?od > ?ld )\n              FILTER NOT EXISTS { $this cr:underUnlock ?u }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb223d9c94c082ef2273c59ad141326d26f4dd885aff729e5d7081f5f3000cc10a8",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Specimen"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A transferred lab result must ride a managed hcls:Specimen (cr:onSpecimen) \u2014 the specimen its lifecycle timestamps describe."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#onSpecimen"
      }
    ]
  },
  {
    "@id": "_:cb224bb9096480b90b17b614cb15fe9e3536a8054d0c9857e053a6224fecaa4f30c",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A quality tolerance limit must state, in operator language, what is measured."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#measuredParameter"
      }
    ]
  },
  {
    "@id": "_:cb227055b0b53f2fd4d64c3b0d1e84e1764433d8e52f01574007b000cffa7e8ebe2",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "PlannedVisit has no cr:windowEnd."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#windowEnd"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "_:cb22894a599e5ad3854f0aff6ea96430d59986b44415510cc33db446a33531e0293",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#ClinicalTrialAgreement"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Activation requires an executed Clinical Trial Agreement."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#cta"
      }
    ]
  },
  {
    "@id": "_:cb230ba48ad015921c82195d620ee306bdbb265119649a8f6253b682c53c5a83f45",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A transferred lab result carries specimen-lifecycle timestamps but its hcls:Specimen has no cr:CustodyEvent chain. The timestamps are a convenience view over the authoritative chain of custody (provenance, not a Biomedical Concept), which must exist."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this cr:onSpecimen ?spec .\n              FILTER NOT EXISTS { ?ce a cr:CustodyEvent ; cr:specimen ?spec }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb2310e0394f0305e1834c9db2daa79f98e6b1876903e23125fbf99d09854e05640",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "cr:DataProcessingAgreement must link to a processor organization via cr:processorOrg."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#processorOrg"
      }
    ]
  },
  {
    "@id": "_:cb233d2bc2db8e1320dae4f56daacd71c588ae3a235ecf9841dce8be4b5361cf678",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "High-risk critical-to-quality factor has no mitigation plan."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#riskLevel> \"high\" .\n              FILTER NOT EXISTS { ?mp <https://top.scientix.ai/cr/v1#mitigates> $this . }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb236d9b6ccb816c3746594b5ae45fe2c2715342abacdb99a0aa8f5f1270846d896",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "AE"
          },
          {
            "@value": "lost-to-follow-up"
          },
          {
            "@value": "other"
          },
          {
            "@value": "subject-decision"
          }
