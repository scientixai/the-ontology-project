      }
    ]
  },
  {
    "@id": "_:cb2fa508ab2b169704223160b095ab852576f5e992be2f3eff4342cbd84314e2b76",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Violation: candidate converted to Participant without an 'eligible' screening outcome."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/shapes/recruitment-v1"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n                $this cr:convertedBy ?enrollment .\n                FILTER NOT EXISTS {\n                    ?sr cr:screensRecruit $this ; cr:screeningOutcome \"eligible\" .\n                }\n            }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
