  {
    "@id": "_:cb2a960bcb215ea7a8849ad73282f336ded0dff1edba922040ddfa2c3205e5b9fea",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Violation: site closure rests on a reconciliation that is 'discrepant' \u2014 resolve (a later balanced reconciliation) before closing."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/shapes/site-closeout-v1"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n                $this cr:closureRestsOnReconciliation ?r .\n                ?r cr:reconciliationOutcome \"discrepant\" .\n            }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
