        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Violation: destruction without a recorded authorizer \u2014 product never silently leaves the accountability chain."
      }
