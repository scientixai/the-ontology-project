  },
  {
    "@id": "_:cb2ed289cbd8a1f822f7eaf73051a0bc5180b07e9a12bbac2e7debf4f6fdc140ee9",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Warning: candidate has no recruitment source (no cr:respondedToCampaign and no cr:recruitmentSource) \u2014 funnel attribution is broken."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/shapes/recruitment-v1"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n                FILTER NOT EXISTS { $this cr:respondedToCampaign ?c }\n                FILTER NOT EXISTS { $this cr:recruitmentSource ?s }\n            }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Warning"
      }
    ]
  },
  {
