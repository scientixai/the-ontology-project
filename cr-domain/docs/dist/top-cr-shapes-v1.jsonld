          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "TransferProfile.fileFormat is mandatory and must be in controlled terminology (SAS-XPT | CSV | Dataset-JSON | ODM-XML | Define-XML | Excel | PDF | FHIR | JSON)."
      }
    ],
