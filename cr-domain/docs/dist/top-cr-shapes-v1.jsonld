  {
    "@id": "_:cb20bf3f237b06a1c4a05e3e3b560058c702b794225a58370d933019d883874ac46",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#CSRSection"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A ClinicalStudyReport must have at least one cr:CSRSection."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
