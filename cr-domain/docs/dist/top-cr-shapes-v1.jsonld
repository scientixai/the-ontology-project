  {
    "@id": "_:cb261cc8c74501ef0aadc08edaf016dd5c8d897d03476311d6a79d06537c94c5650",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "VendorAlias neither resolves to a canonical entity (cr:aliasResolvesTo) nor carries a catalog Attestation (cr:resolutionAttestedBy). An unresolved, unattested vendor term cannot be admitted \u2014 it re-introduces the interpretation node."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/cr/v1#"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this a cr:VendorAlias .\n              FILTER NOT EXISTS { $this cr:aliasResolvesTo ?c }\n              FILTER NOT EXISTS { $this cr:resolutionAttestedBy ?a }\n            }\n        "
      }
    ]
  },
