        "@id": "https://top.scientix.ai/cr/v1#screeningOutcome"
      }
    ]
  },
  {
    "@id": "_:cb21ee07934919c2ab967a1ebf97a7d108ec2c059bcafe660e00a2a008404dd4fde",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "emergency"
          },
          {
            "@value": "planned"
          },
          {
            "@value": "regulatory"
          }
        ]
      }
    ],
