        "@id": "https://top.scientix.ai/cr/v1#SourceDocument"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A certified copy must reference the source document it copies."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#certifiedCopyOf"
      }
    ]
  },
  {
    "@id": "_:cb24f4a78580ac9b43cfabc5310aeda0cfe27cfe034e4cd213ae939bf0f5b670802",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Act exercises a capability with no delegation of that capability to its performer (undelegated work)."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#exercisesCapability> ?cap .\n              $this <https://top.scientix.ai/cr/v1#performedBy> ?p .\n              FILTER NOT EXISTS {\n                ?d a <https://top.scientix.ai/cr/v1#Delegation> ;\n                   <https://top.scientix.ai/cr/v1#delegate> ?p ;\n                   <https://top.scientix.ai/cr/v1#delegatedCapability> ?cap .\n              }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb258fd6f7070e686f0c6b6aea20b5b393362b706af4bdc9d00aa363b7636f1f3f6",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Mapping must reference a TOP/CR-core subject term (IRI)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
