    "http://www.w3.org/ns/shacl#datatype": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A VendorAlias must record the raw vendor string (cr:vendorTerm) it resolves \u2014 provenance for the compounding corpus."
      }
    ],
