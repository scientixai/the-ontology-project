      }
    ]
  },
  {
    "@id": "_:cb21049cf07689bf35b6def468e52cd420989b5a2a5e790f542abc53dbdcb018931",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "ADSL"
          },
          {
            "@value": "BDS"
          },
          {
            "@value": "OCCDS"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "cr:datasetStructure, when declared, must be ADSL, BDS, or OCCDS (CDISC ADaM structure classes)."
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#datasetStructure"
      }
    ]
  },
  {
    "@id": "_:cb2136aba2b420dbb70a5921930fbfb7171082f456ab5d240e39211f68051232b46",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A DataTransferAgreement is ratified by an Attestation that is not backed by a valid Credential (cr:backedByCredential). 'Was this party authorized to make this transfer?' must be answerable from the graph."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/cr/v1#"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this cr:ratifiedBy ?att .\n              FILTER NOT EXISTS { ?att cr:backedByCredential ?cred . ?cred a cr:Credential . }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb2165182e0ae310de0b4d6122217dbdaed931ed6d2bbe8b699e585dbe3f64eaaf6",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#Capability"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Delegation must grant a Capability."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#delegatedCapability"
      }
    ]
  },
  {
    "@id": "_:cb2175b24d59d2dd69d899395bfbefeef962f542617b61eae90b6c743043a9f77cf",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A code assignment must reference the assigned dictionary code by IRI (BYOL)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#assignedCode"
      }
    ]
  },
  {
    "@id": "_:cb21921c1f7383b20c67d2cc26f53394723fb7b2f3f1f8ce7d23a810d9888570713",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "VendorAlias was auto-resolved (has cr:resolutionConfidence) but is missing provenance: it must record prov:wasDerivedFrom (the retained source it was transformed from \u2014 e.g. the original FHIR resource) AND an attributed agent (cr:resolvedBy / prov:wasAttributedTo). A transformed value with no traceable source or author is not admissible."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/cr/v1#"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr:   <https://top.scientix.ai/cr/v1#>\n            PREFIX prov: <http://www.w3.org/ns/prov#>\n            SELECT $this WHERE {\n              $this cr:resolutionConfidence ?c .\n              FILTER ( NOT EXISTS { $this prov:wasDerivedFrom ?src }\n                       || NOT EXISTS { $this prov:wasAttributedTo ?ag } )\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb21c393b7f5e7c9fe36392321c84dbcd33b949cbad9721d0429847399e37c163b3",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "eligible"
          },
          {
            "@value": "screen-failure"
          },
          {
