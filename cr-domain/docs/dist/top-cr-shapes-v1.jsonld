[
  {
    "@id": "_:cb0",
    "http://www.w3.org/ns/shacl#alternativePath": [
      {
        "@list": [
          {
            "@id": "https://top.scientix.ai/tmf/v1#concerns"
          },
          {
            "@id": "https://top.scientix.ai/tmf/v1#defines"
          },
          {
            "@id": "https://top.scientix.ai/tmf/v1#documents"
          },
          {
            "@id": "https://top.scientix.ai/tmf/v1#records"
          }
        ]
      }
    ]
  },
  {
    "@id": "_:cb1052552a5fac75bb8a01850f7330e4a327a2e7d8f997dcee69813672e31d2c0c5",
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#collectedAt"
      }
    ]
  },
  {
    "@id": "_:cb10cc6e59a6d2db7613a5194050e0c4aa4f48010c50c278c5c003f4f0eb8cd8d15",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "PlannedActivity has neither a cr:timing nor an ordering edge (cr:precedes); it is unpositioned."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#timing> ?t . }\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#precedes> ?o . }\n              FILTER NOT EXISTS { ?p <https://top.scientix.ai/cr/v1#precedes> $this . }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb10ed5cf425231f1e69ba12c515226b4b7c0fe6619117321758f382cb27a4a90e3",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "EOP2 meeting lacks a binding agreement and/or a risk register (readiness warning)."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#meetingType> \"EOP2\" .\n              FILTER ( NOT EXISTS { $this <https://top.scientix.ai/cr/v1#producedAgreement> ?a }\n                       || NOT EXISTS { $this <https://top.scientix.ai/cr/v1#hasRiskRegister> ?r } )\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb11334cb11ddf71ee5550f23e888f6dc1d69f871a4d0abf482bedddfe5dc286703",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Actual visit's observedAt falls outside the planned window of the visit it realizes (out-of-window) \u2014 review materiality."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#realizes> ?pv ;\n                    <https://top.scientix.ai/v1#observedAt> ?t .\n              ?pv a <https://top.scientix.ai/cr/v1#PlannedVisit> ;\n                  <https://top.scientix.ai/cr/v1#windowStart> ?ws ;\n                  <https://top.scientix.ai/cr/v1#windowEnd> ?we .\n              FILTER ( ?t < ?ws || ?t > ?we )\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb11a0ced0b1817018b2c024fd9cf89cf2f2ecde9b25a2a398ab16361cc967cfaab",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Warning: publication cites no endpoint result (cr:disclosesResult) \u2014 fine for a design/methods paper, a trace hole for a results paper."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/shapes/disclosure-v1"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n                FILTER NOT EXISTS { $this cr:disclosesResult ?r }\n            }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Warning"
      }
    ]
  },
  {
    "@id": "_:cb11a6dfbf633d422b829d09d0a65a6cabb97e6bd4bebdb2b74f8b60b499e631df9",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "cx:Mapping has cx:inferredBy (LLM-produced) but cx:confirmedBy is absent. Human curation is required before promotion to verified."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/crosswalk/v1#inferredBy> ?agent .\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/crosswalk/v1#confirmedBy> ?curator . }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb11c0e0d79b5789a44a80d7e1222c61856718db5d0adea203544bb47d56981aa55",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Universal DNA: every entity must carry a top:identifier."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/v1#identifier"
      }
    ]
  },
  {
    "@id": "_:cb12728f7cbc1e90c625b7791593fbb13da76d42e13f3eec64f594fca32a6a2645b",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Consent must record who performed it."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#performedBy"
      }
    ]
  },
  {
    "@id": "_:cb1420056ecab70121706c3d6a0ed49d2f0afba89e1882f0a9d38dc5bb0d4306cff",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "cr:RegulatoryInteraction must carry cr:meetingType (Pre-IND, EOP1, EOP2, Type-A/B/C)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#meetingType"
      }
    ]
  },
  {
    "@id": "_:cb14dcfc16ce9fad2423deaac47c6ab5a3cd864586eece468dd417b22399a1e45a7",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "SUSAR submitted after regulatory deadline (submissionDate > reportingDeadline)."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#submissionDate> ?sub ;\n                    <https://top.scientix.ai/cr/v1#reportingDeadline> ?dl .\n              BIND(xsd:date(?dl) AS ?dlDate)\n              FILTER ( ?sub > ?dlDate )\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb15c7e84df20d88114a67c07f970e91ef586f9b1b8353a9dbd228bf8de6bd3a474",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Essential TMF artifact type required by the completeness profile has no current filed artifact \u2014 TMF inspection-incomplete."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this ?reqType WHERE {\n              $this <https://top.scientix.ai/tmf/v1#followsProfile> ?p .\n              ?p <https://top.scientix.ai/tmf/v1#requiresArtifactType> ?reqType .\n              FILTER NOT EXISTS {\n                $this <https://top.scientix.ai/tmf/v1#hasFiledArtifact> ?fa .\n                ?fa <https://top.scientix.ai/tmf/v1#ofType> ?reqType ;\n                    <https://top.scientix.ai/v1#status> \"current\" .\n              }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb162466372680d6d99144b6ea5daf104fd2138c5f8444a0039ada72ec7915c7eef",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "VisitOccurrence.visitStatus=COMPLETED but actualEndDate is missing."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#visitStatus> \"COMPLETED\" .\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#actualEndDate> ?d . }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb162f018c22cd7e4e89a340c7cb52756bde324f33fa3c9de795eee35b4dbafcc69",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "QTL thresholds must be justified (benchmark, simulation, statistical model) \u2014 ICH E6(R3) proportionality."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#thresholdRationale"
      }
    ]
  },
  {
    "@id": "_:cb162fd8d020d6ca2e80526cfbb4484d0515adff3ccea92b67cf944fa8f5fe36efa",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "VendorAlias resolved by a low-confidence match (cr:resolutionConfidence < 0.85) with no catalog Attestation \u2014 route to the attestation queue before admitting. Audit the confident population too, not just this flagged tail."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/cr/v1#"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this cr:resolutionConfidence ?c .\n              FILTER ( ?c < 0.85 )\n              FILTER NOT EXISTS { $this cr:resolutionAttestedBy ?a }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb16520b85700cdba52aad1a51a3eee5a083dd69adddba7385fbd7018e47e9a9934",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "100% SDV applied to a low-risk factor (over-monitoring; consider risk-based reduction)."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#sdvIntensity> ?i ;\n                    <https://top.scientix.ai/cr/v1#mitigates> ?ra .\n              ?ra <https://top.scientix.ai/cr/v1#riskLevel> \"low\" .\n              FILTER ( ?i = 1.0 )\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb168087fed14dea848518f8565d1f91bf0d7df94404534ec4652f8555e32b99da4",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "cr:Assessment must link to the visit during which it was performed (cr:assessedAt). Missing on this assessment."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#assessedAt"
      }
    ]
  },
  {
    "@id": "_:cb16936133d3262b8175662ffb61daf42d93e328cd8e4c9cf6ea082145affbefb60",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Universal DNA: every entity must carry a top:status."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/v1#status"
      }
    ]
  },
  {
    "@id": "_:cb16f0f29c1e55db9195062d632381c6ce7342fc410c670abaf5623ee7eb005818c",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "isolated"
          },
          {
            "@value": "systemic"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A breach must be dispositioned 'systemic' or 'isolated' \u2014 the escalation path depends on it."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#breachDisposition"
      }
    ]
  },
  {
    "@id": "_:cb172c1aef25a2c9c5c00053ab5015ec0f9493e2a8a7b6eae90c06b0751474b051b",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "An eCTDSubmission carries a CSR but not the analysis datasets (cr:includesDataset) and/or the Define-XML (cr:includesDefine). Module 5 datasets should ship with the report a reviewer reads them against."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this a cr:eCTDSubmission .\n              FILTER ( NOT EXISTS { $this cr:includesDataset ?d }\n                       || NOT EXISTS { $this cr:includesDefine ?x } )\n            }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Warning"
      }
    ]
  },
  {
    "@id": "_:cb173a5627d86c02d46a6be82dfe16240a6999ea7b997b338da1572f3d85c3fbdcd",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#StudyEvent"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Observation must reference the StudyEvent it was captured at."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#capturedDuring"
      }
    ]
  },
  {
    "@id": "_:cb173dea6f33ef5651e5d7f36436f972d5f86165cf2ead2414216b8049128ea718b",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A work stream produces an output that does not trace (prov:wasDerivedFrom) to any input."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#produces> ?out .\n              FILTER NOT EXISTS { ?out <http://www.w3.org/ns/prov#wasDerivedFrom> ?in . }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb1753a5c21b33fe07f8e8c48a2c7eee87a8305e9b3308c98fad53483a036d84068",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "cr:RegulatoryInteraction must carry cr:meetingDate."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#meetingDate"
      }
    ]
  },
  {
    "@id": "_:cb175daecd7329007ffc19c50bd96bb44db718e9b93cd8f498f128a85f48600f972",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Deviation event has no recorded antecedent (latent cause not captured)."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              FILTER NOT EXISTS { ?a <https://top.scientix.ai/cr/v1#manifestsAs> $this . }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb17fdc6908da140828e0233324766c49791b835dce5dd81dcf6db4f91d0b8cd653",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "high"
          },
          {
            "@value": "low"
          },
          {
            "@value": "medium"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Impact, when stated, is 'low'|'medium'|'high' (ICH Q9(R1) severity of harm)."
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#impact"
      }
    ]
  },
  {
    "@id": "_:cb18136b029cfc971b212d580b79d4ad25974be3c02def3f067d9ec93d87badb070",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "ProtocolVersion declares no eligibility criteria (design-quality warning)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#hasEligibilityCriterion"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Warning"
      }
    ]
  },
  {
    "@id": "_:cb182f5063c189c097f2d75b29b7b76fdf172878235f7b7b78f201c98413947da37",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Violation: cr:withdrawalDate precedes top:validFrom \u2014 consent cannot be withdrawn before it was recorded."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/shapes/participant-v1"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr:  <https://top.scientix.ai/cr/v1#>\n            PREFIX top: <https://top.scientix.ai/v1#>\n            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n            SELECT $this ?withdrawalDate ?validFrom\n            WHERE {\n                $this cr:withdrawalDate ?withdrawalDate ;\n                      top:validFrom     ?validFrom .\n                FILTER ( ?withdrawalDate < ?validFrom )\n            }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "_:cb1855ea02bea5d08fabba4cce973bca1d012cca7dc2940793e19c8d28acb439a33",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "An eCTDSubmission is built on a database lock that is not a HARD lock. Reversible (soft-locked) data cannot ground a regulatory filing."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this a cr:eCTDSubmission ; cr:builtOnLock ?lk .\n              FILTER NOT EXISTS { ?lk cr:lockType \"hard\" }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb18658ced976334f71e5903b8b04ca1b84d46d064f10be51f07054d7e81975f409",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Warning: autocoded assignment has no human cr:CodingReview \u2014 the autocoder's output is a suggestion, not a judgment, until a coder reviews it."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/shapes/coding-v1"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n                $this cr:codingMethod \"autocoder\" .\n                FILTER NOT EXISTS { ?r cr:reviewsAssignment $this }\n            }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Warning"
      }
    ]
  },
  {
    "@id": "_:cb187edc77cc4b29e1cff0975bedc164cd8ccff2e2b8d8c44939b1dc417e4314b04",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Enrollment must reference the real Person (PII bridge)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#enrolledPerson"
      }
    ]
  },
  {
    "@id": "_:cb188d48e57bfe26f7010f1b1944a2ab89a213eeb4d2a64feae8e3c004fdb5c505e",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "high"
          },
          {
            "@value": "low"
          },
          {
            "@value": "medium"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Detectability, when stated, is 'low'|'medium'|'high'."
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#detectability"
      }
    ]
  },
  {
    "@id": "_:cb18a6a787757b1eca5ce43617b973399606f032e107e8462c6ee17b748ce0a329b",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A DataTransferAgreement references a legal document but does not pin it by content hash (cr:documentHash). The binding legal contract stays prose/DocuSign; the DTA references it by URI + hash + version so the reference cannot silently drift."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/cr/v1#"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this cr:referencesLegalDocument ?doc .\n              FILTER NOT EXISTS { $this cr:documentHash ?h }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb194636ed1df1b9624583ed72da6d2ce4779af147cd7e53c43420024f84c152b7e",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Study carries more than 5 quality tolerance limits \u2014 TransCelerate recommends 3-5 to avoid diluting oversight."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              { SELECT $this (COUNT(?q) AS ?n) WHERE {\n                  $this <https://top.scientix.ai/cr/v1#limitForStudy> ?study .\n                  ?q <https://top.scientix.ai/cr/v1#limitForStudy> ?study .\n                } GROUP BY $this }\n              FILTER ( ?n > 5 )\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb1957d4145b1b114576f5253c3201d986c44db499d6bbeead9ec9126dc5c107775",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "An assessment carrying cr:assessmentResult should also carry cr:assessmentUnit (UCUM code)."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#assessmentResult> ?v .\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#assessmentUnit> ?u . }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb1979cafd6867c1339f4d90831530d56b74217b540c20480b284c667709f0cd990",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#Delegation"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Consent must reference the authorizing Delegation."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#underDelegation"
      }
    ]
  },
  {
    "@id": "_:cb197d63efd5d86d77353d1141eb21517c8e3a71486640ab8c115288ad948346123",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "efficacy"
          },
          {
            "@value": "qol"
          },
          {
            "@value": "safety"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A FollowUpVisit should declare cr:followUpType (safety | efficacy | qol)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#followUpType"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Warning"
      }
    ]
  },
  {
    "@id": "_:cb19c606734300bc9522eea904839da358903257c9fe5e22dfefeca19571c8ad1d4",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "cx:Mapping has cx:inferredBy but cx:mappingMethod is not 'LLMInference'. Set mappingMethod to document provenance correctly."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/crosswalk/v1#inferredBy> ?agent .\n              FILTER NOT EXISTS {\n                $this <https://top.scientix.ai/crosswalk/v1#mappingMethod> \"LLMInference\" .\n              }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb19cd5574ee6c08e6358e4a4ea7f47238b13dd2beb97a82c2a75c7dd9ef42c87f3",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "DataElementSpecification value range is inverted (cr:valueRangeLow > cr:valueRangeHigh)."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/cr/v1#"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this cr:valueRangeLow ?lo ; cr:valueRangeHigh ?hi .\n              FILTER ( ?lo > ?hi )\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb19d0e03ffe2a52cfb5a8e39246b8eba83ad440589082fa8cf6ef70d4be651981e",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A DataElementSpecification with no bound BiomedicalConcept is non-conformant: the SDTM target is a projection of the concept binding, so an unbound element can never be rendered."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#boundConcept"
      }
    ]
  },
  {
    "@id": "_:cb1a27a0ab475b36b001f249386254d5f189ad4751751e70b6c6fc79dd7f92ee84d",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Violation: product dispensed from a lot while a temperature excursion on it is still 'quarantined' (dispensing valid-time after the excursion's)."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/shapes/supply-v1"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr:  <https://top.scientix.ai/cr/v1#>\n            PREFIX top: <https://top.scientix.ai/v1#>\n            SELECT $this WHERE {\n                $this cr:excursionDisposition \"quarantined\" ;\n                      cr:excursionOnLot ?lot ;\n                      top:observedAt ?et .\n                ?d a cr:DispensingEvent ;\n                   cr:dispensesFromLot ?lot ;\n                   top:observedAt ?dt .\n                FILTER ( ?dt > ?et )\n            }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "_:cb1a3ecf1f3af34f928c806c23b6d65e05dc10bb126741adec2fa018fcb1246cb1e",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "VisitOccurrence.atStudySite does not match the forParticipant's forStudySite."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#atStudySite> ?ss ;\n                    <https://top.scientix.ai/cr/v1#forParticipant> ?p .\n              ?p <https://top.scientix.ai/cr/v1#forStudySite> ?pss .\n              FILTER ( ?ss != ?pss )\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb1a859de85ffab63aa198f81de272d8b110e652b219bfa4685a779458826602702",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "An integrated summary must integrate >=1 study (by IRI)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#integratesStudy"
      }
    ]
  },
  {
    "@id": "_:cb1aad94d929e849c00e513de37760752bbbd86db6c671402a9fcfffde2c03b4219",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#IRBApproval"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Activation requires local IRB/IEC approval."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#irbApproval"
      }
    ]
  },
  {
    "@id": "_:cb1ac8e96128e2fafedaf74559c8d407dcc71bd750cc85209f103824648a9b587a3",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Source data has no audit trail (ALCOA++ reconstructability not explicitly asserted)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#hasAuditTrail"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Warning"
      }
    ]
  },
  {
    "@id": "_:cb1aedfb27d625c6893c011a70e2f84650a5aefa543b1552639bb75e7826fc2a453",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#CloseOutVisit"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Violation: site closure without a Close-Out Visit \u2014 a site is closed by evidence, not declaration."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#closureRestsOnCOV"
      }
    ]
  },
  {
    "@id": "_:cb1b06763dad2ae574f7832f0f628a0af223a1d7d44b8514f623118f2a310c5e3ae",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "MedDRA"
          },
          {
            "@value": "WHODrug"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "cr:codingDictionary must be MedDRA or WHODrug."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#codingDictionary"
      }
    ]
  },
  {
    "@id": "_:cb1b28575ac773f6cb8911b7eb2993d9ef64c82e782aa9f75457cfa24d3a8e1a8c3",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Systemic QTL breach has no CSR documentation (cr:reportedIn) \u2014 required in the clinical study report at trial end."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#breachedLimit> ?limit ;\n                    <https://top.scientix.ai/cr/v1#breachDisposition> \"systemic\" .\n              ?limit a <https://top.scientix.ai/cr/v1#QualityToleranceLimit> .\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#reportedIn> ?sec . }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb1b2b6ccb9e33cf980eb5ee20d72852149d3bfe9495552c3bd0bca8021f8c534e9",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A 'go' / 'go-with-modification' decision does not yield a Phase 3 design (cr:yieldsDesign). A go with no forward design is a decision without a consequence."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#decisionOutcome> ?o .\n              FILTER ( ?o IN ( \"go\", \"go-with-modification\" ) )\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#yieldsDesign> ?d }\n            }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Warning"
      }
    ]
  },
  {
    "@id": "_:cb1b7147594d9838c07a11cd4aa39095eab89db62d82d618e16e605df94c0bddd38",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Lot"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Destruction must name the lot it closes out."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#destroysLot"
      }
    ]
  },
  {
    "@id": "_:cb1b88aadf1ccbde2bc13d3a4f8ca47a341145986f2b087965f1a0e2ed741e9c345",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Delegation must name the responsible delegator (PI)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#delegator"
      }
    ]
  },
  {
    "@id": "_:cb1be24319a21f06bc50d846634d87464360418f5738a2491e37357fc9809d7b800",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Acts executed out of the order their planned activities require (cr:precedes violated)."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this   <https://top.scientix.ai/cr/v1#realizes> ?pa ;\n                      <https://top.scientix.ai/v1#observedAt> ?ta .\n              ?pa     <https://top.scientix.ai/cr/v1#precedes> ?pb .\n              ?other  <https://top.scientix.ai/cr/v1#realizes> ?pb ;\n                      <https://top.scientix.ai/v1#observedAt> ?tb .\n              FILTER ( ?ta > ?tb )\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb1bea75ad16a18f3f546aa2ecba376e41ae6e87a29d8a522ebbcc5cb74d6353e14",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#SiteInitiationVisit"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Activation requires a completed Site Initiation Visit."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#siv"
      }
    ]
  },
  {
    "@id": "_:cb1bfaa973cec1498bb746ecc41b0d0cb511cd7300477cbdfb0911862cee83388a1",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "PlannedEncounter has no cr:timing (an encounter must be positioned on the timeline)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#timing"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "_:cb1c03bc8f7aa5761d73d002bf335c4e996bab53777e7caf61b9d56528e6d44a1f5",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#CriticalToQualityFactor"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A quality tolerance limit must guard a named critical-to-quality factor."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#protectsFactor"
      }
    ]
  },
  {
    "@id": "_:cb1c211f1b17467a1b814404f317a93b604d13dcb2b17bb0a5bd1e80d130004372e",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A code assignment must say what it codes (cr:codesEntity)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#codesEntity"
      }
    ]
  },
  {
    "@id": "_:cb1c5dddf1085bccb02e00f57c935040a9a5f184cd16cecd22f72739f7b5ec3a626",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A DataElementSpecification must declare its unit as a dereferenceable UCUM IRI (cr:declaredUnitConcept). A unit that does not resolve to UCUM is non-conformant \u2014 canonical conversion depends on it."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#declaredUnitConcept"
      }
    ]
  },
  {
    "@id": "_:cb1c63404da48fbe2bf911f96dfe28605618fecd09f6dfccf87164d5656ebc39e0b",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#MetricObservation"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A limit breach must rest on at least one metric observation \u2014 no evidence, no breach."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#breachEvidence"
      }
    ]
  },
  {
    "@id": "_:cb1c75b541be4178d8836474786c754acbae8a33f4b9e2b3d07ae382daa87394383",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Recommended TMF artifact type has no current filed artifact \u2014 reviewable completeness gap."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this ?recType WHERE {\n              $this <https://top.scientix.ai/tmf/v1#followsProfile> ?p .\n              ?p <https://top.scientix.ai/tmf/v1#recommendsArtifactType> ?recType .\n              FILTER NOT EXISTS {\n                $this <https://top.scientix.ai/tmf/v1#hasFiledArtifact> ?fa .\n                ?fa <https://top.scientix.ai/tmf/v1#ofType> ?recType ;\n                    <https://top.scientix.ai/v1#status> \"current\" .\n              }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb1c777141f9aeb37bebff18e2a274002fbcfd38d0eef81ad11228e863f2bf21109",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Lot"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "An excursion must name the affected lot."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#excursionOnLot"
      }
    ]
  },
  {
    "@id": "_:cb1c7cbc419462e756ba4aa219c3fdd6f16e655e0f40cfbb43b7f26e6054b480d3a",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "figure"
          },
          {
            "@value": "listing"
          },
          {
            "@value": "table"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "TableListingFigure.tlfType must be 'table', 'listing', or 'figure'."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#tlfType"
      }
    ]
  },
  {
    "@id": "_:cb1c9df96b256d230fd8805990405d7e7bb43cda872d3a0c066997cd1cb440f6cfd",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Observation recorded after the subject's consent withdrawal date (GDPR / ICH E6(R3) concern)."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/v1#validFrom> ?obsDate .\n              ?withdrawal a <https://top.scientix.ai/cr/v1#ConsentWithdrawal> ;\n                          <https://top.scientix.ai/cr/v1#closesConsent> ?consent .\n              ?consent <https://top.scientix.ai/cr/v1#withdrawalDate> ?wd .\n              FILTER ( xsd:date(?obsDate) > ?wd )\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb1cc05a2d94201eb6f76f9d3154153a9a32e1c383dbb91b97ae832e4f40f99520c",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "VendorAlias resolves to a canonical entity but does not pin the reference version it resolved against (cr:resolvedAgainstVersion) \u2014 reference drift could silently re-write meaning."
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://top.scientix.ai/cr/v1#"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this cr:aliasResolvesTo ?c .\n              FILTER NOT EXISTS { $this cr:resolvedAgainstVersion ?v }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb1cc8ab0a3a9692a6bf5a4d2d72eb1b56251c23c2905dd015280fca733d85b3c9d",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#Sponsor"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A Study must have a Sponsor."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#sponsoredBy"
      }
    ]
  },
  {
    "@id": "_:cb1d136d9c1ecbd640b9944ff741f4c6e4c57098946be41c7a96ca930d84749f63b",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "PlannedVisit has no cr:windowStart."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#windowStart"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "_:cb1d20a44b52514998c03a8a88b70c7ed14d4167c0eecb59ccc172d03aa29347f50",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A limit breach must name the limit that was crossed."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#breachedLimit"
      }
    ]
  },
  {
    "@id": "_:cb1d28744bf52912820c8826879bf9e65fec416fe3f5170a57e2530846579d9d32f",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "high"
          },
          {
            "@value": "low"
          },
          {
            "@value": "medium"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Likelihood, when stated, is 'low'|'medium'|'high' (ICH Q9(R1) probability of harm)."
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#likelihood"
      }
    ]
  },
  {
    "@id": "_:cb1d447ac2cc73ac94e982b24687cb7c7492eb387786eafc32f851a225f2179e641",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#ClinicalStudyReport"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "An eCTDSubmission (Module 5) must include a cr:ClinicalStudyReport."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#includesReport"
      }
    ]
  },
  {
    "@id": "_:cb1d5c87f9e95fd3b602cfbc8500c5d9e3655f18ffbe1cdb7de812447d95bd7f597",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "cr:DoseLimitingToxicity must declare a CTCAE grade."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#ctcaeGrade"
      }
    ]
  },
  {
    "@id": "_:cb1d63699400662c162d64e7bfcd41cb77f3633f3cdcfef9d7b84d7cbfb1eb597f5",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Filed artifact has no tmf:ofType \u2014 an unclassified document (cannot bind facts or satisfy a requirement)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/tmf/v1#ofType"
      }
    ]
  },
  {
    "@id": "_:cb1d8035e4c9e93944a4bea7197650c7302e29bf50264b7654c0b6d8354971b56dc",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "dose-selection"
          },
          {
            "@value": "go"
          },
          {
            "@value": "go-with-modification"
          },
          {
            "@value": "no-go"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "AnalysisDecision.decisionOutcome must be 'go', 'no-go', 'go-with-modification', or 'dose-selection'."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#decisionOutcome"
      }
    ]
  },
  {
    "@id": "_:cb1d948be1b6b276e2c85bc8da22828c1cc89f3cf155f4ac24a604824dc93411fd5",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A CSR results section (sectionKind efficacy-results / safety-results) must cr:presentsTLF and/or cr:reportsResult the analysis output it draws its conclusion from. A results conclusion with no backing output is inadmissible."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this a cr:CSRSection ; cr:sectionKind ?k .\n              FILTER ( ?k IN ( \"efficacy-results\", \"safety-results\" ) )\n              FILTER NOT EXISTS { $this cr:presentsTLF ?t }\n              FILTER NOT EXISTS { $this cr:reportsResult ?r }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb1da8ee017e86038dbd3ccded55d8d4c844a1d66dc3d3f94ccb2d590ec901eb209",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Nonclinical finding is not addressed by any clinical-protocol safety assessment (broken IND narrative -> clinical-hold risk)."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this a <https://top.scientix.ai/cr/v1#NonclinicalFinding> .\n              FILTER NOT EXISTS {\n                ?sa a <https://top.scientix.ai/cr/v1#SafetyAssessment> ;\n                    <https://top.scientix.ai/cr/v1#addressesFinding> $this .\n              }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb1dc9cc789e0635590d35f834a5208029273e7e5e9343d354110ef3ba99fac7703",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "definite"
          },
          {
            "@value": "possible"
          },
          {
            "@value": "probable"
          },
          {
            "@value": "unrelated"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "cr:causalityVerdict must be one of: unrelated, possible, probable, definite."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#causalityVerdict"
      }
    ]
  },
  {
    "@id": "_:cb1de4b7ac2a1bc63d04e5fb708a59fbe2165b5a85194d54e742667fc76684c872b",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "VisitOccurrence.windowStatus=OUT_OF_WINDOW but no linked Deviation. Consider documenting as a protocol deviation per ICH E6(R3) \u00a74.5."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#windowStatus> \"OUT_OF_WINDOW\" .\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#associatedDeviation> ?d . }\n            }\n        "
      }
    ]
  },
  {
    "@id": "_:cb1de62641bc5072250b593a7d43947ca31458b7db51126173c792504afcab7235e",
    "http://www.w3.org/ns/shacl#datatype": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Violation: a code assignment without its dictionary version is meaningless at reconciliation and at submission (Define-XML external codelist versioning)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#codingDictionaryVersion"
      }
    ]
  },
  {
    "@id": "_:cb1de9929065dd5cc2f48c8c42e72739ea7a327203dbca79500be7677ab961e17f3",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "efficacy"
          },
          {
            "@value": "safety"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "cr:summaryKind must be 'safety' (ISS) or 'efficacy' (ISE)."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#summaryKind"
      }
    ]
  },
  {
    "@id": "_:cb1e333bcb43eb43a5bb97cb8cff4a886f509077f8519c3b5ee223deff2a967d5b6",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "data-quality"
          },
          {
            "@value": "protocol-compliance"
          },
          {
            "@value": "safety-reporting"
          },
          {
            "@value": "site-performance"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "KRI category must be one of: site-performance | data-quality | protocol-compliance | safety-reporting."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#kriCategory"
      }
    ]
  },
  {
    "@id": "_:cb1e490ea782fbd65ee331a72cf6498a56ea9efc941964540af95e0f6a1ef74f4ba",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/cr/v1#StatisticalAnalysisPlan"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A TableListingFigure must be cr:prespecifiedIn a StatisticalAnalysisPlan. A table with no SAP grounding is post-hoc \u2014 inadmissible when presented as pivotal."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#prespecifiedIn"
      }
    ]
  },
  {
    "@id": "_:cb1e4da446c096b9c374f8dce084de9d0a80ab1e61b64ad23f9782324913e63c9ae",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://top.scientix.ai/hcls/v1#Person"
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "cr:witnessedBy must point to at most one hcls:Person."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 0
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://top.scientix.ai/cr/v1#witnessedBy"
      }
    ]
  },
  {
    "@id": "_:cb1e5b19abc5df7cf6ac7bf001761f093d436640701a7021115b541f0927b800469",
