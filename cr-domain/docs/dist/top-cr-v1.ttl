    top:flavor "Additive" .

cr:resolvedAgainstVersion a owl:DatatypeProperty ;
    rdfs:label "resolved against reference version" ;
    rdfs:comment "The TOP cr/v1 reference version a binding resolved against, so reference drift never silently re-writes meaning (§4 reference-version pinning)." ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:resolvedBy a owl:ObjectProperty ;
    rdfs:label "resolved by" ;
    rdfs:comment "The top:AutonomousAgent that produced an automatic resolution. A kind of prov:wasAttributedTo, so the transforming agent is queryable as provenance. When a human reconciles, a second attribution is appended — the machine step is never overwritten." ;
    rdfs:range top:AutonomousAgent ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
