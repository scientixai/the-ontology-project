    top:flavor "Additive" .

cr:susarUnexpected a owl:DatatypeProperty ;
    rdfs:comment "Deprecated (P6): use cr:ExpectednessAssessment — the judgment, with its authority and the reference safety information it was made against." ;
    owl:deprecated true ;
    top:flavor "Additive" .

cr:targetAccrual a owl:DatatypeProperty ;
    rdfs:label "target accrual" ;
    rdfs:domain cr:StudySite ;
    rdfs:range xsd:integer ;
    top:flavor "Additive" .

cr:targetDate a owl:DatatypeProperty ;
    rdfs:label "target date" ;
    rdfs:domain cr:PlannedVisit ;
    rdfs:range xsd:dateTime ;
    top:flavor "Additive" .

cr:term_ALCOAplus a skos:Concept ;
    rdfs:isDefinedBy <https://www.ich.org/page/efficacy-guidelines> ;
    rdfs:seeAlso cr:AuditTrail ;
    skos:definition "Data-integrity expectations: attributable, legible, contemporaneous, original, accurate, plus complete, consistent, enduring, available (paraphrased, ICH E6(R3) data governance). Realized in TOP by the bitemporal + PROV envelope." ;
    skos:inScheme cr:E6R3Glossary ;
    skos:prefLabel "ALCOA++" .

cr:term_Auditor a skos:Concept ;
    rdfs:isDefinedBy <https://www.ich.org/page/efficacy-guidelines> ;
    rdfs:seeAlso cr:audits ;
    skos:definition "A person conducting a systematic, independent examination of trial activities and documents (paraphrased, ICH E6(R3))." ;
    skos:inScheme cr:E6R3Glossary ;
    skos:prefLabel "Auditor" .

cr:term_Investigator a skos:Concept ;
    rdfs:isDefinedBy <https://www.ich.org/page/efficacy-guidelines> ;
    rdfs:seeAlso cr:principalInvestigator ;
    skos:definition "The person responsible for the conduct of the trial at a trial site (paraphrased, ICH E6(R3))." ;
    skos:inScheme cr:E6R3Glossary ;
    skos:prefLabel "Investigator" .

cr:term_Monitor a skos:Concept ;
    rdfs:isDefinedBy <https://www.ich.org/page/efficacy-guidelines> ;
    rdfs:seeAlso cr:monitors ;
    skos:definition "A person who oversees the progress of the trial and that it is conducted, recorded, and reported per protocol, SOPs, GCP, and regulation (paraphrased, ICH E6(R3))." ;
    skos:inScheme cr:E6R3Glossary ;
    skos:prefLabel "Monitor" .

cr:term_QualityByDesign a skos:Concept ;
    rdfs:isDefinedBy <https://www.ich.org/page/efficacy-guidelines> ;
    rdfs:seeAlso cr:CriticalToQualityFactor ;
    skos:definition "Building quality into trial design and conduct by focusing on factors critical to quality (paraphrased, ICH E6(R3)/E8(R1))." ;
    skos:inScheme cr:E6R3Glossary ;
    skos:prefLabel "Quality by Design" .

cr:threatens a owl:ObjectProperty ;
    rdfs:label "threatens" ;
    rdfs:comment "The critical-to-quality factor this latent condition endangers." ;
    rdfs:domain cr:DeviationAntecedent ;
    rdfs:range cr:CriticalToQualityFactor ;
    top:flavor "Additive" .

cr:thresholdRationale a owl:DatatypeProperty ;
    rdfs:label "threshold rationale" ;
    rdfs:comment "Why the boundary sits where it sits — historical benchmark, statistical simulation, Poisson/lognormal modeling, expert calibration. ICH E6(R3) proportionality: thresholds must be justified, not intuited." ;
    top:flavor "Additive" .

cr:tierBindingsModule a owl:Ontology ;
    rdfs:label "TOP CR — Tier class bindings (generated; RFC 0003 / ADR-0028)" ;
    rdfs:comment "Layer-attribution bindings: each domain-native object subClassOf its parent-layer category so the layer-discipline gate sees a real chain to Core/HCLS. Source: views/tier-map.json." .

cr:timing a owl:ObjectProperty ;
    rdfs:label "timing" ;
    rdfs:comment "The relative-timing rule positioning a planned encounter or activity." ;
    rdfs:range cr:Timing ;
    top:flavor "Additive" .

cr:timingType a owl:DatatypeProperty ;
    rdfs:label "timing type" ;
    rdfs:comment "before | after | fixed — the sense of the offset relative to the anchor." ;
    rdfs:domain cr:Timing ;
    top:flavor "Additive" .

cr:tlfType a owl:DatatypeProperty ;
    rdfs:label "TLF type" ;
    rdfs:comment "Controlled: 'table' | 'listing' | 'figure'." ;
    rdfs:domain cr:TableListingFigure ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:toState a owl:DatatypeProperty ;
    rdfs:label "to state" ;
    rdfs:domain cr:CustodyEvent ;
    top:flavor "Additive" .

cr:tracesToNonclinical a owl:ObjectProperty ;
    rdfs:domain cr:INDApplication ;
    rdfs:range cr:GLPToxReport ;
    top:flavor "Additive" .

cr:transferEnvironment a owl:DatatypeProperty ;
    rdfs:label "transfer environment" ;
    rdfs:comment "Test vs production environment for the transfer." ;
    rdfs:domain cr:TransferProfile ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:transferSchedule a owl:DatatypeProperty ;
    rdfs:label "transfer schedule" ;
    rdfs:comment "Delivery frequency/cadence (e.g. 'weekly', 'daily', 'near-real-time'). USDM does NOT model transfer frequency/timing — this is genuinely new and lives here (open Q4). Temporal is native to TOP, so cadence and windows are first-class, not prose." ;
    rdfs:domain cr:TransferProfile ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:transmissionMethod a owl:DatatypeProperty ;
    rdfs:label "transmission method" ;
    rdfs:comment "How the file is transmitted (e.g. SFTP, API, Snowflake-share). CT-enforced." ;
    rdfs:domain cr:TransferProfile ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:transmissionType a owl:DatatypeProperty ;
    rdfs:label "transmission type" ;
    rdfs:comment "Cumulative vs incremental delivery. CT-enforced." ;
    rdfs:domain cr:TransferProfile ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:trialPhase a owl:ObjectProperty ;
    rdfs:label "trial phase" ;
    rdfs:comment "The development phase of this study (one of the cr:TrialPhase individuals)." ;
    rdfs:domain cr:Study ;
    rdfs:range cr:TrialPhase ;
    top:flavor "Additive" .

cr:triggers a owl:ObjectProperty ;
    rdfs:label "triggers" ;
    rdfs:comment "The corrective/preventive action this deviation triggered." ;
    rdfs:domain cr:DeviationEvent ;
    rdfs:range cr:CAPA ;
    top:flavor "Additive" .

cr:unblindingAuthorizedBy a owl:ObjectProperty ;
    rdfs:label "unblinding authorized by" ;
    rdfs:comment "Who authorized breaking the blind (medical monitor, PI under emergency provisions). Required." ;
    rdfs:domain cr:UnblindingEvent ;
    rdfs:range hcls:Person ;
    top:flavor "Additive" .

cr:unblindingKind a owl:DatatypeProperty ;
    rdfs:label "unblinding kind" ;
    rdfs:comment "Controlled: 'emergency' | 'planned' | 'regulatory'. A value, not a class (ADR-0024)." ;
    rdfs:domain cr:UnblindingEvent ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:unblindingReason a owl:DatatypeProperty ;
    rdfs:label "unblinding reason" ;
    rdfs:comment "Why the blind was broken (e.g. 'SAE management required knowledge of assignment'). Required — an unblinding without a reason is a Violation." ;
    rdfs:domain cr:UnblindingEvent ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:unblindsSubject a owl:ObjectProperty ;
    rdfs:label "unblinds subject" ;
    rdfs:comment "The participant whose assignment this event discloses." ;
    rdfs:domain cr:UnblindingEvent ;
    rdfs:range cr:StudySubject ;
    top:flavor "Additive" .

cr:unboundRationale a owl:DatatypeProperty ;
    rdfs:label "unbound rationale" ;
    rdfs:comment "The documented reason a DataElementSpecification is deliberately NOT bound to a BiomedicalConcept — e.g. a vendor passthrough / escape-hatch column (the template's AUX1–10, CTESTCD/CTEST/CUNIT/CSPEC) for which no canonical concept yet exists. Its presence makes 'unbound' an explicit, auditable choice rather than a silent prose gap: every element is either bound (concept + UCUM unit) or explicitly unbound WITH a reason. Bind, don't describe — and when you can't bind, say why." ;
    rdfs:domain cr:DataElementSpecification ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:underDelegation a owl:ObjectProperty ;
    rdfs:label "under delegation" ;
    rdfs:comment "Links a performed act to the delegation authorizing it (delegation invariant)." ;
    rdfs:range cr:Delegation ;
    top:flavor "Additive" .

cr:underRandomization a owl:ObjectProperty ;
    rdfs:label "under randomization" ;
    rdfs:comment "The randomization event a kit assignment implements — the forward trace from kit to assignment." ;
    rdfs:domain cr:KitAssignment ;
    rdfs:range cr:RandomizationEvent ;
    top:flavor "Additive" .

cr:underUnlock a owl:ObjectProperty ;
    rdfs:label "under unlock" ;
    rdfs:comment "Links a post-lock clinical value (an observation changed/added after a hard lock) to the DatabaseUnlock that authorized it. Its presence is what makes a post-lock change legitimate." ;
    rdfs:range cr:DatabaseUnlock ;
    top:flavor "Additive" .

cr:unlockReason a owl:DatatypeProperty ;
    rdfs:label "unlock reason" ;
    rdfs:comment "The documented reason a locked database was reopened." ;
    rdfs:domain cr:DatabaseUnlock ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:valueRangeHigh a owl:DatatypeProperty ;
    rdfs:label "value range high" ;
    rdfs:domain cr:DataElementSpecification ;
    rdfs:range xsd:decimal ;
    top:flavor "Additive" .

cr:valueRangeLow a owl:DatatypeProperty ;
    rdfs:label "value range low" ;
    rdfs:domain cr:DataElementSpecification ;
    rdfs:range xsd:decimal ;
    top:flavor "Additive" .

cr:vendorApiStyle a owl:DatatypeProperty ;
    rdfs:label "vendor API style" ;
    rdfs:comment "The documented integration style of a VendorConnectorProfile (e.g. 'OAuth2-REST', 'RWS-ODM', 'Snowflake-share', 'BigQuery-direct', 'SFTP'). Descriptive; grounded in public vendor docs." ;
    rdfs:domain cr:VendorConnectorProfile ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:vendorDocumentation a owl:DatatypeProperty ;
    rdfs:label "vendor documentation" ;
    rdfs:comment "URL of the public documentation a VendorConnectorProfile was grounded in (provenance for the connector default)." ;
    rdfs:domain cr:VendorConnectorProfile ;
    rdfs:range xsd:anyURI ;
    top:flavor "Additive" .

cr:vendorTerm a owl:DatatypeProperty ;
    rdfs:label "vendor term" ;
    rdfs:comment "The raw vendor string (column name, visit label, unit) captured on a VendorAlias resolution edge." ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:verbatimTerm a owl:DatatypeProperty ;
    rdfs:label "verbatim term" ;
    rdfs:comment "The investigator's words, exactly as captured ('achy joints', 'baby aspirin')." ;
    rdfs:domain cr:CodeAssignment ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:verifiedBy a owl:ObjectProperty ;
    rdfs:comment "The monitor who source-verified the value (SDV)." ;
    rdfs:domain cr:ClinicalObservation ;
    rdfs:range hcls:Person ;
    top:flavor "Additive" .

cr:warningThreshold a owl:DatatypeProperty ;
    rdfs:label "warning threshold" ;
    rdfs:comment "KRI boundary at which a site is flagged for attention (statistical-process-control warning limit, e.g. 2 SD from benchmark)." ;
    rdfs:domain cr:KeyRiskIndicator ;
    rdfs:range xsd:decimal ;
    top:flavor "Additive" .

cr:whodrugAtcClass a owl:ObjectProperty ;
    rdfs:label "WHODrug ATC class" ;
    rdfs:comment "IRI reference to the ATC classification the coded product carries. BYOL." ;
    top:flavor "Additive" .

cr:whodrugCode a owl:ObjectProperty ;
    rdfs:label "WHODrug code" ;
    rdfs:comment "IRI reference to a WHODrug medicinal-product record. BYOL; no licensed content reproduced." ;
    top:flavor "Additive" .

cr:whodrugVersion a owl:DatatypeProperty ;
    rdfs:label "WHODrug version" ;
    rdfs:comment "The WHODrug release used (e.g. 'GLOBAL B3 Mar 2026')." ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:window a owl:ObjectProperty ;
    rdfs:label "window" ;
    rdfs:domain cr:Timing ;
    rdfs:range cr:TimingWindow ;
    top:flavor "Additive" .

cr:windowEnd a owl:DatatypeProperty ;
    rdfs:label "window end" ;
    rdfs:domain cr:PlannedVisit ;
    rdfs:range xsd:dateTime ;
    top:flavor "Additive" .

cr:windowLowerDays a owl:DatatypeProperty ;
    rdfs:label "window lower (days)" ;
    rdfs:domain cr:TimingWindow ;
    rdfs:range xsd:decimal ;
    top:flavor "Additive" .

cr:windowStart a owl:DatatypeProperty ;
    rdfs:label "window start" ;
    rdfs:domain cr:PlannedVisit ;
    rdfs:range xsd:dateTime ;
    top:flavor "Additive" .

cr:windowUpperDays a owl:DatatypeProperty ;
    rdfs:label "window upper (days)" ;
    rdfs:domain cr:TimingWindow ;
    rdfs:range xsd:decimal ;
    top:flavor "Additive" .

cr:withdrawalDate a owl:DatatypeProperty ;
    rdfs:label "withdrawal date" ;
    rdfs:comment "Calendar date on which consent was withdrawn, if applicable." ;
    rdfs:domain cr:InformedConsent ;
    rdfs:range xsd:date .

cr:withdrawalReason a owl:DatatypeProperty ;
    rdfs:label "withdrawal reason" ;
    rdfs:comment "Coded reason: subject-decision, AE, lost-to-follow-up, or other." ;
    rdfs:domain cr:ConsentWithdrawal ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:witnessedBy a owl:ObjectProperty ;
    rdfs:label "witnessed by" ;
    rdfs:comment "The person who witnessed the consent signing." ;
    rdfs:domain cr:InformedConsent ;
    rdfs:range hcls:Person .

cr:yieldsDesign a owl:ObjectProperty ;
    rdfs:label "yields design" ;
    rdfs:comment "The Phase3Design a 'go' (or 'go-with-modification') decision produces — the consequence edge that makes a go-decision actionable." ;
    rdfs:domain cr:AnalysisDecision ;
    rdfs:range cr:Phase3Design ;
    top:flavor "Additive" .

cr:yieldsResult a owl:ObjectProperty ;
    rdfs:label "yields result" ;
    rdfs:comment "An assay result that traces to this collection act (forward of cr:derivedFromCollection)." ;
    rdfs:domain cr:StudyEvent ;
    rdfs:range cr:AssayResult ;
    owl:inverseOf cr:derivedFromCollection ;
    top:flavor "Additive" .

<https://top.scientix.ai/cr/v1/actions> a owl:Ontology ;
    dcterms:description "The authorized-operation layer: 78 hcls:Action archetypes (who may do what, in which trial stage, on what) grounding agent authorization queries." ;
    dcterms:title "CR-core — action catalog" .

<https://top.scientix.ai/cr/v1/adam> a owl:Ontology ;
    dcterms:description "ADaM's value is reproducibility: every analysis result traces to its source. In this reference the chain is result -> analysis dataset -> NATIVE source facts (via W3C PROV wasDerivedFrom) — traceability to the one source of truth, not the fragile SDTM-document -> ADaM-document chain. SDTM and ADaM are both views of the native graph. v1.1 adds the CDISC ADaM structural vocabulary: the dataset's structure class (ADSL / BDS / OCCDS — a CLASSIFICATION carried as a value, ADR-0024) and the analysis variable / parameter layer (PARAMCD) that BDS datasets pivot on." ;
    dcterms:title "CR-core — ADaM analysis layer & traceability" ;
    owl:versionInfo "1.1" .

<https://top.scientix.ai/cr/v1/coding> a owl:Ontology ;
    dcterms:description "The coding WORKFLOW the term crosswalks alone don't carry (Operating Model §3.2): a code assignment is a promoted JUDGMENT — 'this verbatim term means this dictionary code' — with its method (autocoder vs manual), its coder, and its review. The existing cr:meddra* properties record WHERE an event landed in MedDRA; this module records WHO decided that, HOW, and whether a human reviewed it. WHODrug joins MedDRA as a BYOL (bring-your-own-license) IRI reference — no licensed content is reproduced. NOTICE: MedDRA is © MSSO/ICH; WHODrug is © Uppsala Monitoring Centre; both require valid licences to resolve." ;
    dcterms:title "CR-core — medical coding workflow (MedDRA / WHODrug)" ;
    owl:versionInfo "1.0" .

<https://top.scientix.ai/cr/v1/deviation> a owl:Ontology ;
    dcterms:description "Deviation events, antecedents, risk signals, and corrective/preventive actions — the quality-event chain." ;
    dcterms:title "CR-core — protocol deviations & CAPA" .

<https://top.scientix.ai/cr/v1/disclosure> a owl:Ontology ;
    dcterms:description "Two submission-and-transparency layers the CSR/eCTD spine didn't carry (Operating Model §3.4): (1) the Integrated Summaries of Safety and Efficacy (ISS/ISE) — cross-study analyses that rest on the per-study locked datasets; the summary KIND is a value, not a class (ADR-0024). (2) The public-disclosure obligations: the trial-registry record (ClinicalTrials.gov / EUCTR — registration, results posting) and publications. Disclosure artifacts are projections of already-produced results, never new sources of truth — the same manifest discipline as the eCTD." ;
    dcterms:title "CR-core — integrated summaries & disclosure" ;
    owl:versionInfo "1.0" .

<https://top.scientix.ai/cr/v1/edc> a owl:Ontology ;
    dcterms:description "Electronic data capture: eCRF, clinical observations, queries, source data verification." ;
    dcterms:title "CR-core — EDC & clinical observations" .

<https://top.scientix.ai/cr/v1/eop2> a owl:Ontology ;
    dcterms:description "The EOP2 gate: analysis decisions, briefing evidence, go/no-go conclusions." ;
    dcterms:title "CR-core — End-of-Phase-2 decision" .

<https://top.scientix.ai/cr/v1/gcp> a owl:Ontology ;
    rdfs:label "TOP CR — ICH E6(R3) GCP definitional layer" ;
    dcterms:rights "Independent derivative adaptation of the ICH E6(R3) Guideline. The classes, properties, and SKOS concepts here are an adaptation (structure + paraphrased definitions), not a reproduction. NOT endorsed or sponsored by ICH. The original ICH E6(R3) document is copyright © ICH." ;
    dcterms:source "ICH E6(R3) Good Clinical Practice (Step 4, adopted January 2025): Principles, Glossary, and Annex 1 (interventional trials). Annex 2 (additional/non-traditional data sources) is NOT modeled in this version." ;
    rdfs:comment "Changes made: ICH E6(R3) terms are reorganized into an OWL/SKOS structure, definitions are paraphrased, and obligations are expressed as SHACL shapes rather than encoded text. Each derived term carries rdfs:isDefinedBy the ICH efficacy-guidelines source." .

<https://top.scientix.ai/cr/v1/lims> a owl:Ontology ;
    dcterms:description "Lab orders, assay definitions, specimens, custody chain, and assay results." ;
    dcterms:title "CR-core — laboratory & specimens" .

<https://top.scientix.ai/cr/v1/participant> a owl:Ontology ;
    dcterms:description "Extends CR-core with InformedConsent enrichment (US-500-003): consentVersion, consentFormIRI, witnessedBy, withdrawalDate. Property-only module: the classes these properties describe (cr:InformedConsent, cr:StudySubject, cr:Enrollment, cr:EligibilityCriterion) are defined once, in cr-core.ttl." ;
    dcterms:title "CR-core ontology — participant & consent module" ;
    owl:versionInfo "1.5" .

<https://top.scientix.ai/cr/v1/phases> a owl:Ontology ;
    dcterms:description "Two deliberately separated concepts: cr:TrialPhase (Phase 1-4, BESH — classification of the study) and cr:TrialStage (startup/conduct/closeout — position in execution)." ;
    dcterms:title "CR-core — trial phases & trial stages" .

<https://top.scientix.ai/cr/v1/preind> a owl:Ontology ;
    dcterms:description "Pre-IND meetings, briefing books, regulatory questions and positions, the IND 30-day clock." ;
    dcterms:title "CR-core — pre-IND & regulatory interactions" .

<https://top.scientix.ai/cr/v1/privacy> a owl:Ontology ;
    dcterms:description "PII boundary vocabulary: lawful bases, data categories, pseudonymization discipline." ;
    dcterms:title "CR-core — privacy & lawful basis" .

<https://top.scientix.ai/cr/v1/randomization> a owl:Ontology ;
    dcterms:description "The events an IxRS/RTSM system records, modeled as first-class bitemporal facts (Operating Model §2.3): the randomization act (subject → arm, under a stratum), the kit assignment that keeps the blind, and the audited unblinding event. The design-time ratio stays on the study (cr:randomizationRatio); these are the EXECUTION events. An unblinding without a recorded reason and authorization is the pharmacovigilance breach every inspector checks first — modeled exactly like cr:DatabaseUnlock: an audited event, never a silent state flip." ;
    dcterms:title "CR-core — randomization & blinding (IxRS/RTSM events)" ;
    owl:versionInfo "1.0" .

<https://top.scientix.ai/cr/v1/rbqm> a owl:Ontology ;
    dcterms:description "The ICH E6(R3)/Q9(R1) RBQM cycle: CtQ factors, risk assessments, QTLs, KRIs, metric observations, limit breaches, mitigation and review." ;
    dcterms:title "CR-core — risk-based quality management" .

<https://top.scientix.ai/cr/v1/recruitment> a owl:Ontology ;
    dcterms:description "The funnel from outreach to enrolled participant (Operating Model §2.2–2.3): campaign → candidate → pre-screening → screening → conversion. The candidate (cr:Recruit) is a SITE-BOUNDARY identity like hcls:Person — PII-side, never referenced by downstream clinical data; conversion to the pseudonymous cr:StudySubject happens only through the attested cr:Enrollment bridge. Screen failure is an OUTCOME VALUE, not a class (ADR-0024 one-question gate: a classification of a screening, not a kind of thing)." ;
    dcterms:title "CR-core — recruitment & screening funnel" ;
    owl:versionInfo "1.0" .

<https://top.scientix.ai/cr/v1/regulatory> a owl:Ontology ;
    dcterms:description "Regulatory laws and lawful bases the domain cites (ICH E6(R3), 21 CFR Part 11, GDPR) as named individuals." ;
    dcterms:title "CR — regulatory constraints" .

<https://top.scientix.ai/cr/v1/roles> a owl:Ontology ;
    dcterms:description "OWL agent-type classes (site- and sponsor-boundary) and the JTBD catalog binding operator intent to authorized actions." ;
    dcterms:title "CR-core — agent types & jobs-to-be-done" .

<https://top.scientix.ai/cr/v1/safety> a owl:Ontology ;
    dcterms:description "Adverse events, SAEs, causality and expectedness assessments, expedited reporting clocks." ;
    dcterms:title "CR-core — safety & pharmacovigilance" .

<https://top.scientix.ai/cr/v1/schedule> a owl:Ontology ;
    dcterms:description "The bitemporal SoA: planned visits and activities, amendments, as-of reconstruction." ;
    dcterms:title "CR-core — schedule of activities" .

<https://top.scientix.ai/cr/v1/site-closeout> a owl:Ontology ;
    dcterms:description "The SITE-side of closeout (Operating Model §3.1) — the counterpart of the data-side database lock: the Close-Out Visit, the reconciliations (drug, device, documents, queries — the SCOPE is a value, not four classes, ADR-0024), the Investigator Site File whose completeness gates closure, the archival with its retention clock, and the site-closure record that must rest on all of it. A closure without a Close-Out Visit and completed reconciliations is a Violation — a site is closed by evidence, not by declaration." ;
    dcterms:title "CR-core — site closeout" ;
    owl:versionInfo "1.0" .

<https://top.scientix.ai/cr/v1/startup> a owl:Ontology ;
    dcterms:description "Site activation and its prerequisites: IRB approval, CTA, SIV; enrollment-before-activation is the flagship violation." ;
    dcterms:title "CR-core — site activation" .

<https://top.scientix.ai/cr/v1/startup-package> a owl:Ontology ;
    dcterms:description "Startup artifacts, work streams, and the derivation chain from package to activation prerequisites." ;
    dcterms:title "CR-core — study startup package" .

<https://top.scientix.ai/cr/v1/supply> a owl:Ontology ;
    dcterms:description "The investigational-product custody events (Operating Model §2.1/§2.4/§3.1): shipment to site, dispensing to a participant, return, and authorized destruction — each a first-class bitemporal event on an hcls:Lot. The ACCOUNTABILITY LOG IS A PROJECTION of these events (like the DoA log), never a maintained spreadsheet: reconcile-ability is a query over the event chain. A temperature excursion is a promoted fact that quarantines what it touched." ;
    dcterms:title "CR-core — drug supply & IMP accountability" ;
    owl:versionInfo "1.0" .

<https://top.scientix.ai/cr/v1/thesaurus> a owl:Ontology ;
    dcterms:title "TOP CR — operator thesaurus (dialects, acronyms, routing)" ;
    rdfs:comment "Controlled-vocabulary + thesaurus layer for the CR domain (ADR-0024; first-principles P7 layers 1 and 4). Labels only — no classes or properties are defined here." ;
    owl:versionInfo "1.0" .

<https://top.scientix.ai/cr/v1/tmf-onboarding> a owl:Ontology ;
    dcterms:description "Trial Master File onboarding: expected-essential artifact sets and the filed-set diff." ;
    dcterms:title "TMF — onboarding & completeness" .

<https://top.scientix.ai/cr/v1/tmf-reference> a owl:Ontology ;
    dcterms:description "TMF artifact types aligned by name to the DIA TMF Reference Model (licensed; no text reproduced)." ;
    dcterms:title "TMF — artifact type reference" .

<https://top.scientix.ai/cr/v1/visit-execution> a owl:Ontology ;
    dcterms:description "Actual visit conduct against the SoA: performed activities, missed visits, visit-level capture." ;
    dcterms:title "CR-core — visit execution" .

cx: a owl:Ontology ;
    rdfs:label "TOP crosswalk vocabulary (SSSOM-aligned)" ;
    rdfs:comment "OWNED, provenance-tagged crosswalks from TOP/CR-core to external ontologies. Aligns to SSSOM slots (subject_id/predicate_id/object_id/mapping_justification/confidence/author_id/mapping_date); an SSSOM TSV is an edge projection of these. Crosswalks are assertions WE own and curate, never imports of the external ontology." .

cx:author a owl:ObjectProperty ;
    rdfs:label "author id" ;
    rdfs:comment "The curator/agent IRI (SSSOM author_id)." ;
    top:flavor "Additive" .

cx:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence" ;
    rdfs:range xsd:decimal ;
    top:flavor "Additive" .

cx:confirmedAt a owl:DatatypeProperty ;
    rdfs:label "confirmed at" ;
    rdfs:comment "Timestamp when a mapping was confirmed by a human reviewer. Together with cx:confirmedBy, closes the audit trail for human-in-the-loop validation." ;
    rdfs:range xsd:dateTime ;
    top:flavor "Additive" .

cx:confirmedBy a owl:ObjectProperty ;
    rdfs:label "confirmed by" ;
    rdfs:comment "The human agent (or committee) that reviewed and confirmed a proposed mapping. Required for promotion from 'under_review' to 'confirmed'.",
        "The human curator (prov:Person IRI) who reviewed and approved an LLM-inferred mapping. Required before verificationStatus may be set to 'verified'." ;
    rdfs:domain cx:Mapping ;
    top:flavor "Additive" .

cx:inferredBy a owl:ObjectProperty ;
    rdfs:label "inferred by" ;
    rdfs:comment "The LLM agent (prov:SoftwareAgent IRI) that produced this mapping candidate. Presence triggers the SHACL HITL gate.",
        "The top:AutonomousAgent instance that proposed this mapping via LLM inference. Enables provenance tracing back to the agent model and prompt version." ;
    rdfs:domain cx:Mapping ;
    top:flavor "Additive" .

cx:justification a owl:ObjectProperty ;
    rdfs:label "mapping justification" ;
    rdfs:comment "A semapv justification IRI (e.g. ManualMappingCuration)." ;
    top:flavor "Additive" .

cx:mappingDate a owl:DatatypeProperty ;
    rdfs:label "mapping date" ;
    rdfs:range xsd:date ;
    top:flavor "Additive" .

cx:mappingMethod a owl:DatatypeProperty ;
    rdfs:label "mapping method" ;
    rdfs:comment "Free-text tag describing how the mapping was produced. Controlled values: 'ManualCuration', 'LLMInference', 'LexicalMatching', 'LogicalReasoning'.",
        "How the mapping was produced: ManualCuration | LLMInference | RuleBasedExtraction | HybridReview. Drives downstream trust and routing." ;
    rdfs:domain cx:Mapping ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cx:mappingRationale a owl:DatatypeProperty ;
    rdfs:label "mapping rationale" ;
    rdfs:comment "Human-readable explanation of why this mapping was proposed, especially for LLM-inferred mappings. Mirrors top:rationale on a Conclusion." ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cx:objectId a owl:ObjectProperty ;
    rdfs:label "object id" ;
    rdfs:comment "The external ontology term (right side)." ;
    top:flavor "Additive" .

cx:predicateId a owl:ObjectProperty ;
    rdfs:label "predicate id" ;
    rdfs:comment "SKOS mapping predicate." ;
    top:flavor "Additive" .

cx:retrievedFrom a owl:DatatypeProperty ;
    rdfs:label "retrieved from" ;
    rdfs:comment "The primary source the target IRI was verified against (URL + retrieval date)." ;
    top:flavor "Additive" .

cx:reviewStatus a owl:DatatypeProperty ;
    rdfs:label "review status" ;
    rdfs:comment "Lifecycle state of the mapping: proposed | under_review | confirmed | rejected | deprecated. Confirmed mappings graduate from ephemeral inference to Layer-2 crosswalk." ;
    top:flavor "Additive" .

cx:subjectId a owl:ObjectProperty ;
    rdfs:label "subject id" ;
    rdfs:comment "The TOP/CR-core term (left side)." ;
    top:flavor "Additive" .

cx:verificationStatus a owl:DatatypeProperty ;
    rdfs:label "verification status" ;
    rdfs:comment "verified | unverified | deprecated — whether the target IRI was confirmed against a primary source." ;
    top:flavor "Additive" .

hcls: a owl:Ontology ;
    rdfs:label "HCLS-core" ;
    rdfs:comment "Mid-layer specializing TOP Core for entities that recur across >=2 HCLS domains (clinical research, hospital, manufacturing, pharmacovigilance, RWE, commercialization). Seeded minimally; grows by promotion (rule of three). Standards projection target: FHIR, OMOP." .

hcls:Questionnaire a owl:Class ;
    rdfs:label "Questionnaire" ;
    rdfs:comment "A structured data-capture instrument (a form / questionnaire). HCLS-universal: recurs across clinical-research, clinical-care, and registries (rule of three; RFC 0003 / ADR-0028). The instrument is a definitional artifact, distinct from the responses it collects — a completed response is an hcls:Observation set. Standards projection target: HL7 FHIR Questionnaire." ;
    rdfs:subClassOf top:Document .

hcls:Substance a owl:Class ;
    rdfs:label "Substance" ;
    rdfs:comment "A chemical or biological substance." ;
    rdfs:subClassOf top:Resource .

hcls:actsAs a owl:DatatypeProperty ;
    rdfs:label "acts as" ;
    rdfs:comment "At instance-graph time, a human-readable label for the contextual role a Person plays within a Scope (Study, Site, Care Episode). Not a class; purely a string annotation on the Person-Scope binding. Example value: 'Principal Investigator'." ;
    rdfs:domain hcls:Person ;
    top:flavor "Additive" .

hcls:affiliatedWith a owl:ObjectProperty ;
    rdfs:label "affiliated with" ;
    rdfs:domain hcls:Person ;
    rdfs:range hcls:Organization ;
    top:flavor "Additive" .

hcls:authorizedAgentType a owl:ObjectProperty ;
    rdfs:label "authorized agent type" ;
    rdfs:comment "The OWL class of agent authorized to execute this Action. Authorization binds directly to agent type — no OperatorRole intermediary. Multi-valued: an Action may be authorized for more than one agent type." ;
    rdfs:domain hcls:Action ;
    rdfs:range owl:Class ;
    top:flavor "Additive" .

hcls:collectedFrom a owl:ObjectProperty ;
    rdfs:label "collected from" ;
    rdfs:domain hcls:Specimen ;
    rdfs:range hcls:Person ;
    top:flavor "Additive" .

hcls:consentSubject a owl:ObjectProperty ;
    rdfs:label "consent subject" ;
    rdfs:domain hcls:Consent ;
    rdfs:range hcls:Person ;
    top:flavor "Additive" .

hcls:executesAction a owl:ObjectProperty ;
    rdfs:label "executes action" ;
    rdfs:comment "An Action performed as part of accomplishing this job." ;
    rdfs:domain hcls:JobToBeDone ;
    rdfs:range hcls:Action ;
    top:flavor "Additive" .

hcls:givesConsent a owl:ObjectProperty ;
    rdfs:label "gives consent" ;
    rdfs:domain hcls:Person ;
    rdfs:range hcls:Consent ;
    top:flavor "Additive" .

hcls:involvesObject a owl:ObjectProperty ;
    rdfs:label "involves object" ;
    rdfs:comment "An entity class that participates in this job's object graph." ;
    rdfs:domain hcls:JobToBeDone ;
    rdfs:range owl:Class ;
    top:flavor "Additive" .

hcls:jobOfAgentType a owl:ObjectProperty ;
    rdfs:label "job of agent type" ;
    rdfs:comment "The OWL class of agent this job belongs to." ;
    rdfs:domain hcls:JobToBeDone ;
    rdfs:range owl:Class ;
    top:flavor "Additive" .

hcls:jobTrigger a owl:DatatypeProperty ;
    rdfs:label "job trigger" ;
    rdfs:comment "The condition or event that initiates this job (from OOUX JTBD 'trigger' field)." ;
    rdfs:domain hcls:JobToBeDone ;
    top:flavor "Additive" .

hcls:locatedAt a owl:ObjectProperty ;
    rdfs:label "located at" ;
    rdfs:domain hcls:Organization ;
    rdfs:range hcls:HealthcareFacility ;
    top:flavor "Additive" .

hcls:operatesOn a owl:ObjectProperty ;
    rdfs:label "operates on" ;
    rdfs:comment "The OWL class of the primary entity this Action targets. Enables querying: what Actions are available on a given entity type for a given agent type in a given stage?" ;
    rdfs:domain hcls:Action ;
    rdfs:range owl:Class ;
    top:flavor "Additive" .

hcls:realizationOf a owl:ObjectProperty ;
    rdfs:label "realization of" ;
    rdfs:comment "Links a prov:Activity instance (an occurrence that actually happened) to the hcls:Action archetype it realizes. Instance-to-archetype traceability link." ;
    rdfs:range hcls:Action ;
    top:flavor "Additive" .

hcls:successSignal a owl:DatatypeProperty ;
    rdfs:label "success signal" ;
    rdfs:comment "A measurable indicator that the job has been completed. Multi-valued." ;
    rdfs:domain hcls:JobToBeDone ;
    top:flavor "Additive" .

ns1:CAPALog a ns1:TMFArtifactType ;
    rdfs:label "CAPA Log" ;
    skos:broader ns1:Zone_TrialManagement ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "CAPA Log" ;
    ns1:records cr:CAPA .

ns1:CoreStartupProfile a ns1:CompletenessProfile ;
    rdfs:label "Core site start-up essential-documents profile" ;
    rdfs:comment "The TMF artifact types expected for a site at activation — the ICH E6 essential-documents-before-the-trial checklist, as reusable data. Aligned by name to the DIA TMF Reference Model; not transcribed from the licensed model." ;
    ns1:recommendsArtifactType ns1:CurriculumVitae,
        ns1:MonitoringPlan ;
    ns1:requiresArtifactType ns1:ClinicalTrialAgreementDoc,
        ns1:Form1572,
        ns1:IRBApprovalLetter,
        ns1:InformedConsentForm,
        ns1:Protocol ;
    top:identifier "tmf:profile/core-startup" ;
    top:status "active" .

ns1:DataManagementPlan a ns1:TMFArtifactType ;
    rdfs:label "Data Management Plan" ;
    skos:broader ns1:Zone_TrialManagement ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Data Management Plan" ;
    ns1:documents cr:DataElementDef .

ns1:DelegationOfAuthorityLog a ns1:TMFArtifactType ;
    rdfs:label "Delegation of Authority Log" ;
    skos:broader ns1:Zone_SiteManagement ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Delegation of Authority Log" ;
    ns1:records cr:Delegation .

ns1:FinancialDisclosureForm a ns1:TMFArtifactType ;
    rdfs:label "Financial Disclosure Form" ;
    skos:broader ns1:Zone_SiteManagement ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Financial Disclosure Form" ;
    ns1:documents cr:StudySite .

ns1:InvestigatorBrochure a ns1:TMFArtifactType ;
    rdfs:label "Investigator Brochure" ;
    skos:broader ns1:Zone_CentralTrialDocs ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Investigator Brochure" ;
    ns1:documents cr:InvestigationalProduct .

ns1:ProtocolDeviationLog a ns1:TMFArtifactType ;
    rdfs:label "Protocol Deviation Log" ;
    skos:broader ns1:Zone_TrialManagement ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Protocol Deviation Log" ;
    ns1:records cr:DeviationEvent .

ns1:SAEReport a ns1:TMFArtifactType ;
    rdfs:label "SAE Report" ;
    skos:broader ns1:Zone_SafetyReporting ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "SAE Report" ;
    ns1:records cr:SafetyReport .

ns1:ScheduleOfActivities a ns1:TMFArtifactType ;
    rdfs:label "Schedule of Activities" ;
    skos:broader ns1:Zone_CentralTrialDocs ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Schedule of Activities" ;
    ns1:defines cr:ScheduleTimeline .

ns1:SiteActivationManual a ns1:TMFArtifactType ;
    rdfs:label "Site Activation Manual" ;
    skos:broader ns1:Zone_TrialManagement ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Site Activation Manual" ;
    ns1:documents cr:SiteActivation .

ns1:defines a owl:ObjectProperty ;
    rdfs:label "defines" ;
    rdfs:comment "The artifact establishes/specifies the entity (e.g. a Protocol defines the CtQ factors)." ;
    rdfs:subPropertyOf ns1:concerns ;
    top:flavor "Additive" .

ns1:documents a owl:ObjectProperty ;
    rdfs:label "documents" ;
    rdfs:comment "The artifact describes/evidences the entity (e.g. a Monitoring Plan documents the mitigation plan)." ;
    rdfs:subPropertyOf ns1:concerns ;
    top:flavor "Additive" .

ns1:expiresAt a owl:DatatypeProperty ;
    rdfs:label "expires at" ;
    rdfs:comment "When this filed artifact ceases to be valid (e.g. an IRB approval's expiry). After it, the artifact should carry top:status \"expired\" and no longer satisfies a requirement." ;
    rdfs:domain ns1:FiledArtifact ;
    rdfs:range xsd:dateTime .

ns1:followsProfile a owl:ObjectProperty ;
    rdfs:label "follows profile" ;
    rdfs:comment "The completeness profile this TMF is judged against." ;
    rdfs:domain ns1:TrialMasterFile ;
    rdfs:range ns1:CompletenessProfile .

ns1:forStudy a owl:ObjectProperty ;
    rdfs:label "for study" ;
    rdfs:comment "The study this TMF evidences." ;
    rdfs:domain ns1:TrialMasterFile ;
    rdfs:range cr:Study .

ns1:hasFiledArtifact a owl:ObjectProperty ;
    rdfs:label "has filed artifact" ;
    rdfs:comment "A document filed into this TMF (forward edge: the filed set)." ;
    rdfs:domain ns1:TrialMasterFile ;
    rdfs:range ns1:FiledArtifact .

ns1:ofType a owl:ObjectProperty ;
    rdfs:label "of type" ;
    rdfs:comment "The artifact type this filed document is classified as — and thereby the domain class its facts mean (via the type's content binding)." ;
    rdfs:domain ns1:FiledArtifact ;
    rdfs:range ns1:TMFArtifactType .

ns1:recommendsArtifactType a owl:ObjectProperty ;
    rdfs:label "recommends artifact type" ;
    rdfs:comment "A RECOMMENDED artifact type: its absence is a reviewable gap (Warning)." ;
    rdfs:domain ns1:CompletenessProfile ;
    rdfs:range ns1:TMFArtifactType .

ns1:records a owl:ObjectProperty ;
    rdfs:label "records" ;
    rdfs:comment "The artifact is a running log of the entity's instances (e.g. a Deviation Log records deviation events)." ;
    rdfs:subPropertyOf ns1:concerns ;
    top:flavor "Additive" .

ns1:requiresArtifactType a owl:ObjectProperty ;
    rdfs:label "requires artifact type" ;
    rdfs:comment "An ESSENTIAL artifact type: its absence (no current filed artifact) is an inspection finding (Violation)." ;
    rdfs:domain ns1:CompletenessProfile ;
    rdfs:range ns1:TMFArtifactType .

ns1:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes" ;
    rdfs:comment "A newer filed version supersedes an older one (the version chain); the superseded one carries top:status \"superseded\"." ;
    rdfs:domain ns1:FiledArtifact ;
    rdfs:range ns1:FiledArtifact .

<https://top.scientix.ai/v1> a owl:Ontology ;
    rdfs:label "TOP Core" ;
    dcterms:bibliographicCitation "ScientixAI (2026). TOP Core (v1). The Ontology Project." ;
    dcterms:creator "ScientixAI" ;
    dcterms:description "The universal foundation of The Ontology Project: one root (top:CommonEntity), eight Category-Level Objects, the Universal DNA (identifier / observedAt / status), the ADR-0021 bitemporal vocabulary, and the ADR-0019 extension-flavor contract. Domain reference graphs (e.g. TOP-CR) specialize this artifact and pin it by checksum." ;
    dcterms:issued "2026-07-07"^^xsd:date ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:publisher "ScientixAI" ;
    dcterms:title "TOP Core" ;
    owl:versionIRI <https://top.scientix.ai/v1/core-v1> ;
    owl:versionInfo "v1" .

top:Additive a owl:NamedIndividual ;
    rdfs:label "Additive"@en ;
    rdfs:comment "A top:flavor value indicating domain specializations may add new properties or shapes at their layer without affecting the base constraint. Purely extensible."@en .

top:AttestationMustVersionShape a sh:NodeShape ;
    rdfs:label "Attestations must be versioned"@en ;
    sh:message "A top:Attestation is a committed, signed declaration and must be an immutable version." ;
    sh:node top:BitemporalShape ;
    sh:severity sh:Violation ;
    sh:targetClass top:Attestation .

top:EvidenceShouldVersionShape a sh:NodeShape ;
    rdfs:label "Evidence should be versioned once committed"@en ;
    sh:property [ sh:message "This evidentiary value is not yet a version. Drafts may stay mutable; once finalized (and certainly once hashed or signed) it must be versioned (top:Versioned with top:validFrom)." ;
            sh:minCount 1 ;
            sh:path top:validFrom ;
            sh:severity sh:Warning ] ;
    sh:targetClass top:Credential,
        top:Document,
        top:Log .

top:Group a owl:Class ;
    rdfs:label "Group"@en ;
    rdfs:comment "A bounded collective acting with shared purpose and accountability — committee, team, working group, oversight body, panel."@en ;
    rdfs:subClassOf prov:Agent,
        top:Agent .

top:HashedMustVersionShape a sh:NodeShape ;
    rdfs:label "Hashed values must be versioned"@en ;
    sh:message "A value carrying top:integrityHash must be an immutable version (top:Versioned: top:validFrom + prov:specializationOf). You cannot hash a value and leave it mutable." ;
    sh:node top:BitemporalShape ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf top:integrityHash .

top:Invariant a owl:NamedIndividual ;
    rdfs:label "Invariant"@en ;
    rdfs:comment "A top:flavor value indicating this property's constraint cannot be changed by domain specializations. Loosening it breaks the universal contract."@en .

top:Material a owl:Class ;
    rdfs:label "Material"@en ;
    rdfs:comment "A consumable or substance used or transformed — sample, kit, reagent, raw material, drug substance, dosage unit."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#MaterialEntity>,
        prov:Entity,
        top:Resource .

top:Milestone a owl:Class ;
    rdfs:label "Milestone"@en ;
    rdfs:comment "A point-in-time marker of significant progress — first-patient-in, last-patient-last-visit, batch release, regulatory approval."@en ;
    rdfs:subClassOf prov:Activity,
        top:Temporal .

top:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "A captured data point — vital sign, lab value, sensor reading, qualitative assessment, computed metric."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#GenericallyDependentContinuant>,
        prov:Entity,
        top:Outcome .

top:Organism a owl:Class ;
    rdfs:label "Organism"@en ;
    rdfs:comment "A living biological non-human entity acting or being acted upon in an operational context — laboratory animal, livestock under veterinary care, plant in an agricultural trial, microbial culture, model organism in a biology study."@en ;
    rdfs:subClassOf prov:Agent,
        top:Agent .

top:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "A legal or business entity — corporate parent, operating company, hospital, academic institution, regulator, vendor, sponsor."@en ;
    rdfs:subClassOf prov:Organization,
        top:Agent .

top:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "An individual human acting in any role across any workflow."@en ;
    rdfs:subClassOf prov:Person,
        top:Agent .

top:Physical a owl:Class ;
    rdfs:label "Physical Location"@en ;
    rdfs:comment "A real-world place with geospatial coordinates — building, room, floor, campus, depot, manufacturing line, ward."@en ;
    rdfs:subClassOf prov:Location,
        top:Location .

top:PhysicalLimit a owl:Class ;
    rdfs:label "Physical Limit"@en ;
    rdfs:comment "A bound rooted in physical reality — temperature range, dose ceiling, pressure limit, mass tolerance, biological viability window."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#Quality>,
        prov:Entity,
        top:Constraint .

top:Portfolio a owl:Class ;
    rdfs:label "Portfolio"@en ;
    rdfs:comment "The widest organizational container — a collection of Programs sharing strategic direction, oversight, or funding."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#GenericallyDependentContinuant>,
        prov:Plan,
        top:Scope .

top:Program a owl:Class ;
    rdfs:label "Program"@en ;
    rdfs:comment "An intermediate container — a coordinated set of Projects sharing therapeutic area, product family, or regulatory pathway."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#GenericallyDependentContinuant>,
        prov:Plan,
        top:Scope .

top:Project a owl:Class ;
    rdfs:label "Project"@en ;
    rdfs:comment "A bounded body of work with a defined start, end, and objective — a study, a campaign, a batch, a submission, a commissioning effort."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#GenericallyDependentContinuant>,
        prov:Plan,
        top:Scope .

top:SafetyGuardrail a owl:Class ;
    rdfs:label "Safety Guardrail"@en ;
    rdfs:comment "A boundary rooted in safety discipline — biosafety floor, blinding rule, contamination boundary, escalation threshold, stop-rule."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#GenericallyDependentContinuant>,
        prov:Entity,
        top:Constraint .

top:SignedMustVersionShape a sh:NodeShape ;
    rdfs:label "Signed values must be versioned"@en ;
    sh:message "A value carrying top:signedBy must be an immutable version. You cannot sign a value and leave it mutable." ;
    sh:node top:BitemporalShape ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf top:signedBy .

top:StatusChangeMustVersionShape a sh:NodeShape ;
    rdfs:label "Status changes must be versioned"@en ;
    sh:message "A top:StatusChange is the audit event of a transition and must be an immutable version." ;
    sh:node top:BitemporalShape ;
    sh:severity sh:Violation ;
    sh:targetClass top:StatusChange .

top:Storage a owl:Class ;
    rdfs:label "Storage Location"@en ;
    rdfs:comment "A place where Resources reside under controlled conditions — biorepository freezer, IP storage, sample archive, document repository, data vault."@en ;
    rdfs:subClassOf prov:Location,
        top:Location .

top:System a owl:Class ;
    rdfs:label "System"@en ;
    rdfs:comment "A software or operational system used to execute work — EDC, CTMS, IRT, LIMS, MES, ERP."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#GenericallyDependentContinuant>,
        prov:Entity,
        top:Resource .

top:Tightenable a owl:NamedIndividual ;
    rdfs:label "Tightenable"@en ;
    rdfs:comment "A top:flavor value indicating domain specializations may narrow this property's range or add sh:in / sh:minInclusive constraints, but may not loosen the base constraint."@en .

top:UniversalDNAShape a sh:NodeShape ;
    rdfs:label "Universal DNA Shape"@en ;
    rdfs:comment "The minimum every TOP entity must carry: a unique identifier, an observation timestamp, and a current status."@en ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:message "Every TOP entity must carry exactly one top:identifier (xsd:anyURI)." ;
            sh:minCount 1 ;
            sh:path top:identifier ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Every TOP entity must carry exactly one top:observedAt (xsd:dateTime)." ;
            sh:minCount 1 ;
            sh:path top:observedAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Every TOP entity must carry exactly one top:status (xsd:string)." ;
            sh:minCount 1 ;
            sh:path top:status ] ;
    sh:targetClass top:CommonEntity .

top:Virtual a owl:Class ;
    rdfs:label "Virtual Location"@en ;
    rdfs:comment "A logical place addressable via URI / path / network identifier — data warehouse, system zone, application namespace, regulatory jurisdiction."@en ;
    rdfs:subClassOf prov:Location,
        top:Location .

top:Window a owl:Class ;
    rdfs:label "Window"@en ;
    rdfs:comment "A bounded interval within which an activity must occur — visit window, dose window, regulatory submission window, calibration window."@en ;
    rdfs:subClassOf prov:Activity,
        top:Temporal .

top:accessRequirement a owl:ObjectProperty ;
    rdfs:label "access requirement"@en ;
    rdfs:comment "Constraints required to enter this Location (clearance, training prerequisite, escort policy, biosafety level)."@en ;
    rdfs:domain top:Location ;
    rdfs:range top:Constraint ;
    top:flavor "Tightenable" .

top:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to"@en ;
    rdfs:comment "Targets of the Constraint. Constraints can scope to Agents, Resources, Scopes, or Temporals; range is top:CommonEntity so the targeting is uniform across Categories. Leaf layer narrows by domain."@en ;
    rdfs:domain top:Constraint ;
    rdfs:range top:CommonEntity ;
    top:flavor "Tightenable" .

top:authorizedBy a owl:ObjectProperty ;
    rdfs:label "authorized by"@en ;
    rdfs:comment "The authority that granted the Agent permission to act in a specific scope."@en ;
    rdfs:domain top:Agent ;
    rdfs:range top:Agent ;
    top:flavor "Tightenable" .

top:concludesAbout a owl:ObjectProperty ;
    rdfs:label "concludes about"@en ;
    rdfs:comment "The entity (or set of entities) this Conclusion pertains to."@en ;
    rdfs:domain top:Conclusion ;
    rdfs:range top:CommonEntity ;
    top:flavor "Tightenable" .

top:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:comment "Epistemic certainty expressed as a decimal in [0.0, 1.0]."@en ;
    rdfs:domain top:Conclusion ;
    rdfs:range xsd:decimal ;
    top:flavor "Tightenable" .

top:containsActivity a owl:ObjectProperty ;
    rdfs:label "contains activity"@en ;
    rdfs:comment "Links the Scope to the Temporal entities (planned or executed activities) happening within it."@en ;
    rdfs:domain top:Scope ;
    rdfs:range top:Temporal ;
    top:flavor "Tightenable" .

top:endTime a owl:DatatypeProperty ;
    rdfs:label "end time"@en ;
    rdfs:comment "Actual or planned end. May be open (null) for ongoing activities."@en ;
    rdfs:domain top:Temporal ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf prov:endedAtTime ;
    top:flavor "Invariant" .

top:enforcedBy a owl:ObjectProperty ;
    rdfs:label "enforced by"@en ;
    rdfs:comment "Links the Constraint to the Agent responsible for oversight. The IRB enforces the inclusion criterion; the QA Lead enforces the calibration window; the Pharmacist enforces the dose limit."@en ;
    rdfs:domain top:Constraint ;
    rdfs:range top:Agent ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    top:flavor "Tightenable" .

top:flavor a owl:AnnotationProperty ;
    rdfs:label "flavor"@en ;
    rdfs:comment "Extensibility flavor per ADR-0019. Permitted values: 'Invariant', 'Tightenable', 'Additive'."@en .

top:geoSpatialData a owl:DatatypeProperty ;
    rdfs:label "geo-spatial data"@en ;
    rdfs:comment "Physical coordinates or digital path. WKT / GeoJSON for physical spaces; structured locator (URI, file path, network address) for logical spaces."@en ;
    rdfs:domain top:Location ;
    rdfs:range xsd:string ;
    top:flavor "Tightenable" .

top:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by"@en ;
    rdfs:comment "Links the Scope to specific Constraints — regulatory, contractual, safety. The legal frame the Scope operates within."@en ;
    rdfs:domain top:Scope ;
    rdfs:range top:Constraint ;
    top:flavor "Tightenable" .

top:hasCredential a owl:ObjectProperty ;
    rdfs:label "has credential"@en ;
    rdfs:comment "Links the Agent to their proof of qualification or identity."@en ;
    rdfs:domain top:Agent ;
    rdfs:range top:Credential ;
    top:flavor "Tightenable" .

top:hasMaintenanceLog a owl:ObjectProperty ;
    rdfs:label "has maintenance log"@en ;
    rdfs:comment "Links the Resource to its history of maintenance / calibration / validation Log."@en ;
    rdfs:domain top:Resource ;
    rdfs:range top:Log ;
    top:flavor "Tightenable" .

top:measuredBy a owl:ObjectProperty ;
    rdfs:label "measured by"@en ;
    rdfs:comment "Links the Outcome to the Resource (Equipment, System) that captured or produced it."@en ;
    rdfs:domain top:Outcome ;
    rdfs:range top:Resource ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    top:flavor "Tightenable" .

top:memberOf a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    rdfs:comment "Organizational or group hierarchy the Agent belongs to."@en ;
    rdfs:domain top:Agent ;
    rdfs:range top:Agent ;
    rdfs:subPropertyOf prov:actedOnBehalfOf ;
    top:flavor "Tightenable" .

top:modelVersion a owl:DatatypeProperty ;
    rdfs:label "model version"@en ;
    rdfs:comment "Identifier of the LLM (name + version/hash) that produced this conclusion." ;
    rdfs:domain top:Conclusion ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

top:objectiveStatement a owl:DatatypeProperty ;
    rdfs:label "objective statement"@en ;
    rdfs:comment "High-level description of the strategic 'why'. Operator-grounded — what an investigator, sponsor, or regulator would say this Scope is for."@en ;
    rdfs:domain top:Scope ;
    rdfs:range xsd:string ;
    top:flavor "Tightenable" .

top:occursAt a owl:ObjectProperty ;
    rdfs:label "occurs at"@en ;
    rdfs:comment "Where the Temporal happens. PROV-aligned to prov:atLocation."@en ;
    rdfs:domain top:Temporal ;
    rdfs:range top:Location ;
    rdfs:subPropertyOf prov:atLocation ;
    top:flavor "Tightenable" .

top:operationalState a owl:DatatypeProperty ;
    rdfs:label "operational state"@en ;
    rdfs:comment "Hardware/software-specific readiness beyond top:status. CALIBRATED / DUE_FOR_CALIBRATION / OUT_OF_SERVICE for Equipment; RUNNING / DEGRADED / OFFLINE for System."@en ;
    rdfs:domain top:Resource ;
    rdfs:range xsd:string ;
    top:flavor "Tightenable" .

top:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en ;
    rdfs:comment "The Agent (Person or Organization) that owns / has custody of the Resource. Chain-of-custody anchor."@en ;
    rdfs:domain top:Resource ;
    rdfs:range top:Agent ;
    top:flavor "Tightenable" .

top:partOfScope a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of scope"@en ;
    rdfs:comment "Hierarchical containment between Scopes. Transitive: Portfolio contains Program contains Project."@en ;
    rdfs:domain top:Scope ;
    rdfs:range top:Scope ;
    top:flavor "Tightenable" .

top:precededBy a owl:ObjectProperty ;
    rdfs:label "preceded by"@en ;
    rdfs:comment "Sequence logic — the Temporal that immediately precedes this one."@en ;
    rdfs:domain top:Temporal ;
    rdfs:range top:Temporal ;
    rdfs:subPropertyOf prov:wasInformedBy ;
    top:flavor "Tightenable" .

top:producedBy a owl:ObjectProperty ;
    rdfs:label "produced by"@en ;
    rdfs:comment "Links the Outcome to the Activity (Temporal) that generated it."@en ;
    rdfs:domain top:Outcome ;
    rdfs:range top:Temporal ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    top:flavor "Tightenable" .

top:promptTemplate a owl:DatatypeProperty ;
    rdfs:label "prompt template"@en ;
    rdfs:comment "The prompt template used to elicit the LLM inference, with slot markers. Stored verbatim for reproducibility." ;
    rdfs:domain top:Conclusion ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

top:rationale a owl:DatatypeProperty ;
    rdfs:label "rationale"@en ;
    rdfs:comment "Human-readable explanation of why this Conclusion was reached."@en ;
    rdfs:domain top:Conclusion ;
    rdfs:range xsd:string ;
    top:flavor "Tightenable" .

top:recordedAt a owl:DatatypeProperty ;
    rdfs:label "recorded at"@en ;
    rdfs:comment "Transaction time (append-only): when the system first knew this fact. Never rewritten. Complements top:observedAt / top:validFrom (valid time). PROV peer: prov:generatedAtTime carries the same instant when a generation activity is modeled."@en ;
    rdfs:range xsd:dateTime ;
    top:flavor "Invariant" .

top:satisfiesConstraint a owl:ObjectProperty ;
    rdfs:label "satisfies constraint"@en ;
    rdfs:comment "Links the Outcome to the Constraint(s) it has been validated against."@en ;
    rdfs:domain top:Outcome ;
    rdfs:range top:Constraint ;
    top:flavor "Tightenable" .

top:severityLevel a owl:DatatypeProperty ;
    rdfs:label "severity level"@en ;
    rdfs:comment "Operational impact of violation. Universal enum — INFORMATIONAL / MINOR / MAJOR / CRITICAL. Workflow extensions can refine."@en ;
    rdfs:domain top:Constraint ;
    rdfs:range xsd:string ;
    top:flavor "Tightenable" .

top:sourceContext a owl:DatatypeProperty ;
    rdfs:label "source context"@en ;
    rdfs:comment "The retrieved context passages (e.g. SPARQL results, vector-search snippets) injected into the prompt. Stored verbatim. See the PII scope note in this module's header." ;
    rdfs:domain top:Conclusion ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

top:startTime a owl:DatatypeProperty ;
    rdfs:label "start time"@en ;
    rdfs:comment "Actual or planned start. PROV-aligned to prov:startedAtTime."@en ;
    rdfs:domain top:Temporal ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf prov:startedAtTime ;
    top:flavor "Invariant" .

top:supersededAt a owl:DatatypeProperty ;
    rdfs:label "superseded at"@en ;
    rdfs:comment "Transaction time (append-only): when a later assertion superseded this one. A correction is a NEW assertion carrying its own recordedAt; this timestamp closes the old one and is never rewritten."@en ;
    rdfs:range xsd:dateTime ;
    top:flavor "Invariant" .

top:variance a owl:DatatypeProperty ;
    rdfs:label "variance"@en ;
    rdfs:comment "Delta between expected and actual. Format depends on leaf specialization."@en ;
    rdfs:domain top:Outcome ;
    rdfs:range xsd:string ;
    top:flavor "Tightenable" .

top:verifiesOutcome a owl:ObjectProperty ;
    rdfs:label "verifies outcome"@en ;
    rdfs:comment "Direct link to the Outcome this Evidence supports."@en ;
    rdfs:domain top:Evidence ;
    rdfs:range top:Outcome ;
    top:flavor "Tightenable" .

top:withinLocation a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "within location"@en ;
    rdfs:comment "Recursive parent location. Transitive: Room within Building within Campus is queryable as Room within Campus."@en ;
    rdfs:domain top:Location ;
    rdfs:range top:Location ;
    top:flavor "Tightenable" .

prov:specializationOf rdfs:range top:VersionSeries .

<https://top.scientix.ai/cr/v1> a owl:Ontology ;
    rdfs:label "TOP — Clinical Research Reference Graph" ;
    dcterms:bibliographicCitation "ScientixAI (2026). TOP — Clinical Research Reference Graph (v1). The Ontology Project." ;
    dcterms:contributor "TOP Clinical Research working group" ;
    dcterms:creator "ScientixAI" ;
    dcterms:description "An inheritable, provenance-native, bitemporal reference knowledge graph for the clinical-research lifecycle (Pre-IND through End-of-Phase-2, plus site operations). The founding domain of TOP (The Ontology Project)." ;
    dcterms:issued "2026-06-22"^^xsd:date ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:publisher "ScientixAI" ;
    dcterms:rights "Includes an independent derivative adaptation of the ICH E6(R3) Good Clinical Practice Guideline (Step 4, 2025; Principles, Glossary, Annex 1) — paraphrased, not endorsed or sponsored by ICH, original copyright © ICH. TMF artifact types align by name to the DIA TMF Reference Model (licensed; no text reproduced). See the repository NOTICE file." ;
    dcterms:title "TOP Clinical Research (CR) domain — module root",
        "TOP — Clinical Research Reference Graph" ;
    rdfs:comment "Imports every authored module of the CR domain plus the pinned TOP Core. The coherence gate enforces that every ontology/*.ttl module is listed here." ;
    owl:versionIRI <https://top.scientix.ai/cr/v1> ;
    owl:versionInfo "v1" .

cr:ActivateStudy a hcls:Action ;
    rdfs:label "Activate Study" ;
    cr:occursInStage cr:StudyDesignStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:AddBudgetLineItem a hcls:Action ;
    rdfs:label "Add Budget Line Item" ;
    cr:occursInStage cr:StartupStage ;
    hcls:authorizedAgentType cr:FinanceStaff ;
    hcls:operatesOn cr:Study .

cr:AddLogEntry a hcls:Action ;
    rdfs:label "Add Log Entry" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:StudySite .

cr:Administration a owl:Class ;
    rdfs:label "Administration" ;
    rdfs:comment "A dosing event." ;
    rdfs:subClassOf top:Temporal .

cr:AnalysisVariable a owl:Class ;
    rdfs:label "Analysis Variable" ;
    rdfs:comment "The analysis analog of the EDC item definition: results cite the variable they were computed over, closing the result -> variable -> dataset -> source chain at variable grain." ;
    rdfs:subClassOf cr:DataElementDef ;
    skos:altLabel "ADaM variable"@en,
        "PARAMCD"@en,
        "analysis parameter"@en ;
    skos:definition "A variable definition within an analysis dataset (e.g. AVAL, CHG, TRTP) — the analysis-layer counterpart of the capture-layer cr:DataElementDef." ;
    skos:prefLabel "Analysis Variable"@en ;
    top:flavor "Additive" .

cr:ApproveBudget a hcls:Action ;
    rdfs:label "Approve Budget" ;
    cr:occursInStage cr:StartupStage ;
    hcls:authorizedAgentType cr:FinanceStaff ;
    hcls:operatesOn cr:Study .

cr:ApprovePayment a hcls:Action ;
    rdfs:label "Approve Payment" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:FinanceStaff ;
    hcls:operatesOn cr:StudySite .

cr:ArchiveStudy a hcls:Action ;
    rdfs:label "Archive Study" ;
    cr:occursInStage cr:ArchivalStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:AssessAdverseEvent a hcls:Action ;
    rdfs:label "Assess Adverse Event" ;
    cr:occursInStage cr:SafetyStage ;
    hcls:authorizedAgentType cr:Investigator ;
    hcls:operatesOn cr:AdverseEvent .

cr:AssignQuery a hcls:Action ;
    rdfs:label "Assign Query" ;
    cr:occursInStage cr:DataCollectionStage ;
    hcls:authorizedAgentType cr:DataManager ;
    hcls:operatesOn cr:eCRF .

cr:AssignTask a hcls:Action ;
    rdfs:label "Assign Task" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:BriefingBook a owl:Class ;
    rdfs:label "Briefing Book" ;
    rdfs:comment "A dossier submitted to the regulator ahead of a meeting (Pre-IND / EOP2)." ;
    rdfs:subClassOf top:Evidence .

cr:ClinicalHold a owl:Class ;
    rdfs:label "Clinical Hold" ;
    rdfs:comment "An FDA order that halts or prevents a trial from proceeding." ;
    rdfs:subClassOf top:Outcome .

cr:CloseAdverseEvent a hcls:Action ;
    rdfs:label "Close Adverse Event" ;
    cr:occursInStage cr:SafetyStage ;
    hcls:authorizedAgentType cr:Investigator ;
    hcls:operatesOn cr:AdverseEvent .

cr:CloseEnrollment a hcls:Action ;
    rdfs:label "Close Enrollment" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:CloseQuery a hcls:Action ;
    rdfs:label "Close Query" ;
    cr:occursInStage cr:DataCollectionStage ;
    hcls:authorizedAgentType cr:DataManager ;
    hcls:operatesOn cr:eCRF .

cr:CloseSafetySignal a hcls:Action ;
    rdfs:label "Close Safety Signal" ;
    cr:occursInStage cr:SafetyStage ;
    hcls:authorizedAgentType cr:PharmacovigilianceSpecialist ;
    hcls:operatesOn cr:AdverseEvent .

cr:CloseSite a hcls:Action ;
    rdfs:label "Close Site" ;
    cr:occursInStage cr:ArchivalStage ;
    hcls:authorizedAgentType cr:ClinicalResearchAssociate,
        cr:SponsorProjectManager ;
    hcls:operatesOn cr:StudySite .

cr:CloseSiteToEnrollment a hcls:Action ;
    rdfs:label "Close Site to Enrollment" ;
    cr:occursInStage cr:CloseoutStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:StudySite .

cr:CloseStudy a hcls:Action ;
    rdfs:label "Close Study" ;
    cr:occursInStage cr:ArchivalStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:Cohort a owl:Class ;
    rdfs:label "Cohort" ;
    rdfs:comment "A group of subjects sharing a dosing or treatment assignment." ;
    rdfs:subClassOf top:Scope .

cr:CollectSample a hcls:Action ;
    rdfs:label "Collect Sample" ;
    cr:occursInStage cr:VisitExecutionStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:ActivityOccurrence .

cr:CompleteCRF a hcls:Action ;
    rdfs:label "Complete CRF" ;
    cr:occursInStage cr:DataCollectionStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:eCRF .

cr:CompleteParticipantStudy a hcls:Action ;
    rdfs:label "Complete Participant Study" ;
    cr:occursInStage cr:CloseoutStage ;
    hcls:authorizedAgentType cr:Investigator ;
    hcls:operatesOn cr:Participant .

cr:CompleteVisit a hcls:Action ;
    rdfs:label "Complete Visit" ;
    cr:occursInStage cr:VisitExecutionStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:VisitOccurrence .

cr:CoverageAnalysis a owl:Class ;
    rdfs:label "Coverage Analysis (MCA)" ;
    rdfs:comment "A Medicare/insurance coverage analysis for study procedures." ;
    rdfs:subClassOf top:Evidence .

cr:CreateArm a hcls:Action ;
    rdfs:label "Create Arm" ;
    cr:occursInStage cr:StudyDesignStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Arm .

cr:CreateBudget a hcls:Action ;
    rdfs:label "Create Budget" ;
    cr:occursInStage cr:StartupStage ;
    hcls:authorizedAgentType cr:FinanceStaff ;
    hcls:operatesOn cr:Study .

cr:CreateLog a hcls:Action ;
    rdfs:label "Create Log" ;
    cr:occursInStage cr:SiteActivationStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:StudySite .

cr:CreateMilestone a hcls:Action ;
    rdfs:label "Create Milestone" ;
    cr:occursInStage cr:StartupStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:CreatePayment a hcls:Action ;
    rdfs:label "Create Payment" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:FinanceStaff ;
    hcls:operatesOn cr:StudySite .

cr:CreateStudy a hcls:Action ;
    rdfs:label "Create Study" ;
    cr:occursInStage cr:StudyDesignStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:DataDefinition a owl:Class ;
    rdfs:label "Data Definition (Define-XML)" ;
    rdfs:subClassOf top:Evidence ;
    skos:definition "The CDISC Define-XML metadata that describes the submitted datasets (variable-level metadata, value-level metadata, controlled terminology, computational method traceability). The map a reviewer uses to read the datasets." .

cr:DoseLevel a owl:Class ;
    rdfs:label "Dose Level" ;
    rdfs:comment "A dose level in a dose-escalation design." ;
    rdfs:subClassOf top:Scope .

cr:EnrollParticipant a hcls:Action ;
    rdfs:label "Enroll Participant" ;
    cr:occursInStage cr:RecruitmentStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:Participant .

cr:EvaluateSafetySignal a hcls:Action ;
    rdfs:label "Evaluate Safety Signal" ;
    cr:occursInStage cr:SafetyStage ;
    hcls:authorizedAgentType cr:PharmacovigilianceSpecialist ;
    hcls:operatesOn cr:AdverseEvent .

cr:FinalizeReport a hcls:Action ;
    rdfs:label "Finalize Report" ;
    cr:occursInStage cr:ReportingStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:CSR .

cr:FollowUpAdverseEvent a hcls:Action ;
    rdfs:label "Follow Up on Adverse Event" ;
    cr:occursInStage cr:SafetyStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:AdverseEvent .

cr:FollowUpStage a cr:TrialStage ;
    rdfs:label "Follow-up" ;
    rdfs:comment "Post-treatment assessments, long-term safety evaluation, survival follow-up, adverse event monitoring through the follow-up window." .

cr:IdentifySafetySignal a hcls:Action ;
    rdfs:label "Identify Safety Signal" ;
    cr:occursInStage cr:SafetyStage ;
    hcls:authorizedAgentType cr:PharmacovigilianceSpecialist ;
    hcls:operatesOn cr:AdverseEvent .

cr:InitiateSite a hcls:Action ;
    rdfs:label "Initiate Site (SIV)" ;
    cr:occursInStage cr:SiteActivationStage ;
    hcls:authorizedAgentType cr:ClinicalResearchAssociate ;
    hcls:operatesOn cr:StudySite .

cr:IssueSitePayment a hcls:Action ;
    rdfs:label "Issue Site Payment" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:FinanceStaff ;
    hcls:operatesOn cr:StudySite .

cr:LastPatientLastVisit a owl:Class ;
    rdfs:label "Last Patient Last Visit (LPLV)" ;
    rdfs:subClassOf top:Outcome,
        top:Versioned ;
    skos:definition "The study-level milestone marking the last protocol visit of the last active participant — the event that opens closeout and starts the clock toward database lock." .

cr:LockBudget a hcls:Action ;
    rdfs:label "Lock Budget" ;
    cr:occursInStage cr:StartupStage ;
    hcls:authorizedAgentType cr:FinanceStaff ;
    hcls:operatesOn cr:Study .

cr:LockUnlockCRF a hcls:Action ;
    rdfs:label "Lock / Unlock CRF" ;
    cr:occursInStage cr:DataAnalysisStage ;
    hcls:authorizedAgentType cr:DataManager ;
    hcls:operatesOn cr:eCRF .

cr:LogCommunication a hcls:Action ;
    rdfs:label "Log Communication" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:Study .

cr:LongTermFollowUp a owl:Class ;
    rdfs:label "Long-term Follow-up" ;
    rdfs:subClassOf top:Scope ;
    skos:definition "A planned long-term follow-up programme for a study (e.g. survival follow-up, long-term safety), spanning follow-up visits beyond the treatment period." .

cr:ObtainParticipantConsent a hcls:Action ;
    rdfs:label "Obtain Participant Consent" ;
    cr:occursInStage cr:RecruitmentStage ;
    hcls:authorizedAgentType cr:Investigator,
        cr:SiteCoordinator ;
    hcls:operatesOn cr:InformedConsentAct .

cr:OpenEnrollment a hcls:Action ;
    rdfs:label "Open Enrollment" ;
    cr:occursInStage cr:RecruitmentStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:OperationalRecord a owl:Class ;
    rdfs:label "Operational Record" ;
    rdfs:comment "Non-clinical, non-GCP-governed data captured during trial operations — process metrics, site performance indicators, sponsor-defined operational fields (e.g. X_WHATEVER extensions in Medidata). Not an hcls:Observation (no clinical value) and not directly regulated by ICH E6; captured in operational CRFs or sponsor-specific payloads. Primary target for LLM-assisted field-mapping inference (cr:mappingConfidence)." ;
    rdfs:subClassOf top:Evidence .

cr:ProcessPayment a hcls:Action ;
    rdfs:label "Process Payment" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:FinanceStaff ;
    hcls:operatesOn cr:StudySite .

cr:RebaselineTimeline a hcls:Action ;
    rdfs:label "Rebaseline Timeline" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:ReconcileSAE a hcls:Action ;
    rdfs:label "Reconcile SAE" ;
    cr:occursInStage cr:SafetyStage ;
    hcls:authorizedAgentType cr:PharmacovigilianceSpecialist ;
    hcls:operatesOn cr:AdverseEvent .

cr:RefreshGCPTraining a hcls:Action ;
    rdfs:label "Refresh GCP Training" ;
    cr:occursInStage cr:SiteActivationStage ;
    hcls:authorizedAgentType cr:Investigator ;
    hcls:operatesOn cr:Credential .

cr:RegulatoryAgreement a owl:Class ;
    rdfs:label "Regulatory Agreement" ;
    rdfs:comment "A binding FDA agreement (a commitment the program is held to)." ;
    rdfs:subClassOf top:Constraint .

cr:ReopenQuery a hcls:Action ;
    rdfs:label "Reopen Query" ;
    cr:occursInStage cr:DataCollectionStage ;
    hcls:authorizedAgentType cr:ClinicalResearchAssociate,
        cr:DataManager ;
    hcls:operatesOn cr:eCRF .

cr:ReportAdverseEvent a hcls:Action ;
    rdfs:label "Report Adverse Event" ;
    cr:occursInStage cr:SafetyStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:AdverseEvent .

cr:ReportDeviation a hcls:Action ;
    rdfs:label "Report Deviation" ;
    cr:occursInStage cr:OversightStage ;
    hcls:authorizedAgentType cr:ClinicalResearchAssociate,
        cr:SiteCoordinator ;
    hcls:operatesOn cr:VisitOccurrence .

cr:ReportSAE a hcls:Action ;
    rdfs:label "Report SAE" ;
    cr:occursInStage cr:SafetyStage ;
    hcls:authorizedAgentType cr:Investigator ;
    hcls:operatesOn cr:AdverseEvent .

cr:RespondToQuery a hcls:Action ;
    rdfs:label "Respond to Query" ;
    cr:occursInStage cr:DataCollectionStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:eCRF .

cr:ReviewCRF a hcls:Action ;
    rdfs:label "Review CRF" ;
    cr:occursInStage cr:DataCollectionStage ;
    hcls:authorizedAgentType cr:Investigator ;
    hcls:operatesOn cr:eCRF .

cr:RiskRegister a owl:Class ;
    rdfs:label "Risk Register" ;
    rdfs:comment "A record of risks and decisions captured at a regulatory gate." ;
    rdfs:subClassOf top:Evidence .

cr:SafetyAssessment a owl:Class ;
    rdfs:label "Safety Assessment" ;
    rdfs:comment "A clinical-protocol safety monitoring provision (e.g. CBC monitoring + dose-hold)." ;
    rdfs:subClassOf top:Constraint .

cr:ScheduleVisit a hcls:Action ;
    rdfs:label "Schedule Visit" ;
    cr:occursInStage cr:VisitExecutionStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:VisitOccurrence .

cr:ScreenParticipant a hcls:Action ;
    rdfs:label "Screen Participant" ;
    cr:occursInStage cr:RecruitmentStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:Participant .

cr:SelectSiteForStudy a hcls:Action ;
    rdfs:label "Select Site for Study" ;
    cr:occursInStage cr:SiteSelectionStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:StudySite .

cr:SignCRF a hcls:Action ;
    rdfs:label "Sign CRF" ;
    cr:occursInStage cr:DataCollectionStage ;
    hcls:authorizedAgentType cr:Investigator ;
    hcls:operatesOn cr:eCRF .

cr:SiteInitiationVisit a owl:Class ;
    rdfs:label "Site Initiation Visit (SIV)" ;
    rdfs:comment "The visit that prepares and activates a site for enrollment." ;
    rdfs:subClassOf top:Temporal ;
    skos:altLabel "SIV"@en,
        "initiation visit"@en ;
    skos:prefLabel "Site Initiation Visit"@en .

cr:SourceData a owl:Class ;
    rdfs:label "Source Data" ;
    rdfs:isDefinedBy <https://www.ich.org/page/efficacy-guidelines> ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "original data"@en ;
    skos:definition "The original recorded information, and certified copies of it, needed to reconstruct and evaluate the trial (paraphrased, ICH E6(R3))." ;
    skos:prefLabel "Source Data"@en .

cr:StartVisit a hcls:Action ;
    rdfs:label "Start Visit" ;
    cr:occursInStage cr:VisitExecutionStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:VisitOccurrence .

cr:StoppingRule a owl:Class ;
    rdfs:label "Stopping Rule" ;
    rdfs:comment "A safety rule that halts dosing or enrollment when triggered." ;
    rdfs:subClassOf top:Constraint ;
    skos:altLabel "futility rule"@en,
        "safety stopping boundary"@en ;
    skos:prefLabel "Stopping Rule"@en .

cr:SubmitExpeditedReport a hcls:Action ;
    rdfs:label "Submit Expedited Report" ;
    cr:occursInStage cr:SafetyStage ;
    hcls:authorizedAgentType cr:PharmacovigilianceSpecialist ;
    hcls:operatesOn cr:AdverseEvent .

cr:TransferFile a owl:Class ;
    rdfs:label "Transfer File" ;
    rdfs:comment "Grounded in the info-model TRANSFER_FILE entity. The specification is the plan; the file is the Outcome:Artifact." ;
    rdfs:subClassOf top:Outcome ;
    skos:definition "An actual delivered file instance (as distinct from its TransferSpecification). Carries its own transfer lifecycle timestamps and PROV attribution to the vendor org." .

cr:TrialMasterFile a owl:Class ;
    rdfs:label "Trial Master File" ;
    rdfs:isDefinedBy <https://www.ich.org/page/efficacy-guidelines> ;
    rdfs:subClassOf top:Evidence ;
    skos:altLabel "TMF",
        "TMF"@en,
        "eTMF"@en ;
    skos:definition "The collection of essential records that allows the conduct of the trial and the quality of the data to be evaluated (paraphrased, ICH E6(R3))." ;
    skos:prefLabel "Trial Master File"@en .

cr:UpdateAdverseEventDetails a hcls:Action ;
    rdfs:label "Update Adverse Event Details" ;
    cr:occursInStage cr:SafetyStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:AdverseEvent .

cr:UpdateEnrollmentStatus a hcls:Action ;
    rdfs:label "Update Enrollment Status" ;
    cr:occursInStage cr:RecruitmentStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:EnrollmentRecord .

cr:UpdateFCOIDisclosure a hcls:Action ;
    rdfs:label "Update FCOI Disclosure" ;
    cr:occursInStage cr:SiteActivationStage ;
    hcls:authorizedAgentType cr:Investigator ;
    hcls:operatesOn cr:Credential .

cr:UpdateSAE a hcls:Action ;
    rdfs:label "Update SAE" ;
    cr:occursInStage cr:SafetyStage ;
    hcls:authorizedAgentType cr:Investigator ;
    hcls:operatesOn cr:AdverseEvent .

cr:UpdateStudyDetails a hcls:Action ;
    rdfs:label "Update Study Details" ;
    cr:occursInStage cr:StudyDesignStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:UpdateTimeline a hcls:Action ;
    rdfs:label "Update Timeline" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:WithdrawParticipant a hcls:Action ;
    rdfs:label "Withdraw Participant" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:Investigator ;
    hcls:operatesOn cr:Participant .

cr:aliquotOf a owl:ObjectProperty ;
    rdfs:label "aliquot of" ;
    rdfs:comment "Partition/aliquot lineage (a kind of prov:wasDerivedFrom)." ;
    rdfs:domain hcls:Specimen ;
    rdfs:range hcls:Specimen ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    top:flavor "Additive" .

cr:audits a owl:ObjectProperty ;
    rdfs:label "audits" ;
    rdfs:comment "Independent audit of trial conduct/records (the auditor function as a relationship)." ;
    top:flavor "Additive" .

cr:certifiedCopyOf a owl:ObjectProperty ;
    rdfs:label "certified copy of" ;
    rdfs:comment "The source document this certified copy reproduces." ;
    rdfs:domain cr:CertifiedCopy ;
    rdfs:range cr:SourceDocument ;
    top:flavor "Additive" .

cr:collectedAt a owl:ObjectProperty ;
    rdfs:label "collected at" ;
    rdfs:comment "The StudyEvent (e.g. blood draw) at which a primary specimen was collected." ;
    rdfs:domain hcls:Specimen ;
    rdfs:range cr:StudyEvent ;
    top:flavor "Additive" .

cr:derivedFromCollection a owl:ObjectProperty ;
    rdfs:label "derived from collection" ;
    rdfs:comment "The collection act a result ultimately traces to (lineage back-edge)." ;
    rdfs:domain cr:AssayResult ;
    rdfs:range cr:StudyEvent ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    top:flavor "Additive" .

cr:flags a owl:ObjectProperty ;
    rdfs:label "flags" ;
    rdfs:comment "The antecedent this leading indicator points at." ;
    rdfs:domain cr:RiskSignal ;
    rdfs:range cr:DeviationAntecedent ;
    top:flavor "Additive" .

cr:manifestsAs a owl:ObjectProperty ;
    rdfs:label "manifests as" ;
    rdfs:comment "The deviation event this antecedent produced under load." ;
    rdfs:domain cr:DeviationAntecedent ;
    rdfs:range cr:DeviationEvent ;
    top:flavor "Additive" .

cr:mitigates a owl:ObjectProperty ;
    rdfs:domain cr:MitigationPlan ;
    rdfs:range cr:RiskAssessment ;
    top:flavor "Additive" .

cr:monitors a owl:ObjectProperty ;
    rdfs:label "monitors" ;
    rdfs:comment "Monitoring oversight of a site (the monitor function as a relationship)." ;
    rdfs:range cr:StudySite ;
    top:flavor "Additive" .

cr:principalInvestigator a owl:ObjectProperty ;
    rdfs:label "principal investigator" ;
    rdfs:comment "Role-as-relationship; bitemporal at instance level." ;
    rdfs:domain cr:StudySite ;
    rdfs:range hcls:Person ;
    top:flavor "Additive" .

cr:queryOn a owl:ObjectProperty ;
    rdfs:label "query on" ;
    rdfs:comment "The entity the query is anchored to (observation, event, form, subject...)." ;
    rdfs:domain cr:Query ;
    top:flavor "Additive" .

cr:screensRecruit a owl:ObjectProperty ;
    rdfs:label "screens recruit" ;
    rdfs:comment "The candidate this screening record concerns." ;
    rdfs:domain cr:ScreeningRecord ;
    rdfs:range cr:Recruit ;
    top:flavor "Additive" .

cr:specimen a owl:ObjectProperty ;
    rdfs:label "specimen" ;
    rdfs:comment "The specimen this custody transition concerns." ;
    rdfs:domain cr:CustodyEvent ;
    rdfs:range hcls:Specimen ;
    top:flavor "Additive" .

cr:xl-agent a ns2:Label ;
    dcterms:source "First-principles P7 CV-obligations (anti-synonym example)" ;
    skos:scopeNote "ANTI-SYNONYM: pharmacological 'agent' (the drug/substance) is NOT top:Agent (an actor bearing responsibility). Route drug-sense to cr:InvestigationalProduct / hcls:Substance; actor-sense to top:Agent."@en ;
    ns2:literalForm "agent"@en .

cr:xl-analysis a ns2:Label ;
    dcterms:source "Convener sanity review, 2026-07 (cr-core-lims ambiguity finding)" ;
    skos:scopeNote "HOMONYM: a laboratory assay (cr:AssayDefinition / cr:LabOrder), the statistical analysis layer (cr:AnalysisDataset / cr:AnalysisDecision / SAP), and everyday operational analysis ('analyze the five worst sites'). Never route the bare word; qualify by context — lab context -> assay terms, biostatistics context -> analysis-layer terms, otherwise no routing."@en ;
    ns2:literalForm "analysis"@en .

cr:xl-participant-patient a ns2:Label ;
    dcterms:source "Industry drift observed by convener, 2026-07 (ADR-0024): 'There are indications that the industry is moving to patient, but for clinical research, participant should be the preferred label.'" ;
    skos:scopeNote "Routed to cr:StudySubject in study context; routed to hcls:Person in care-delivery context."@en ;
    ns2:literalForm "patient"@en .

cr:xl-phase a ns2:Label ;
    dcterms:source "Convener sanity review, 2026-07 (cr-core-phases conflation finding)" ;
    skos:scopeNote "HOMONYM: the trial phase (cr:TrialPhase — Phase 1..4 / BESH, a classification of the STUDY: 'this is a Phase 2 trial') vs the trial stage (cr:TrialStage — startup/conduct/closeout, a position in the trial's EXECUTION). Neither concept uses the bare word: the model only names the qualified forms (trial phase, trial stage); any new label containing 'phase' must route explicitly."@en ;
    ns2:literalForm "phase"@en .

cr:xl-screen a ns2:Label ;
    dcterms:source "OPMODEL §2.2 Recruitment" ;
    skos:scopeNote "HOMONYM: eligibility screening (the recruitment-funnel activity — vocabulary lands with the funnel model, a declared V1 deferral) vs screen failure vs the UI screen. No default routing; qualify."@en ;
    ns2:literalForm "screen"@en .

cr:xl-service a ns2:Label ;
    dcterms:source "Convener sanity review, 2026-07 (cr-core-lims ambiguity finding)" ;
    skos:scopeNote "HOMONYM: a catalog lab test (cr:AssayDefinition, formerly 'AnalysisService'), a vendor organization (cr:ServiceProvider), and the API/runtime sense. Default routing: none; qualify."@en ;
    ns2:literalForm "service"@en .

cr:xl-subject a ns2:Label ;
    dcterms:source "First-principles P7 CV-obligations (homonym-routing example); OPMODEL" ;
    skos:scopeNote "HOMONYM: human-research 'subject' routes to cr:StudySubject (prefLabel Participant, ADR-0024); animal-research 'subject' is out of this domain; grammatical/email 'subject' is noise. Never route to hcls:Person."@en ;
    ns2:literalForm "subject"@en .

hcls:Clinician a owl:Class ;
    rdfs:label "Clinician" ;
    rdfs:comment "A licensed clinician who provides or oversees clinical care or research. Specializes in sub-domains: Investigator (clinical research), Physician (clinical care), Pharmacist, etc." ;
    rdfs:subClassOf hcls:Practitioner .

hcls:Condition a owl:Class ;
    rdfs:label "Condition" ;
    rdfs:comment "A diagnosed state of a Person." ;
    rdfs:subClassOf top:Outcome .

ns1:ClinicalTrialAgreementDoc a ns1:TMFArtifactType ;
    rdfs:label "Clinical Trial Agreement (artifact)" ;
    skos:broader ns1:Zone_SiteManagement ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Clinical Trial Agreement" ;
    ns1:documents cr:ClinicalTrialAgreement .

ns1:CurriculumVitae a ns1:TMFArtifactType ;
    rdfs:label "Curriculum Vitae" ;
    skos:broader ns1:Zone_SiteManagement ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Curriculum Vitae" ;
    ns1:documents cr:Credential .

ns1:Form1572 a ns1:TMFArtifactType ;
    rdfs:label "Form FDA 1572" ;
    skos:broader ns1:Zone_SiteManagement ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Form FDA 1572" ;
    ns1:documents cr:StudySite .

ns1:IRBApprovalLetter a ns1:TMFArtifactType ;
    rdfs:label "IRB/IEC Approval Letter" ;
    skos:broader ns1:Zone_SiteManagement ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "IRB/IEC Approval Letter" ;
    ns1:documents cr:IRBApproval .

ns1:InformedConsentForm a ns1:TMFArtifactType ;
    rdfs:label "Informed Consent Form" ;
    skos:broader ns1:Zone_SiteManagement ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Informed Consent Form" ;
    ns1:documents cr:InformedConsent .

ns1:MonitoringPlan a ns1:TMFArtifactType ;
    rdfs:label "Monitoring Plan" ;
    skos:broader ns1:Zone_TrialManagement ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Monitoring Plan" ;
    ns1:documents cr:MitigationPlan,
        cr:RiskAssessment .

ns1:Protocol a ns1:TMFArtifactType ;
    rdfs:label "Protocol" ;
    skos:broader ns1:Zone_CentralTrialDocs ;
    skos:inScheme ns1:TMFReferenceModel ;
    skos:prefLabel "Protocol" ;
    ns1:defines cr:CriticalToQualityFactor,
        cr:EligibilityCriterion,
        cr:Endpoint .

ns1:Zone_SafetyReporting a skos:Concept ;
    skos:prefLabel "Safety Reporting" ;
    skos:topConceptOf ns1:TMFReferenceModel .

top:AutonomousAgent a owl:Class ;
    rdfs:label "Autonomous Agent"@en ;
    rdfs:comment "A software entity acting on delegated authority — robotic process, AI agent, automated decision system, scheduler, monitor."@en ;
    rdfs:subClassOf prov:SoftwareAgent,
        top:Agent .

top:Equipment a owl:Class ;
    rdfs:label "Equipment"@en ;
    rdfs:comment "A physical device used in operations — analyzer, scale, freezer, infusion pump, imaging modality, sequencer, sensor."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#MaterialEntity>,
        prov:Entity,
        top:Resource .

top:ProvenancedEntity a owl:Class ;
    rdfs:label "Provenanced Entity"@en ;
    rdfs:comment "Marker for anything carrying the full bitemporal + PROV envelope: exactly one top:observedAt, exactly one top:recordedAt, at least one prov:wasAttributedTo (an identified agent). Domains enforce the envelope with their own SHACL (e.g. the CR domain's top:BitemporalProvShape); Core carries the vocabulary."@en .

top:StatusChange a owl:Class ;
    rdfs:label "Status Change"@en ;
    rdfs:comment "A discrete transition in lifecycle state — enrollment, withdrawal, batch release, IRB approval, record finalization."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#ProcessBoundary>,
        prov:Entity,
        top:Outcome .

top:identifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "identifier"@en ;
    rdfs:comment "Globally unique URI / URN. The opaque, durable, system-of-record handle for the entity. Functional: every TOP entity has exactly one."@en ;
    rdfs:domain top:CommonEntity ;
    rdfs:range xsd:anyURI ;
    top:flavor "Invariant" .

top:integrityHash a owl:DatatypeProperty ;
    rdfs:label "integrity hash"@en ;
    rdfs:comment "Digital fingerprint (SHA-256 or stronger) ensuring non-repudiation. Anchors GxP / 21 CFR Part 11 audit-trail discipline at the Core layer."@en ;
    rdfs:domain top:Evidence ;
    rdfs:range xsd:string ;
    top:flavor "Invariant" .

top:observedAt a owl:DatatypeProperty ;
    rdfs:label "observed at"@en ;
    rdfs:comment "When the system recorded this entity-version — the transaction-time anchor (per ADR-0021), NGSI-LD-style. Distinct from valid time (top:validFrom / top:validUntil, the second clock, opt-in) and from intrinsic activity times (Temporal.startTime / endTime, domain-level)."@en ;
    rdfs:domain top:CommonEntity ;
    rdfs:range xsd:dateTime ;
    top:flavor "Invariant" .

top:signedBy a owl:ObjectProperty ;
    rdfs:label "signed by"@en ;
    rdfs:comment "Links the Evidence to the Agent who attested to its truth. E-signature semantics (21 CFR Part 11) and PROV attribution."@en ;
    rdfs:domain top:Evidence ;
    rdfs:range top:Agent ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    top:flavor "Tightenable" .

top:status a owl:DatatypeProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Current lifecycle / health state. Each Category narrows the enum at its layer; leaves narrow further. Universal at this layer because every entity has SOME state and the project-wide status query is operationally meaningful."@en ;
    rdfs:domain top:CommonEntity ;
    rdfs:range xsd:string ;
    top:flavor "Tightenable" .

top:validUntil a owl:DatatypeProperty ;
    rdfs:label "valid until"@en ;
    rdfs:comment "End of the valid-time interval; open (absent) for the currently-valid version. Invariant per ADR-0019."@en ;
    rdfs:range xsd:dateTime ;
    top:flavor "Invariant" .

cr:AchieveMilestone a hcls:Action ;
    rdfs:label "Achieve Milestone" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:ActivityTemplate a owl:Class ;
    rdfs:label "Activity Template" ;
    rdfs:comment "The protocol-defined activity template: the procedure to perform at a visit. USDM-ingest-derivable from StudyDesign.activities[]. Carries the biomedical-concept code that determines what kind of data the activity collects. USDM: Activity." ;
    rdfs:subClassOf top:Scope .

cr:AddInvestigatorDelegation a hcls:Action ;
    rdfs:label "Add Investigator Delegation" ;
    cr:occursInStage cr:SiteActivationStage ;
    hcls:authorizedAgentType cr:Investigator ;
    hcls:operatesOn cr:Delegation .

cr:ArchivalEvent a owl:Class ;
    rdfs:label "Archival Event" ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "archiving"@en,
        "records retention"@en ;
    skos:definition "The transfer of the site's essential records into retention storage, opening the retention clock (ICH E6(R3): per sponsor/regulatory requirements)." ;
    skos:prefLabel "Archival Event"@en .

cr:AuditTrail a owl:Class ;
    rdfs:label "Audit Trail" ;
    rdfs:isDefinedBy <https://www.ich.org/page/efficacy-guidelines> ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "audit log"@en,
        "change history"@en ;
    skos:definition "Secure, computer- or paper-generated documentation that allows reconstruction of the course of events around a record (paraphrased, ICH E6(R3)). In TOP, the bitemporal + PROV envelope realizes this by construction." ;
    skos:prefLabel "Audit Trail"@en .

cr:BiomedicalConcept a owl:Class ;
    rdfs:label "Biomedical Concept" ;
    rdfs:comment "Reuses CDISC Biomedical Concept anchors as an INPUT (crosswalk targets), not a rival. The concept-first pivot: bind once to the concept; every standard (SDTM/Define/FHIR) is then a projection." ;
    rdfs:subClassOf top:Evidence ;
    skos:definition "A canonical, sponsor-agnostic concept a data element binds to (e.g. Sodium). Codes to external terminologies (LOINC, NCIt, SNOMED) are attached as Relationships to dereferenceable URIs via cr:codedAs — never as string Properties." .

cr:BlindingConstraint a owl:Class ;
    rdfs:label "Blinding Constraint" ;
    rdfs:comment "Grounded in MVP Inventory §5 blinding. A cr:blindingScope value (e.g. 'treatment-assignment', 'unblinded-pk') plus provenance." ;
    rdfs:subClassOf top:Constraint ;
    skos:definition "The scope and provenance of what is blinded in a transfer, and to whom — a constraint that drives routing, not a boolean. Replaces the MVP's boolean 'Transfer Blinding'." .

cr:Capability a owl:Class ;
    rdfs:label "Capability" ;
    rdfs:comment "A delegable permission to perform a trial task (e.g. obtain informed consent)." ;
    rdfs:subClassOf top:Constraint ;
    skos:altLabel "authorized task"@en,
        "delegable task"@en ;
    skos:prefLabel "Capability"@en .

cr:CausalityAssessment a owl:Class ;
    rdfs:label "Causality Assessment" ;
    rdfs:comment "Physician's coded causality judgment for an adverse event, recorded with provenance and rationale." ;
    rdfs:subClassOf top:Conclusion ;
    skos:altLabel "attribution"@en,
        "causality"@en,
        "relatedness"@en ;
    skos:prefLabel "Causality Assessment"@en .

cr:CertifiedCopy a owl:Class ;
    rdfs:label "Certified Copy" ;
    rdfs:isDefinedBy <https://www.ich.org/page/efficacy-guidelines> ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:definition "A copy of original information verified (dated/signed or generated by a validated process) as a complete and accurate copy (paraphrased, ICH E6(R3))." .

cr:ClinicalTrialAgreement a owl:Class ;
    rdfs:label "Clinical Trial Agreement (CTA)" ;
    rdfs:comment "Executed site contract (observedAt = execution date)." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "CTA"@en,
        "clinical trial agreement"@en,
        "contract"@en,
        "site contract"@en ;
    skos:prefLabel "Clinical Trial Agreement (CTA)"@en .

cr:ConsentWithdrawal a owl:Class ;
    rdfs:label "Consent Withdrawal" ;
    rdfs:comment "The temporal act of a subject withdrawing informed consent, closing the consent valid-time interval." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "revoked consent"@en,
        "withdrawal of consent"@en ;
    skos:prefLabel "Consent Withdrawal"@en .

cr:CreateQuery a hcls:Action ;
    rdfs:label "Create Query" ;
    cr:occursInStage cr:DataCollectionStage ;
    hcls:authorizedAgentType cr:ClinicalResearchAssociate,
        cr:DataManager ;
    hcls:operatesOn cr:eCRF .

cr:DataAnalysisStage a cr:TrialStage ;
    rdfs:label "Data Analysis" ;
    rdfs:comment "Database lock, data cleaning and validation, statistical analysis plan execution, longitudinal analysis, survival analysis, interim and final analyses." .

cr:DelayMilestone a hcls:Action ;
    rdfs:label "Delay Milestone" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:EssentialRecord a owl:Class ;
    rdfs:label "Essential Record" ;
    rdfs:comment "The class the TMF artifact-type scheme (tmf:) classifies the documents of." ;
    rdfs:isDefinedBy <https://www.ich.org/page/efficacy-guidelines> ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "Essential Document",
        "essential document"@en ;
    skos:definition "A record that, individually or collectively, permits evaluation of the conduct of a trial and the quality of the data produced (paraphrased, ICH E6(R3))." ;
    skos:prefLabel "Essential Record"@en .

cr:Estimand a owl:Class ;
    rdfs:label "Estimand" ;
    rdfs:comment "The precise treatment-effect definition a result must trace to (overstatement guard)." ;
    rdfs:subClassOf top:Scope ;
    skos:prefLabel "Estimand"@en .

cr:ExpectednessAssessment a owl:Class ;
    rdfs:label "Expectedness Assessment" ;
    rdfs:comment "The recorded judgment that a reaction is expected or unexpected against the current reference safety information (Investigator's Brochure / label) — the P6 promotion of the former susarUnexpected boolean. Same shape as cr:CausalityAssessment: a judgment with authority, time, and the document it was judged against." ;
    rdfs:subClassOf top:Conclusion ;
    skos:altLabel "expected/unexpected judgment"@en,
        "expectedness"@en ;
    skos:hiddenLabel "susarUnexpected"@en ;
    skos:prefLabel "Expectedness Assessment"@en .

cr:FollowUpVisit a owl:Class ;
    rdfs:label "Follow-up Visit" ;
    rdfs:comment "A kind of cr:Visit; the followUpType qualifier (safety | efficacy | qol) distinguishes the purpose without a parallel hierarchy." ;
    rdfs:subClassOf cr:Visit ;
    skos:definition "A visit that occurs after the treatment period — long-term safety, efficacy, or QoL follow-up. May continue after database lock, captured under an addendum/unlock." .

cr:GLPToxReport a owl:Class ;
    rdfs:label "GLP Toxicology Report" ;
    rdfs:comment "A GLP toxicology study report supporting safe human dosing." ;
    rdfs:subClassOf top:Evidence .

cr:INDApplication a owl:Class ;
    rdfs:label "IND Application" ;
    rdfs:comment "The submission authorizing human dosing; starts a 30-day review clock (top:observedAt = submission) after which trials may proceed unless a clinical hold is placed." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned .

cr:IRBApproval a owl:Class ;
    rdfs:label "IRB/IEC Approval" ;
    rdfs:comment "Local IRB/IEC approval (observedAt = approval date)." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "EC approval"@en,
        "IEC approval"@en,
        "ethics approval"@en ;
    skos:prefLabel "IRB Approval"@en .

cr:InvestigatorSiteFile a owl:Class ;
    rdfs:label "Investigator Site File" ;
    rdfs:comment "Sibling of cr:TrialMasterFile; ISF completeness is a closure gate." ;
    rdfs:subClassOf top:Evidence ;
    skos:altLabel "ISF"@en,
        "investigator file"@en,
        "regulatory binder"@en,
        "site file"@en ;
    skos:definition "The site's regulated file of essential records (the ISF / 'regulatory binder') — the site-held counterpart of the sponsor's Trial Master File." ;
    skos:prefLabel "Investigator Site File"@en .

cr:LabOrder a owl:Class ;
    rdfs:label "Lab Order" ;
    rdfs:comment "The order binding an assay to a specimen — what the operator calls 'the order'. Renamed from cr:AnalysisRequest: 'analysis request' collides with every non-lab sense of analysis (e.g. a manager asking for a site-performance analysis) — first-principles P2, ADR-0024 ambiguity gate." ;
    rdfs:subClassOf top:Temporal ;
    skos:altLabel "lab request"@en,
        "order"@en,
        "test order"@en ;
    skos:hiddenLabel "AnalysisRequest"@en,
        "analysis request"@en ;
    skos:prefLabel "Lab Order"@en ;
    skos:scopeNote "Renamed from cr:AnalysisRequest (ADR-0024 ambiguity gate): 'analysis request' collides with every non-lab sense — a manager requesting a site-performance analysis is not a lab order."@en .

cr:NonclinicalFinding a owl:Class ;
    rdfs:label "Nonclinical Finding" ;
    rdfs:comment "An observed animal toxicity/finding that the clinical protocol must address." ;
    rdfs:subClassOf top:Outcome .

cr:PreScreening a owl:Class ;
    rdfs:label "Pre-Screening" ;
    rdfs:subClassOf top:Temporal ;
    skos:altLabel "phone screen"@en,
        "pre-screen"@en,
        "prescreen"@en ;
    skos:definition "A preliminary eligibility check performed before consent — a phone script, an EHR filter, a questionnaire — that decides whether a candidate proceeds to full screening." ;
    skos:prefLabel "Pre-Screening"@en .

cr:RecordFinding a hcls:Action ;
    rdfs:label "Record Finding" ;
    cr:occursInStage cr:OversightStage ;
    hcls:authorizedAgentType cr:ClinicalResearchAssociate ;
    hcls:operatesOn cr:VisitOccurrence .

cr:RegulatoryQuestion a owl:Class ;
    rdfs:label "Regulatory Question" ;
    rdfs:comment "A briefing-book question; should carry a proposed position (FDA punishes vague questions)." ;
    rdfs:subClassOf top:Evidence .

cr:RepeatingPlannedActivity a owl:Class ;
    rdfs:label "Repeating Planned Activity" ;
    rdfs:comment "A planned activity that recurs on an interval until a stop condition (e.g. a daily participant diary until Day N; dosing every 7 days)." ;
    rdfs:subClassOf cr:PlannedActivity .

cr:RetentionPolicy a owl:Class ;
    rdfs:label "Retention Policy" ;
    rdfs:comment "A regulatory or sponsor-mandated data retention period (e.g. ICH E6(R3): 25 years for essential documents)." ;
    rdfs:subClassOf top:Constraint .

cr:RiskManagementPlan a owl:Class ;
    rdfs:label "Risk Management Plan" ;
    rdfs:comment "A living document — updated as circumstances change; versions supersede bitemporally. Aggregates via cr:documentsAssessment." ;
    rdfs:subClassOf top:Constraint ;
    skos:altLabel "RBQM plan"@en,
        "RMP"@en,
        "quality management plan"@en ;
    skos:definition "The living document that records the trial's risk methodology and current risk posture: identified assessments, evaluation criteria, control strategies, monitoring approach, and review cadence." ;
    skos:prefLabel "Risk Management Plan"@en .

cr:RiskReview a owl:Class ;
    rdfs:label "Risk Review" ;
    rdfs:comment "RBQM is a cycle, not a checklist: identification, evaluation, control, communication, review — and review feeds back into identification. The review is the entity that makes the cycle auditable." ;
    rdfs:subClassOf top:Evidence ;
    skos:altLabel "periodic risk review"@en,
        "risk re-assessment"@en ;
    skos:definition "A periodic re-examination of a risk assessment against accumulated trial experience — the ICH E6(R3) risk review step. Each review confirms, revises, or retires the assessment it reviews." ;
    skos:prefLabel "Risk Review"@en .

cr:RiskSignal a owl:Class ;
    rdfs:label "Risk Signal" ;
    rdfs:comment "A leading indicator (a trend or metric) that flags a deviation antecedent before it manifests — the signal a provenance-native graph can hold as low-trust, provenance-tagged evidence." ;
    rdfs:subClassOf top:Evidence ;
    skos:altLabel "KRI"@en,
        "KRI signal"@en,
        "key risk indicator"@en ;
    skos:prefLabel "Risk Signal"@en .

cr:StatisticalAnalysisPlan a owl:Class ;
    rdfs:label "Statistical Analysis Plan" ;
    rdfs:comment "The pre-specified plan for analyzing the study's data." ;
    rdfs:subClassOf top:Evidence ;
    skos:altLabel "SAP"@en ;
    skos:prefLabel "Statistical Analysis Plan"@en .

cr:UpdateCRF a hcls:Action ;
    rdfs:label "Update CRF" ;
    cr:occursInStage cr:DataCollectionStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:eCRF .

cr:VendorAlias a owl:Class ;
    rdfs:label "Vendor Alias" ;
    rdfs:comment "The exemplar of the whole thesis. Resolve once; the next sponsor with the same vendor term auto-resolves. Grounded in the info-model ENCOUNTER_MAPPING / Data-Provider-Visit fields — deliberately re-modeled." ;
    rdfs:subClassOf top:Evidence ;
    skos:definition "A vendor's term (column name, visit label, unit string) captured ONLY as a resolution edge into the canonical corpus: cr:vendorTerm (the raw string) + cr:aliasResolvesTo (the canonical concept/encounter/unit) + cr:resolutionConfidence + cr:resolvedFrom provenance. Deliberately NOT a stored per-DTA row — the DTA group's ENCOUNTER_MAPPING re-modeled as resolution so the corpus compounds." .

cr:VendorConnectorProfile a owl:Class ;
    rdfs:label "Vendor Connector Profile" ;
    rdfs:comment "Instances grounded in verified public documentation: Castor EDC (OAuth2 REST + CDISC ODM export), Veeva Vault CDMS/CDB (SDE CSV/SAS/XPT + incremental SFF), Medidata Rave (RWS + ODM + audit-ID incremental), Oracle Clinical One (ODM-XML extract, Snapshot/Transactional). See examples/dta-lab-safety/vendor-connectors.ttl." ;
    rdfs:subClassOf cr:TransferProfile ;
    skos:definition "A TransferProfile pre-populated from a named vendor's documented data-export surface (API/format/terminology), so a sponsor onboarding that vendor starts from a catalog default rather than a blank DTA. The operational counterpart to the compounding alias corpus." .

cr:xl-arm a ns2:Label ;
    dcterms:source "OPMODEL §1.1 Study Design" ;
    skos:scopeNote "HOMONYM: treatment arm (cr:Arm) vs the anatomical arm (blood-draw laterality, injection site). Study-design context routes to cr:Arm; clinical-procedure context is anatomical."@en ;
    ns2:literalForm "arm"@en .

cr:xl-monitor a ns2:Label ;
    dcterms:source "OPMODEL §2.5 Oversight; ROLES persona aliases" ;
    skos:scopeNote "HOMONYM: the person (cr:ClinicalResearchAssociate), the visit (monitoring visit), the discipline (risk-based / central / medical monitoring — distinct capabilities), and the verb. Default routing: the CRA role; qualify otherwise."@en ;
    ns2:literalForm "monitor"@en .

cr:xl-site a ns2:Label ;
    dcterms:source "OPMODEL §1.4 Site Selection" ;
    skos:scopeNote "HOMONYM: the investigative site (cr:StudySite, an organization) vs bfo:Site / top:Location (a place) vs injection/body site vs website. Default routing in this domain: cr:StudySite."@en ;
    ns2:literalForm "site"@en .

hcls:HealthcareFacility a owl:Class ;
    rdfs:label "Healthcare Facility" ;
    rdfs:comment "A physical place where care or research is conducted." ;
    rdfs:subClassOf top:Location .

hcls:MedicinalProduct a owl:Class ;
    rdfs:label "Medicinal Product" ;
    rdfs:comment "A medicinal product (drug or biologic)." ;
    rdfs:subClassOf top:Resource .

hcls:Practitioner a owl:Class ;
    rdfs:label "Practitioner" ;
    rdfs:comment "A healthcare professional." ;
    rdfs:subClassOf hcls:Person .

top:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:comment "An executed unit of operational work — a procedure performed, a batch run, a shipment received, a review completed."@en ;
    rdfs:subClassOf prov:Activity,
        top:Temporal .

top:Artifact a owl:Class ;
    rdfs:label "Artifact"@en ;
    rdfs:comment "A produced object — a manufactured batch unit, a generated dataset, a derived report, a synthesized substance."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#MaterialEntity>,
        prov:Entity,
        top:Outcome .

top:Credential a owl:Class ;
    rdfs:label "Credential"@en ;
    rdfs:comment "Proof of qualification or identity for an Agent — license, certification, training record, role assignment, e-credential."@en ;
    rdfs:subClassOf prov:Entity,
        top:Evidence .

top:Schedule a owl:Class ;
    rdfs:label "Schedule"@en ;
    rdfs:comment "A planned sequence of activities with intended timing — Schedule of Assessments, manufacturing campaign plan, audit calendar, dosing schedule."@en ;
    rdfs:subClassOf prov:Activity,
        top:Temporal .

top:VersionSeries a owl:Class ;
    rdfs:label "Version Series"@en ;
    rdfs:comment "The stable identity root for a chain of top:Versioned snapshots. An instance of top:VersionSeries has a single IRI that never changes; each point-in-time value-version links to it via prov:specializationOf. Consumers and external references always point at the VersionSeries; version navigation is a query, not an IRI change."@en .

top:validFrom a owl:DatatypeProperty ;
    rdfs:label "valid from"@en ;
    rdfs:comment "Domain intentionally open: rdfs:domain is an inference axiom, not a constraint — a domain of top:Versioned would retype every dated entity as Versioned and drag it under the versioning contract (the RDFS target cascade). The requirement side lives in SHACL: top:BitemporalShape demands validFrom on Versioned."@en,
        "Start of the valid-time interval — when this version's state became true in the world. Distinct from top:observedAt (transaction time). Invariant per ADR-0019, like top:startTime/top:endTime. No PROV-O peer: PROV models system time, not valid-time-of-a-fact (declared absence, per ADR-0021)."@en ;
    rdfs:range xsd:dateTime ;
    top:flavor "Invariant" .

cr:AssayDefinition a owl:Class ;
    rdfs:label "Assay Definition" ;
    rdfs:comment "Catalog definition of a laboratory test/assay (e.g. a biomarker assay) — the definitional pattern of cr:VisitDefinition and cr:DataElementDef applied to the lab. Renamed from cr:AnalysisService ('service' collides with service-provider and API senses)." ;
    rdfs:subClassOf top:Evidence ;
    skos:altLabel "assay"@en,
        "lab test"@en,
        "test definition"@en,
        "test panel"@en ;
    skos:hiddenLabel "AnalysisService"@en,
        "analysis service"@en ;
    skos:prefLabel "Assay Definition"@en ;
    skos:scopeNote "Renamed from cr:AnalysisService: 'service' collides with cr:ServiceProvider and API/runtime senses."@en .

cr:AssayResult a owl:Class ;
    rdfs:label "Assay Result" ;
    rdfs:comment "A measured laboratory result on a Specimen, joined to the StudySubject." ;
    rdfs:subClassOf hcls:Observation ;
    skos:altLabel "lab result"@en,
        "lab value"@en,
        "test result"@en ;
    skos:prefLabel "Assay Result"@en .

cr:CaseReportForm a owl:Class ;
    rdfs:label "Case Report Form" ;
    rdfs:comment "A case report form — a collection of item groups capturing a visit's data." ;
    rdfs:subClassOf top:Evidence ;
    skos:altLabel "CRF"@en ;
    skos:prefLabel "Case Report Form"@en .

cr:CloseOutVisit a owl:Class ;
    rdfs:label "Close-Out Visit" ;
    rdfs:comment "The closing bracket of the SIV — same shape as cr:SiteInitiationVisit, at the other end of the site's life." ;
    rdfs:subClassOf top:Temporal ;
    skos:altLabel "COV"@en,
        "closeout visit"@en,
        "final monitoring visit"@en ;
    skos:definition "The CRA's final monitoring visit to a site (COV): confirming reconciliations, ISF completeness, outstanding-query closure, and archival arrangements before the site closes." ;
    skos:prefLabel "Close-Out Visit"@en .

cr:ConductMonitoringVisit a hcls:Action ;
    rdfs:label "Conduct Monitoring Visit" ;
    cr:occursInStage cr:OversightStage ;
    hcls:authorizedAgentType cr:ClinicalResearchAssociate ;
    hcls:operatesOn cr:VisitOccurrence .

cr:DatabaseUnlock a owl:Class ;
    rdfs:label "Database Unlock" ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "database reopen"@en,
        "unlock"@en ;
    skos:definition "A controlled, reasoned reopening of a locked database (e.g. a late data correction). It references the DatabaseLock it reopens and records a reason — the audit gate that makes post-lock change legitimate rather than silent." ;
    skos:prefLabel "Database Unlock"@en .

cr:DestructionEvent a owl:Class ;
    rdfs:label "Destruction Event" ;
    rdfs:comment "Destruction without a recorded authorizer is a Violation — product never silently disappears from the chain." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "destruction"@en,
        "drug destruction"@en ;
    skos:definition "The authorized destruction of investigational product, closing its accountability chain." ;
    skos:prefLabel "Destruction Event"@en .

cr:IntegratedSummary a owl:Class ;
    rdfs:label "Integrated Summary" ;
    rdfs:comment "The kind (safety vs efficacy) is cr:summaryKind, a value — not two classes (ADR-0024). Multi-study by construction: >=1 cr:integratesStudy, each referenced by IRI. Derives from the per-study ADaM datasets via prov:wasDerivedFrom, so the integrated number is reproducible to each study's source." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "ISE"@en,
        "ISS"@en,
        "integrated summary of efficacy"@en,
        "integrated summary of safety"@en ;
    skos:definition "A cross-study integrated analysis prepared for a marketing application — the Integrated Summary of Safety (ISS) or of Efficacy (ISE) — resting on the locked analysis datasets of the studies it integrates." ;
    skos:prefLabel "Integrated Summary"@en .

cr:InvestigationalProduct a owl:Class ;
    rdfs:label "Investigational Product" ;
    rdfs:comment "The investigational drug or biologic being studied." ;
    rdfs:subClassOf hcls:MedicinalProduct ;
    skos:altLabel "IMP"@en,
        "IP"@en,
        "investigational medicinal product"@en,
        "study drug"@en,
        "test article"@en ;
    skos:prefLabel "Investigational Product"@en .

cr:Phase3Design a owl:Class ;
    rdfs:label "Proposed Phase 3 Design" ;
    rdfs:comment "A proposed Phase 3 trial design taken to the EOP2 meeting." ;
    rdfs:subClassOf top:Scope .

cr:PlannedEncounter a owl:Class ;
    rdfs:label "Planned Encounter" ;
    rdfs:comment "A planned visit slot on the timeline (USDM Encounter). Positioned by a cr:Timing relative to an anchor; actual cr:Visits are reconciled against it." ;
    rdfs:subClassOf top:Constraint .

cr:Publication a owl:Class ;
    rdfs:label "Publication" ;
    rdfs:comment "The kind (article/abstract/preprint) is cr:publicationKind, a value (ADR-0024). A publication reporting a result cites it by IRI (cr:disclosesResult) — 'what does this paper's number rest on' is the same graph walk as the CSR's cr:reportsResult." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "abstract"@en,
        "journal article"@en,
        "manuscript"@en,
        "paper"@en ;
    skos:definition "A peer-reviewed article, conference abstract, or preprint disclosing study results — reporting results that trace to the analysis layer." ;
    skos:prefLabel "Publication"@en .

cr:RecruitmentCampaign a owl:Class ;
    rdfs:label "Recruitment Campaign" ;
    rdfs:comment "The top of the funnel. Carries its channel (cr:campaignChannel) and the study it recruits for." ;
    rdfs:subClassOf top:Scope ;
    skos:altLabel "outreach"@en,
        "patient finding"@en,
        "recruitment"@en ;
    skos:definition "A planned outreach effort to find candidates for a study — advertising, referral programs, EHR cohort searches, community outreach." ;
    skos:prefLabel "Recruitment Campaign"@en .

cr:ReturnEvent a owl:Class ;
    rdfs:label "Return Event" ;
    rdfs:subClassOf top:Temporal ;
    skos:altLabel "drug return"@en,
        "returned units"@en ;
    skos:definition "The return of unused or partially used investigational product from a participant or site back into custody, with the returned quantity." ;
    skos:prefLabel "Return Event"@en .

cr:SUSAR a owl:Class ;
    rdfs:label "SUSAR" ;
    rdfs:comment "Suspected Unexpected Serious Adverse Reaction — requires expedited regulatory reporting (7 days fatal/life-threatening, 15 days other). ADR-0024 known deviation: 'suspected' (causality) and 'unexpected' (vs. reference safety information) are judgments against criteria; refactors together with cr:SeriousAdverseEvent in the dedicated safety-module pass." ;
    rdfs:subClassOf cr:SeriousAdverseEvent ;
    skos:altLabel "suspected unexpected serious adverse reaction"@en ;
    skos:prefLabel "SUSAR"@en .

cr:SafetyReport a owl:Class ;
    rdfs:label "Safety Report" ;
    rdfs:comment "Expedited report of an SAE to the regulator." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "15-day report"@en,
        "IND safety report"@en,
        "expedited report"@en ;
    skos:prefLabel "Safety Report"@en .

cr:SeriousAdverseEvent a owl:Class ;
    rdfs:label "Serious Adverse Event" ;
    rdfs:comment "An adverse event meeting seriousness criteria (expedited reporting). ADR-0024 known deviation: seriousness is a judgment against ICH E2A criteria — the same shape as cr:CausalityAssessment, which the model already promotes to a fact. Slated to become a promoted seriousness assessment with 'SAE' derived as a view, in a dedicated safety-module pass (the expedited-reporting shapes and worked examples currently depend on this class)." ;
    rdfs:subClassOf cr:AdverseEvent ;
    skos:altLabel "SAE"@en ;
    skos:prefLabel "Serious Adverse Event"@en .

cr:Shipment a owl:Class ;
    rdfs:label "Shipment" ;
    rdfs:subClassOf top:Temporal ;
    skos:altLabel "consignment"@en,
        "drug shipment"@en,
        "resupply"@en ;
    skos:definition "A transfer of investigational-product lots from depot (or sponsor) to a study site, with its dispatch and receipt times." ;
    skos:prefLabel "Shipment"@en .

cr:SiteClosure a owl:Class ;
    rdfs:label "Site Closure" ;
    rdfs:comment "A promoted fact (P6): 'isClosed' is never a flag. Closure without its evidence (COV + reconciliations complete) is a Violation." ;
    rdfs:subClassOf top:Outcome,
        top:Versioned ;
    skos:altLabel "closure"@en,
        "site closed"@en,
        "site closeout"@en ;
    skos:definition "The record that a site's participation in the study has ended — resting on the Close-Out Visit and the completed reconciliations." ;
    skos:prefLabel "Site Closure"@en .

cr:SourceDocument a owl:Class ;
    rdfs:label "Source Document" ;
    rdfs:isDefinedBy <https://www.ich.org/page/efficacy-guidelines> ;
    rdfs:subClassOf cr:EssentialRecord ;
    skos:altLabel "source"@en,
        "source doc"@en,
        "worksheet"@en ;
    skos:definition "The original document/record holding source data (paraphrased, ICH E6(R3))." ;
    skos:prefLabel "Source Document"@en .

cr:Sponsor a owl:Class ;
    rdfs:label "Sponsor" ;
    rdfs:comment "The organization that initiates and is accountable for the trial." ;
    rdfs:subClassOf hcls:Organization .

cr:SubmitMonitoringReport a hcls:Action ;
    rdfs:label "Submit Monitoring Report" ;
    cr:occursInStage cr:OversightStage ;
    hcls:authorizedAgentType cr:ClinicalResearchAssociate ;
    hcls:operatesOn cr:VisitOccurrence .

cr:TemperatureExcursion a owl:Class ;
    rdfs:label "Temperature Excursion" ;
    rdfs:subClassOf top:Outcome ;
    skos:altLabel "cold-chain excursion"@en,
        "excursion"@en,
        "temp excursion"@en ;
    skos:definition "A recorded departure from a lot's required storage conditions — a promoted fact (never an 'isCompromised' flag) that quarantines the affected product until disposition." ;
    skos:prefLabel "Temperature Excursion"@en .

cr:TimingWindow a owl:Class ;
    rdfs:label "Timing Window" ;
    rdfs:comment "An allowed tolerance around a planned time: a lower and an upper offset in days (e.g. [-2 days, +2 days])." ;
    rdfs:subClassOf top:Constraint .

cr:TransferAmendment a owl:Class ;
    rdfs:label "Transfer Amendment" ;
    rdfs:comment "Amendment as event (Outcome:StatusChange). Bitemporal; drives the cross-entity shape that forces amendment propagation to be explicit." ;
    rdfs:subClassOf top:Outcome ;
    skos:definition "A status change on a protocol/spec version that carries effectiveFrom/To and MUST reference the TransferSpecifications it affects. Propagation is a graph update + re-validation, not N manual DTA re-authorings." .

cr:TransferScope a owl:Class ;
    rdfs:label "Transfer Scope" ;
    rdfs:comment "Grounded in DTA MVP Information Model open Q1 (multi-vendor / multi-scope DTA). Recommend modeling scope explicitly — the single-vendor simplification is exactly where the exponential hides." ;
    rdfs:subClassOf top:Scope ;
    skos:definition "A mediator that lets one DataTransferAgreement cover multiple vendor/data-type scopes without repeating the agreement. Each TransferScope binds a data type, a vendor Organization and its TransferSpecification(s). Modeling scope explicitly from the start is where the DTA group's combinatorics are made visible rather than hidden (open Q1)." .

cr:VisitDefinition a owl:Class ;
    rdfs:label "Visit Definition" ;
    rdfs:comment "The protocol-defined visit template: what is SUPPOSED to happen (type, window, mode, ordering). USDM-ingest-derivable from StudyDesign.encounters[]. UNSCHEDULED visits (urgent care, AE workup) have no VisitDefinition; their VisitOccurrence.definedBy is absent. USDM: Encounter. SDTM projection: SE (Study Elements) domain." ;
    rdfs:subClassOf prov:Entity,
        top:Scope .

cx:Mapping a owl:Class ;
    rdfs:label "Crosswalk Mapping" ;
    rdfs:comment "A curated, provenanced correspondence from a TOP term to an external ontology term." ;
    rdfs:subClassOf top:Evidence .

hcls:Consent a owl:Class ;
    rdfs:label "Consent" ;
    rdfs:comment "An act of agreement by a Person authorizing an action or use of their data/person. HCLS-universal: permutates to cr:InformedConsentAct (clinical trial enrollment), HIPAA Authorization (data use), Treatment Consent (clinical care). Carries valid-time (when consent was given, when it expires) and transaction-time (when it was recorded)." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned .

hcls:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "An information artifact recording a measured value; refersTo the Person/Specimen it is about." ;
    rdfs:subClassOf top:Evidence .

ns1:TrialMasterFile a owl:Class ;
    rdfs:label "Trial Master File" ;
    rdfs:comment "The assembled set of filed artifacts evidencing the conduct of one study (the cabinet). Carries the filed set and the completeness profile it is judged against." ;
    rdfs:subClassOf top:Evidence .

ns1:Zone_CentralTrialDocs a skos:Concept ;
    skos:prefLabel "Central Trial Documents" ;
    skos:topConceptOf ns1:TMFReferenceModel .

ns1:concerns a owl:ObjectProperty ;
    rdfs:label "concerns" ;
    rdfs:comment "The domain class whose instances this artifact type carries (general bridge)." ;
    rdfs:domain ns1:TMFArtifactType ;
    rdfs:range owl:Class ;
    top:flavor "Additive" .

cr:AnalysisDataset a owl:Class ;
    rdfs:label "Analysis Dataset (ADaM)" ;
    rdfs:comment "Must declare prov:wasDerivedFrom its source so any result built on it is reproducible to source. Its ADaM structure (ADSL/BDS/OCCDS) is cr:datasetStructure — a value, not a subclass (ADR-0024 one-question gate)." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "ADaM dataset"@en,
        "analysis data"@en ;
    skos:definition "An ADaM analysis dataset (e.g. ADSL, ADAE, ADEFF) — analysis-ready data derived from the native clinical facts, structured per a CDISC ADaM structure class." ;
    skos:prefLabel "Analysis Dataset"@en .

cr:CAPA a owl:Class ;
    rdfs:label "CAPA" ;
    rdfs:comment "Corrective And Preventive Action — the formal response to a deviation or finding (corrective: fix this occurrence; preventive: stop recurrence). Bitemporal + attested." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "corrective action"@en,
        "corrective and preventive action"@en ;
    skos:prefLabel "CAPA"@en .

cr:ClinicalStudyReport a owl:Class ;
    rdfs:label "Clinical Study Report (CSR)" ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "CSR"@en,
        "study report"@en ;
    skos:definition "The ICH E3 integrated report of a single study — the narrative document the submission (eCTD Module 5.3.5) carries. Modeled as a fact graph of its sections, not an opaque file, so its results sections trace to the analysis outputs they present." ;
    skos:prefLabel "Clinical Study Report"@en .

cr:CodingReview a owl:Class ;
    rdfs:label "Coding Review" ;
    rdfs:subClassOf top:Temporal ;
    skos:altLabel "coder review"@en,
        "coding approval"@en ;
    skos:definition "A human review of a code assignment — approving, correcting, or querying it. Autocoded assignments carry one or are flagged." ;
    skos:prefLabel "Coding Review"@en .

cr:CustodyEvent a owl:Class ;
    rdfs:label "Custody Event" ;
    rdfs:comment "A specimen state transition (SampleDue->Received->ToBeVerified->Verified->Published) — chain of custody." ;
    rdfs:subClassOf top:Temporal .

cr:DataProcessingAgreement a owl:Class ;
    rdfs:label "Data Processing Agreement" ;
    rdfs:comment "A GDPR-required agreement between a data controller (sponsor) and data processor (CRO, central lab), versioned and effective-dated." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned .

cr:DataSubjectRequest a owl:Class ;
    rdfs:label "Data Subject Request" ;
    rdfs:comment "A GDPR data subject right exercise: access, erasure, rectification, or portability." ;
    rdfs:subClassOf top:Temporal .

cr:DatabaseLock a owl:Class ;
    rdfs:label "Database Lock" ;
    rdfs:comment "Bitemporal: the lock's valid time (top:observedAt) is the lock date; corrections are new assertions, never rewrites." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "DB lock"@en,
        "data lock"@en,
        "hard lock"@en,
        "soft lock"@en ;
    skos:definition "The act of freezing the study database. A SOFT lock freezes it for review and is reversible; a HARD lock freezes it for analysis. After a hard lock, no clinical value may change without a recorded DatabaseUnlock." ;
    skos:prefLabel "Database Lock"@en ;
    skos:scopeNote "Operators say 'the finish line'; soft vs hard is carried by cr:lockType, not by separate classes (ADR-0024 one-question gate: a classification, not a kind)."@en .

cr:DispensingEvent a owl:Class ;
    rdfs:label "Dispensing Event" ;
    rdfs:comment "Dispensed TO the pseudonymous Participant (cr:StudySubject), never an identifiable Person — the PII containment invariant extends to the pharmacy." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "dispensation"@en,
        "dispensing"@en,
        "drug dispensing"@en ;
    skos:definition "The handing of investigational product (by kit, from a lot) to a participant at a visit — the pivotal accountability event." ;
    skos:prefLabel "Dispensing Event"@en .

cr:ItemGroup a owl:Class ;
    rdfs:label "Item Group" ;
    rdfs:comment "A logical clustering of items (ItemGroupOID)." ;
    rdfs:subClassOf top:Evidence .

cr:KeyRiskIndicator a owl:Class ;
    rdfs:label "Key Risk Indicator" ;
    rdfs:comment "Operational and leading, in contrast to the trial-level cr:QualityToleranceLimit which is systemic. A KRI should trace to the CtQ factor it protects (cr:informsFactor) — a KRI with no CtQ ancestry is measurement theater." ;
    rdfs:subClassOf top:Constraint ;
    skos:altLabel "KRI"@en,
        "quality metric"@en,
        "risk indicator"@en ;
    skos:definition "A site- or data-domain-level leading metric used to detect localized performance degradation early — screen-failure rate, eCRF entry cycle time, query aging, deviation rate. Breaches trigger targeted monitoring intervention, not (by themselves) CSR reporting." ;
    skos:prefLabel "Key Risk Indicator"@en .

cr:KitAssignment a owl:Class ;
    rdfs:label "Kit Assignment" ;
    rdfs:comment "The kit number is what the site sees; the arm behind it stays with the randomization system. Dispensing (cr:DispensingEvent, supply module) cites the kit." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "blinded kit"@en,
        "kit"@en,
        "kit number"@en ;
    skos:definition "The assignment of a blinded kit (numbered container of investigational product or comparator) to a randomized participant — the mechanism that operationalizes the blind." ;
    skos:hiddenLabel "IRT"@en,
        "IWRS"@en,
        "IxRS"@en,
        "RTSM"@en ;
    skos:prefLabel "Kit Assignment"@en ;
    skos:scopeNote "IxRS / IWRS / IRT / RTSM name the SYSTEM that performs randomization and supply; its recorded acts are cr:RandomizationEvent and cr:KitAssignment."@en .

cr:MetricObservation a owl:Class ;
    rdfs:label "Metric Observation" ;
    rdfs:comment "The bitemporal envelope is what answers the inspector's question 'why didn't the algorithm flag the March 1 event on March 3?' — because recordedAt shows the event had not yet arrived." ;
    rdfs:subClassOf top:Evidence ;
    skos:altLabel "CSM metric"@en,
        "KRI reading"@en,
        "centralized monitoring output"@en ;
    skos:definition "A computed value of a monitored quality parameter at a point in time — the output of a centralized-monitoring run. Attributed (prov:wasAttributedTo) to the computing agent, typically a system agent; bitemporal, so 'what did the algorithm know on March 3' is a filter, not an excavation." ;
    skos:prefLabel "Metric Observation"@en .

cr:ParticipantSchedule a owl:Class ;
    rdfs:label "Participant Schedule" ;
    rdfs:comment "The schedule projected for a specific subject from a ScheduleTimeline once an anchor date (e.g. enrollment) is known. Bitemporal: re-projected when the governing protocol version changes." ;
    rdfs:subClassOf top:Evidence .

cr:PlannedActivity a owl:Class ;
    rdfs:label "Planned Activity" ;
    rdfs:comment "A planned activity within an encounter (USDM ScheduledActivityInstance) — e.g. ECG, blood draw, PRO. Positioned by a cr:Timing and/or an ordering edge (cr:precedes)." ;
    rdfs:subClassOf top:Constraint .

cr:QualityToleranceLimit a owl:Class ;
    rdfs:label "Quality Tolerance Limit" ;
    rdfs:comment "Trial-level, few in number (TransCelerate: 3-5 per trial — see QTLCountShape), defined before first participant first visit, monitored continuously, and every significant deviation documented in the CSR (cr:reportedIn). Site-level leading metrics are cr:KeyRiskIndicator, a different concept." ;
    rdfs:subClassOf top:Constraint ;
    skos:altLabel "QTL"@en,
        "acceptable range"@en,
        "quality tolerance level"@en ;
    skos:definition "A trial-level boundary on a quality parameter tied to a critical-to-quality factor — the range beyond which a systemic issue threatens participant safety, data integrity, or the study's statistical power. ICH E6(R3) calls these acceptable ranges; the industry says QTL." ;
    skos:prefLabel "Quality Tolerance Limit"@en .

cr:Reconciliation a owl:Class ;
    rdfs:label "Reconciliation" ;
    rdfs:comment "One class, four scopes (ADR-0024 one-question gate: drug vs document reconciliation is a classification of the act, not a different kind of act). The IMP scope reconciles against the accountability-log projection (supply module) — arithmetic over events, not a spreadsheet." ;
    rdfs:subClassOf top:Temporal ;
    skos:altLabel "device reconciliation"@en,
        "document reconciliation"@en,
        "drug reconciliation"@en ;
    skos:definition "The act of confirming that a site's records balance at closeout — investigational product counts, device counts, essential documents, or open queries. The scope (what is being reconciled) is cr:reconciliationScope, a value." ;
    skos:prefLabel "Reconciliation"@en ;
    skos:scopeNote "One act, four scopes (IMP/device/documents/queries) — the scope is a value, never four classes (ADR-0024)."@en .

cr:ScheduleTimeline a owl:Class ;
    rdfs:label "Schedule Timeline" ;
    rdfs:comment "The planned Schedule of Activities for a protocol version, as a timeline of planned encounters and activities. Bitemporal: a protocol amendment supersedes it, so the schedule is reconstructable as-of any date." ;
    rdfs:subClassOf top:Evidence .

cr:StartupArtifact a owl:Class ;
    rdfs:label "Start-up Artifact" ;
    rdfs:comment "A document instance in (or produced from) the start-up package, classified to a TMF artifact type. Carries the data that the work streams consume and transform." ;
    rdfs:subClassOf top:Evidence .

cr:StudyStartupPackage a owl:Class ;
    rdfs:label "Study Start-up Package" ;
    rdfs:comment "The bundle of document artifacts a site receives on being awarded a study. Not a singular item — a set of typed artifacts; in practice fetched one-by-one from sponsor portals." ;
    rdfs:subClassOf top:Evidence ;
    skos:altLabel "award package"@en,
        "site package"@en,
        "startup package"@en ;
    skos:prefLabel "Study Startup Package"@en .

cr:TableListingFigure a owl:Class ;
    rdfs:label "Table / Listing / Figure (TLF)" ;
    rdfs:comment "The tlfType qualifier (table | listing | figure) distinguishes the kind without a parallel hierarchy. A TLF that is not pre-specified is a post-hoc analysis — legitimate as exploratory, inadmissible when presented as pivotal." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "TFL"@en,
        "TLF"@en,
        "display"@en,
        "output"@en ;
    skos:definition "A pre-specified analysis output — a table, a listing, or a figure — built from an ADaM analysis dataset. The unit the CSR and the submission actually present. Must be reproducible to source (prov:wasDerivedFrom an AnalysisDataset) and grounded in the SAP that pre-specified it." ;
    skos:prefLabel "Table, Listing or Figure"@en .

cr:UnblindingEvent a owl:Class ;
    rdfs:label "Unblinding Event" ;
    rdfs:comment "Modeled like cr:DatabaseUnlock: the blind is never silently broken. An unblinding must carry its reason and its authorizer; one without both is a Violation. The unblinding kind (emergency vs planned) is a value, not a class (ADR-0024 one-question gate)." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "breaking the blind"@en,
        "code break"@en,
        "emergency unblinding"@en,
        "unblinding"@en ;
    skos:definition "The controlled, audited disclosure of a participant's treatment assignment — emergency (safety) or planned (analysis milestone)." ;
    skos:prefLabel "Unblinding Event"@en .

cr:Visit a owl:Class ;
    rdfs:label "Trial Visit" ;
    rdfs:comment "A protocol visit — a kind of study event." ;
    rdfs:subClassOf cr:StudyEvent,
        top:Temporal .

ns1:CompletenessProfile a owl:Class ;
    rdfs:label "TMF Completeness Profile" ;
    rdfs:comment "An expected-artifact checklist a TMF is judged complete against: the artifact types it must (essential) and should (recommended) contain. The DIA/ICH essential-documents list as data, reusable across studies." ;
    rdfs:subClassOf top:Constraint .

top:Attestation a owl:Class ;
    rdfs:label "Attestation"@en ;
    rdfs:comment "A formal declaration by an Agent affirming a fact — signed consent, regulatory attestation, compliance declaration, e-signature on a record."@en ;
    rdfs:subClassOf prov:Entity,
        top:Evidence ;
    skos:altLabel "sign-off"@en,
        "signature"@en,
        "signed statement"@en ;
    skos:prefLabel "Attestation"@en .

top:BitemporalShape a sh:NodeShape ;
    rdfs:label "Bitemporal Shape"@en ;
    rdfs:comment "The contract a versioned value satisfies: a valid-time start, an optional (open) valid-time end, and a stable identity via prov:specializationOf. Opt-in — NOT targeted at top:CommonEntity, so it never burdens mono-temporal entities."@en ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "A versioned value must state when its state became valid (top:validFrom, exactly one)." ;
            sh:minCount 1 ;
            sh:path top:validFrom ],
        [ sh:class top:VersionSeries ;
            sh:maxCount 1 ;
            sh:message "A versioned value must point at its stable identity (prov:specializationOf → top:VersionSeries, exactly one)." ;
            sh:minCount 1 ;
            sh:path prov:specializationOf ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "top:validUntil is open (absent) for the current version, or exactly one xsd:dateTime when closed." ;
            sh:path top:validUntil ] ;
    sh:targetClass top:Versioned .

cr:AnalysisDecision a owl:Class ;
    rdfs:label "Analysis Decision (gate)" ;
    rdfs:comment "Makes the decision a first-class, evidenced node rather than a free-text cr:meetingOutcome. The decision is bitemporal: superseding a decision (e.g. a later reversal) is a new assertion, never a rewrite." ;
    rdfs:subClassOf top:Outcome,
        top:Versioned ;
    skos:altLabel "gate decision"@en,
        "go decision"@en,
        "go/no-go"@en ;
    skos:definition "A determinate go / no-go (or modify) decision taken at a study gate on the basis of analysis outputs. The End-of-Phase-2 decision is the canonical instance: a coded verdict that rests on the evidence (TLFs / endpoint results) and yields a consequence (a proposed Phase 3 design, or a stop)." ;
    skos:prefLabel "Analysis Decision"@en .

cr:CloseoutStage a cr:TrialStage ;
    rdfs:label "Closeout" ;
    rdfs:comment "From last patient last visit (LPLV) through regulatory submission and study archival. Includes database lock, CSR, and eTMF finalization." ;
    cr:containsStage cr:ArchivalStage,
        cr:DataAnalysisStage,
        cr:FollowUpStage,
        cr:ReportingStage .

cr:DeviationEvent a owl:Class ;
    rdfs:label "Deviation Event" ;
    rdfs:comment "A protocol deviation occurrence (departure from the protocol or GCP). Classified by materiality; significant deviations require a CAPA. Bitemporal + attested." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "PD"@en,
        "deviation"@en,
        "protocol deviation"@en,
        "protocol violation"@en ;
    skos:prefLabel "Deviation Event"@en .

cr:E6R3Glossary a skos:ConceptScheme ;
    rdfs:label "ICH E6(R3) glossary (selected terms)" ;
    rdfs:comment "Definitional concepts cited to ICH E6(R3); related to the cr: class/relation that realizes each, where one exists." .

cr:EligibilityCriterion a owl:Class ;
    rdfs:label "Eligibility Criterion" ;
    rdfs:comment "An inclusion/exclusion rule defining who may enroll." ;
    rdfs:subClassOf top:Constraint ;
    skos:altLabel "I/E criteria"@en,
        "entry criteria"@en,
        "exclusion criterion"@en,
        "inclusion criterion"@en ;
    skos:prefLabel "Eligibility Criterion"@en .

cr:LawfulBasis a owl:Class ;
    rdfs:label "Lawful Basis" ;
    rdfs:comment "A GDPR lawful basis for processing personal data (Articles 6 and 9)." ;
    rdfs:subClassOf top:RegulatoryLaw .

cr:LimitBreach a owl:Class ;
    rdfs:label "Limit Breach" ;
    rdfs:comment "Root-cause disposition distinguishes 'systemic' (threatens the trial; may require protocol amendment; QTL breaches are documented in the CSR via cr:reportedIn) from 'isolated' (an operational artifact; targeted site action via cr:escalatedTo a CAPA or risk signal)." ;
    rdfs:subClassOf top:Conclusion,
        top:Versioned ;
    skos:altLabel "QTL excursion"@en,
        "out-of-tolerance event"@en,
        "threshold breach"@en ;
    skos:definition "A determination that a monitored parameter crossed its boundary — promoted to an entity (P6) so it carries evidence, disposition, escalation, and reporting, rather than living as a flag on the observation." ;
    skos:prefLabel "Limit Breach"@en .

cr:PlannedVisit a owl:Class ;
    rdfs:label "Planned Visit" ;
    rdfs:comment "A projected planned visit for a subject: a target date and a resolved window (start/end dates), against which the actual visit is reconciled." ;
    rdfs:subClassOf top:Constraint .

cr:RandomizationEvent a owl:Class ;
    rdfs:label "Randomization Event" ;
    rdfs:comment "A promoted fact (first-principles P6): 'is randomized' is never a flag — it is this event, with its time, its authority (the system or the unblinded pharmacist), and its stratum." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "random assignment"@en,
        "randomisation"@en,
        "randomization"@en ;
    skos:definition "The act of assigning an enrolled participant to a treatment arm by the randomization system, under a stratification key, yielding a randomization number." ;
    skos:prefLabel "Randomization Event"@en .

cr:SiteSelectionDecision a owl:Class ;
    rdfs:label "Site Selection Decision" ;
    rdfs:comment "A recorded, provenance-tagged decision about a study site at a specific lifecycle transition. Captures both positive (Selected, Reserve) and negative (Dropped) outcomes with mandatory rationale. The negative path — why a site was not selected — is institutional intelligence that is almost never captured in practice today but is essential for: (a) sponsor learning across studies, (b) avoiding repeat qualification of unsuitable sites, (c) CRO accountability. Bitemporal (top:Versioned) because decisions can be revised (a Dropped site can become Reserve under rescue conditions)." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned .

hcls:Lot a owl:Class ;
    rdfs:label "Lot" ;
    rdfs:comment "A manufactured batch/lot; the primary join to the manufacturing domain." ;
    rdfs:subClassOf top:Resource .

ns1:FiledArtifact a owl:Class ;
    rdfs:label "Filed Artifact" ;
    rdfs:comment "A single document instance filed into a TMF, classified to a tmf:TMFArtifactType (whence its content binding). Bitemporal + provenanced: when it became effective (observedAt), when filed (recordedAt), by whom (prov:wasAttributedTo), with lifecycle (top:status: current / superseded / expired)." ;
    rdfs:subClassOf top:Evidence,
        top:ProvenancedEntity .

ns1:Zone_TrialManagement a skos:Concept ;
    skos:prefLabel "Trial Management" ;
    skos:topConceptOf ns1:TMFReferenceModel .

top:Log a owl:Class ;
    rdfs:label "Log"@en ;
    rdfs:comment "A time-ordered collection of recorded events — audit log, communication log, calibration log, equipment log, system event log."@en ;
    rdfs:subClassOf prov:Collection,
        top:Evidence .

cr:ArchivalStage a cr:TrialStage ;
    rdfs:label "Archival" ;
    rdfs:comment "Site close-out visits, eTMF finalization, study archival, storage period compliance per country regulations." .

cr:CriticalToQualityFactor a owl:Class ;
    rdfs:label "Critical-to-Quality Factor" ;
    rdfs:comment "A quality-critical aspect of the trial (e.g. primary endpoint integrity, consent validity, SAE reporting)." ;
    rdfs:subClassOf top:Constraint ;
    skos:altLabel "CtQ factor",
        "CtQ"@en,
        "CtQ factor"@en,
        "critical data and processes"@en ;
    skos:prefLabel "Critical-to-Quality Factor"@en .

cr:DataElementDef a owl:Class ;
    rdfs:label "Data Element Definition" ;
    rdfs:comment "A variable DEFINITION (ItemOID), independent of any form version; carries a PHI classification." ;
    rdfs:subClassOf top:Evidence .

cr:DataTransferAgreement a owl:Class ;
    rdfs:label "Data Transfer Agreement" ;
    rdfs:comment "Grounded in the DTA MVP Information Model DTA entity and MVP Inventory §3 (Version, Version Date, Version Change Rationale). Not a Word/PDF artifact with fields — a fact graph." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "DTA"@en,
        "DTS"@en,
        "data transfer spec"@en,
        "vendor data agreement"@en ;
    skos:definition "The governing artifact for a vendor-to-sponsor transfer relationship. Packages one or more TransferSpecifications, references a TransferProfile, is ratified by Attestations, and cites the conformance shapes it must satisfy. Versioned (DNA status + bitemporal)." ;
    skos:prefLabel "Data Transfer Agreement"@en .

cr:DeviationAntecedent a owl:Class ;
    rdfs:label "Deviation Antecedent" ;
    rdfs:comment "A latent operational condition that predisposes a deviation (e.g. a visit window too tight for the site's staffing). The missing middle between a critical-to-quality factor and the deviation event it manifests as; bitemporal (it exists, and is detected, over time)." ;
    rdfs:subClassOf top:Constraint .

cr:InformedConsentAct a owl:Class ;
    rdfs:label "Informed Consent Act" ;
    rdfs:comment "The CR permutation of hcls:Consent — the enrollment/consent act. Declared so Versioned/Consent inheritance and bitemporal enforcement reach the instances already typed this way." ;
    rdfs:subClassOf cr:InformedConsent .

cr:MitigationPlan a owl:Class ;
    rdfs:label "Mitigation Plan" ;
    rdfs:comment "Mitigations for a risk, including the resulting monitoring strategy and SDV intensity." ;
    rdfs:subClassOf top:Constraint .

cr:Query a owl:Class ;
    rdfs:label "Query" ;
    rdfs:comment "A discrepancy note / data query anchored to a data point or other entity; threaded." ;
    rdfs:subClassOf top:Evidence ;
    skos:altLabel "DCF"@en,
        "data clarification"@en,
        "data query"@en,
        "discrepancy"@en ;
    skos:prefLabel "Query"@en .

cr:RegistryRecord a owl:Class ;
    rdfs:label "Registry Record" ;
    rdfs:comment "Bitemporal by construction: registration time and results-posting time are separate valid-time facts; the results POSTED are a projection of already-produced endpoint results (referenced by IRI), never re-authored." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "ClinicalTrials.gov record"@en,
        "NCT number"@en,
        "registry posting"@en,
        "trial registration"@en ;
    skos:definition "The public trial-registry record for a study (ClinicalTrials.gov, EUCTR, ISRCTN): its registration, and later its posted results — the FDAAA 801 / EU CTR transparency obligation." ;
    skos:prefLabel "Registry Record"@en .

cr:SiteMetrics a owl:Class ;
    rdfs:label "Site Metrics" ;
    rdfs:comment "A periodic KPI snapshot for a study site; bitemporal (top:observedAt = snapshot date, top:validFrom = reporting period start)." ;
    rdfs:subClassOf top:Evidence .

cr:StartupStage a cr:TrialStage ;
    rdfs:label "Startup" ;
    rdfs:comment "Everything from initial protocol design through first-patient-in (FPI). Gate condition: first participant randomized. Canonical ICH E6(R3) pre-trial period." ;
    cr:containsStage cr:SiteActivationStage,
        cr:SiteRegulatoryStage,
        cr:SiteSelectionStage,
        cr:StudyDesignStage ;
    cr:precedesStage cr:ConductStage .

cr:Timing a owl:Class ;
    rdfs:label "Timing" ;
    rdfs:comment "A relative-timing rule: an offset (days or hours) from an anchor — another node, or an anchor event such as enrollment — with an allowed window. The footnote logic, made explicit." ;
    rdfs:subClassOf top:Constraint .

cr:TransferSpecification a owl:Class ;
    rdfs:label "Transfer Specification" ;
    rdfs:comment "Grounded in the info-model TRANSFER_SPECIFICATION entity and CDISC LAB Model v2.0 content. Placed under top:Scope (a specification/plan), bitemporal so amendments supersede cleanly." ;
    rdfs:subClassOf top:Scope ;
    skos:definition "The content layer (the DTS): the set of DataElementSpecifications to be delivered for a given data type/vendor under a DataTransferAgreement. A plan for content, not an act." .

cr:TrialPhase a owl:Class ;
    rdfs:label "Trial Phase" ;
    rdfs:comment "Carried on the study as cr:trialPhase -> one of the named individuals below (ADR-0024: a classification rides as a value/individual, never a subclass of Study). Each phase carries the names practitioners actually use — including the device-world names, per the in-model devices decision (BOUNDARIES.md). USDM: StudyVersion.studyPhase is the crosswalk target." ;
    rdfs:subClassOf top:Scope ;
    skos:definition "The regulatory development phase a clinical trial belongs to — the answer to 'what kind of trial is this?' (Phase 1, 2, 3, 4, or BESH). A classification of the study itself, not a position in its execution (that is the lifecycle stage)." .

cr:CSR a owl:Class ;
    rdfs:comment "Deprecated (convener sanity review, 2026-07): duplicate of cr:ClinicalStudyReport (cr-core-reporting.ttl), which carries the section/traceability model. Unused by any example or shape; removed after 2 MINOR versions per the deprecation policy." ;
    owl:deprecated true ;
    owl:equivalentClass cr:ClinicalStudyReport .

cr:CSRSection a owl:Class ;
    rdfs:label "CSR Section" ;
    rdfs:comment "The sectionKind qualifier (efficacy-results | safety-results | synopsis | narrative | administrative) selects which sections must carry analysis traceability, without a parallel hierarchy." ;
    rdfs:subClassOf top:Evidence ;
    skos:definition "A section of a Clinical Study Report, keyed to its ICH E3 number (e.g. 11.4 Efficacy Results, 12.2 Adverse Events). A results section presents the TLFs and reports the results it draws its conclusions from." .

cr:Endpoint a owl:Class ;
    rdfs:label "Endpoint" ;
    rdfs:comment "A defined outcome measure the study evaluates." ;
    rdfs:subClassOf top:Scope ;
    skos:altLabel "efficacy endpoint"@en,
        "outcome measure"@en ;
    skos:prefLabel "Endpoint"@en .

cr:Recruit a owl:Class ;
    rdfs:label "Recruit" ;
    rdfs:comment "PII containment: downstream clinical data NEVER references a Recruit (cr:forSubject ranges over cr:StudySubject only). The candidate's identifiable record stays inside the site boundary; conversion to a pseudonymous Participant happens only via the attested cr:Enrollment bridge. Retires the legacy undefined cr:Recruit used by pre-rich-shell examples." ;
    rdfs:subClassOf top:Agent ;
    skos:altLabel "candidate"@en,
        "prospective participant"@en,
        "referral"@en ;
    skos:definition "A candidate considered for study participation, from first contact until conversion (enrollment) or exit. A site-boundary identity: PII-side, like hcls:Person." ;
    skos:prefLabel "Recruit"@en ;
    skos:scopeNote "PII-side, site-boundary identity — never referenced by downstream clinical data. Converts to Participant only via the attested Enrollment bridge."@en .

cr:RegulatoryAffairsSpecialist a owl:Class ;
    rdfs:label "Regulatory Affairs Specialist" ;
    rdfs:comment "Manages regulatory submissions (IND, CTA, BLA/NDA/MAA), country configuration, and regulatory authority relationships." ;
    rdfs:subClassOf hcls:Person .

cr:ReportingStage a cr:TrialStage ;
    rdfs:label "Reporting" ;
    rdfs:comment "Clinical Study Report (CSR) authoring, regulatory submission package preparation, safety reporting, data disclosure." .

cr:ScreeningRecord a owl:Class ;
    rdfs:label "Screening Record" ;
    rdfs:comment "Screen failure is cr:screeningOutcome \"screen-failure\", not a subclass (ADR-0024). The screen-failure reason cites the failed cr:EligibilityCriterion by IRI." ;
    rdfs:subClassOf top:Temporal ;
    skos:altLabel "screening"@en,
        "screening visit"@en ;
    skos:definition "The record of formally screening a consented candidate against the protocol's eligibility criteria, with a coded outcome (eligible / screen-failure / withdrew)." ;
    skos:hiddenLabel "screen failure"@en ;
    skos:prefLabel "Screening Record"@en ;
    skos:scopeNote "'Screen failure' routes here as the outcome value screeningOutcome=\"screen-failure\" — a classification, never a class (ADR-0024)."@en .

cr:SiteActivation a owl:Class ;
    rdfs:label "Site Activation" ;
    rdfs:comment "The green-light record (observedAt = activated date); must cite IRB approval, executed CTA, and SIV." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "activation"@en,
        "green light"@en,
        "site ready"@en ;
    skos:prefLabel "Site Activation"@en .

cr:eCTDSubmission a owl:Class ;
    rdfs:label "eCTD Submission" ;
    rdfs:comment "Module 5 (clinical) is what this reference reaches; earlier modules (quality, nonclinical) are out of scope. The submission must be built on a HARD database lock — submitting on reversible (soft-locked) data is inadmissible." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "BLA"@en,
        "NDA"@en,
        "filing"@en,
        "marketing application"@en,
        "submission"@en ;
    skos:definition "An electronic Common Technical Document submission to a regulator (e.g. NDA / BLA / MAA). Modeled as a manifest that references the locked, already-produced content — the Clinical Study Report, the analysis datasets, and the Define-XML — not a re-authored copy of any of it." ;
    skos:prefLabel "eCTD Submission"@en .

ns1:Zone_SiteManagement a skos:Concept ;
    skos:prefLabel "Site Management" ;
    skos:topConceptOf ns1:TMFReferenceModel .

cr:Assessment a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:comment "A clinical assessment performed during the trial." ;
    rdfs:subClassOf top:Temporal .

cr:EndpointResult a owl:Class ;
    rdfs:label "Endpoint Result" ;
    rdfs:comment "A measured efficacy/safety result; must trace to its endpoint, estimand, and SAP." ;
    rdfs:subClassOf top:Outcome,
        top:Versioned ;
    skos:altLabel "primary result"@en,
        "result"@en,
        "topline result"@en ;
    skos:prefLabel "Endpoint Result"@en .

cr:Enrollment a owl:Class ;
    rdfs:label "Enrollment" ;
    rdfs:comment "The bitemporal act linking an hcls:Person to a cr:StudySubject in a cr:Study." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "enrolment"@en,
        "onboarding"@en,
        "registration"@en,
        "study entry"@en ;
    skos:prefLabel "Enrollment"@en .

cr:SiteSelectionStage a cr:TrialStage ;
    rdfs:label "Site Selection" ;
    rdfs:comment "Feasibility assessment, site evaluation, qualification visit (SQV), site selection committee review. Output: selected site list with signed contracts." .

cr:StudyEvent a owl:Class ;
    rdfs:label "Study Event" ;
    rdfs:comment "A scheduled or unscheduled timepoint (StudyEventOID) when data is captured." ;
    rdfs:subClassOf top:Temporal .

cr:WorkStream a owl:Class ;
    rdfs:label "Activation Work Stream" ;
    rdfs:comment "A site-level stream of work triggered by a study award: consumes package documents and produces outputs. Specialized into the three streams below." ;
    rdfs:subClassOf top:Temporal .

cr:CodeAssignment a owl:Class ;
    rdfs:label "Code Assignment" ;
    rdfs:comment "A promoted fact (first-principles P6, ADR-0024): 'is coded' is never a flag. The same shape as cr:CausalityAssessment — a judgment with authority, time, and rationale. The target code is a BYOL IRI reference." ;
    rdfs:subClassOf top:Conclusion,
        top:Versioned ;
    skos:altLabel "autocoding"@en,
        "coding"@en,
        "medical coding"@en,
        "term coding"@en ;
    skos:definition "The recorded judgment that a verbatim term (an investigator's words) corresponds to a dictionary code (MedDRA term, WHODrug record) — with its method, coder, and dictionary version." ;
    skos:prefLabel "Code Assignment"@en .

cr:DataElementSpecification a owl:Class ;
    rdfs:label "Data Element Specification" ;
    rdfs:comment "Grounded in MVP Inventory content rows and the LAB v2.0 LB variable list. The SDTM target is NEVER a stored attribute here — it is a crosswalk edge rendered on projection." ;
    rdfs:subClassOf top:Scope ;
    skos:definition "One expected data element in a TransferSpecification: it binds to a canonical BiomedicalConcept, declares its unit, value range, controlled terminology, mandatory-ness, significant digits and derived flag. The universal content pattern — one shape covers lab, ECG, imaging analytes; data-type specifics are typed extensions, not parallel hierarchies." .

top:Document a owl:Class ;
    rdfs:label "Document"@en ;
    rdfs:comment "A formal artifact carrying recorded content — protocol, SOP, IB, ICF, CAPA report, batch record, regulatory submission."@en ;
    rdfs:subClassOf prov:Entity,
        top:Evidence .

cr:Credential a owl:Class ;
    rdfs:label "Credential" ;
    rdfs:comment "An attested qualification/training record that gates a delegated capability." ;
    rdfs:subClassOf top:Evidence ;
    skos:altLabel "certification"@en,
        "qualification"@en,
        "training record"@en ;
    skos:prefLabel "Credential"@en .

cr:InformedConsent a owl:Class ;
    rdfs:label "Informed Consent" ;
    rdfs:comment "The act of obtaining a subject's informed consent." ;
    rdfs:subClassOf hcls:Consent,
        top:Temporal,
        top:Versioned ;
    skos:altLabel "consent"@en,
        "consenting"@en,
        "eConsent"@en ;
    skos:definition "The act and record of a study participant voluntarily agreeing to participate after being informed of all relevant aspects of the study." ;
    skos:hiddenLabel "ICF"@en ;
    skos:prefLabel "Informed Consent"@en ;
    skos:scopeNote "'ICF' (the form) is routed here but names the document; this class is the ACT of consenting. The customized consent form itself is a startup artifact typed via the TMF scheme."@en .

cr:PharmacovigilianceSpecialist a owl:Class ;
    rdfs:label "Pharmacovigilance Specialist" ;
    rdfs:comment "Manages safety signal detection, expedited SAE reporting, safety line listings, and periodic safety reports (DSUR, PSUR). OOUX persona aliases: Pharmacovigilance, PV." ;
    rdfs:subClassOf hcls:Person ;
    skos:altLabel "PV"@en,
        "drug safety"@en,
        "safety specialist"@en ;
    skos:prefLabel "Pharmacovigilance Specialist"@en .

cr:ProtocolVersion a owl:Class ;
    rdfs:label "Protocol Version" ;
    rdfs:comment "An effective-dated protocol version (bitemporal): which version was valid for a given visit." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "amendment"@en,
        "protocol"@en,
        "protocol amendment"@en ;
    skos:prefLabel "Protocol Version"@en .

top:Conclusion a owl:Class ;
    rdfs:label "Conclusion"@en ;
    rdfs:comment "A reasoned determination — adjudication outcome, root-cause finding, regulatory decision, eligibility determination."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#GenericallyDependentContinuant>,
        prov:Entity,
        top:Outcome .

cr:Delegation a owl:Class ;
    rdfs:label "Delegation" ;
    rdfs:comment "PI delegates a Capability to a Person, gated by a Credential, attested. DOA/training logs are projections of this." ;
    rdfs:subClassOf top:Temporal,
        top:Versioned ;
    skos:altLabel "DoA"@en,
        "delegation of authority"@en,
        "task delegation"@en ;
    skos:prefLabel "Delegation"@en .

cr:SiteRegulatoryStage a cr:TrialStage ;
    rdfs:label "Site Regulatory" ;
    rdfs:comment "IND/CTA filing, IRB/EC review, country-level submissions, amendment management. Output: regulatory clearance per country." .

cr:StudyDesignStage a cr:TrialStage ;
    rdfs:label "Study Design" ;
    rdfs:comment "Protocol authoring, statistical analysis plan, SoA construction, CRF design, arm configuration, endpoint definition. Output: approved protocol version." .

hcls:Specimen a owl:Class ;
    rdfs:label "Specimen" ;
    rdfs:comment "A biospecimen collected from a Person." ;
    rdfs:subClassOf top:Resource ;
    skos:altLabel "aliquot"@en,
        "biospecimen"@en,
        "blood sample"@en,
        "sample"@en ;
    skos:prefLabel "Specimen"@en .

cr:Arm a owl:Class ;
    rdfs:label "Arm" ;
    rdfs:comment "A treatment arm of the study." ;
    rdfs:subClassOf top:Scope ;
    skos:altLabel "study arm"@en,
        "treatment arm"@en,
        "treatment group"@en ;
    skos:prefLabel "Arm"@en ;
    ns2:altLabel cr:xl-arm .

cr:RiskAssessment a owl:Class ;
    rdfs:label "Risk Assessment" ;
    rdfs:comment "An assessment of risk to a CtQ factor. Carries the ICH Q9(R1) decomposition — cr:likelihood, cr:impact, cr:detectability — plus the rolled-up cr:riskLevel and optional cr:riskScore. Bitemporal: re-assessments supersede, never overwrite." ;
    rdfs:subClassOf top:Evidence,
        top:Versioned ;
    skos:altLabel "RACT entry"@en,
        "risk review"@en ;
    skos:prefLabel "Risk Assessment"@en .

cr:TransferProfile a owl:Class ;
    rdfs:label "Transfer Profile" ;
    rdfs:comment "Grounded in MVP Inventory §5 'File Transfer Information'. Specialized per vendor as cr:VendorConnectorProfile instances grounded in each vendor's public API/export surface." ;
    rdfs:subClassOf top:Scope ;
    skos:definition "The operational envelope of a transfer: file format, delimiter, encoding, transmission method, transmission type (cumulative vs incremental), schedule, provider/receiver folder, environment. A declaration (top:Scope); its validity is enforced by cr:TransferProfile* SHACL shapes (open Q2: Scope for declaration + Constraint shapes for enforcement)." .

cr:VisitExecutionStage a cr:TrialStage ;
    rdfs:label "Visit Execution" ;
    rdfs:comment "Scheduled and unscheduled visit conduct: actuals vs. SoA, activity completion, IP administration, sample collection, CRF completion at visit level." .

hcls:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An organization — sponsor, CRO, site, central lab, or regulator." ;
    rdfs:subClassOf top:Agent .

cr:ActivityOccurrence a owl:Class ;
    rdfs:label "Activity Occurrence" ;
    rdfs:comment "One performed activity within a VisitOccurrence. Uses the universal substrate pattern: any assessment (vitals, MRI, ePRO, biopsy, IP administration) uses the same entity shape; content specialisation is via biomedicalConceptCode and taskValueType. FHIR R5: Procedure / Observation / MedicationAdministration (per activity type). SDTM: domain depends on type (VS, LB, EG, EX, PE, etc.)." ;
    rdfs:subClassOf prov:Activity,
        top:Temporal ;
    skos:altLabel "assessment performed"@en,
        "procedure"@en,
        "study task"@en ;
    skos:prefLabel "Activity Occurrence"@en ;
    skos:scopeNote "The universal performed-activity node (first-principles P5): blood draw, ECG, MRI, ePRO completion are all this class, specialized by biomedical-concept code — never by subclass."@en .

cr:ClinicalObservation a owl:Class ;
    rdfs:label "Clinical Observation" ;
    rdfs:comment "A recorded value (ItemData) for a StudySubject at a StudyEvent, defined by a DataElementDef." ;
    rdfs:subClassOf hcls:Observation ;
    skos:altLabel "CRF value"@en,
        "captured value"@en,
        "data point"@en ;
    skos:hiddenLabel "ItemData"@en ;
    skos:prefLabel "Clinical Observation"@en ;
    skos:scopeNote "'ItemData' is the CDISC ODM term (projection layer); operators say 'the value' or 'the data point'."@en .

cr:RecruitmentStage a cr:TrialStage ;
    rdfs:label "Recruitment" ;
    rdfs:comment "Candidate identification, screening, informed consent, eligibility assessment, enrollment, randomization. Operator primary: Site Coordinator + Investigator." .

cr:SiteActivationStage a cr:TrialStage ;
    rdfs:label "Site Activation" ;
    rdfs:comment "Study Startup Package readiness, Site Initiation Visit (SIV), training, delegation of authority, equipment qualification. Output: site activated and ready to enroll. (The stage; the green-light act itself is cr:SiteActivation.)" .

cr:StudySubject a owl:Class ;
    rdfs:label "Participant" ;
    rdfs:comment "The pseudonymous in-study participant identity. Linked to an hcls:Person via the bitemporal cr:Enrollment act (the sensitive bridge); carries no PII. Preferred label 'Participant' per ADR-0024 (operator vocabulary, first-principles P2); the IRI stays cr:StudySubject for stability. The PII boundary is held by homonym routing, not the label: 'Participant' names this pseudonymous identity, never the identifiable hcls:Person." ;
    rdfs:subClassOf top:Agent ;
    skos:altLabel "study participant"@en,
        "study subject"@en,
        "subject"@en ;
    skos:hiddenLabel "ResearchSubject"@en,
        "patient"@en ;
    skos:prefLabel "Participant"@en ;
    skos:scopeNote "ADR-0024: 'Participant' is the preferred operator label for the pseudonymous in-study identity (IRI stays cr:StudySubject for stability). 'Patient' is routed but not promoted — industry drift toward 'patient' is noted; in clinical research the person is a participant, patient only in care contexts. The identifiable human is hcls:Person, never this class; the only bridge is the attested cr:Enrollment."@en ;
    ns2:altLabel cr:xl-participant-patient .

top:RegulatoryLaw a owl:Class ;
    rdfs:label "Regulatory Law"@en ;
    rdfs:comment "A rule rooted in legal or regulatory authority — 21 CFR clause, ICH guideline, EU CTR provision, contractual SLA, jurisdictional reporting requirement."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#GenericallyDependentContinuant>,
        prov:Entity,
        top:Constraint .

cr:ClinicalResearchAssociate a owl:Class ;
    rdfs:label "Clinical Research Associate" ;
    rdfs:comment "Sponsor-side field monitor. Conducts monitoring visits, source data verification, deviation identification, and monitoring report submission. OOUX persona aliases: CRA, Monitor, Site Monitor." ;
    rdfs:subClassOf hcls:Person ;
    skos:altLabel "CRA"@en,
        "site monitor"@en ;
    skos:hiddenLabel "monitor"@en ;
    skos:prefLabel "Clinical Research Associate"@en ;
    skos:scopeNote "ROLES: OOUX persona aliases. 'Monitor' is on the watch-list: the person (CRA), the activity (monitoring visit), and central/medical monitoring are different things."@en ;
    ns2:altLabel cr:xl-monitor .

cr:SafetyStage a cr:TrialStage ;
    rdfs:label "Safety" ;
    rdfs:comment "Adverse event reporting, SAE expedited reporting, investigator causality assessment, pharmacovigilance line listing, safety signal detection. Always concurrent with other sub-stages." .

top:CommonEntity a owl:Class ;
    rdfs:label "Common Entity"@en ;
    rdfs:comment "The root of every TOP entity. Carries Universal DNA — top:identifier, top:observedAt, top:status — that every Category and every Leaf inherits. Not directly instantiated; serves as the type lattice that lets queries reach across every Category."@en .

top:Location a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "The spatial or logical context where an Activity occurs or a Resource resides."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#Site>,
        prov:Location,
        top:CommonEntity ;
    owl:disjointWith top:Constraint,
        top:Outcome,
        top:Resource,
        top:Scope,
        top:Temporal .

cr:FinanceStaff a owl:Class ;
    rdfs:label "Finance" ;
    rdfs:comment "Creates and approves budgets, issues site payments, and processes participant reimbursements. OOUX persona aliases: Finance, Sponsor Finance, Finance Manager." ;
    rdfs:subClassOf hcls:Person .

cr:DataManager a owl:Class ;
    rdfs:label "Data Manager" ;
    rdfs:comment "Creates and locks CRFs, manages queries, reconciles lab and date data, and manages data transfers. Dual-lens: sees CRF as data source for analysis (sponsor perspective)." ;
    rdfs:subClassOf hcls:Person ;
    skos:altLabel "CDM"@en,
        "DM"@en,
        "clinical data manager"@en ;
    skos:prefLabel "Data Manager"@en .

top:Resource a owl:Class ;
    rdfs:label "Resource"@en ;
    rdfs:comment "Physical or digital assets used to execute tasks or produce outcomes. Equipment, instruments, software systems, samples, kits, raw materials, consumables."@en ;
    rdfs:subClassOf prov:Entity,
        top:CommonEntity ;
    owl:disjointWith top:Constraint,
        top:Scope,
        top:Temporal .

cr:SponsorQualityStaff a owl:Class ;
    rdfs:label "Sponsor Quality" ;
    rdfs:comment "Classifies, approves, and closes deviations. Conducts audits and risk assessments; manages CAPAs. OOUX persona aliases: Sponsor Quality, Quality, Auditor." ;
    rdfs:subClassOf hcls:Person .

top:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "The entity with capacity to act, hold authority, or carry responsibility."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#IndependentContinuant>,
        prov:Agent,
        top:CommonEntity ;
    owl:disjointWith top:Constraint,
        top:Evidence,
        top:Location,
        top:Outcome,
        top:Resource,
        top:Scope,
        top:Temporal .

cr:RegulatoryInteraction a owl:Class ;
    rdfs:label "Regulatory Interaction" ;
    rdfs:comment "Pre-IND / EOP2 meeting." ;
    rdfs:subClassOf top:Temporal .

cr:SponsorOperationsStaff a owl:Class ;
    rdfs:label "Sponsor Operations" ;
    rdfs:comment "Manages protocol amendments, site network structure, regions, country configuration, site activation mechanics, and system configuration. OOUX persona aliases: Sponsor Operations, Sponsor Ops, Site Activation Manager." ;
    rdfs:subClassOf hcls:Person .

cr:eCRF a owl:Class ;
    rdfs:label "eCRF" ;
    rdfs:comment "Electronic case report form — the data-collection instrument used at the site." ;
    rdfs:subClassOf cr:CaseReportForm,
        top:Evidence ;
    skos:altLabel "electronic CRF"@en,
        "electronic case report form"@en ;
    skos:prefLabel "eCRF"@en .

ns1:TMFReferenceModel a skos:ConceptScheme ;
    rdfs:label "TOP TMF artifact-type scheme" ;
    rdfs:comment "A SKOS scheme of trial-master-file artifact types, aligned by name to the DIA TMF Reference Model; each artifact type carries content bridges to the domain classes it concerns." .

ns1:TMFArtifactType a owl:Class ;
    rdfs:label "TMF Artifact Type" ;
    rdfs:comment "A kind of trial-master-file document (the document-type binding target)." ;
    rdfs:subClassOf skos:Concept .

cr:TrialStage a owl:Class ;
    rdfs:label "Trial Stage" ;
    rdfs:comment "Stages form a containment tree (cr:containsStage) and a precedence chain (cr:precedesStage). Actions bind to stages via cr:occursInStage. CR-owned deliberately: trial stages exist only in clinical research, so this does not live in hcls-core." ;
    rdfs:subClassOf top:Scope ;
    skos:altLabel "lifecycle stage"@en,
        "study stage"@en ;
    skos:definition "A bounded, sequenced stage of a clinical trial's execution lifecycle — the answer to 'where in its run is this trial?' (startup, conduct, closeout, and their named sub-stages). A position in the trial's execution, not a classification of the study (that is the trial phase)." .

cr:OversightStage a cr:TrialStage ;
    rdfs:label "Oversight" ;
    rdfs:comment "Risk-based monitoring, interim monitoring visits, source data verification, deviation identification and classification, CAPA management, audit. Operator primary: CRA + Sponsor Quality." .

cr:Investigator a owl:Class ;
    rdfs:label "Investigator" ;
    rdfs:comment "A licensed clinician designated as PI or Sub-I at a Site. Holds legal responsibility for trial conduct, GCP compliance, AE causality assessment, CRF sign-off, and delegation of authority. OOUX persona aliases: PI, Investigator, Site PI." ;
    rdfs:subClassOf hcls:Clinician ;
    skos:altLabel "PI"@en,
        "doctor"@en,
        "principal investigator"@en ;
    skos:prefLabel "Investigator"@en ;
    skos:scopeNote "ROLES: OOUX persona aliases."@en .

cr:VisitOccurrence a owl:Class ;
    rdfs:label "Visit Occurrence" ;
    rdfs:comment "An actual protocol visit: what DID happen. Anchored at Participant (1..1) and StudySite (1..1). Optionally definedBy a VisitDefinition (absent for unscheduled visits). FHIR R5: Encounter. SDTM: SV domain (SVSTDTC / SVENDTC / VISITNUM / VISIT). OMOP: VISIT_OCCURRENCE." ;
    rdfs:subClassOf prov:Activity,
        top:Temporal ;
    skos:altLabel "encounter"@en,
        "patient visit"@en,
        "study visit"@en,
        "visit"@en ;
    skos:hiddenLabel "Encounter"@en ;
    skos:prefLabel "Visit Occurrence"@en ;
    skos:scopeNote "FHIR/USDM 'Encounter' is the standards term (projection layer); the operator word is 'visit'."@en .

cr:DataCollectionStage a cr:TrialStage ;
    rdfs:label "Data Collection" ;
    rdfs:comment "EDC data entry and CRF completion, query management, lab reconciliation, concomitant medication and medical history recording. Dual-lens: site captures, sponsor/DM validates." .

top:Outcome a owl:Class ;
    rdfs:label "Outcome"@en ;
    rdfs:comment "Data, state changes, or artifacts produced by a process. Lab values, observations, decisions, batch yields, throughput counts, derived metrics."@en ;
    rdfs:subClassOf prov:Entity,
        top:CommonEntity ;
    owl:disjointWith top:Constraint,
        top:Resource,
        top:Scope,
        top:Temporal .

hcls:JobToBeDone a owl:Class ;
    rdfs:label "Job to Be Done" ;
    rdfs:comment "A bounded unit of operator intent: the goal an agent type is trying to achieve, with a trigger condition and measurable success signals. Scoped to an agent type (OWL class) and a lifecycle stage. References the object graph and authorized Actions involved. Derived from OOUX JTBD blocks." ;
    rdfs:subClassOf top:Scope .

cr:AdverseEvent a owl:Class ;
    rdfs:label "Adverse Event" ;
    rdfs:comment "An untoward medical occurrence in a trial subject." ;
    rdfs:subClassOf top:Outcome ;
    skos:altLabel "AE"@en,
        "adverse experience"@en,
        "safety event"@en ;
    skos:hiddenLabel "adverse reaction"@en,
        "side effect"@en ;
    skos:prefLabel "Adverse Event"@en ;
    skos:scopeNote "'Side effect' (lay) and 'adverse reaction' (implies causality) are routed here but not promoted: an AE makes no causality claim — that is cr:CausalityAssessment."@en .

cr:ConductStage a cr:TrialStage ;
    rdfs:label "Conduct" ;
    rdfs:comment "From first patient in (FPI) through last patient out (LPO) / database lock (DBL). The operational execution window of the trial." ;
    cr:containsStage cr:DataCollectionStage,
        cr:OversightStage,
        cr:RecruitmentStage,
        cr:SafetyStage,
        cr:VisitExecutionStage ;
    cr:precedesStage cr:CloseoutStage .

hcls:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human. BOUNDARY-ONLY / PII layer: an identifiable Person lives inside the source/site sovereign boundary. Downstream and shareable artifacts must attach to a pseudonymous cr:StudySubject, never to a Person. The only legal Person<->Subject link is the attested Enrollment bridge (cr:enrolledPerson). Clinical data is PSEUDONYMIZED, not anonymized: re-identification is preserved but controlled (safety / emergency unblinding)." ;
    rdfs:subClassOf top:Agent ;
    skos:scopeNote "The identifiable human — PII, boundary-only. When an operator says 'participant' or 'patient' about in-study data, route to cr:StudySubject; this class is only for the site-sovereign identity behind the enrollment bridge."@en .

top:Scope a owl:Class ;
    rdfs:label "Scope"@en ;
    rdfs:comment "The logical boundary, strategic intent, or organizational container for work."@en ;
    rdfs:subClassOf prov:Plan,
        top:CommonEntity ;
    owl:disjointWith top:Constraint,
        top:Temporal .

cr:SponsorProjectManager a owl:Class ;
    rdfs:label "Sponsor Project Manager" ;
    rdfs:comment "Creates and activates studies, selects and manages sites, tracks milestones and enrollment, and closes studies. OOUX persona aliases: Sponsor PM, Study PM, Project Manager, Study Manager." ;
    rdfs:subClassOf hcls:Person .

top:Constraint a owl:Class ;
    rdfs:label "Constraint"@en ;
    rdfs:comment "Non-negotiable boundaries — physical, legal, regulatory, contractual, safety. Inclusion criteria, dose limits, regulatory deadlines, blinding rules, biosafety floors, SLAs."@en ;
    rdfs:subClassOf prov:Entity,
        top:CommonEntity .

top:Versioned a owl:Class ;
    rdfs:label "Versioned"@en ;
    rdfs:comment "Marker for an immutable, bitemporally-tracked value-version — an attribute-value-at-a-time (or whole-entity snapshot) carrying valid time and a stable identity via prov:specializationOf. Applied where Tier-1 entailment fires or where a workflow opts an attribute in. Not every TOP entity is Versioned; only those that need full bitemporal history."@en .

cr:SiteCoordinator a owl:Class ;
    rdfs:label "Site Coordinator" ;
    rdfs:comment "The day-to-day clinical operations professional at a Site. Screens and enrolls participants, executes visits, completes CRFs, manages AE reporting, and maintains site logs. Also known as Clinical Research Coordinator (CRC). OOUX persona aliases: Coordinator, Study Coordinator, CRC." ;
    rdfs:subClassOf hcls:Practitioner ;
    skos:altLabel "CRC"@en,
        "coordinator"@en,
        "research coordinator"@en,
        "study coordinator"@en ;
    skos:prefLabel "Site Coordinator"@en ;
    skos:scopeNote "ROLES: OOUX persona aliases."@en .

cr:StudySite a owl:Class ;
    rdfs:label "Study Site" ;
    rdfs:comment "An investigative site conducting the study (an organization at a facility)." ;
    rdfs:subClassOf hcls:Organization ;
    skos:altLabel "clinical site"@en,
        "investigative site"@en,
        "research site"@en,
        "site"@en ;
    skos:prefLabel "Study Site"@en ;
    ns2:altLabel cr:xl-site .

top:Temporal a owl:Class ;
    rdfs:label "Temporal"@en ;
    rdfs:comment "The time-based dimension of operations. Both plans (schedules, milestones, campaigns) and execution (visits, procedures, batches, shipments)."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#Process>,
        prov:Activity,
        top:CommonEntity ;
    owl:disjointWith top:Constraint .

cr:Study a owl:Class ;
    rdfs:label "Study" ;
    rdfs:comment "A clinical study — the unit of investigation the protocol defines." ;
    rdfs:subClassOf top:Scope ;
    skos:altLabel "clinical study"@en,
        "clinical trial"@en,
        "protocol"@en,
        "trial"@en ;
    skos:prefLabel "Study"@en ;
    skos:scopeNote "'Protocol' is routed here when the speaker means the study itself ('this protocol is enrolling'); the versioned protocol document is cr:ProtocolVersion."@en .

top:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ;
    rdfs:comment "Artifacts that provide verifiable proof of an event, state, or action. Lab reports, signed forms, audit logs, calibration certificates, batch records, MedWatch submissions."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo#GenericallyDependentContinuant>,
        prov:Entity,
        top:CommonEntity ;
    owl:disjointWith top:Constraint,
        top:Location,
        top:Outcome,
        top:Resource,
        top:Scope,
        top:Temporal .

hcls:Action a owl:Class ;
    rdfs:label "Action" ;
    rdfs:comment "A named, authorized operation (Call To Action in OOUX terms) that an agent of a given type may perform in a given lifecycle stage. Actions are reference-graph archetypes (top:Constraint: they specify what is authorized). Realized occurrences in instance graphs are prov:Activity individuals linked back via hcls:realizationOf." ;
    rdfs:subClassOf top:Constraint .

