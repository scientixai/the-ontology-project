cr:OverseeStudyConductAtSite a hcls:JobToBeDone ;
    rdfs:label "Hold legal responsibility for trial conduct at the Site" ;
    skos:notation "PI-J01" ;
    hcls:executesAction cr:AddInvestigatorDelegation,
        cr:RefreshGCPTraining,
        cr:UpdateFCOIDisclosure ;
    hcls:involvesObject cr:Credential,
        cr:Delegation,
        cr:Study ;
    hcls:jobOfAgentType cr:Investigator ;
    hcls:jobTrigger "Site selected for a Study; PI designated as Principal Investigator." ;
    hcls:successSignal "GCP training current throughout the Study.",
        "No regulatory or sponsor actions escalated to debarment.",
        "Regulatory investigator-commitment form on file (e.g. Form FDA 1572 in the US; jurisdiction-equivalent elsewhere)." .

cr:OversightBody a owl:Class ;
    rdfs:subClassOf hcls:Organization .

cr:Phase1 a cr:TrialPhase ;
    rdfs:label "Phase 1" ;
    rdfs:comment "Purpose: initial human safety, tolerability, dosing (dose escalation, MTD), and pharmacokinetics — not efficacy. Size: small (typically 20–100), healthy volunteers or, in oncology, patients. Sites: specialized Phase-1 units with intensive-monitoring capability, usually a handful. Device-world names: feasibility / pilot / early feasibility study." ;
    skos:altLabel "FIH"@en,
        "early feasibility study"@en,
        "early-stage study"@en,
        "feasibility study"@en,
        "first-in-human"@en,
        "phase I"@en,
        "pilot study"@en .

cr:Phase2 a cr:TrialPhase ;
    rdfs:label "Phase 2" ;
    rdfs:comment "Purpose: preliminary efficacy signal and dose selection (dose-ranging; ends at the EOP2 gate this model treats as the analysis decision node), continued safety. Size: moderate (typically 100–300 patients with the condition). Sites: academic and specialty investigative sites, tens of sites." ;
    skos:altLabel "dose-finding study"@en,
        "phase II"@en,
        "proof-of-concept study"@en .

cr:Phase3 a cr:TrialPhase ;
    rdfs:label "Phase 3" ;
    rdfs:comment "Purpose: confirmatory efficacy and safety versus control — the evidence a marketing application rests on. Size: large (typically 300–3,000+). Sites: broad multi-site, multi-region networks including community sites. Device-world name: pivotal study (the pre-market confirmatory trial, akin to a Phase 3 drug trial)." ;
    skos:altLabel "confirmatory trial"@en,
        "late-stage study"@en,
        "phase III"@en,
        "pivotal study"@en,
        "pre-market pivotal study"@en .

cr:Phase4 a cr:TrialPhase ;
    rdfs:label "Phase 4" ;
    rdfs:comment "Purpose: real-world safety and effectiveness after approval — rare adverse events, long-term outcomes, use in broader populations; often a post-marketing commitment. Size: large to very large. Sites: routine-care settings. Device-world name: post-market surveillance study." ;
    skos:altLabel "PMS study"@en,
        "phase IV"@en,
        "post-market surveillance study"@en,
        "post-marketing study"@en .

