    hcls:authorizedAgentType cr:SponsorOperationsStaff ;
    hcls:operatesOn cr:StudySite .

cr:TrainingRecord a owl:Class ;
    rdfs:subClassOf top:Document .

cr:TrialLifecycle a cr:TrialStage ;
    rdfs:label "Clinical Trial Lifecycle" ;
    rdfs:comment "The root stage encompassing the entire lifespan of a clinical trial from protocol design to study archival." ;
    cr:containsStage cr:CloseoutStage,
        cr:ConductStage,
        cr:StartupStage .

cr:UpdateArmDetails a hcls:Action ;
    rdfs:label "Update Arm Details" ;
    cr:occursInStage cr:StudyDesignStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Arm .

cr:UpdateBudgetForecast a hcls:Action ;
    rdfs:label "Update Budget Forecast" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:FinanceStaff ;
    hcls:operatesOn cr:Study .

cr:UpdateCAPA a hcls:Action ;
    rdfs:label "Update CAPA" ;
    cr:occursInStage cr:OversightStage ;
    hcls:authorizedAgentType cr:SponsorQualityStaff ;
    hcls:operatesOn cr:AdverseEvent .

cr:UpdateClinicalEventOutcome a hcls:Action ;
    rdfs:label "Update Outcome" ;
    cr:occursInStage cr:DataCollectionStage ;
    hcls:authorizedAgentType cr:Investigator ;
    hcls:operatesOn cr:ClinicalObservation .

cr:UpdateConMed a hcls:Action ;
    rdfs:label "Update ConMed" ;
    cr:occursInStage cr:DataCollectionStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:ActivityOccurrence .

cr:UpdateInformedConsent a hcls:Action ;
    rdfs:label "Update Informed Consent" ;
    cr:occursInStage cr:RecruitmentStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:InformedConsentAct .

cr:UpdateMedicalHistory a hcls:Action ;
    rdfs:label "Update Medical History" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:Participant .

cr:UpdateMilestoneDetails a hcls:Action ;
    rdfs:label "Update Milestone Details" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:SponsorProjectManager ;
    hcls:operatesOn cr:Study .

cr:UpdateParticipantDetails a hcls:Action ;
    rdfs:label "Update Participant Details" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:Participant .

cr:UpdateRegulatoryAuthority a hcls:Action ;
    rdfs:label "Update Regulatory Authority" ;
    cr:occursInStage cr:SiteRegulatoryStage ;
    hcls:authorizedAgentType cr:RegulatoryAffairsSpecialist ;
    hcls:operatesOn cr:RegulatoryInteraction .

cr:UpdateRiskRegister a hcls:Action ;
    rdfs:label "Update Risk Register" ;
    cr:occursInStage cr:OversightStage ;
    hcls:authorizedAgentType cr:SponsorQualityStaff ;
    hcls:operatesOn cr:Study .

cr:UpdateSiteDetails a hcls:Action ;
    rdfs:label "Update Site Details" ;
    cr:occursInStage cr:SiteActivationStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:StudySite .

cr:ValidateSystem a hcls:Action ;
    rdfs:label "Validate System" ;
    cr:occursInStage cr:SiteActivationStage ;
    hcls:authorizedAgentType cr:SponsorQualityStaff ;
    hcls:operatesOn cr:Study .

cr:VerifyCAPAEffectiveness a hcls:Action ;
    rdfs:label "Verify CAPA Effectiveness" ;
    cr:occursInStage cr:OversightStage ;
    hcls:authorizedAgentType cr:SponsorQualityStaff ;
    hcls:operatesOn cr:AdverseEvent .

cr:VerifySiteDataAgainstSource a hcls:JobToBeDone ;
    rdfs:label "Verify that site data matches source documents" ;
    skos:notation "CRA-J02" ;
    hcls:executesAction cr:ConductMonitoringVisit,
        cr:CreateQuery,
        cr:RecordFinding,
        cr:SubmitMonitoringReport ;
    hcls:involvesObject cr:eCRF ;
    hcls:jobOfAgentType cr:ClinicalResearchAssociate ;
    hcls:jobTrigger "Monitoring visit scheduled or risk-based trigger fires." ;
    hcls:successSignal "CRFs reviewed during the visit left in VERIFIED status.",
        "No outstanding major findings recorded.",
        "SDV rate meets monitoring plan target for the window." .

cr:WithdrawAmendment a hcls:Action ;
    rdfs:label "Withdraw Amendment" ;
    cr:occursInStage cr:SiteRegulatoryStage ;
    hcls:authorizedAgentType cr:SponsorOperationsStaff ;
    hcls:operatesOn cr:ProtocolVersion .

cr:WithdrawConsent a hcls:Action ;
    rdfs:label "Withdraw Consent" ;
    cr:occursInStage cr:ConductStage ;
    hcls:authorizedAgentType cr:SiteCoordinator ;
    hcls:operatesOn cr:InformedConsentAct .

cr:WithdrawOrCloseOutParticipant a hcls:JobToBeDone ;
    rdfs:label "Withdraw or close out a participant" ;
    skos:notation "PI-J05" ;
    hcls:executesAction cr:CompleteParticipantStudy,
        cr:WithdrawParticipant ;
    hcls:involvesObject cr:AdverseEvent,
        cr:InformedConsentAct,
        cr:Participant ;
    hcls:jobOfAgentType cr:Investigator ;
    hcls:jobTrigger "Participant withdraws consent, completes study, or meets discontinuation criteria." ;
    hcls:successSignal "In-flight SAEs followed up post-withdrawal.",
        "Participant.participantStatus reflects correct end state (COMPLETED, WITHDRAWN).",
        "Withdrawal reason and date captured." .

cr:WithdrawRegulatorySubmission a hcls:Action ;
    rdfs:label "Withdraw Regulatory Submission" ;
    cr:occursInStage cr:SiteRegulatoryStage ;
    hcls:authorizedAgentType cr:RegulatoryAffairsSpecialist ;
    hcls:operatesOn cr:RegulatoryInteraction .

cr:actionThreshold a owl:DatatypeProperty ;
    rdfs:label "action threshold" ;
    rdfs:comment "KRI boundary at which intervention is mandatory (action limit, e.g. 3 SD from benchmark)." ;
    rdfs:domain cr:KeyRiskIndicator ;
    rdfs:range xsd:decimal ;
    top:flavor "Additive" .

cr:activates a owl:ObjectProperty ;
    rdfs:domain cr:SiteActivation ;
    rdfs:range cr:StudySite ;
    top:flavor "Additive" .

cr:activationPackage a owl:ObjectProperty ;
    rdfs:label "activation package" ;
    rdfs:comment "The start-up package this activation drew from (forward edge, for single-pull retrieval)." ;
    rdfs:domain cr:SiteActivation ;
    rdfs:range cr:StudyStartupPackage ;
    top:flavor "Additive" .

cr:actualEnrollment a owl:DatatypeProperty ;
    rdfs:label "actual enrollment" ;
    rdfs:comment "The number of subjects actually enrolled in this arm (plan-vs-actual tracking)." ;
    rdfs:domain cr:Arm ;
    rdfs:range xsd:integer ;
    top:flavor "Additive" .

cr:addressesFinding a owl:ObjectProperty ;
    rdfs:domain cr:SafetyAssessment ;
    rdfs:range cr:NonclinicalFinding ;
    top:flavor "Additive" .

cr:administersProduct a owl:ObjectProperty ;
    rdfs:label "administers product" ;
    rdfs:comment "The investigational product given in this dosing event." ;
    rdfs:domain cr:Administration ;
    rdfs:range cr:InvestigationalProduct ;
    top:flavor "Additive" .

cr:affectsSpecification a owl:ObjectProperty ;
    rdfs:label "affects specification" ;
    rdfs:comment "A TransferAmendment must reference each TransferSpecification it affects (forces amendment propagation to be explicit)." ;
    rdfs:domain cr:TransferAmendment ;
    rdfs:range cr:TransferSpecification ;
    top:flavor "Additive" .

cr:agentModel a owl:DatatypeProperty ;
    rdfs:label "agent model" ;
    rdfs:comment "The model/version identifier of the autonomous agent that produced an automatic resolution (e.g. 'Auto-resolver 1.4.0'). Provenance for the machine transformation." ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:aliasResolvesTo a owl:ObjectProperty ;
    rdfs:label "alias resolves to" ;
    rdfs:comment "The canonical entity (BiomedicalConcept, cr:Visit/Encounter, or unit URI) a VendorAlias resolves to." ;
    rdfs:domain cr:VendorAlias ;
    top:flavor "Additive" .

cr:analysisCompletedAt a owl:DatatypeProperty ;
    rdfs:label "analysis completed at" ;
    rdfs:comment "Lab transfer lifecycle: when the assay completed." ;
    rdfs:range xsd:dateTime ;
    top:flavor "Additive" .

cr:analysisFlag a owl:DatatypeProperty ;
    rdfs:label "analysis flag" ;
    rdfs:comment "A population/record flag name applied at analysis (e.g. 'ITTFL', 'SAFFL') — the flag DEFINITION reference; membership itself is the analysis-population projection (projections/analysis_population_membership.rq)." ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:analysisMethod a owl:DatatypeProperty ;
    rdfs:label "analysis method" ;
    rdfs:comment "Statistical analysis method name or STATO IRI (e.g. 'mixed model repeated measures')." ;
    rdfs:domain cr:Endpoint ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:analysisModule a owl:Ontology ;
    rdfs:label "TOP CR — Analysis core (A2: TLF outputs & the EOP2 decision node)" ;
    rdfs:comment "Table/Listing/Figure as a pre-specified, reproducible-to-source output, and the study-gate decision as an evidenced first-class node. Reuses AnalysisDataset / EndpointResult / StatisticalAnalysisPlan / RegulatoryInteraction / Phase3Design." .

cr:analyzedUnder a owl:ObjectProperty ;
    rdfs:domain cr:EndpointResult ;
    rdfs:range cr:StatisticalAnalysisPlan ;
    top:flavor "Additive" .

cr:anchorDate a owl:DatatypeProperty ;
    rdfs:label "anchor date" ;
    rdfs:comment "The resolved anchor (e.g. the subject's enrollment date) from which target dates are computed." ;
    rdfs:domain cr:ParticipantSchedule ;
    rdfs:range xsd:dateTime ;
    top:flavor "Additive" .

cr:archivesISF a owl:ObjectProperty ;
    rdfs:label "archives ISF" ;
    rdfs:comment "The Investigator Site File this archival event moves into retention." ;
    rdfs:domain cr:ArchivalEvent ;
    rdfs:range cr:InvestigatorSiteFile ;
    top:flavor "Additive" .

cr:asSubject a owl:ObjectProperty ;
    rdfs:domain cr:Enrollment ;
    rdfs:range cr:StudySubject ;
    top:flavor "Additive" .

cr:assessedAgainstRSI a owl:ObjectProperty ;
    rdfs:label "assessed against RSI" ;
    rdfs:comment "The reference safety information (Investigator's Brochure version, label) the expectedness judgment was made against — the anchor that makes the verdict auditable." ;
    rdfs:domain cr:ExpectednessAssessment ;
    top:flavor "Additive" .

cr:assessedAt a owl:ObjectProperty ;
    rdfs:label "assessed at" ;
    rdfs:comment "The study visit during which this assessment was performed." ;
    rdfs:domain cr:Assessment ;
    rdfs:range cr:Visit ;
    top:flavor "Additive" .

cr:assessedBy a owl:ObjectProperty ;
    rdfs:label "assessed by" ;
    rdfs:comment "The reporting physician who made this causality assessment." ;
    rdfs:domain cr:CausalityAssessment ;
    rdfs:range hcls:Person ;
    top:flavor "Additive" .

cr:assessesFactor a owl:ObjectProperty ;
    rdfs:domain cr:RiskAssessment ;
    rdfs:range cr:CriticalToQualityFactor ;
    top:flavor "Additive" .

cr:assessmentInstrument a owl:ObjectProperty ;
    rdfs:label "assessment instrument" ;
    rdfs:comment "The validated scale or questionnaire used to collect the assessment (e.g. ADAS-Cog, SF-36)." ;
    rdfs:domain cr:Assessment ;
    rdfs:range top:Evidence ;
    top:flavor "Additive" .

cr:assessmentResult a owl:DatatypeProperty ;
    rdfs:label "assessment result" ;
    rdfs:comment "Numeric result value." ;
    rdfs:domain cr:Assessment ;
    rdfs:range xsd:decimal ;
    top:flavor "Additive" .

cr:assessmentScale a owl:DatatypeProperty ;
    rdfs:label "assessment scale" ;
    rdfs:comment "Human-readable name of the scale used (e.g. 'ADAS-Cog 13', 'ECOG PS')." ;
    rdfs:domain cr:Assessment ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:assessmentUnit a owl:DatatypeProperty ;
    rdfs:label "assessment unit" ;
    rdfs:comment "UCUM unit code for the result (e.g. 'kg', 'mmHg')." ;
    rdfs:domain cr:Assessment ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:assignedCode a owl:ObjectProperty ;
    rdfs:label "assigned code" ;
    rdfs:comment "IRI reference to the assigned dictionary term (MedDRA LLT/PT or WHODrug record). BYOL — does not reproduce licensed content." ;
    rdfs:domain cr:CodeAssignment ;
    top:flavor "Additive" .

cr:assignsArm a owl:ObjectProperty ;
    rdfs:label "assigns arm" ;
    rdfs:comment "The treatment arm the event assigns. In a blinded study this edge lives in the randomization system's graph partition, not the site's." ;
    rdfs:domain cr:RandomizationEvent ;
    rdfs:range cr:Arm ;
    top:flavor "Additive" .

cr:assignsKitTo a owl:ObjectProperty ;
    rdfs:label "assigns kit to" ;
    rdfs:comment "The participant the kit is assigned to." ;
    rdfs:domain cr:KitAssignment ;
    rdfs:range cr:StudySubject ;
    top:flavor "Additive" .

cr:atDoseLevel a owl:ObjectProperty ;
    rdfs:label "at dose level" ;
    rdfs:comment "The dose level of a dose-escalation design this dosing event or cohort sits at. Domain intentionally open (cr:Administration, cr:Cohort)." ;
    rdfs:range cr:DoseLevel ;
    top:flavor "Additive" .

cr:atSite a owl:ObjectProperty ;
    rdfs:comment "The site a subject was enrolled at (enables the enroll-after-activation check)." ;
    rdfs:domain cr:Enrollment ;
    rdfs:range cr:StudySite ;
    top:flavor "Additive" .

cr:atStudySite a owl:ObjectProperty ;
    rdfs:label "at study site" ;
    rdfs:comment "1..1. The StudySite that operationally owns this visit (in-person or remote). Redundant with Participant.forStudySite but kept direct for query convenience." ;
    rdfs:domain cr:VisitOccurrence ;
    rdfs:range cr:StudySite ;
    top:flavor "Additive" .

cr:atVisit a owl:ObjectProperty ;
    rdfs:label "at visit" ;
    rdfs:comment "The actual visit an assessment was performed within." ;
    rdfs:domain cr:Assessment ;
    rdfs:range cr:Visit ;
    top:flavor "Additive" .

cr:attestedBy a owl:ObjectProperty ;
    rdfs:label "attested by" ;
    rdfs:range hcls:Person ;
    top:flavor "Additive" .

cr:backedByCredential a owl:ObjectProperty ;
    rdfs:label "backed by credential" ;
    rdfs:comment "The Credential/delegation that authorized a signatory Attestation to ratify a transfer. Enables the 'was this party authorized to make this transfer?' gate — a ratifying Attestation with no backing Credential is a Violation." ;
    rdfs:domain top:Attestation ;
    rdfs:range cr:Credential ;
    top:flavor "Additive" .

cr:basedOnDoseOptimization a owl:ObjectProperty ;
    rdfs:comment "Project Optimus: the proposed Phase 3 dose should rest on dose-optimization work." ;
    rdfs:domain cr:Phase3Design ;
    rdfs:range top:Temporal ;
    top:flavor "Additive" .

cr:blindingConstraint a owl:ObjectProperty ;
    rdfs:label "blinding constraint" ;
    rdfs:comment "The BlindingConstraint governing a TransferProfile (scope + provenance of what is blinded)." ;
    rdfs:domain cr:TransferProfile ;
    rdfs:range cr:BlindingConstraint ;
    top:flavor "Additive" .

cr:blindingScope a owl:DatatypeProperty ;
    rdfs:label "blinding scope" ;
    rdfs:comment "What is blinded (e.g. 'treatment-assignment', 'unblinded-pk', 'none') — the scope a BlindingConstraint carries." ;
    rdfs:domain cr:BlindingConstraint ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:boundConcept a owl:ObjectProperty ;
    rdfs:label "bound concept" ;
    rdfs:comment "The canonical BiomedicalConcept a DataElementSpecification binds to (concept-first). The presence/absence of this binding — not a Y/N cell — is what 'is mapped' means." ;
    rdfs:domain cr:DataElementSpecification ;
    rdfs:range cr:BiomedicalConcept ;
    top:flavor "Additive" .

cr:breachDisposition a owl:DatatypeProperty ;
    rdfs:label "breach disposition" ;
    rdfs:comment "'systemic' (trial-level issue) or 'isolated' (localized operational artifact). Drives the escalation path." ;
    rdfs:domain cr:LimitBreach ;
    top:flavor "Additive" .

cr:breachEvidence a owl:ObjectProperty ;
    rdfs:label "breach evidence" ;
    rdfs:comment "The metric observation(s) the breach determination rests on." ;
    rdfs:domain cr:LimitBreach ;
    rdfs:range cr:MetricObservation ;
    top:flavor "Additive" .

cr:breachedLimit a owl:ObjectProperty ;
    rdfs:label "breached limit" ;
    rdfs:comment "The quality tolerance limit or key risk indicator that was crossed. Range intentionally open across the two limit classes." ;
    rdfs:domain cr:LimitBreach ;
    top:flavor "Additive" .

cr:builtOnLock a owl:ObjectProperty ;
    rdfs:label "built on lock" ;
    rdfs:comment "The DatabaseLock the submission content is built on. Ties B1 back to A1: a submission must rest on a HARD lock — reversible (soft-locked) data cannot ground a filing." ;
    rdfs:domain cr:eCTDSubmission ;
    rdfs:range cr:DatabaseLock ;
    top:flavor "Additive" .

cr:campaignChannel a owl:DatatypeProperty ;
    rdfs:label "campaign channel" ;
    rdfs:comment "Controlled: 'advertising' | 'referral' | 'ehr-search' | 'registry' | 'community' | 'advocacy'." ;
    rdfs:domain cr:RecruitmentCampaign ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:candidatePerson a owl:ObjectProperty ;
    rdfs:label "candidate person" ;
    rdfs:comment "The identifiable person behind this candidate record (site-boundary, PII-side)." ;
    rdfs:domain cr:Recruit ;
    rdfs:range hcls:Person ;
    top:flavor "Additive" .

cr:capaStatus a owl:DatatypeProperty ;
    rdfs:label "CAPA status" ;
    rdfs:comment "open | in-progress | closed." ;
    rdfs:domain cr:CAPA ;
    top:flavor "Additive" .

cr:capaType a owl:DatatypeProperty ;
    rdfs:label "CAPA type" ;
    rdfs:comment "corrective | preventive | corrective-and-preventive." ;
    rdfs:domain cr:CAPA ;
    top:flavor "Additive" .

cr:capturedDuring a owl:ObjectProperty ;
    rdfs:domain cr:ClinicalObservation ;
    rdfs:range cr:StudyEvent ;
    top:flavor "Additive" .

cr:causalityVerdict a owl:DatatypeProperty ;
    rdfs:label "causality verdict" ;
    rdfs:comment "Coded causality judgment: unrelated, possible, probable, or definite (ICH E2A)." ;
    rdfs:domain cr:CausalityAssessment ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:citesShape a owl:ObjectProperty ;
    rdfs:label "cites conformance shape" ;
    rdfs:comment "The conformance shape (IRI) a DataTransferAgreement declares its files must satisfy — the contract carries its own executable conformance." ;
    rdfs:domain cr:DataTransferAgreement ;
    top:flavor "Additive" .

cr:clinicalReviewAt a owl:DatatypeProperty ;
    rdfs:label "clinical review at" ;
    rdfs:comment "Lab transfer lifecycle: when the result was clinically reviewed (e.g. PI review of imaging on receipt)." ;
    rdfs:range xsd:dateTime ;
    top:flavor "Additive" .

cr:closeoutModule a owl:Ontology ;
    rdfs:label "TOP CR — Closeout core (A1: database lock & follow-up)" ;
    rdfs:comment "Database lock, LPLV, post-lock control, and long-term follow-up — the first closeout slice, heavily reusing Visit / ClinicalObservation / Study." .

cr:closesConsent a owl:ObjectProperty ;
    rdfs:label "closes consent" ;
    rdfs:comment "Links the withdrawal event to the cr:InformedConsent it terminates." ;
    rdfs:domain cr:ConsentWithdrawal ;
    rdfs:range cr:InformedConsent ;
    top:flavor "Additive" .

cr:closesSite a owl:ObjectProperty ;
    rdfs:label "closes site" ;
    rdfs:comment "The site this closure record ends." ;
    rdfs:domain cr:SiteClosure ;
    rdfs:range cr:StudySite ;
    top:flavor "Additive" .

cr:closureRestsOnCOV a owl:ObjectProperty ;
    rdfs:label "closure rests on COV" ;
    rdfs:comment "The Close-Out Visit this closure rests on. Required — a site is closed by evidence, not declaration." ;
    rdfs:domain cr:SiteClosure ;
    rdfs:range cr:CloseOutVisit ;
    top:flavor "Additive" .

cr:closureRestsOnReconciliation a owl:ObjectProperty ;
    rdfs:label "closure rests on reconciliation" ;
    rdfs:comment "A completed reconciliation this closure rests on (>=1 required; each must be 'balanced')." ;
    rdfs:domain cr:SiteClosure ;
    rdfs:range cr:Reconciliation ;
    top:flavor "Additive" .

cr:codedAs a owl:ObjectProperty ;
    rdfs:label "coded as" ;
    rdfs:comment "A Relationship from a BiomedicalConcept to a dereferenceable external terminology URI (LOINC/NCIt/SNOMED). Codes are Relationships to URIs, never string Properties (naming convention)." ;
    rdfs:domain cr:BiomedicalConcept ;
    top:flavor "Additive" .

cr:codedBy a owl:ObjectProperty ;
    rdfs:label "coded by" ;
    rdfs:comment "The coder (person) or, for autocoded assignments, the responsible medical-coding owner." ;
    rdfs:domain cr:CodeAssignment ;
    rdfs:range hcls:Person ;
    top:flavor "Additive" .

cr:codesEntity a owl:ObjectProperty ;
    rdfs:label "codes entity" ;
    rdfs:comment "What this assignment codes — an adverse event (MedDRA) or a reported medication (WHODrug). Intended range cr:AdverseEvent / medication record; left open across the two." ;
    rdfs:domain cr:CodeAssignment ;
    top:flavor "Additive" .

cr:codingDictionary a owl:DatatypeProperty ;
    rdfs:label "coding dictionary" ;
    rdfs:comment "Controlled: 'MedDRA' | 'WHODrug'." ;
    rdfs:domain cr:CodeAssignment ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:codingDictionaryVersion a owl:DatatypeProperty ;
    rdfs:label "coding dictionary version" ;
    rdfs:comment "The dictionary version the assignment was made against (e.g. MedDRA '27.0', WHODrug 'GLOBAL B3 Mar 2026'). Required — an assignment is meaningless without its version." ;
    rdfs:domain cr:CodeAssignment ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:codingMethod a owl:DatatypeProperty ;
    rdfs:label "coding method" ;
    rdfs:comment "Controlled: 'autocoder' | 'manual'. A value, not a class (ADR-0024)." ;
    rdfs:domain cr:CodeAssignment ;
    rdfs:range xsd:string ;
    top:flavor "Additive" .

cr:concernsStudy a owl:ObjectProperty ;
    rdfs:label "concerns study" ;
    rdfs:comment "The study the regulatory interaction concerns." ;
    rdfs:domain cr:RegulatoryInteraction ;
    rdfs:range cr:Study ;
    top:flavor "Additive" .

cr:conductedAt a owl:ObjectProperty ;
    rdfs:domain cr:Study ;
    rdfs:range cr:StudySite ;
    top:flavor "Additive" .

cr:conductedByCRA a owl:ObjectProperty ;
    rdfs:label "conducted by CRA" ;
    rdfs:comment "The monitor who conducted the visit." ;
    rdfs:domain cr:CloseOutVisit ;
    rdfs:range hcls:Person ;
    top:flavor "Additive" .

cr:consentDate a owl:DatatypeProperty ;
    rdfs:label "consent date" ;
    rdfs:comment "Calendar date on which consent was obtained." ;
    rdfs:domain cr:InformedConsent ;
    rdfs:range xsd:date .

cr:consentFormIRI a owl:DatatypeProperty ;
    rdfs:label "consent form IRI" ;
    rdfs:comment "Dereferenceable IRI to the consent form document." ;
    rdfs:domain cr:InformedConsent ;
    rdfs:range xsd:anyURI .

cr:consentStatus a owl:DatatypeProperty ;
    rdfs:label "consent status" ;
    rdfs:comment "Workflow status of the consent (e.g. active, withdrawn, expired)." ;
    rdfs:domain cr:InformedConsent ;
    rdfs:range xsd:string .

cr:consentVersion a owl:DatatypeProperty ;
    rdfs:label "consent version" ;
    rdfs:comment "Version identifier of the consent form (e.g. 'v2.1')." ;
    rdfs:domain cr:InformedConsent ;
    rdfs:range xsd:string .

cr:consumes a owl:ObjectProperty ;
    rdfs:label "consumes" ;
    rdfs:comment "An input package document the stream uses (its data)." ;
    rdfs:domain cr:WorkStream ;
    rdfs:range cr:StartupArtifact ;
    top:flavor "Additive" .

cr:containsSourceData a owl:ObjectProperty ;
    rdfs:label "contains source data" ;
    rdfs:domain cr:SourceDocument ;
    rdfs:range cr:SourceData ;
    top:flavor "Additive" .

cr:containsStage a owl:ObjectProperty ;
    rdfs:label "contains stage" ;
    rdfs:comment "Containment: a trial stage contains its named sub-stages. Transitive; used to derive the top-level stage for any sub-stage." ;
    rdfs:domain cr:TrialStage ;
    rdfs:range cr:TrialStage ;
    top:flavor "Additive" .

cr:controlApproach a owl:DatatypeProperty ;
    rdfs:label "control approach" ;
    rdfs:comment "The risk-control decision this plan implements: 'eliminate' (design the risk out), 'reduce' (lower likelihood or impact), or 'accept' (tolerate with monitoring). ICH E6(R3) risk control step." ;
    rdfs:domain cr:MitigationPlan ;
    top:flavor "Additive" .

cr:controllerOrg a owl:ObjectProperty ;
    rdfs:label "controller organization" ;
    rdfs:comment "The data controller (sponsor) party to this DPA." ;
    rdfs:domain cr:DataProcessingAgreement ;
