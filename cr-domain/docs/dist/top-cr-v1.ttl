    top:flavor "Additive" .

cr:restsOn a owl:ObjectProperty ;
    rdfs:label "rests on" ;
    rdfs:comment "The analysis evidence a decision rests on — a TableListingFigure and/or an EndpointResult. A decision that rests on nothing is a decision by assertion; its presence is required. (Range left open: both TLF (Evidence) and EndpointResult (Outcome) are valid analysis evidence.)" ;
