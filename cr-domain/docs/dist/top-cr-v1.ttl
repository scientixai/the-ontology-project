cr:SiteStatusActive a owl:NamedIndividual ;
    rdfs:label "Active" ;
    rdfs:comment "Site is actively enrolling or conducting the trial (post-SIV, first subject possible or enrolled)." .

cr:SiteStatusClosed a owl:NamedIndividual ;
    rdfs:label "Closed" ;
    rdfs:comment "Site close-out visit completed; no further subject activity; eTMF finalization in progress." .

cr:SiteStatusDropped a owl:NamedIndividual ;
    rdfs:label "Dropped" ;
    rdfs:comment "Site was not selected or was withdrawn after selection. The reason MUST be captured in a cr:SiteSelectionDecision — this is institutional intelligence almost never recorded today." .

cr:SiteStatusFeasibility a owl:NamedIndividual ;
    rdfs:label "Feasibility" ;
    rdfs:comment "Site is under feasibility assessment: SQV scheduled or completed, selection committee review pending." .

cr:SiteStatusReserve a owl:NamedIndividual ;
    rdfs:label "Reserve" ;
    rdfs:comment "Site has passed feasibility but is held in reserve as a rescue site. Sponsor may activate it if enrollment falls short at active sites. Distinct from Selected: no startup work has begun." .

cr:SiteStatusSelected a owl:NamedIndividual ;
    rdfs:label "Selected" ;
    rdfs:comment "Site has been selected: contracts signed, Study Startup Package in preparation." .

cr:SiteStatusStartup a owl:NamedIndividual ;
    rdfs:label "Startup" ;
    rdfs:comment "Site Initiation Visit completed or in progress; staff training, delegation of authority, equipment qualification underway." .

cr:SponsorBoundary a owl:NamedIndividual ;
