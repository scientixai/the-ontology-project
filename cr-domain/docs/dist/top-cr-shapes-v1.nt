_:cb233d2bc2db8e1320dae4f56daacd71c588ae3a235ecf9841dce8be4b5361cf678 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#riskLevel> \"high\" .\n              FILTER NOT EXISTS { ?mp <https://top.scientix.ai/cr/v1#mitigates> $this . }\n            }\n        " .
_:cb2349c36f93d11bfe2279ef72e8d71fb4e074c3e82d33c33a11c581a817c606b5b <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "API" .
