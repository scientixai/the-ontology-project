_:cb1a3ecf1f3af34f928c806c23b6d65e05dc10bb126741adec2fa018fcb1246cb1e <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#atStudySite> ?ss ;\n                    <https://top.scientix.ai/cr/v1#forParticipant> ?p .\n              ?p <https://top.scientix.ai/cr/v1#forStudySite> ?pss .\n              FILTER ( ?ss != ?pss )\n            }\n        " .
