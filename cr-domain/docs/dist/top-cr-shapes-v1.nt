_:cb1ab734ac6efc31f39e71fb9cacd4f64f89b98afb851dc77089d658811ff0a86d5 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
