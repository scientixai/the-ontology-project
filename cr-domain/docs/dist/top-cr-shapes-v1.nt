_:cb1a8eb3a218435c1a569b7cee6fe9978c871a6facbf1e9d14f4695c02e9aafe35c <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
