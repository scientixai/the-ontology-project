_:cb1d5c87f9e95fd3b602cfbc8500c5d9e3655f18ffbe1cdb7de812447d95bd7f597 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb1d5c87f9e95fd3b602cfbc8500c5d9e3655f18ffbe1cdb7de812447d95bd7f597 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#ctcaeGrade> .
_:cb1d948be1b6b276e2c85bc8da22828c1cc89f3cf155f4ac24a604824dc93411fd5 <http://www.w3.org/ns/shacl#message> "A CSR results section (sectionKind efficacy-results / safety-results) must cr:presentsTLF and/or cr:reportsResult the analysis output it draws its conclusion from. A results conclusion with no backing output is inadmissible." .
_:cb1d948be1b6b276e2c85bc8da22828c1cc89f3cf155f4ac24a604824dc93411fd5 <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this a cr:CSRSection ; cr:sectionKind ?k .\n              FILTER ( ?k IN ( \"efficacy-results\", \"safety-results\" ) )\n              FILTER NOT EXISTS { $this cr:presentsTLF ?t }\n              FILTER NOT EXISTS { $this cr:reportsResult ?r }\n            }\n        " .
_:cb1da8ee017e86038dbd3ccded55d8d4c844a1d66dc3d3f94ccb2d590ec901eb209 <http://www.w3.org/ns/shacl#message> "Nonclinical finding is not addressed by any clinical-protocol safety assessment (broken IND narrative -> clinical-hold risk)." .
_:cb1da8ee017e86038dbd3ccded55d8d4c844a1d66dc3d3f94ccb2d590ec901eb209 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this a <https://top.scientix.ai/cr/v1#NonclinicalFinding> .\n              FILTER NOT EXISTS {\n                ?sa a <https://top.scientix.ai/cr/v1#SafetyAssessment> ;\n                    <https://top.scientix.ai/cr/v1#addressesFinding> $this .\n              }\n            }\n        " .
