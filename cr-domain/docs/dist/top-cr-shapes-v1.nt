_:cb2008fcab75b07f72a2fe59f71e95ec9bf03e9c8e4a03f4588bbb48d5be4685755 <http://www.w3.org/ns/shacl#message> "cr:consentFormIRI (xsd:anyURI) is required (US-500-003)." .
_:cb2008fcab75b07f72a2fe59f71e95ec9bf03e9c8e4a03f4588bbb48d5be4685755 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb2008fcab75b07f72a2fe59f71e95ec9bf03e9c8e4a03f4588bbb48d5be4685755 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#consentFormIRI> .
_:cb20338b707d112c9a3834e58a4cee9a709b852ecfa643425b9659912ada4ce0ee3 <http://www.w3.org/ns/shacl#message> "Significant deviation (critical/major) has no CAPA." .
_:cb20338b707d112c9a3834e58a4cee9a709b852ecfa643425b9659912ada4ce0ee3 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#deviationCategory> ?c .\n              FILTER ( ?c IN ( \"critical\", \"major\" ) )\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#triggers> ?capa . }\n            }\n        " .
_:cb205557f025973cf8c64d7414c237afb6b638a68a8aaa88903eb6c2f9638191903 <http://www.w3.org/ns/shacl#message> "Analysis dataset (ADaM) must declare prov:wasDerivedFrom its source (traceability)." .
_:cb205557f025973cf8c64d7414c237afb6b638a68a8aaa88903eb6c2f9638191903 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb205557f025973cf8c64d7414c237afb6b638a68a8aaa88903eb6c2f9638191903 <http://www.w3.org/ns/shacl#nodeKind> <http://www.w3.org/ns/shacl#IRI> .
_:cb205557f025973cf8c64d7414c237afb6b638a68a8aaa88903eb6c2f9638191903 <http://www.w3.org/ns/shacl#path> <http://www.w3.org/ns/prov#wasDerivedFrom> .
_:cb20890ec4eb5afc4d39dac62fb2926f3c05b9334d65d6dad1a6c1112b644bad219 <http://www.w3.org/ns/shacl#datatype> <http://www.w3.org/2001/XMLSchema#string> .
_:cb20890ec4eb5afc4d39dac62fb2926f3c05b9334d65d6dad1a6c1112b644bad219 <http://www.w3.org/ns/shacl#message> "cr:consentVersion is required (US-500-003)." .
_:cb20890ec4eb5afc4d39dac62fb2926f3c05b9334d65d6dad1a6c1112b644bad219 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb20890ec4eb5afc4d39dac62fb2926f3c05b9334d65d6dad1a6c1112b644bad219 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#consentVersion> .
_:cb20bf3f237b06a1c4a05e3e3b560058c702b794225a58370d933019d883874ac46 <http://www.w3.org/ns/shacl#class> <https://top.scientix.ai/cr/v1#CSRSection> .
_:cb20bf3f237b06a1c4a05e3e3b560058c702b794225a58370d933019d883874ac46 <http://www.w3.org/ns/shacl#message> "A ClinicalStudyReport must have at least one cr:CSRSection." .
_:cb20bf3f237b06a1c4a05e3e3b560058c702b794225a58370d933019d883874ac46 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb20bf3f237b06a1c4a05e3e3b560058c702b794225a58370d933019d883874ac46 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#hasSection> .
_:cb2136aba2b420dbb70a5921930fbfb7171082f456ab5d240e39211f68051232b46 <http://www.w3.org/ns/shacl#message> "A DataTransferAgreement is ratified by an Attestation that is not backed by a valid Credential (cr:backedByCredential). 'Was this party authorized to make this transfer?' must be answerable from the graph." .
_:cb2136aba2b420dbb70a5921930fbfb7171082f456ab5d240e39211f68051232b46 <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/cr/v1#> .
_:cb2136aba2b420dbb70a5921930fbfb7171082f456ab5d240e39211f68051232b46 <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this cr:ratifiedBy ?att .\n              FILTER NOT EXISTS { ?att cr:backedByCredential ?cred . ?cred a cr:Credential . }\n            }\n        " .
_:cb2165182e0ae310de0b4d6122217dbdaed931ed6d2bbe8b699e585dbe3f64eaaf6 <http://www.w3.org/ns/shacl#class> <https://top.scientix.ai/cr/v1#Capability> .
_:cb2165182e0ae310de0b4d6122217dbdaed931ed6d2bbe8b699e585dbe3f64eaaf6 <http://www.w3.org/ns/shacl#message> "Delegation must grant a Capability." .
_:cb2165182e0ae310de0b4d6122217dbdaed931ed6d2bbe8b699e585dbe3f64eaaf6 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb2165182e0ae310de0b4d6122217dbdaed931ed6d2bbe8b699e585dbe3f64eaaf6 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#delegatedCapability> .
_:cb2175b24d59d2dd69d899395bfbefeef962f542617b61eae90b6c743043a9f77cf <http://www.w3.org/ns/shacl#message> "A code assignment must reference the assigned dictionary code by IRI (BYOL)." .
_:cb2175b24d59d2dd69d899395bfbefeef962f542617b61eae90b6c743043a9f77cf <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb2175b24d59d2dd69d899395bfbefeef962f542617b61eae90b6c743043a9f77cf <http://www.w3.org/ns/shacl#nodeKind> <http://www.w3.org/ns/shacl#IRI> .
_:cb2175b24d59d2dd69d899395bfbefeef962f542617b61eae90b6c743043a9f77cf <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#assignedCode> .
_:cb21921c1f7383b20c67d2cc26f53394723fb7b2f3f1f8ce7d23a810d9888570713 <http://www.w3.org/ns/shacl#message> "VendorAlias was auto-resolved (has cr:resolutionConfidence) but is missing provenance: it must record prov:wasDerivedFrom (the retained source it was transformed from — e.g. the original FHIR resource) AND an attributed agent (cr:resolvedBy / prov:wasAttributedTo). A transformed value with no traceable source or author is not admissible." .
_:cb21921c1f7383b20c67d2cc26f53394723fb7b2f3f1f8ce7d23a810d9888570713 <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/cr/v1#> .
_:cb21921c1f7383b20c67d2cc26f53394723fb7b2f3f1f8ce7d23a810d9888570713 <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr:   <https://top.scientix.ai/cr/v1#>\n            PREFIX prov: <http://www.w3.org/ns/prov#>\n            SELECT $this WHERE {\n              $this cr:resolutionConfidence ?c .\n              FILTER ( NOT EXISTS { $this prov:wasDerivedFrom ?src }\n                       || NOT EXISTS { $this prov:wasAttributedTo ?ag } )\n            }\n        " .
_:cb21db7922ef20c7f5696a5491858c7225a70208db7d90ae733c0ff2767df168cdc <http://www.w3.org/ns/shacl#in> _:cbe7cecdb881fa10d202f550f4ec7308432a07a9aecf6e4cfb1a0b5c7c66057838 .
_:cb21db7922ef20c7f5696a5491858c7225a70208db7d90ae733c0ff2767df168cdc <http://www.w3.org/ns/shacl#message> "TransferProfile.transmissionType is mandatory and must be 'cumulative' or 'incremental'." .
_:cb21db7922ef20c7f5696a5491858c7225a70208db7d90ae733c0ff2767df168cdc <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb21db7922ef20c7f5696a5491858c7225a70208db7d90ae733c0ff2767df168cdc <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#transmissionType> .
_:cb21f6bc46899999f7a96720f80f0df411dac6dc2ebceeb085c477aa33cda906bdc <http://www.w3.org/ns/shacl#in> _:cb596e304bf40927bc9ad618de8c823f0a3a56a0233d0e0bcc023efbe5cfc78a0c .
_:cb21f6bc46899999f7a96720f80f0df411dac6dc2ebceeb085c477aa33cda906bdc <http://www.w3.org/ns/shacl#message> "Query must carry a resolution status (open/answered/closed)." .
_:cb21f6bc46899999f7a96720f80f0df411dac6dc2ebceeb085c477aa33cda906bdc <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb21f6bc46899999f7a96720f80f0df411dac6dc2ebceeb085c477aa33cda906bdc <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#resolutionStatus> .
_:cb2209935c7b08a5c795f7c6d90b0da55ff6b2ecaaf28935e053ef755ff1ac757cb <http://www.w3.org/ns/shacl#datatype> <http://www.w3.org/2001/XMLSchema#string> .
_:cb2209935c7b08a5c795f7c6d90b0da55ff6b2ecaaf28935e053ef755ff1ac757cb <http://www.w3.org/ns/shacl#message> "Violation: an unblinding without a recorded reason — the blind is never silently broken." .
_:cb2209935c7b08a5c795f7c6d90b0da55ff6b2ecaaf28935e053ef755ff1ac757cb <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb2209935c7b08a5c795f7c6d90b0da55ff6b2ecaaf28935e053ef755ff1ac757cb <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#unblindingReason> .
_:cb221f5ce2135f4ba5769f26719a3f0bfdaa6d4621129033c4856fd652918af4da0 <http://www.w3.org/ns/shacl#class> <https://top.scientix.ai/cr/v1#StatisticalAnalysisPlan> .
_:cb221f5ce2135f4ba5769f26719a3f0bfdaa6d4621129033c4856fd652918af4da0 <http://www.w3.org/ns/shacl#message> "EndpointResult must trace to the SAP it was analyzed under." .
_:cb221f5ce2135f4ba5769f26719a3f0bfdaa6d4621129033c4856fd652918af4da0 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb221f5ce2135f4ba5769f26719a3f0bfdaa6d4621129033c4856fd652918af4da0 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#analyzedUnder> .
_:cb22272a8231e3e70d6f1e5d016e4db52d39621516511c704803076694c27945bab <http://www.w3.org/ns/shacl#message> "Violation: an integrated summary that derives from nothing — the integrated number must be reproducible to the per-study datasets." .
_:cb22272a8231e3e70d6f1e5d016e4db52d39621516511c704803076694c27945bab <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb22272a8231e3e70d6f1e5d016e4db52d39621516511c704803076694c27945bab <http://www.w3.org/ns/shacl#path> <http://www.w3.org/ns/prov#wasDerivedFrom> .
_:cb2235e5cb31a16d51f75740428f8a63e1c9b4da335a0783887ddc3a03d0d4a0eb2 <http://www.w3.org/ns/shacl#message> "A clinical observation was recorded/changed after a HARD database lock but is not covered by a cr:DatabaseUnlock. Post-lock change must be legitimate (a documented unlock), never silent." .
_:cb2235e5cb31a16d51f75740428f8a63e1c9b4da335a0783887ddc3a03d0d4a0eb2 <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/cr/v1#> .
_:cb2235e5cb31a16d51f75740428f8a63e1c9b4da335a0783887ddc3a03d0d4a0eb2 <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr:  <https://top.scientix.ai/cr/v1#>\n            PREFIX top: <https://top.scientix.ai/v1#>\n            SELECT $this WHERE {\n              $this a cr:ClinicalObservation ; top:observedAt ?od .\n              ?lk a cr:DatabaseLock ; cr:lockType \"hard\" ; top:observedAt ?ld .\n              FILTER ( ?od > ?ld )\n              FILTER NOT EXISTS { $this cr:underUnlock ?u }\n            }\n        " .
_:cb227055b0b53f2fd4d64c3b0d1e84e1764433d8e52f01574007b000cffa7e8ebe2 <http://www.w3.org/ns/shacl#message> "PlannedVisit has no cr:windowEnd." .
_:cb227055b0b53f2fd4d64c3b0d1e84e1764433d8e52f01574007b000cffa7e8ebe2 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb227055b0b53f2fd4d64c3b0d1e84e1764433d8e52f01574007b000cffa7e8ebe2 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#windowEnd> .
_:cb227055b0b53f2fd4d64c3b0d1e84e1764433d8e52f01574007b000cffa7e8ebe2 <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Violation> .
_:cb22894a599e5ad3854f0aff6ea96430d59986b44415510cc33db446a33531e0293 <http://www.w3.org/ns/shacl#class> <https://top.scientix.ai/cr/v1#ClinicalTrialAgreement> .
