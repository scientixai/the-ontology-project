_:cb1b28575ac773f6cb8911b7eb2993d9ef64c82e782aa9f75457cfa24d3a8e1a8c3 <http://www.w3.org/ns/shacl#message> "Systemic QTL breach has no CSR documentation (cr:reportedIn) — required in the clinical study report at trial end." .
_:cb1b28575ac773f6cb8911b7eb2993d9ef64c82e782aa9f75457cfa24d3a8e1a8c3 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#breachedLimit> ?limit ;\n                    <https://top.scientix.ai/cr/v1#breachDisposition> \"systemic\" .\n              ?limit a <https://top.scientix.ai/cr/v1#QualityToleranceLimit> .\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#reportedIn> ?sec . }\n            }\n        " .
_:cb1b2b6ccb9e33cf980eb5ee20d72852149d3bfe9495552c3bd0bca8021f8c534e9 <http://www.w3.org/ns/shacl#message> "A 'go' / 'go-with-modification' decision does not yield a Phase 3 design (cr:yieldsDesign). A go with no forward design is a decision without a consequence." .
_:cb1b2b6ccb9e33cf980eb5ee20d72852149d3bfe9495552c3bd0bca8021f8c534e9 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#decisionOutcome> ?o .\n              FILTER ( ?o IN ( \"go\", \"go-with-modification\" ) )\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#yieldsDesign> ?d }\n            }\n        " .
_:cb1b2b6ccb9e33cf980eb5ee20d72852149d3bfe9495552c3bd0bca8021f8c534e9 <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning> .
