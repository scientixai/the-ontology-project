_:cb156a6e0741b4806684207f1d6fda18f4479973c39e9f18f2e40473928debcac4b <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb15c7e84df20d88114a67c07f970e91ef586f9b1b8353a9dbd228bf8de6bd3a474 <http://www.w3.org/ns/shacl#message> "Essential TMF artifact type required by the completeness profile has no current filed artifact — TMF inspection-incomplete." .
_:cb15c7e84df20d88114a67c07f970e91ef586f9b1b8353a9dbd228bf8de6bd3a474 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this ?reqType WHERE {\n              $this <https://top.scientix.ai/tmf/v1#followsProfile> ?p .\n              ?p <https://top.scientix.ai/tmf/v1#requiresArtifactType> ?reqType .\n              FILTER NOT EXISTS {\n                $this <https://top.scientix.ai/tmf/v1#hasFiledArtifact> ?fa .\n                ?fa <https://top.scientix.ai/tmf/v1#ofType> ?reqType ;\n                    <https://top.scientix.ai/v1#status> \"current\" .\n              }\n            }\n        " .
_:cb15e01ab40fef30fd45834f80119866223d5fc7466bf8cfcff3939fb3a11abdb27 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "no-go" .
_:cb15e01ab40fef30fd45834f80119866223d5fc7466bf8cfcff3939fb3a11abdb27 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:cb17d3bb8d12b6e0450695dcd7fa0cf4a93567fb551108d7948f7549ff639781523 .
_:cb162466372680d6d99144b6ea5daf104fd2138c5f8444a0039ada72ec7915c7eef <http://www.w3.org/ns/shacl#message> "VisitOccurrence.visitStatus=COMPLETED but actualEndDate is missing." .
_:cb162466372680d6d99144b6ea5daf104fd2138c5f8444a0039ada72ec7915c7eef <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#visitStatus> \"COMPLETED\" .\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#actualEndDate> ?d . }\n            }\n        " .
_:cb162f018c22cd7e4e89a340c7cb52756bde324f33fa3c9de795eee35b4dbafcc69 <http://www.w3.org/ns/shacl#message> "QTL thresholds must be justified (benchmark, simulation, statistical model) — ICH E6(R3) proportionality." .
_:cb162f018c22cd7e4e89a340c7cb52756bde324f33fa3c9de795eee35b4dbafcc69 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb162f018c22cd7e4e89a340c7cb52756bde324f33fa3c9de795eee35b4dbafcc69 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#thresholdRationale> .
_:cb162fd8d020d6ca2e80526cfbb4484d0515adff3ccea92b67cf944fa8f5fe36efa <http://www.w3.org/ns/shacl#message> "VendorAlias resolved by a low-confidence match (cr:resolutionConfidence < 0.85) with no catalog Attestation — route to the attestation queue before admitting. Audit the confident population too, not just this flagged tail." .
_:cb162fd8d020d6ca2e80526cfbb4484d0515adff3ccea92b67cf944fa8f5fe36efa <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/cr/v1#> .
_:cb162fd8d020d6ca2e80526cfbb4484d0515adff3ccea92b67cf944fa8f5fe36efa <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this cr:resolutionConfidence ?c .\n              FILTER ( ?c < 0.85 )\n              FILTER NOT EXISTS { $this cr:resolutionAttestedBy ?a }\n            }\n        " .
_:cb16520b85700cdba52aad1a51a3eee5a083dd69adddba7385fbd7018e47e9a9934 <http://www.w3.org/ns/shacl#message> "100% SDV applied to a low-risk factor (over-monitoring; consider risk-based reduction)." .
_:cb16520b85700cdba52aad1a51a3eee5a083dd69adddba7385fbd7018e47e9a9934 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#sdvIntensity> ?i ;\n                    <https://top.scientix.ai/cr/v1#mitigates> ?ra .\n              ?ra <https://top.scientix.ai/cr/v1#riskLevel> \"low\" .\n              FILTER ( ?i = 1.0 )\n            }\n        " .
_:cb16542bd2a91e669729fa70af7e69baf26c96a45b4335420d28694fcef93cfeadf <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "medium" .
