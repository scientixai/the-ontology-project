_:cb1c9df96b256d230fd8805990405d7e7bb43cda872d3a0c066997cd1cb440f6cfd <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/v1#validFrom> ?obsDate .\n              ?withdrawal a <https://top.scientix.ai/cr/v1#ConsentWithdrawal> ;\n                          <https://top.scientix.ai/cr/v1#closesConsent> ?consent .\n              ?consent <https://top.scientix.ai/cr/v1#withdrawalDate> ?wd .\n              FILTER ( xsd:date(?obsDate) > ?wd )\n            }\n        " .
_:cb1cc05a2d94201eb6f76f9d3154153a9a32e1c383dbb91b97ae832e4f40f99520c <http://www.w3.org/ns/shacl#message> "VendorAlias resolves to a canonical entity but does not pin the reference version it resolved against (cr:resolvedAgainstVersion) — reference drift could silently re-write meaning." .
_:cb1cc05a2d94201eb6f76f9d3154153a9a32e1c383dbb91b97ae832e4f40f99520c <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/cr/v1#> .
