_:cb3875526b2a390968fc49074d71ba6229fda253f868e3de4712c61061d98eed5a4 <http://www.w3.org/ns/shacl#message> "Violation: a screen-failure must cite the failed eligibility criterion (cr:failedCriterion)." .
_:cb3875526b2a390968fc49074d71ba6229fda253f868e3de4712c61061d98eed5a4 <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/shapes/recruitment-v1> .
_:cb3875526b2a390968fc49074d71ba6229fda253f868e3de4712c61061d98eed5a4 <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n                $this cr:screeningOutcome \"screen-failure\" .\n                FILTER NOT EXISTS { $this cr:failedCriterion ?c }\n            }\n        " .
_:cb3875526b2a390968fc49074d71ba6229fda253f868e3de4712c61061d98eed5a4 <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Violation> .
_:cb38950f00af3498c4c0b7d704d16b16ddb1d4194aa234c4e4cbb1c209b8014a4e8 <http://www.w3.org/ns/shacl#class> <https://top.scientix.ai/cr/v1#Arm> .
_:cb38950f00af3498c4c0b7d704d16b16ddb1d4194aa234c4e4cbb1c209b8014a4e8 <http://www.w3.org/ns/shacl#maxCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb38950f00af3498c4c0b7d704d16b16ddb1d4194aa234c4e4cbb1c209b8014a4e8 <http://www.w3.org/ns/shacl#message> "cr:enrolledInArm must point to exactly one cr:Arm." .
_:cb38950f00af3498c4c0b7d704d16b16ddb1d4194aa234c4e4cbb1c209b8014a4e8 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb38950f00af3498c4c0b7d704d16b16ddb1d4194aa234c4e4cbb1c209b8014a4e8 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#enrolledInArm> .
_:cb39a64d7c1324e5a7a2fd5c3b80c65ddb00aa2b4f2632d4904341d628e55bf4459 <http://www.w3.org/ns/shacl#message> "T6: Identity stability violated — the derivation chain from $this traces back to multiple distinct identities (different IRIs and different VersionSeries) for what should be the same source event. A reminted SAE/AssayResult IRI breaks traceability." .
_:cb39a64d7c1324e5a7a2fd5c3b80c65ddb00aa2b4f2632d4904341d628e55bf4459 <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/shapes/traceability-v1> .
_:cb39a64d7c1324e5a7a2fd5c3b80c65ddb00aa2b4f2632d4904341d628e55bf4459 <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            PREFIX prov: <http://www.w3.org/ns/prov#>\n            PREFIX top: <https://top.scientix.ai/v1#>\n            SELECT $this WHERE {\n              # Find all source events this derives from (transitive)\n              $this prov:wasDerivedFrom+ ?source .\n              ?source a ?sourceType .\n              FILTER ( ?sourceType IN ( cr:AdverseEvent, cr:SeriousAdverseEvent, cr:AssayResult ) )\n              \n              # Get the stable identity (VersionSeries if Versioned, else the IRI itself)\n              OPTIONAL { ?source prov:specializationOf ?vs1 }\n              BIND ( COALESCE(?vs1, ?source) AS ?identity1 )\n              \n              # Check if there's a DIFFERENT source with a DIFFERENT identity\n              ?another a ?sourceType2 .\n              FILTER ( ?sourceType2 IN ( cr:AdverseEvent, cr:SeriousAdverseEvent, cr:AssayResult ) )\n              FILTER ( ?another != ?source )\n              OPTIONAL { ?another prov:specializationOf ?vs2 }\n              BIND ( COALESCE(?vs2, ?another) AS ?identity2 )\n              \n              # If both are about the same subject but have different identities, fail\n              ?source cr:forSubject ?subj .\n              ?another cr:forSubject ?subj .\n              FILTER ( ?identity1 != ?identity2 )\n            }\n        " .
_:cb39b4891b67e08a58d9c3cc5c902348c0ae89c679b80d8a0b76d9b9095ca7614d8 <http://www.w3.org/ns/shacl#class> <https://top.scientix.ai/cr/v1#Arm> .
