_:cb170f9edd02da75c93cfc1fc8a9aaebeba7290dbe1460b80cae0f62a903fbe4d6f <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb171af4db37c721b5aff45ddd6d9a3842dad18604f89eb32e1e734f1453d89b896 <http://www.w3.org/ns/shacl#in> _:cb6834024c81cbb7907ca02373b2b21d71a849eb4840bb6957396e66790ce975a9 .
_:cb171af4db37c721b5aff45ddd6d9a3842dad18604f89eb32e1e734f1453d89b896 <http://www.w3.org/ns/shacl#maxCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb171af4db37c721b5aff45ddd6d9a3842dad18604f89eb32e1e734f1453d89b896 <http://www.w3.org/ns/shacl#message> "cr:registryName must be a recognized public registry." .
_:cb171af4db37c721b5aff45ddd6d9a3842dad18604f89eb32e1e734f1453d89b896 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb171af4db37c721b5aff45ddd6d9a3842dad18604f89eb32e1e734f1453d89b896 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#registryName> .
_:cb1728a52fee8b8451ea01a1188bc5216422f92636d4de6ba8729f9fd289ce5af2d <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "minor" .
_:cb1728a52fee8b8451ea01a1188bc5216422f92636d4de6ba8729f9fd289ce5af2d <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb172c1aef25a2c9c5c00053ab5015ec0f9493e2a8a7b6eae90c06b0751474b051b <http://www.w3.org/ns/shacl#message> "An eCTDSubmission carries a CSR but not the analysis datasets (cr:includesDataset) and/or the Define-XML (cr:includesDefine). Module 5 datasets should ship with the report a reviewer reads them against." .
_:cb172c1aef25a2c9c5c00053ab5015ec0f9493e2a8a7b6eae90c06b0751474b051b <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this a cr:eCTDSubmission .\n              FILTER ( NOT EXISTS { $this cr:includesDataset ?d }\n                       || NOT EXISTS { $this cr:includesDefine ?x } )\n            }\n        " .
_:cb172c1aef25a2c9c5c00053ab5015ec0f9493e2a8a7b6eae90c06b0751474b051b <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning> .
_:cb173a5627d86c02d46a6be82dfe16240a6999ea7b997b338da1572f3d85c3fbdcd <http://www.w3.org/ns/shacl#class> <https://top.scientix.ai/cr/v1#StudyEvent> .
_:cb173a5627d86c02d46a6be82dfe16240a6999ea7b997b338da1572f3d85c3fbdcd <http://www.w3.org/ns/shacl#message> "Observation must reference the StudyEvent it was captured at." .
_:cb173a5627d86c02d46a6be82dfe16240a6999ea7b997b338da1572f3d85c3fbdcd <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb173a5627d86c02d46a6be82dfe16240a6999ea7b997b338da1572f3d85c3fbdcd <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#capturedDuring> .
_:cb173dea6f33ef5651e5d7f36436f972d5f86165cf2ead2414216b8049128ea718b <http://www.w3.org/ns/shacl#message> "A work stream produces an output that does not trace (prov:wasDerivedFrom) to any input." .
_:cb173dea6f33ef5651e5d7f36436f972d5f86165cf2ead2414216b8049128ea718b <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#produces> ?out .\n              FILTER NOT EXISTS { ?out <http://www.w3.org/ns/prov#wasDerivedFrom> ?in . }\n            }\n        " .
_:cb1753a5c21b33fe07f8e8c48a2c7eee87a8305e9b3308c98fad53483a036d84068 <http://www.w3.org/ns/shacl#message> "cr:RegulatoryInteraction must carry cr:meetingDate." .
_:cb1753a5c21b33fe07f8e8c48a2c7eee87a8305e9b3308c98fad53483a036d84068 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb1753a5c21b33fe07f8e8c48a2c7eee87a8305e9b3308c98fad53483a036d84068 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#meetingDate> .
_:cb175daecd7329007ffc19c50bd96bb44db718e9b93cd8f498f128a85f48600f972 <http://www.w3.org/ns/shacl#message> "Deviation event has no recorded antecedent (latent cause not captured)." .
_:cb175daecd7329007ffc19c50bd96bb44db718e9b93cd8f498f128a85f48600f972 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              FILTER NOT EXISTS { ?a <https://top.scientix.ai/cr/v1#manifestsAs> $this . }\n            }\n        " .
_:cb1765229286e395b5eda662dfb79204cfdeb1a6c384f9e7aa26cb7137d8925e30f <http://www.w3.org/ns/shacl#in> _:cb4f5184e03a9dcaa76e64a65a046ae101d8a85e4c816e719fa73eb457711566a5 .
_:cb1765229286e395b5eda662dfb79204cfdeb1a6c384f9e7aa26cb7137d8925e30f <http://www.w3.org/ns/shacl#maxCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb1765229286e395b5eda662dfb79204cfdeb1a6c384f9e7aa26cb7137d8925e30f <http://www.w3.org/ns/shacl#message> "cr:codingDictionary must be MedDRA or WHODrug." .
_:cb1765229286e395b5eda662dfb79204cfdeb1a6c384f9e7aa26cb7137d8925e30f <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb1765229286e395b5eda662dfb79204cfdeb1a6c384f9e7aa26cb7137d8925e30f <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#codingDictionary> .
_:cb17c55734a6a0e9fba298668509fafeb412a7b2e173e436afe8e432eef7be43392 <http://www.w3.org/ns/shacl#in> _:cbac5719d2335c0df721046582fda2316c468675d72e8c0a786e52f9c8fc971060 .
_:cb17c55734a6a0e9fba298668509fafeb412a7b2e173e436afe8e432eef7be43392 <http://www.w3.org/ns/shacl#message> "Deviation event must carry a category (critical/major/minor)." .
_:cb17c55734a6a0e9fba298668509fafeb412a7b2e173e436afe8e432eef7be43392 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb17c55734a6a0e9fba298668509fafeb412a7b2e173e436afe8e432eef7be43392 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#deviationCategory> .
_:cb17d5d3ffcc9adb4af2b634e749e13d274f897ee19cd7b7a8a0a12bd93008a3b3c <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "discrepant" .
_:cb17d5d3ffcc9adb4af2b634e749e13d274f897ee19cd7b7a8a0a12bd93008a3b3c <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb17fb9a5c29943c146e9cf05449dc748ce697412e99f17ad6fba801b8f1271ae8e <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> <http://www.w3.org/2004/02/skos/core#narrowMatch> .
_:cb17fb9a5c29943c146e9cf05449dc748ce697412e99f17ad6fba801b8f1271ae8e <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb18136b029cfc971b212d580b79d4ad25974be3c02def3f067d9ec93d87badb070 <http://www.w3.org/ns/shacl#message> "ProtocolVersion declares no eligibility criteria (design-quality warning)." .
_:cb18136b029cfc971b212d580b79d4ad25974be3c02def3f067d9ec93d87badb070 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb18136b029cfc971b212d580b79d4ad25974be3c02def3f067d9ec93d87badb070 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#hasEligibilityCriterion> .
_:cb18136b029cfc971b212d580b79d4ad25974be3c02def3f067d9ec93d87badb070 <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning> .
_:cb182f5063c189c097f2d75b29b7b76fdf172878235f7b7b78f201c98413947da37 <http://www.w3.org/ns/shacl#message> "Violation: cr:withdrawalDate precedes top:validFrom — consent cannot be withdrawn before it was recorded." .
_:cb182f5063c189c097f2d75b29b7b76fdf172878235f7b7b78f201c98413947da37 <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/shapes/participant-v1> .
_:cb182f5063c189c097f2d75b29b7b76fdf172878235f7b7b78f201c98413947da37 <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr:  <https://top.scientix.ai/cr/v1#>\n            PREFIX top: <https://top.scientix.ai/v1#>\n            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n            SELECT $this ?withdrawalDate ?validFrom\n            WHERE {\n                $this cr:withdrawalDate ?withdrawalDate ;\n                      top:validFrom     ?validFrom .\n                FILTER ( ?withdrawalDate < ?validFrom )\n            }\n        " .
_:cb182f5063c189c097f2d75b29b7b76fdf172878235f7b7b78f201c98413947da37 <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Violation> .
_:cb1855ea02bea5d08fabba4cce973bca1d012cca7dc2940793e19c8d28acb439a33 <http://www.w3.org/ns/shacl#message> "An eCTDSubmission is built on a database lock that is not a HARD lock. Reversible (soft-locked) data cannot ground a regulatory filing." .
_:cb1855ea02bea5d08fabba4cce973bca1d012cca7dc2940793e19c8d28acb439a33 <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this a cr:eCTDSubmission ; cr:builtOnLock ?lk .\n              FILTER NOT EXISTS { ?lk cr:lockType \"hard\" }\n            }\n        " .
_:cb18658ced976334f71e5903b8b04ca1b84d46d064f10be51f07054d7e81975f409 <http://www.w3.org/ns/shacl#message> "Warning: autocoded assignment has no human cr:CodingReview — the autocoder's output is a suggestion, not a judgment, until a coder reviews it." .
_:cb18658ced976334f71e5903b8b04ca1b84d46d064f10be51f07054d7e81975f409 <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/shapes/coding-v1> .
_:cb18658ced976334f71e5903b8b04ca1b84d46d064f10be51f07054d7e81975f409 <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n                $this cr:codingMethod \"autocoder\" .\n                FILTER NOT EXISTS { ?r cr:reviewsAssignment $this }\n            }\n        " .
_:cb18658ced976334f71e5903b8b04ca1b84d46d064f10be51f07054d7e81975f409 <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning> .
_:cb187edc77cc4b29e1cff0975bedc164cd8ccff2e2b8d8c44939b1dc417e4314b04 <http://www.w3.org/ns/shacl#class> <https://top.scientix.ai/hcls/v1#Person> .
_:cb187edc77cc4b29e1cff0975bedc164cd8ccff2e2b8d8c44939b1dc417e4314b04 <http://www.w3.org/ns/shacl#message> "Enrollment must reference the real Person (PII bridge)." .
_:cb187edc77cc4b29e1cff0975bedc164cd8ccff2e2b8d8c44939b1dc417e4314b04 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb187edc77cc4b29e1cff0975bedc164cd8ccff2e2b8d8c44939b1dc417e4314b04 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#enrolledPerson> .
_:cb188312394ea2562a79cdbe68bf29a49024482b30c94a1fcccda3f876733bac61d <http://www.w3.org/ns/shacl#in> _:cb3d3343566c4e1fcac2d50ddceeba7ef767d328191520c7846b67a0f97e24de25 .
_:cb188312394ea2562a79cdbe68bf29a49024482b30c94a1fcccda3f876733bac61d <http://www.w3.org/ns/shacl#message> "Risk assessment must carry a risk level (low/medium/high)." .
_:cb188312394ea2562a79cdbe68bf29a49024482b30c94a1fcccda3f876733bac61d <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb188312394ea2562a79cdbe68bf29a49024482b30c94a1fcccda3f876733bac61d <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#riskLevel> .
_:cb1894c1ff29337f96ae38bb40b7be759a08eb05cdeff5f2df51dca3dcfa9dbd5c0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "rejected" .
_:cb1894c1ff29337f96ae38bb40b7be759a08eb05cdeff5f2df51dca3dcfa9dbd5c0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb18a073cc77dd80fead805a23816758b69ca4b88a47bdcb11d6b2bb874dd9b4778 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "figure" .
_:cb18a073cc77dd80fead805a23816758b69ca4b88a47bdcb11d6b2bb874dd9b4778 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb18a6a787757b1eca5ce43617b973399606f032e107e8462c6ee17b748ce0a329b <http://www.w3.org/ns/shacl#message> "A DataTransferAgreement references a legal document but does not pin it by content hash (cr:documentHash). The binding legal contract stays prose/DocuSign; the DTA references it by URI + hash + version so the reference cannot silently drift." .
_:cb18a6a787757b1eca5ce43617b973399606f032e107e8462c6ee17b748ce0a329b <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/cr/v1#> .
_:cb18a6a787757b1eca5ce43617b973399606f032e107e8462c6ee17b748ce0a329b <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this cr:referencesLegalDocument ?doc .\n              FILTER NOT EXISTS { $this cr:documentHash ?h }\n            }\n        " .
_:cb18d366d468b9105cd907ac90f77dec0174357eb239f3eefd3f1ad47a31b892b7f <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "ChiCTR" .
_:cb18d366d468b9105cd907ac90f77dec0174357eb239f3eefd3f1ad47a31b892b7f <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb18de3fdaea25abd1cb64c846a26cfb88b97f5965a96a93114867c18476b12b4b0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "Manual-upload" .
_:cb18de3fdaea25abd1cb64c846a26cfb88b97f5965a96a93114867c18476b12b4b0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb18f51c5dd0a64f622da98e1252d0bf55f42b7131ffac3983b66d5a67728631169 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> <https://w3id.org/semapv/vocab/LogicalReasoning> .
_:cb18f51c5dd0a64f622da98e1252d0bf55f42b7131ffac3983b66d5a67728631169 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb190ae2b5c0116d6fb898871331ad4487f38d2b26b01316beaf9ab1513f88659ab <http://www.w3.org/ns/shacl#in> _:cb5ebafcfb01be931c147b39027d2d427784c6d1f417eff2a50be4578076051110 .
_:cb190ae2b5c0116d6fb898871331ad4487f38d2b26b01316beaf9ab1513f88659ab <http://www.w3.org/ns/shacl#message> "TransferProfile.transmissionMethod is mandatory and must be in controlled terminology (SFTP | FTP | API | FHIR-API | Webhook | Snowflake-share | BigQuery-direct | Manual-upload)." .
_:cb190ae2b5c0116d6fb898871331ad4487f38d2b26b01316beaf9ab1513f88659ab <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb190ae2b5c0116d6fb898871331ad4487f38d2b26b01316beaf9ab1513f88659ab <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#transmissionMethod> .
_:cb1957d4145b1b114576f5253c3201d986c44db499d6bbeead9ec9126dc5c107775 <http://www.w3.org/ns/shacl#message> "An assessment carrying cr:assessmentResult should also carry cr:assessmentUnit (UCUM code)." .
_:cb1957d4145b1b114576f5253c3201d986c44db499d6bbeead9ec9126dc5c107775 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#assessmentResult> ?v .\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#assessmentUnit> ?u . }\n            }\n        " .
_:cb1979cafd6867c1339f4d90831530d56b74217b540c20480b284c667709f0cd990 <http://www.w3.org/ns/shacl#class> <https://top.scientix.ai/cr/v1#Delegation> .
_:cb1979cafd6867c1339f4d90831530d56b74217b540c20480b284c667709f0cd990 <http://www.w3.org/ns/shacl#message> "Consent must reference the authorizing Delegation." .
_:cb1979cafd6867c1339f4d90831530d56b74217b540c20480b284c667709f0cd990 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb1979cafd6867c1339f4d90831530d56b74217b540c20480b284c667709f0cd990 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#underDelegation> .
