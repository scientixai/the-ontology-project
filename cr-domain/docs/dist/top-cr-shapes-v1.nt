_:cb1911644d5cd0f340a50c0fabea74ea374778161363fcff6ae47c2eda719b61e8d <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb194275ac27f2fdad98db1e3ad287bbff75045db28d58a36dfc0a5362667cf2ee8 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "ToBeVerified" .
_:cb194275ac27f2fdad98db1e3ad287bbff75045db28d58a36dfc0a5362667cf2ee8 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:cb2781432efbeabb9c8637b3fe374bc09d35ba5ba892d83a916189c89683b6ed5e2 .
_:cb194636ed1df1b9624583ed72da6d2ce4779af147cd7e53c43420024f84c152b7e <http://www.w3.org/ns/shacl#message> "Study carries more than 5 quality tolerance limits — TransCelerate recommends 3-5 to avoid diluting oversight." .
_:cb194636ed1df1b9624583ed72da6d2ce4779af147cd7e53c43420024f84c152b7e <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              { SELECT $this (COUNT(?q) AS ?n) WHERE {\n                  $this <https://top.scientix.ai/cr/v1#limitForStudy> ?study .\n                  ?q <https://top.scientix.ai/cr/v1#limitForStudy> ?study .\n                } GROUP BY $this }\n              FILTER ( ?n > 5 )\n            }\n        " .
_:cb1957d4145b1b114576f5253c3201d986c44db499d6bbeead9ec9126dc5c107775 <http://www.w3.org/ns/shacl#message> "An assessment carrying cr:assessmentResult should also carry cr:assessmentUnit (UCUM code)." .
_:cb1957d4145b1b114576f5253c3201d986c44db499d6bbeead9ec9126dc5c107775 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#assessmentResult> ?v .\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#assessmentUnit> ?u . }\n            }\n        " .
_:cb19586212d7d608bb199d2868b33d5e746ce58485031f53f4142bdb8434fffd14f <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "exclusion" .
_:cb19586212d7d608bb199d2868b33d5e746ce58485031f53f4142bdb8434fffd14f <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb1979cafd6867c1339f4d90831530d56b74217b540c20480b284c667709f0cd990 <http://www.w3.org/ns/shacl#class> <https://top.scientix.ai/cr/v1#Delegation> .
_:cb1979cafd6867c1339f4d90831530d56b74217b540c20480b284c667709f0cd990 <http://www.w3.org/ns/shacl#message> "Consent must reference the authorizing Delegation." .
_:cb1979cafd6867c1339f4d90831530d56b74217b540c20480b284c667709f0cd990 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:cb1979cafd6867c1339f4d90831530d56b74217b540c20480b284c667709f0cd990 <http://www.w3.org/ns/shacl#path> <https://top.scientix.ai/cr/v1#underDelegation> .
_:cb19c606734300bc9522eea904839da358903257c9fe5e22dfefeca19571c8ad1d4 <http://www.w3.org/ns/shacl#message> "cx:Mapping has cx:inferredBy but cx:mappingMethod is not 'LLMInference'. Set mappingMethod to document provenance correctly." .
_:cb19c606734300bc9522eea904839da358903257c9fe5e22dfefeca19571c8ad1d4 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/crosswalk/v1#inferredBy> ?agent .\n              FILTER NOT EXISTS {\n                $this <https://top.scientix.ai/crosswalk/v1#mappingMethod> \"LLMInference\" .\n              }\n            }\n        " .
_:cb19cd5574ee6c08e6358e4a4ea7f47238b13dd2beb97a82c2a75c7dd9ef42c87f3 <http://www.w3.org/ns/shacl#message> "DataElementSpecification value range is inverted (cr:valueRangeLow > cr:valueRangeHigh)." .
_:cb19cd5574ee6c08e6358e4a4ea7f47238b13dd2beb97a82c2a75c7dd9ef42c87f3 <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/cr/v1#> .
_:cb19cd5574ee6c08e6358e4a4ea7f47238b13dd2beb97a82c2a75c7dd9ef42c87f3 <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n              $this cr:valueRangeLow ?lo ; cr:valueRangeHigh ?hi .\n              FILTER ( ?lo > ?hi )\n            }\n        " .
_:cb1a0207bc5fc6cf1f30bd207bebafd62ceb9597f919935c0f36270bde43247b4f1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "jRCT" .
_:cb1a0207bc5fc6cf1f30bd207bebafd62ceb9597f919935c0f36270bde43247b4f1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:cb2080e6e56667dcbab5e63ca0c6bffdf2d73c4369855bbcd2ba255a5a80e76d410 .
_:cb1a27a0ab475b36b001f249386254d5f189ad4751751e70b6c6fc79dd7f92ee84d <http://www.w3.org/ns/shacl#message> "Violation: product dispensed from a lot while a temperature excursion on it is still 'quarantined' (dispensing valid-time after the excursion's)." .
_:cb1a27a0ab475b36b001f249386254d5f189ad4751751e70b6c6fc79dd7f92ee84d <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/shapes/supply-v1> .
_:cb1a27a0ab475b36b001f249386254d5f189ad4751751e70b6c6fc79dd7f92ee84d <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr:  <https://top.scientix.ai/cr/v1#>\n            PREFIX top: <https://top.scientix.ai/v1#>\n            SELECT $this WHERE {\n                $this cr:excursionDisposition \"quarantined\" ;\n                      cr:excursionOnLot ?lot ;\n                      top:observedAt ?et .\n                ?d a cr:DispensingEvent ;\n                   cr:dispensesFromLot ?lot ;\n                   top:observedAt ?dt .\n                FILTER ( ?dt > ?et )\n            }\n        " .
_:cb1a27a0ab475b36b001f249386254d5f189ad4751751e70b6c6fc79dd7f92ee84d <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Violation> .
_:cb1a3ecf1f3af34f928c806c23b6d65e05dc10bb126741adec2fa018fcb1246cb1e <http://www.w3.org/ns/shacl#message> "VisitOccurrence.atStudySite does not match the forParticipant's forStudySite." .
_:cb1a3ecf1f3af34f928c806c23b6d65e05dc10bb126741adec2fa018fcb1246cb1e <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#atStudySite> ?ss ;\n                    <https://top.scientix.ai/cr/v1#forParticipant> ?p .\n              ?p <https://top.scientix.ai/cr/v1#forStudySite> ?pss .\n              FILTER ( ?ss != ?pss )\n            }\n        " .
_:cb1a5e090c7c1009ef46cb5ecf176fa48cc77cb0e5705a1bc17196794aed7ef9f0c <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "other" .
