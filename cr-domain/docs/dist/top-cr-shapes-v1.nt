_:cb1c75b541be4178d8836474786c754acbae8a33f4b9e2b3d07ae382daa87394383 <http://www.w3.org/ns/shacl#message> "Recommended TMF artifact type has no current filed artifact — reviewable completeness gap." .
_:cb1c75b541be4178d8836474786c754acbae8a33f4b9e2b3d07ae382daa87394383 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this ?recType WHERE {\n              $this <https://top.scientix.ai/tmf/v1#followsProfile> ?p .\n              ?p <https://top.scientix.ai/tmf/v1#recommendsArtifactType> ?recType .\n              FILTER NOT EXISTS {\n                $this <https://top.scientix.ai/tmf/v1#hasFiledArtifact> ?fa .\n                ?fa <https://top.scientix.ai/tmf/v1#ofType> ?recType ;\n                    <https://top.scientix.ai/v1#status> \"current\" .\n              }\n            }\n        " .
_:cb1c777141f9aeb37bebff18e2a274002fbcfd38d0eef81ad11228e863f2bf21109 <http://www.w3.org/ns/shacl#class> <https://top.scientix.ai/hcls/v1#Lot> .
