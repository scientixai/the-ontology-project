_:cb10cc6e59a6d2db7613a5194050e0c4aa4f48010c50c278c5c003f4f0eb8cd8d15 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#timing> ?t . }\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/cr/v1#precedes> ?o . }\n              FILTER NOT EXISTS { ?p <https://top.scientix.ai/cr/v1#precedes> $this . }\n            }\n        " .
_:cb10ed5cf425231f1e69ba12c515226b4b7c0fe6619117321758f382cb27a4a90e3 <http://www.w3.org/ns/shacl#message> "EOP2 meeting lacks a binding agreement and/or a risk register (readiness warning)." .
_:cb10ed5cf425231f1e69ba12c515226b4b7c0fe6619117321758f382cb27a4a90e3 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#meetingType> \"EOP2\" .\n              FILTER ( NOT EXISTS { $this <https://top.scientix.ai/cr/v1#producedAgreement> ?a }\n                       || NOT EXISTS { $this <https://top.scientix.ai/cr/v1#hasRiskRegister> ?r } )\n            }\n        " .
_:cb112ad97bd53ed589c0ae49ab5cdfb2e9296950ea46642d97056324d466d404fdf <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "administrative" .
_:cb112ad97bd53ed589c0ae49ab5cdfb2e9296950ea46642d97056324d466d404fdf <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cb11334cb11ddf71ee5550f23e888f6dc1d69f871a4d0abf482bedddfe5dc286703 <http://www.w3.org/ns/shacl#message> "Actual visit's observedAt falls outside the planned window of the visit it realizes (out-of-window) — review materiality." .
_:cb11334cb11ddf71ee5550f23e888f6dc1d69f871a4d0abf482bedddfe5dc286703 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/cr/v1#realizes> ?pv ;\n                    <https://top.scientix.ai/v1#observedAt> ?t .\n              ?pv a <https://top.scientix.ai/cr/v1#PlannedVisit> ;\n                  <https://top.scientix.ai/cr/v1#windowStart> ?ws ;\n                  <https://top.scientix.ai/cr/v1#windowEnd> ?we .\n              FILTER ( ?t < ?ws || ?t > ?we )\n            }\n        " .
_:cb11a0ced0b1817018b2c024fd9cf89cf2f2ecde9b25a2a398ab16361cc967cfaab <http://www.w3.org/ns/shacl#message> "Warning: publication cites no endpoint result (cr:disclosesResult) — fine for a design/methods paper, a trace hole for a results paper." .
_:cb11a0ced0b1817018b2c024fd9cf89cf2f2ecde9b25a2a398ab16361cc967cfaab <http://www.w3.org/ns/shacl#prefixes> <https://top.scientix.ai/shapes/disclosure-v1> .
_:cb11a0ced0b1817018b2c024fd9cf89cf2f2ecde9b25a2a398ab16361cc967cfaab <http://www.w3.org/ns/shacl#select> "\n            PREFIX cr: <https://top.scientix.ai/cr/v1#>\n            SELECT $this WHERE {\n                FILTER NOT EXISTS { $this cr:disclosesResult ?r }\n            }\n        " .
_:cb11a0ced0b1817018b2c024fd9cf89cf2f2ecde9b25a2a398ab16361cc967cfaab <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning> .
_:cb11a6dfbf633d422b829d09d0a65a6cabb97e6bd4bebdb2b74f8b60b499e631df9 <http://www.w3.org/ns/shacl#message> "cx:Mapping has cx:inferredBy (LLM-produced) but cx:confirmedBy is absent. Human curation is required before promotion to verified." .
_:cb11a6dfbf633d422b829d09d0a65a6cabb97e6bd4bebdb2b74f8b60b499e631df9 <http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n              $this <https://top.scientix.ai/crosswalk/v1#inferredBy> ?agent .\n              FILTER NOT EXISTS { $this <https://top.scientix.ai/crosswalk/v1#confirmedBy> ?curator . }\n            }\n        " .
